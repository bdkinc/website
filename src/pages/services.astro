---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { getCollection } from 'astro:content';
import { PiEnvelope } from 'react-icons/pi';
import { Card } from '@/components/ui/card';
import InteractiveServiceCard from '@/components/InteractiveServiceCard';
import Footer from '@/components/Footer.astro';

const { servicesData, recentPosts } = await getNavigationData();

// Get all services from the content collection
const allServices = await getCollection('services');
// Sort by order field
const services = allServices.sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="IT Services | Managed Services, Cloud Hosting, Cybersecurity | BDKinc"
>
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="circuit-overlay absolute inset-0 opacity-30"></div>
      <div
        class="via-background/30 to-background absolute inset-0 bg-gradient-to-b from-transparent"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-7xl text-center">
        {/* Badge */}
        <div
          class="glass border-primary/20 animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
        >
          <span class="text-sm">
            <span class="font-semibold text-[--brand-accent]"
              >Enterprise-Grade</span
            > Solutions
          </span>
        </div>

        <h1
          class="fill-mode-both animate-in fade-in slide-in-from-top-6 mb-4 text-5xl font-bold delay-100 duration-700 md:text-6xl"
        >
          <span class="text-foreground">Our </span>
          <span
            class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
            >Services</span
          >
        </h1>
        <p
          class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-4 mx-auto max-w-2xl text-xl delay-200 duration-600"
        >
          Comprehensive IT solutions designed to help your business thrive
        </p>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-gradient-to-r to-[--brand-accent]/50"
      >
      </div>
    </section>

    <!-- Services Grid Section -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        {/* 3x3 Grid Layout */}
        <div
          class="grid auto-rows-fr grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
        >
          {
            services.map((service, index) => {
              return (
                <InteractiveServiceCard
                  client:visible
                  id={service.id}
                  title={service.data.title}
                  description={service.data.description}
                  icon={service.data.icon}
                  index={index}
                />
              );
            })
          }
        </div>
      </div>
    </section>

    {/* CTA Section */}
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <InteractiveServiceCard
          client:visible
          id="cta-contact"
          title="Ready to Get Started?"
          description="Contact us today to discuss how our services can help your business grow. We architect, manage, and secure your infrastructure so you can focus on driving your business forward."
          icon="Envelope"
          index={10}
          asChild
        >
          <a
            href="/contact"
            class="flex flex-col items-center text-center h-full w-full"
          >
            {/* The InteractiveServiceCard handles the layout, we just need to provide the link content if needed or wrap it */}
          </a>
        </InteractiveServiceCard>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
