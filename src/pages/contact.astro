---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import ContactChat from '@/components/ContactChat';
import { getNavigationData } from '@/lib/navigation-data';
import Footer from '@/components/Footer.astro';
import { ServiceCard } from '@/components/ServiceCard';
import { PiPhone, PiEnvelope, PiMapPin, PiHeadset } from 'react-icons/pi';
import { actions } from 'astro:actions';

export const prerender = false;

const { servicesData, recentPosts } = await getNavigationData();

// Get referrer-based suggestions using Astro action
const fromParam = Astro.url.searchParams.get('from');
const result = await Astro.callAction(actions.getReferrerSuggestions, {
  from: fromParam || undefined,
});

const initialSuggestions = result?.data?.suggestions || [
  'Schedule a consultation',
  'Request a technical assessment',
  'Inquire about managed services',
  'Discuss cloud migration',
];
---

<Layout title="Contact | BDKinc - Strategic Technical Partner">
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />

  <main id="main-content">
    {/* HERO Section: Background + Text + Gradient Border */}
    <section class="relative overflow-visible px-4 pt-24 pb-24 sm:px-6 lg:px-8">
      {/* Background stays inside hero */}
      <div class="circuit-overlay absolute inset-0 opacity-20"></div>
      <div class="gradient-mesh absolute inset-0 opacity-40"></div>

      {/* Subtle glow pools */}
      <div
        class="bg-brand-primary/10 absolute -top-24 left-1/4 h-[520px] w-[520px] rounded-full blur-[110px]"
      >
      </div>
      <div
        class="bg-brand-secondary/10 absolute right-1/4 -bottom-24 h-[520px] w-[520px] rounded-full blur-[110px]"
      >
      </div>

      <div class="relative z-10">
        {/* Text block */}
        <div class="mx-auto max-w-4xl text-center">
          <div
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 duration-700"
          >
            <div
              class="border-primary/20 bg-background/40 text-muted-foreground mb-6 inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-semibold tracking-wide backdrop-blur-md"
            >
              <div class="text-foreground/80">
                Premier Technology <span class="text-accent">Partner</span>
              </div>
            </div>
          </div>

          <h1
            class="mb-5 text-4xl font-bold tracking-tight md:text-5xl lg:text-6xl"
          >
            <span class="text-foreground">Start the </span>
            <span
              class="from-brand-primary to-brand-secondary bg-linear-to-br bg-clip-text text-transparent"
            >
              Conversation
            </span>
          </h1>

          <p
            class="text-muted-foreground mx-auto max-w-2xl text-xl leading-relaxed"
          >
            Ask anything about our work. Our intelligent assistant handles
            discovery, while request routing guarantees a leadership response
            within 2 hours.
          </p>

          <div
            class="text-muted-foreground mt-8 flex flex-wrap justify-center gap-x-6 gap-y-3 text-sm"
          >
            <div class="flex items-center gap-2">
              <div class="bg-primary/60 h-1.5 w-1.5 rounded-full"></div>
              <span>2-hour response time</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="bg-secondary/60 h-1.5 w-1.5 rounded-full"></div>
              <span>Ask us anything</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="h-1.5 w-1.5 rounded-full bg-emerald-500/60"></div>
              <span>Premier IT partnership</span>
            </div>
          </div>
        </div>
      </div>
      {/* Gradient border at bottom of hero */}
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--brand-accent]/50"
      >
      </div>
    </section>
  </main>

  {/* CHAT Section: Mostly below hero, slight overlap at top */}
  <section class="relative z-20 -mt-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <div
        class="fill-mode-both animate-in fade-in slide-in-from-bottom-6 delay-150 duration-700"
      >
        <ContactChat
          client:only="react"
          initialSuggestions={initialSuggestions}
        />
      </div>
    </div>
  </section>

  {/* Secondary content: Contact cards BELOW chat */}
  <section
    class="border-primary/5 bg-muted/5 relative border-t px-4 py-14 sm:px-6 lg:px-8"
  >
    <div class="mx-auto max-w-7xl">
      <div class="mb-10 text-center">
        <h2 class="text-foreground font-bold tracking-tight">
          <span class="text-foreground">Direct </span>
          <span class="gradient-primary bg-clip-text text-transparent"
            >Contact</span
          >
        </h2>
        <p class="text-muted-foreground mx-auto mt-3 max-w-2xl">
          Prefer a traditional channel? Use phone/email, or find our HQ details
          below.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        <ServiceCard
          variant="default"
          interactive
          delay={100}
          className="h-full"
        >
          <div class="flex h-full flex-col justify-center p-6 text-center">
            <div
              class="bg-primary/10 text-brand-primary mb-4 inline-flex h-12 w-12 items-center justify-center rounded-full"
            >
              <PiPhone className="h-6 w-6" />
            </div>
            <h3
              class="text-muted-foreground mb-2 text-sm font-semibold tracking-wide uppercase"
            >
              Phone
            </h3>
            <a
              href="tel:8003090004"
              class="text-foreground hover:text-brand-primary text-lg font-bold transition-colors"
            >
              (800) 309-0004
            </a>
            <span class="text-muted-foreground mt-2 text-xs"
              >Mon–Fri, 9am–5pm EST</span
            >
          </div>
        </ServiceCard>

        <ServiceCard
          variant="default"
          interactive
          delay={200}
          className="h-full"
        >
          <div class="flex h-full flex-col justify-center p-6 text-center">
            <div
              class="bg-primary/10 text-brand-primary mb-4 inline-flex h-12 w-12 items-center justify-center rounded-full"
            >
              <PiEnvelope className="h-6 w-6" />
            </div>
            <h3
              class="text-muted-foreground mb-2 text-sm font-semibold tracking-wide uppercase"
            >
              Email
            </h3>
            <a
              href="mailto:info@bdkinc.com"
              class="text-foreground hover:text-brand-primary text-lg font-bold transition-colors"
            >
              info@bdkinc.com
            </a>
            <span class="text-muted-foreground mt-2 text-xs"
              >General inquiries & introductions</span
            >
          </div>
        </ServiceCard>

        <ServiceCard
          variant="default"
          interactive
          delay={300}
          className="h-full"
        >
          <div class="flex h-full flex-col justify-center p-6 text-center">
            <div
              class="bg-primary/10 text-brand-primary mb-4 inline-flex h-12 w-12 items-center justify-center rounded-full"
            >
              <PiMapPin className="h-6 w-6" />
            </div>
            <h3
              class="text-muted-foreground mb-2 text-sm font-semibold tracking-wide uppercase"
            >
              Headquarters
            </h3>
            <a
              href="https://www.google.com/maps/search/?api=1&query=29515+Canvasback+Drive+Easton+MD+21601"
              target="_blank"
              rel="noopener noreferrer"
              class="text-foreground hover:text-brand-primary text-lg font-bold transition-colors"
            >
              Easton, MD
            </a>
            <span class="text-muted-foreground mt-2 text-xs"
              >29515 Canvasback Drive</span
            >
          </div>
        </ServiceCard>

        <ServiceCard
          variant="default"
          interactive
          delay={400}
          className="h-full"
        >
          <div class="flex h-full flex-col justify-center p-6 text-center">
            <div
              class="bg-primary/10 text-brand-primary mb-4 inline-flex h-12 w-12 items-center justify-center rounded-full"
            >
              <PiHeadset className="h-6 w-6" />
            </div>
            <h3
              class="text-muted-foreground mb-2 text-sm font-semibold tracking-wide uppercase"
            >
              Client Support
            </h3>
            <div class="text-foreground text-lg font-bold">24/7 Monitoring</div>
            <span
              class="mt-2 flex items-center justify-center gap-1.5 text-xs font-medium text-emerald-500"
            >
              <span class="relative flex h-2 w-2">
                <span
                  class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
                ></span>
                <span
                  class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"
                ></span>
              </span>
              Active Support
            </span>
          </div>
        </ServiceCard>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
