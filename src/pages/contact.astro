---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import ContactChat from '@/components/ContactChat';
import { getNavigationData } from '@/lib/navigation-data';
import Footer from '@/components/Footer.astro';
import { ServiceCard } from '@/components/ServiceCard';
import { PiPhone, PiEnvelope, PiMapPin, PiHeadset } from 'react-icons/pi';
import { actions } from 'astro:actions';

export const prerender = false;

const { servicesData, recentPosts } = await getNavigationData();

// Get referrer-based suggestions using Astro action
const fromParam = Astro.url.searchParams.get('from');
const result = await Astro.callAction(actions.getReferrerSuggestions, {
  from: fromParam || undefined,
});

const initialSuggestions = result?.data?.suggestions || [
  'Schedule a consultation',
  'Request a technical assessment',
  'Inquire about managed services',
  'Discuss cloud migration',
];
---

<Layout title="Contact | BDKinc - Strategic Technical Partner">
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />

  <main id="main-content">
    {/* HERO Section: Background + Text + Gradient Border */}
    <section class="relative overflow-visible px-4 pt-24 pb-24 sm:px-6 lg:px-8">
      {/* Background stays inside hero */}
      <div class="circuit-overlay absolute inset-0 opacity-20"></div>
      <div class="gradient-mesh absolute inset-0 opacity-40"></div>

      {/* Subtle glow pools */}
      <div class="absolute -top-24 left-1/4 h-[520px] w-[520px] rounded-full bg-brand-primary/10 blur-[110px]"></div>
      <div class="absolute -bottom-24 right-1/4 h-[520px] w-[520px] rounded-full bg-brand-secondary/10 blur-[110px]"></div>

      <div class="relative z-10">
        {/* Text block */}
        <div class="mx-auto max-w-4xl text-center">
          <div class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 duration-700">
            <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-background/40 px-3 py-1.5 text-xs font-semibold tracking-wide text-muted-foreground backdrop-blur-md">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
              <span class="text-foreground/80">Status:</span>
              <span class="text-emerald-500">Systems Nominal</span>
            </div>

            <h1 class="mb-5 text-4xl font-bold tracking-tight md:text-5xl lg:text-6xl">
              <span class="text-foreground">Start the </span>
              <span class="from-brand-primary to-brand-secondary bg-linear-to-br bg-clip-text text-transparent">
                Conversation
              </span>
            </h1>

            <p class="text-muted-foreground mx-auto max-w-2xl text-xl leading-relaxed">
              Use our strategic assistant below to route your request directly to senior engineering leadership.
            </p>

            <div class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-3 text-sm text-muted-foreground">
              <div class="flex items-center gap-2">
                <div class="h-1.5 w-1.5 rounded-full bg-primary/60"></div>
                <span>No sales layers</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="h-1.5 w-1.5 rounded-full bg-secondary/60"></div>
                <span>Direct technical triage</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="h-1.5 w-1.5 rounded-full bg-emerald-500/60"></div>
                <span>Enterprise-ready</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Gradient border at bottom of hero */}
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--brand-accent]/50"
      ></div>
    </section>

    {/* CHAT Section: Mostly below hero, slight overlap at top */}
    <section class="relative z-20 -mt-16 px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <div class="fill-mode-both animate-in fade-in slide-in-from-bottom-6 delay-150 duration-700">
          <div class="glass rounded-2xl border border-primary/10 p-1 shadow-2xl">
            <ContactChat client:only="react" initialSuggestions={initialSuggestions} />
          </div>
        </div>
      </div>
    </section>

    {/* Secondary content: Contact cards BELOW chat */}
    <section class="relative border-t border-primary/5 bg-muted/5 px-4 py-14 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-10 text-center">
          <h2 class="text-foreground font-bold tracking-tight uppercase">
            <span class="text-foreground">Direct </span>
            <span class="gradient-primary bg-clip-text text-transparent">Contact</span>
          </h2>
          <p class="text-muted-foreground mx-auto mt-3 max-w-2xl">
            Prefer a traditional channel? Use phone/email, or find our HQ details below.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
          <ServiceCard variant="default" interactive delay={100} className="h-full">
            <div class="flex h-full flex-col justify-center p-6 text-center">
              <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-brand-primary">
                <PiPhone className="h-6 w-6" />
              </div>
              <h3 class="mb-2 text-sm font-semibold tracking-wide text-muted-foreground uppercase">Phone</h3>
              <a
                href="tel:8003090004"
                class="text-lg font-bold text-foreground transition-colors hover:text-brand-primary"
              >
                (800) 309-0004
              </a>
              <span class="mt-2 text-xs text-muted-foreground">Mon–Fri, 9am–5pm EST</span>
            </div>
          </ServiceCard>

          <ServiceCard variant="default" interactive delay={200} className="h-full">
            <div class="flex h-full flex-col justify-center p-6 text-center">
              <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-brand-primary">
                <PiEnvelope className="h-6 w-6" />
              </div>
              <h3 class="mb-2 text-sm font-semibold tracking-wide text-muted-foreground uppercase">Email</h3>
              <a
                href="mailto:info@bdkinc.com"
                class="text-lg font-bold text-foreground transition-colors hover:text-brand-primary"
              >
                info@bdkinc.com
              </a>
              <span class="mt-2 text-xs text-muted-foreground">General inquiries & introductions</span>
            </div>
          </ServiceCard>

          <ServiceCard variant="default" interactive delay={300} className="h-full">
            <div class="flex h-full flex-col justify-center p-6 text-center">
              <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-brand-primary">
                <PiMapPin className="h-6 w-6" />
              </div>
              <h3 class="mb-2 text-sm font-semibold tracking-wide text-muted-foreground uppercase">
                Headquarters
              </h3>
              <a
                href="https://www.google.com/maps/search/?api=1&query=29515+Canvasback+Drive+Easton+MD+21601"
                target="_blank"
                rel="noopener noreferrer"
                class="text-lg font-bold text-foreground transition-colors hover:text-brand-primary"
              >
                Easton, MD
              </a>
              <span class="mt-2 text-xs text-muted-foreground">29515 Canvasback Drive</span>
            </div>
          </ServiceCard>

          <ServiceCard variant="default" interactive delay={400} className="h-full">
            <div class="flex h-full flex-col justify-center p-6 text-center">
              <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-brand-primary">
                <PiHeadset className="h-6 w-6" />
              </div>
              <h3 class="mb-2 text-sm font-semibold tracking-wide text-muted-foreground uppercase">
                Client Support
              </h3>
              <div class="text-lg font-bold text-foreground">24/7 Monitoring</div>
              <span class="mt-2 flex items-center justify-center gap-1.5 text-xs font-medium text-emerald-500">
                <span class="relative flex h-2 w-2">
                  <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
                </span>
                Active Support
              </span>
            </div>
          </ServiceCard>
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Layout>
