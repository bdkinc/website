---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import Hero from '@/components/Hero';
import Services from '@/components/Services';
import TrustShowcase from '@/components/TrustShowcase';
import WhyChooseUs from '@/components/WhyChooseUs';
import Testimonials from '@/components/Testimonials.astro';
import CTASection from '@/components/CTASection';
import { getNavigationData } from '@/lib/navigation-data';
import Footer from '@/components/Footer.astro';

const { servicesData, recentPosts } = await getNavigationData();
---

<Layout title="Premier Managed IT Services & Cloud Hosting | BDKinc">
  <!-- JSON-LD Organization Schema -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "BDKinc",
      "url": "https://www.bdkinc.com",
      "logo": "https://www.bdkinc.com/logo.svg",
      "description": "Premier technology partner delivering Managed IT, Cloud Solutions, and Custom Software with enterprise-grade expertise.",
      "sameAs": [],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "(800) 309-0004",
        "contactType": "Customer Support",
        "email": "info@bdkinc.com"
      }
    }
  </script>

  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <Hero client:visible />
    <Services client:visible services={servicesData} />
    <TrustShowcase client:visible />
    <WhyChooseUs client:visible />
    <Testimonials />
    <CTASection client:visible icon="click" />
  </main>

  <Footer />
</Layout>
