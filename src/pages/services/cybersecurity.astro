---
import { getEntry, getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import { TechCard, TechCardGrid } from '@/components/TechCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import WhoThisIsFor from '@/components/WhoThisIsFor';
import TechnicalSection from '@/components/TechnicalSection';
import CybersecurityVisualization from '@/components/visualizations/CybersecurityVisualization';
import FeatureCarousel from '@/components/FeatureCarousel';
import {
  PiArrowsClockwise,
  PiBell,
  PiCheckCircle,
  PiEye,
  PiFileText,
  PiHardDrives,
  PiLock,
  PiShield,
  PiShieldCheck,
  PiUsers,
  PiWarning,
  PiQuotesFill,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';
const service = await getEntry('services', 'cybersecurity');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');
const _serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.title,
  description:
    'Fortified security for a complex world. Enterprise-grade threat resilience, managed detection and response, and rigorous compliance engineering for high-stakes environments.',
  provider: {
    '@type': 'Organization',
    name: 'BDKinc',
    url: 'https://www.bdkinc.com',
  },
  serviceType: 'Managed Cybersecurity Services',
  areaServed: ['National', 'Global'],
};
const relatedTags = [
  'cybersecurity',
  'security',
  'compliance',
  'incident-response',
];
const relatedPosts = (await getCollection('blog'))
  .filter((post) => {
    const data = post.data as unknown as { tags?: string[]; draft?: boolean };
    if (data.draft) return false;
    return (
      Array.isArray(data.tags) &&
      data.tags.some((tag) => relatedTags.includes(tag))
    );
  })
  .slice(0, 3);
const metrics = [
  { value: '24/7', label: 'Security Monitoring', icon: PiEye },
  { value: '15 min', label: 'Average Alert Response', icon: PiBell },
  { value: '99.99%', label: 'Uptime Target', icon: PiShieldCheck },
  { value: '100%', label: 'Compliance Readiness', icon: PiFileText },
];
const faqs = [
  {
    question: 'How does BDKinc integrate with our existing IT team?',
    answer:
      'We operate as a force multiplier for your internal team. Whether you need a fully managed security operations center (SOC) or co-managed support, we integrate seamlessly into your workflows. We provide the tools, telemetry, and tier-3 expertise, allowing your staff to focus on strategic initiatives while we handle threat detection and response.',
  },
  {
    question: 'Can you assist with SOC 2, HIPAA, and PCI compliance?',
    answer:
      'Yes. We do not just consult on compliance; we engineer it. Our team implements the specific technical controls required for HIPAA, PCI DSS, SOC 2, and NIST frameworks. We map your infrastructure to regulatory requirements, automate evidence collection, and ensure your organization is prepared to pass rigorous third-party audits.',
  },
  {
    question: 'What is your response time for critical security incidents?',
    answer:
      'Time is the critical factor in containment. Our Security Operations Center (SOC) operates 24/7/365 with aggressive SLAs. For critical severity incidents, we initiate containment protocols immediately upon detection, minimizing dwell time and preventing lateral movement within your network.',
  },
];
const strategicFeatures = [
  {
    title: 'Adaptive Threat Intelligence',
    description:
      'Real-time defense that evolves with the threat landscape.',
    highlight: 'Real-time defense',
    icon: 'ShieldCheck',
    detail:
      "We don't just react to known threats; we use advanced telemetry and global intelligence feeds to anticipate and block emerging attack vectors before they reach your network.",
  },
  {
    title: 'Zero-Trust Architecture',
    description:
      'Verify every user and device, every time, regardless of location.',
    highlight: 'Verify every user',
    icon: 'Lock',
    detail:
      "Our security models are built on the principle of 'never trust, always verify.' We implement robust identity management and micro-segmentation to prevent lateral movement within your infrastructure.",
  },
  {
    title: 'Compliance Engineering',
    description:
      'Automating evidence collection and technical controls for rigorous audits.',
    highlight: 'Automating evidence collection',
    icon: 'FileText',
    detail:
      "We map your technical controls directly to HIPAA, PCI, and SOC 2 frameworks, turning compliance from a yearly burden into a continuous, automated property of your IT operations.",
  },
  {
    title: 'Resilient Recovery',
    description:
      'Immutable backups and rapid containment protocols to neutralize ransomware.',
    highlight: 'Immutable backups',
    icon: 'ArrowsClockwise',
    detail:
      "In the event of an incident, our rapid-response protocols isolate threats instantly while our immutable backup systems ensure you can restore operations without paying a ransom.",
  },
];
const detailColumns = [
  {
    title: 'Managed Detection & Response',
    icon: PiShieldCheck,
    items: [
      'Real-time monitoring across endpoints, network, and cloud workloads',
      'Security analysts triage alerts and coordinate remediation 24/7',
      'Threat intelligence feeds keep defenses tuned to current attacks',
    ],
  },
  {
    title: 'Compliance & Risk',
    icon: PiFileText,
    items: [
      'Mapped controls for HIPAA, PCI, CJIS, NIST, and regional mandates',
      'Audit-ready reporting with evidence collection and retention',
      'Executive briefings translate risk posture into action plans',
    ],
  },
];
---
<Layout
  title={`${service.data.title} & Compliance Services | BDKinc`}
  description="Fortified security for a complex world. Enterprise-grade threat resilience, managed detection and response, and rigorous compliance engineering."
  ogDescription="BDKinc delivers 24/7 managed cybersecurity with ransomware protection, compliance readiness, and rapid incident response for enterprise environments."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(_serviceSchema)}
  />
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="circuit-overlay absolute inset-0 opacity-40"></div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
          <!-- Badge -->
          <div
            class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
          >
            <div class="flex items-center gap-2 text-sm">
              <span>24/7 Threat <span class="text-accent font-semibold">Protection</span></span>
            </div>
          </div>
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <!-- Heading -->
          <h1
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold tracking-tight delay-100 duration-700 md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <!-- Subtitle -->
          <p
            class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 mx-auto mb-16 max-w-3xl text-xl leading-relaxed delay-200 duration-700"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            Fortified security for a complex world. Enterprise-grade threat resilience, 
            managed detection and response, and rigorous compliance engineering 
            for high-stakes environments.
          </p>
        </div>
        <!-- Visualization -->
        <div
          class="fill-mode-both animate-in fade-in zoom-in delay-300 duration-700"
        >
          <div class="mx-auto max-w-5xl">
            <CybersecurityVisualization client:visible />
          </div>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--brand-accent]/50"
      >
      </div>
    </section>
    <!-- Core Services -->
    <section class="bg-muted/30 dark:bg-white/[0.02] px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight normal-case md:text-4xl"
          >
            <span class="text-foreground">Core </span>
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >Capabilities</span
            >
          </h2>
          <p
            class="text-muted-foreground mx-auto mt-4 max-w-2xl font-sans text-xl"
          >
            Comprehensive security management designed for the
            <span class="text-accent font-semibold">modern enterprise</span>.
          </p>
        </div>
        <TechCardGrid client:visible className="md:grid-cols-3">
          <TechCard
            variant="technical"
            interactive={true}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiShieldCheck
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Managed Detection & Response
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                24/7/365 surveillance of your entire digital estate. Our SOC 
                analysts leverage advanced telemetry to detect anomalies, 
                investigate threats, and neutralize attacks before they impact operations.
              </div>
            </div>
          </TechCard>
          <TechCard
            variant="technical"
            interactive={true}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiLock
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Ransomware Defense
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Zero-trust architecture combined with immutable backups. We 
                implement rigorous prevention strategies and rapid recovery 
                protocols to ensure business continuity in the face of extortion attempts.
              </div>
            </div>
          </TechCard>
          <TechCard
            variant="technical"
            interactive={true}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiFileText
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Compliance Engineering
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                We don't just consult on compliance; we engineer it. Our team 
                implements the technical controls required for HIPAA, PCI DSS, 
                SOC 2, and NIST frameworks to prepare you for audits.
              </div>
            </div>
          </TechCard>
        </TechCardGrid>
      </div>
    </section>
    <!-- Strategic Leadership Section -->
    <section class="relative overflow-hidden py-24">
      <div
        class="via-primary/20 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-12 text-center">
          <h2
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-4xl font-bold tracking-tight duration-600 md:text-5xl"
          >
            <span class="text-foreground">Security </span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Leadership</span
            >
          </h2>
        </div>
        <figure class="relative mx-auto max-w-3xl">
          <PiQuotesFill
            className="text-primary/25 pointer-events-none absolute -top-10 right-0 h-16 w-16"
            aria-hidden="true"
          />
          <blockquote
            class="border-secondary/50 text-muted-foreground border-l-4 pl-6 text-xl leading-relaxed font-light md:text-2xl"
          >
            "In an era of sophisticated state-sponsored attacks, reactive security is failure.
            We architect
            <span class="text-accent font-semibold">
              proactive resilience</span
            >
            into every layer of your digital estate, ensuring your data is protected 
            and your operations are audit-ready 24/7."
          </blockquote>
        </figure>
      </div>
      <div
        class="via-primary/20 absolute bottom-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
    </section>
    <!-- Strategic Advantage -->
    <section
      class="bg-linear-to-b from-transparent to-muted/20 dark:to-white/[0.02] px-4 py-24 sm:px-6 lg:px-8"
    >
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            The Strategic <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Advantage</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            Move beyond antivirus and basic firewalls with a partner who builds 
            defense-in-depth security architectures.
          </p>
        </div>
        <FeatureCarousel client:visible features={strategicFeatures} />
      </div>
    </section>
    <!-- Security Framework Section -->
    <section class="bg-muted/30 dark:bg-white/[0.02] px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            Our Security <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Framework</span
            >
          </h2>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          <div class="group relative overflow-hidden rounded-xl border border-primary/20 bg-card/30 p-6 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] hover:border-primary/50 hover:bg-card/50 hover:shadow-[0_0_30px_rgba(0,212,255,0.1)]">
            <div class="scanlines pointer-events-none absolute inset-0 opacity-[0.02]"></div>
            <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-primary/20 group-hover:bg-primary/20 group-hover:ring-primary/40 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing]">
              <PiShieldCheck
                className="text-primary h-8 w-8"
                aria-hidden="true"
              />
            </div>
            <h4 class="text-foreground mb-3 text-xl font-bold font-display">
              Prevent
            </h4>
            <ul class="text-muted-foreground space-y-2 text-sm font-sans">
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>Firewall management</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>Endpoint protection</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>Email security</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>User education</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>Access controls</span>
              </li>
            </ul>
          </div>
          <div class="group relative overflow-hidden rounded-xl border border-primary/20 bg-card/30 p-6 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] hover:border-primary/50 hover:bg-card/50 hover:shadow-[0_0_30px_rgba(0,212,255,0.1)]">
            <div class="scanlines pointer-events-none absolute inset-0 opacity-[0.02]"></div>
            <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-primary/20 group-hover:bg-primary/20 group-hover:ring-primary/40 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing]">
              <PiEye
                className="text-primary h-8 w-8"
                aria-hidden="true"
              />
            </div>
            <h4 class="text-foreground mb-3 text-xl font-bold font-display">Detect</h4>
            <ul class="text-muted-foreground space-y-2 text-sm font-sans">
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>24/7 monitoring</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>Intrusion detection</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>Log analysis</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>Vulnerability scanning</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>Threat intelligence</span>
              </li>
            </ul>
          </div>
          <div class="group relative overflow-hidden rounded-xl border border-primary/20 bg-card/30 p-6 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] hover:border-primary/50 hover:bg-card/50 hover:shadow-[0_0_30px_rgba(0,212,255,0.1)]">
            <div class="scanlines pointer-events-none absolute inset-0 opacity-[0.02]"></div>
            <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-primary/20 group-hover:bg-primary/20 group-hover:ring-primary/40 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing]">
              <PiBell
                className="text-primary h-8 w-8"
                aria-hidden="true"
              />
            </div>
            <h4 class="text-foreground mb-3 text-xl font-bold font-display">
              Respond
            </h4>
            <ul class="text-muted-foreground space-y-2 text-sm font-sans">
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>Incident response</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>Forensic analysis</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>Containment procedures</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>Recovery processes</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>Post-incident review</span>
              </li>
            </ul>
          </div>
          <div class="group relative overflow-hidden rounded-xl border border-primary/20 bg-card/30 p-6 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] hover:border-primary/50 hover:bg-card/50 hover:shadow-[0_0_30px_rgba(0,212,255,0.1)]">
            <div class="scanlines pointer-events-none absolute inset-0 opacity-[0.02]"></div>
            <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-primary/20 group-hover:bg-primary/20 group-hover:ring-primary/40 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing]">
              <PiHardDrives
                className="text-primary h-8 w-8"
                aria-hidden="true"
              />
            </div>
            <h4 class="text-foreground mb-3 text-xl font-bold font-display">
              Recover
            </h4>
            <ul class="text-muted-foreground space-y-2 text-sm font-sans">
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>Backup systems</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>Recovery procedures</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>Continuity planning</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>Communication protocols</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>System restoration</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>
    <!-- Key Benefits -->
    <section class="bg-muted/20 dark:bg-white/[0.01] px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            Key <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Benefits</span
            >
          </h2>
        </div>
        <div class="grid gap-x-12 gap-y-16 md:grid-cols-2 lg:grid-cols-3">
          <!-- Benefit 1 -->
          <div class="group flex flex-col items-center text-center">
            <PiWarning
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              Reduce Risk
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Protect against data breaches, ransomware, and other emerging 
              cyber threats
            </p>
          </div>
          <!-- Benefit 2 -->
          <div class="group flex flex-col items-center text-center">
            <PiFileText
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              Ensure Compliance
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Meet industry security standards and regulations including HIPAA, 
              PCI DSS, and SOC 2
            </p>
          </div>
          <!-- Benefit 3 -->
          <div class="group flex flex-col items-center text-center">
            <PiArrowsClockwise
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              Minimize Downtime
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Quick incident recovery ensures your business operations continue 
              without disruption
            </p>
          </div>
          <!-- Benefit 4 -->
          <div class="group flex flex-col items-center text-center">
            <PiShield
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              Protect Reputation
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Prevent damaging data breaches that erode customer trust and 
              brand equity
            </p>
          </div>
          <!-- Benefit 5 -->
          <div class="group flex flex-col items-center text-center">
            <PiEye
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              24/7 Peace of Mind
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Rest easy knowing your critical systems are monitored and 
              protected around the clock
            </p>
          </div>
          <!-- Benefit 6 -->
          <div class="group flex flex-col items-center text-center">
            <PiUsers
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              Expert Guidance
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Direct access to senior security professionals with deep 
              industry expertise
            </p>
          </div>
        </div>
      </div>
    </section>
    <!-- Detailed Capabilities Section -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2 class="text-foreground mb-6 text-3xl font-bold font-display tracking-tight md:text-4xl">
            Technical <span class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent">Specifications</span>
          </h2>
        </div>
        <div class="grid gap-8 md:grid-cols-2">
          {
            detailColumns.map((column) => (
              <div class="glass border-border rounded-2xl border p-8">
                <div class="mb-6 flex items-center gap-3">
                  <column.icon
                    className="text-primary h-8 w-8"
                    aria-hidden="true"
                  />
                  <h4 class="text-foreground text-2xl font-bold">
                    {column.title}
                  </h4>
                </div>
                <div class="text-muted-foreground space-y-3">
                  {column.items.map((item) => (
                    <div class="flex items-start gap-2">
                      <PiCheckCircle
                        className="text-primary mt-1 h-5 w-5 shrink-0"
                        aria-hidden="true"
                      />
                      <span>{item}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>
    <TechnicalSection client:visible id="compliance-vault" overlayOpacity="opacity-10">
      <div class="relative z-10 flex flex-col items-center text-center">
        <div class="mb-6 flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1">
          <div class="h-2 w-2 animate-pulse rounded-full bg-primary"></div>
          <span class="text-xs font-bold tracking-widest text-primary font-display">Compliance Engineering Vault</span>
        </div>
        <h3 class="mb-6 max-w-2xl text-3xl font-bold text-foreground font-display tracking-tight">
          Rigorous Standards. <span class="text-primary">Zero Compromise.</span>
        </h3>
        <div class="mx-auto max-w-4xl text-lg leading-relaxed text-muted-foreground font-sans">
          We help you meet security requirements for HIPAA, PCI DSS, SOC 2, and 
          NIST frameworks. Our team engineers technical controls directly into your 
          infrastructure, automating evidence collection and ensuring you are 
          prepared for pass rigorous third-party audits.
        </div>
      </div>
    </TechnicalSection>
    <WhoThisIsFor client:visible />
    <!-- FAQ -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
          Frequently Asked Questions
        </h3>
        <div class="mb-20">
          <TechnicalFAQ client:visible faqs={faqs} />
        </div>
      </div>
    </section>
    <!-- Related Resources -->
    {
      relatedPosts.length > 0 && (
        <section class="mx-auto max-w-5xl px-4 py-24">
          <h2 class="text-foreground mb-6 text-center text-3xl font-bold">
            Related Resources
          </h2>
          <div class="grid gap-6 md:grid-cols-3">
            {relatedPosts.map((post) => (
              <a
                href={`/blog/${post.slug}`}
                class="border-border hover:border-primary flex flex-col rounded-xl border p-6 transition-colors"
              >
                <h3 class="text-foreground mb-2 text-lg font-semibold">
                  {post.data.title}
                </h3>
                <p class="text-muted-foreground text-sm">
                  {post.data.description}
                </p>
                <span class="text-primary mt-4 text-sm font-medium">
                  Read Article →
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }
    <ImpactMetricsSection metrics={metrics} />
    <!-- CTA -->
    <CTASection
      client:visible
      title="Secure Your Digital Future"
      description="Stop settling for standard protection. Partner with the experts who understand enterprise-grade threat resilience."
      buttonText="Request a Security Audit"
      buttonHref="/contact#chat"
    />
  </main>
  <Footer />
</Layout>
