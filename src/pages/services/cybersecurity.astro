---
import { getEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import { ServiceCard, ServiceCardGrid } from '@/components/ServiceCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import {
  PiArrowsClockwise,
  PiBell,
  PiCheckCircle,
  PiEye,
  PiFileText,
  PiHardDrives,
  PiLock,
  PiShield,
  PiShieldCheck,
  PiUsers,
  PiWarning,
  PiTrendUp,
  PiCode,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import WhoThisIsFor from '@/components/WhoThisIsFor';
import TechnicalSection from '@/components/TechnicalSection';
import CybersecurityVisualization from '@/components/visualizations/CybersecurityVisualization';
import { cn } from '@/lib/utils';

const service = await getEntry('services', 'cybersecurity');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');

const _serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.title,
  description:
    'Fortified security for a complex world. Enterprise-grade threat resilience, managed detection and response, and rigorous compliance engineering for high-stakes environments.',
  provider: {
    '@type': 'Organization',
    name: 'BDKinc',
    url: 'https://www.bdkinc.com',
  },
  serviceType: 'Managed Cybersecurity Services',
  areaServed: ['National', 'Global'],
};

const relatedTags = [
  'cybersecurity',
  'security',
  'compliance',
  'incident-response',
];
const relatedPosts = (await getCollection('blog'))
  .filter((post) => {
    const data = post.data as unknown as { tags?: string[]; draft?: boolean };
    if (data.draft) return false;
    return (
      Array.isArray(data.tags) &&
      data.tags.some((tag) => relatedTags.includes(tag))
    );
  })
  .slice(0, 3);

const metrics = [
  { value: '24/7', label: 'SECURITY MONITORING', icon: PiEye },
  { value: '15 MIN', label: 'AVERAGE ALERT RESPONSE', icon: PiBell },
  { value: '99.99%', label: 'UPTIME TARGET', icon: PiShieldCheck },
  { value: '100%', label: 'COMPLIANCE READINESS', icon: PiFileText },
];

const faqs = [
  {
    question: 'How does BDKinc integrate with our existing IT team?',
    answer:
      'We operate as a force multiplier for your internal team. Whether you need a fully managed security operations center (SOC) or co-managed support, we integrate seamlessly into your workflows. We provide the tools, telemetry, and tier-3 expertise, allowing your staff to focus on strategic initiatives while we handle threat detection and response.',
  },
  {
    question: 'Can you assist with SOC 2, HIPAA, and PCI compliance?',
    answer:
      'Yes. We do not just consult on compliance; we engineer it. Our team implements the specific technical controls required for HIPAA, PCI DSS, SOC 2, and NIST frameworks. We map your infrastructure to regulatory requirements, automate evidence collection, and ensure your organization is prepared to pass rigorous third-party audits.',
  },
  {
    question: 'What is your response time for critical security incidents?',
    answer:
      'Time is the critical factor in containment. Our Security Operations Center (SOC) operates 24/7/365 with aggressive SLAs. For critical severity incidents, we initiate containment protocols immediately upon detection, minimizing dwell time and preventing lateral movement within your network.',
  },
];

const detailColumns = [
  {
    title: 'Managed Detection & Response',
    icon: PiShieldCheck,
    items: [
      'Real-time monitoring across endpoints, network, and cloud workloads',
      'Security analysts triage alerts and coordinate remediation 24/7',
      'Threat intelligence feeds keep defenses tuned to current attacks',
    ],
  },
  {
    title: 'Compliance & Risk',
    icon: PiFileText,
    items: [
      'Mapped controls for HIPAA, PCI, CJIS, NIST, and regional mandates',
      'Audit-ready reporting with evidence collection and retention',
      'Executive briefings translate risk posture into action plans',
    ],
  },
];
---

<Layout
  title={`${service.data.title} & Compliance Services | BDKinc`}
  description="Fortified security for a complex world. Enterprise-grade threat resilience, managed detection and response, and rigorous compliance engineering."
  ogDescription="BDKinc delivers 24/7 managed cybersecurity with ransomware protection, compliance readiness, and rapid incident response for enterprise environments."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(_serviceSchema)}
  />
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="circuit-overlay absolute inset-0 opacity-40"></div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="text-center">
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <h1
            class="mb-6 text-5xl font-bold md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <p
            class="text-muted-foreground mx-auto mb-12 max-w-3xl text-xl"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            {service.data.description}
          </p>
        </div>

        {/* Hero Visualization */}
        <div
          class="fill-mode-both animate-in fade-in zoom-in delay-300 duration-700"
        >
          <div class="mx-auto max-w-5xl">
            <CybersecurityVisualization client:load />
          </div>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--brand-accent]/50"
      >
      </div>
    </section>

    <!-- Content Section -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div
        class="animate-in fade-in slide-in-from-bottom-4 fill-mode-both space-y-12 delay-600 duration-700"
      >
        <div class="mx-auto max-w-7xl">
          <div class="service-content-wrapper">
            <div class="not-prose mx-auto max-w-4xl">
              <h2 class="text-foreground mb-6 text-center text-3xl font-bold">
                Enterprise-Grade Threat Resilience
              </h2>
              <div
                class="text-muted-foreground mb-10 text-center text-lg leading-relaxed"
              >
                In an era of sophisticated state-sponsored attacks and automated ransomware, standard antivirus is no longer sufficient. BDKinc delivers comprehensive, defense-in-depth security architectures designed for high-stakes environments. We operate as your dedicated security partner, navigating the complexities of compliance and threat management so you can focus on innovation.
              </div>
            </div>

            <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
              Core Security Services
            </h3>

            <ServiceCardGrid client:visible>
              <ServiceCard variant="technical" interactive metadata="THREAT_DEF_01">
                <div class="p-8 flex flex-col items-center text-center h-full">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:scale-110 group-hover:bg-primary/10 transition-all duration-500">
                    <PiShieldCheck
                      className="text-primary h-16 w-16"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-4 text-2xl font-bold font-display uppercase tracking-tight group-hover:text-primary transition-colors">
                    Managed Detection & Response
                  </h4>
                  <div class="text-muted-foreground leading-relaxed text-sm">
                    24/7/365 surveillance of your entire digital estate. Our SOC analysts leverage advanced telemetry to detect anomalies, investigate threats, and neutralize attacks before they impact operations.
                  </div>
                </div>
              </ServiceCard>

              <ServiceCard variant="technical" interactive metadata="RANSOM_SHIELD_02">
                <div class="p-8 flex flex-col items-center text-center h-full">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:scale-110 group-hover:bg-primary/10 transition-all duration-500">
                    <PiLock
                      className="text-primary h-16 w-16"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-4 text-2xl font-bold font-display uppercase tracking-tight group-hover:text-primary transition-colors">
                    Ransomware Defense
                  </h4>
                  <div class="text-muted-foreground leading-relaxed text-sm">
                    Zero-trust architecture combined with immutable backups. We implement rigorous prevention strategies and rapid recovery protocols to ensure business continuity in the face of extortion attempts.
                  </div>
                </div>
              </ServiceCard>

              <ServiceCard variant="technical" interactive metadata="COMPLIANCE_ENG_03">
                <div class="p-8 flex flex-col items-center text-center h-full">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:scale-110 group-hover:bg-primary/10 transition-all duration-500">
                    <PiFileText
                      className="text-primary h-16 w-16"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-4 text-2xl font-bold font-display uppercase tracking-tight group-hover:text-primary transition-colors">
                    Compliance Engineering
                  </h4>
                  <div class="text-muted-foreground leading-relaxed text-sm">
                    We don't just consult on compliance; we engineer it. Our team implements the technical controls required for HIPAA, PCI DSS, SOC 2, and NIST frameworks to prepare you for audits.
                  </div>
                </div>
              </ServiceCard>
            </ServiceCardGrid>

            <h3
              class="text-foreground mt-12 mb-6 text-center text-2xl font-bold"
            >
              Comprehensive Security Management
            </h3>

            <div class="not-prose mb-20">
              <p class="text-muted-foreground mb-10 text-center text-xl">
                Protect every layer of your infrastructure with our managed
                security services
              </p>

              {/* Feature Image Placeholder */}
              <div class="mb-10">
                <div
                  class="glass border-primary/20 mx-auto max-w-3xl overflow-hidden rounded-xl border relative"
                >
                   {/* Scanline overlay */}
                  <div class="scanlines pointer-events-none absolute inset-0 opacity-[0.05]"></div>
                  {/* Corner accents */}
                  <div class="absolute top-0 right-0 h-8 w-8">
                    <div class="absolute top-2 right-2 h-px w-4 bg-primary/40"></div>
                    <div class="absolute top-2 right-2 h-4 w-px bg-primary/40"></div>
                  </div>
                  <div class="absolute bottom-0 left-0 h-8 w-8">
                    <div class="absolute bottom-2 left-2 h-px w-4 bg-primary/40"></div>
                    <div class="absolute bottom-2 left-2 h-4 w-px bg-primary/40"></div>
                  </div>

                  <div
                    class="from-primary/5 via-secondary/5 to-primary/5 flex aspect-21/9 items-center justify-center bg-linear-to-br"
                  >
                    <div class="p-4 text-center relative z-10">
                      <div
                        class="text-muted-foreground/40 mb-1 text-xs font-medium tracking-wider uppercase font-display"
                      >
                        Feature Image
                      </div>
                      <div class="text-muted-foreground/60 text-sm">
                        Benefits Illustration
                      </div>
                      <div class="text-muted-foreground/40 mt-1 text-[10px]">
                        1200x500px
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="grid gap-6 md:grid-cols-2">
                <div
                  class="bg-background/50 border-border hover:border-primary flex items-start gap-4 rounded-lg border p-4 transition-colors"
                >
                  <div class="bg-primary mt-2 h-2 w-2 shrink-0 rounded-full">
                  </div>
                  <div>
                    <h5 class="text-foreground mb-1 text-lg font-bold">
                      Threat Intelligence
                    </h5>
                    <div class="text-muted-foreground text-sm">
                      Integrated feeds from global threat networks keep your defenses tuned to the latest attack vectors and zero-day vulnerabilities.
                    </div>
                  </div>
                </div>

                <div
                  class="bg-background/50 border-border hover:border-primary flex items-start gap-4 rounded-lg border p-4 transition-colors"
                >
                  <div class="bg-primary mt-2 h-2 w-2 shrink-0 rounded-full">
                  </div>
                  <div>
                    <h5 class="text-foreground mb-1 text-lg font-bold">
                      Vulnerability Management
                    </h5>
                    <div class="text-muted-foreground text-sm">
                      Continuous scanning and automated patching to eliminate exposure points before they can be exploited by attackers.
                    </div>
                  </div>
                </div>

                <div
                  class="bg-background/50 border-border hover:border-primary flex items-start gap-4 rounded-lg border p-4 transition-colors"
                >
                  <div class="bg-primary mt-2 h-2 w-2 shrink-0 rounded-full">
                  </div>
                  <div>
                    <h5 class="text-foreground mb-1 text-lg font-bold">
                      Endpoint Detection & Response
                    </h5>
                    <div class="text-muted-foreground text-sm">
                      Behavior-based analysis to block malicious activity at the device level, even when off-network, preventing lateral movement.
                    </div>
                  </div>
                </div>

                <div
                  class="bg-background/50 border-border hover:border-primary flex items-start gap-4 rounded-lg border p-4 transition-colors"
                >
                  <div class="bg-primary mt-2 h-2 w-2 shrink-0 rounded-full">
                  </div>
                  <div>
                    <h5 class="text-foreground mb-1 text-lg font-bold">
                      Identity & Access Management
                    </h5>
                    <div class="text-muted-foreground text-sm">
                      Zero-trust principles applied to user access, ensuring least-privilege enforcement and robust authentication across your organization.
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
              Our Security Framework
            </h3>

            <div class="not-prose mb-20">
              <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
                <div class="group relative overflow-hidden rounded-xl border border-primary/20 bg-card/30 p-6 transition-all hover:border-primary/50 hover:bg-card/50 hover:shadow-[0_0_30px_rgba(0,212,255,0.1)]">
                  <div class="scanlines pointer-events-none absolute inset-0 opacity-[0.02]"></div>
                  <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-primary/20 group-hover:bg-primary/20 group-hover:ring-primary/40 transition-all">
                    <PiShieldCheck
                      className="text-primary h-8 w-8"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display">
                    Prevent
                  </h4>
                  <ul class="text-muted-foreground space-y-2 text-sm font-sans">
                    <li class="flex items-start gap-2">
                      <span class="text-primary mt-1">•</span>
                      <span>Firewall management</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-primary mt-1">•</span>
                      <span>Endpoint protection</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-primary mt-1">•</span>
                      <span>Email security</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-primary mt-1">•</span>
                      <span>User education</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-primary mt-1">•</span>
                      <span>Access controls</span>
                    </li>
                  </ul>
                </div>

                <div class="group relative overflow-hidden rounded-xl border border-primary/20 bg-card/30 p-6 transition-all hover:border-primary/50 hover:bg-card/50 hover:shadow-[0_0_30px_rgba(0,212,255,0.1)]">
                  <div class="scanlines pointer-events-none absolute inset-0 opacity-[0.02]"></div>
                  <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-primary/20 group-hover:bg-primary/20 group-hover:ring-primary/40 transition-all">
                    <PiEye
                      className="text-primary h-8 w-8"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display">Detect</h4>
                  <ul class="text-muted-foreground space-y-2 text-sm font-sans">
                    <li class="flex items-start gap-2">
                      <span class="text-primary mt-1">•</span>
                      <span>24/7 monitoring</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-primary mt-1">•</span>
                      <span>Intrusion detection</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-primary mt-1">•</span>
                      <span>Log analysis</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-primary mt-1">•</span>
                      <span>Vulnerability scanning</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-primary mt-1">•</span>
                      <span>Threat intelligence</span>
                    </li>
                  </ul>
                </div>

                <div class="group relative overflow-hidden rounded-xl border border-primary/20 bg-card/30 p-6 transition-all hover:border-primary/50 hover:bg-card/50 hover:shadow-[0_0_30px_rgba(0,212,255,0.1)]">
                  <div class="scanlines pointer-events-none absolute inset-0 opacity-[0.02]"></div>
                  <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-primary/20 group-hover:bg-primary/20 group-hover:ring-primary/40 transition-all">
                    <PiBell
                      className="text-primary h-8 w-8"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display">
                    Respond
                  </h4>
                  <ul class="text-muted-foreground space-y-2 text-sm font-sans">
                    <li class="flex items-start gap-2">
                      <span class="text-primary mt-1">•</span>
                      <span>Incident response</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-primary mt-1">•</span>
                      <span>Forensic analysis</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-primary mt-1">•</span>
                      <span>Containment procedures</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-primary mt-1">•</span>
                      <span>Recovery processes</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-primary mt-1">•</span>
                      <span>Post-incident review</span>
                    </li>
                  </ul>
                </div>

                <div class="group relative overflow-hidden rounded-xl border border-primary/20 bg-card/30 p-6 transition-all hover:border-primary/50 hover:bg-card/50 hover:shadow-[0_0_30px_rgba(0,212,255,0.1)]">
                  <div class="scanlines pointer-events-none absolute inset-0 opacity-[0.02]"></div>
                  <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-lg bg-primary/10 ring-1 ring-primary/20 group-hover:bg-primary/20 group-hover:ring-primary/40 transition-all">
                    <PiHardDrives
                      className="text-primary h-8 w-8"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display">
                    Recover
                  </h4>
                  <ul class="text-muted-foreground space-y-2 text-sm font-sans">
                    <li class="flex items-start gap-2">
                      <span class="text-primary mt-1">•</span>
                      <span>Backup systems</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-primary mt-1">•</span>
                      <span>Recovery procedures</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-primary mt-1">•</span>
                      <span>Continuity planning</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-primary mt-1">•</span>
                      <span>Communication protocols</span>
                    </li>
                    <li class="flex items-start gap-2">
                      <span class="text-primary mt-1">•</span>
                      <span>System restoration</span>
                    </li>
                  </ul>
                </div>
              </div>
            </div>

            <h3 class="text-foreground mb-12 text-center text-2xl font-bold font-display uppercase tracking-tight">
              Key Benefits
            </h3>

            <div
              class="not-prose mb-20 grid gap-6 md:grid-cols-2 lg:grid-cols-3"
            >
              <ServiceCard
                variant="technical"
                interactive={false}
                metadata="SEC_BENEFIT_01"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiWarning
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display uppercase tracking-tight">
                    Reduce Risk
                  </h4>
                  <div class="text-muted-foreground text-sm leading-relaxed">
                    Protect against data breaches, ransomware, and other cyber
                    threats
                  </div>
                </div>
              </ServiceCard>

              <ServiceCard
                variant="technical"
                interactive={false}
                metadata="SEC_BENEFIT_02"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiFileText
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display uppercase tracking-tight">
                    Ensure Compliance
                  </h4>
                  <div class="text-muted-foreground text-sm leading-relaxed">
                    Meet industry security standards and regulations (HIPAA, PCI
                    DSS, SOC 2)
                  </div>
                </div>
              </ServiceCard>

              <ServiceCard
                variant="technical"
                interactive={false}
                metadata="SEC_BENEFIT_03"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiArrowsClockwise
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display uppercase tracking-tight">
                    Minimize Downtime
                  </h4>
                  <div class="text-muted-foreground text-sm leading-relaxed">
                    Quick recovery from incidents keeps your business running
                  </div>
                </div>
              </ServiceCard>

              <ServiceCard
                variant="technical"
                interactive={false}
                metadata="SEC_BENEFIT_04"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiShield
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display uppercase tracking-tight">
                    Protect Reputation
                  </h4>
                  <div class="text-muted-foreground text-sm leading-relaxed">
                    Prevent data breaches that damage customer trust
                  </div>
                </div>
              </ServiceCard>

              <ServiceCard
                variant="technical"
                interactive={false}
                metadata="SEC_BENEFIT_05"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiEye
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display uppercase tracking-tight">
                    Peace of Mind
