---
import { getEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import { TechCard, TechCardGrid } from '@/components/TechCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import EDIFlowVisualization from '@/components/visualizations/EDIFlowVisualization';
import WhoThisIsFor from '@/components/WhoThisIsFor';
import TechnicalSection from '@/components/TechnicalSection';
import Footer from '@/components/Footer.astro';
import {
  PiLightning,
  PiUsers,
  PiShoppingCart,
  PiEye,
  PiCheckCircle,
  PiCurrencyDollar,
  PiGlobe,
  PiArrowsLeftRight,
  PiShieldCheck,
  PiNetwork,
  PiPulse,
} from 'react-icons/pi';

const service = await getEntry('services', 'edi-solutions');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');

const metrics = [
  { value: '250+', label: 'Retail Connections', icon: PiShoppingCart },
  { value: '99.99%', label: 'Uptime SLA', icon: PiCheckCircle },
  { value: '48h', label: 'Average Onboarding', icon: PiLightning },
  { value: '24/7', label: 'Transaction Monitoring', icon: PiEye },
];

const faqs = [
  {
    question: "What protocols and standards do you support?",
    answer: "We support the full spectrum of industry-standard protocols including AS2, SFTP, FTPS, HTTPS, and traditional VAN networks. Our translation engine handles ANSI X12, EDIFACT, TRADACOMS, and XML formats, ensuring compatibility with any global trading partner."
  },
  {
    question: "How do you handle high-volume transaction scaling?",
    answer: "Our infrastructure is built on elastic cloud architecture designed for enterprise scale. It automatically provisions resources to handle peak loads—whether from seasonal spikes or rapid market expansion—ensuring consistent throughput and zero message loss."
  },
  {
    question: "Can you integrate with our existing ERP environment?",
    answer: "Yes. Our solution acts as a universal middleware layer, integrating seamlessly with major ERPs (SAP, Oracle, NetSuite, Microsoft Dynamics) as well as custom legacy systems. We map data directly to your internal formats, preserving your existing workflows."
  }
];

const audience = [
  {
    title: "Enterprise Retail Suppliers",
     description: "High-volume suppliers connecting with major retailers like Walmart, Target, and Amazon who need SLA-backed uptime and compliance.",
    icon: PiShoppingCart
  },
  {
    title: "Logistics & 3PL Providers",
    description: "Logistics firms managing complex EDI flows (204, 214, 210) across a fragmented carrier network.",
    icon: PiNetwork
  },
  {
    title: "Manufacturing Hubs",
    description: "Manufacturers requiring JIT inventory synchronization via 846/940/945 transactions with zero latency.",
    icon: PiPulse
  }
];
---

<Layout
  title={`${service.data.title} - BDKinc`}
  description={service.data.description}
>
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-32 pb-20 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="circuit-overlay absolute inset-0 opacity-40"></div>
       <div class="relative z-10 mx-auto max-w-7xl">
          <div class="mx-auto max-w-4xl flex flex-col items-center text-center">
            <div
              class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-8 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
            >
              <span class="text-sm">
                <span class="text-accent font-semibold">Global</span> Connectivity
              </span>
            </div>

          <div
            class="from-primary/10 to-secondary/10 mb-8 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <h1
             class="mb-6 text-5xl font-bold tracking-tight md:text-7xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <p
            class="text-muted-foreground mx-auto mb-16 max-w-3xl text-xl leading-relaxed"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
             Orchestrate global EDI with a managed platform that keeps partners connected, documents flowing, and transactions visible in real time.
          </p>
        </div>

        {/* Technical Flow Visualization */}
        <div
          class="fill-mode-both animate-in fade-in zoom-in delay-300 duration-700 mx-auto max-w-6xl"
        >
          <EDIFlowVisualization client:visible />
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-px bg-linear-to-r to-[--brand-accent]/50"
      >
      </div>
    </section>

    <!-- Technical Orchestration Section -->
    <TechnicalSection client:visible id="edi-orchestration" overlayOpacity="opacity-10">
      <div class="relative z-10 flex flex-col items-center text-center">
        <div class="mb-6 flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1">
          <div class="h-2 w-2 animate-pulse rounded-full bg-primary"></div>
          <span class="text-xs font-bold tracking-widest text-primary font-display">Supply Chain Command Node</span>
        </div>
        
        <h2 class="mb-6 max-w-3xl text-4xl font-bold text-foreground font-display tracking-tight md:text-5xl">
          Enterprise Supply Chain <span class="text-primary">Orchestration.</span>
        </h2>
        
        <div class="mx-auto max-w-4xl text-xl leading-relaxed text-muted-foreground font-sans">
           Modern commerce requires synchronized data exchange. BDK automates trading-partner document flow so orders, invoices, and shipping updates move instantly.
        </div>
      </div>
    </TechnicalSection>

    <!-- Core Capabilities Section -->
    <section class="relative px-4 py-24 sm:px-6 lg:px-8 overflow-hidden">
      <div class="mx-auto max-w-7xl relative z-10">
        <h3 class="text-foreground mb-16 text-center text-3xl font-bold font-display tracking-tight">
          Core Capabilities
        </h3>

        <TechCardGrid client:visible>
          <TechCard variant="simple" interactive metadata="EDI_PARTNER_01">
            <div class="p-8 flex flex-col items-center text-center h-full">
              <div class="mb-6 p-4 rounded-2xl bg-primary/5 border border-primary/10 group-hover:scale-110 group-hover:bg-primary/10 transition-[transform,background-color] duration-500">
                <PiUsers
                  className="text-primary h-12 w-12"
                  aria-hidden="true"
                />
              </div>
              <h4 class="text-foreground mb-4 text-xl font-bold font-display tracking-tight group-hover:text-primary transition-colors">
                Global Partner Integration
              </h4>
              <div class="text-muted-foreground leading-relaxed text-sm">
                Rapidly onboard retailers, suppliers, and 3PLs across any region. We maintain certified maps for thousands of trading partners, ensuring effortless compliance with complex routing requirements and varying standards.
              </div>
            </div>
          </TechCard>

          <TechCard variant="simple" interactive metadata="EDI_AUTO_02">
            <div class="p-8 flex flex-col items-center text-center h-full">
              <div class="mb-6 p-4 rounded-2xl bg-primary/5 border border-primary/10 group-hover:scale-110 group-hover:bg-primary/10 transition-[transform,background-color] duration-500">
                <PiLightning
                  className="text-primary h-12 w-12"
                  aria-hidden="true"
                />
              </div>
              <h4 class="text-foreground mb-4 text-xl font-bold font-display tracking-tight group-hover:text-primary transition-colors">
                Automated Workflows
              </h4>
              <div class="text-muted-foreground leading-relaxed text-sm">
                 Eliminate manual intervention. Automate POs, invoices, and ASNs (850, 810, 856) to reduce manual errors and accelerate order-to-cash cycles.
              </div>
            </div>
          </TechCard>

          <TechCard variant="simple" interactive metadata="EDI_NET_03">
            <div class="p-8 flex flex-col items-center text-center h-full">
              <div class="mb-6 p-4 rounded-2xl bg-primary/5 border border-primary/10 group-hover:scale-110 group-hover:bg-primary/10 transition-[transform,background-color] duration-500">
                <PiNetwork
                  className="text-primary h-12 w-12"
                  aria-hidden="true"
                />
              </div>
              <h4 class="text-foreground mb-4 text-xl font-bold font-display tracking-tight group-hover:text-primary transition-colors">
                Protocol Agnostic Infrastructure
              </h4>
              <div class="text-muted-foreground leading-relaxed text-sm">
                Secure, reliable transmission across all major protocols including AS2, SFTP, FTPS, and VAN. Our architecture adapts to your partners' technical constraints without requiring changes to your internal systems.
              </div>
            </div>
          </TechCard>
        </TechCardGrid>
      </div>
    </section>

    <!-- Why Choose BDK Section -->
    <section class="px-4 py-24 sm:px-6 lg:px-8 bg-secondary/5 border-y border-border/40">
      <div class="mx-auto max-w-7xl">
        <h3 class="text-foreground mb-16 text-center text-3xl font-bold font-display tracking-tight">
          Why Choose BDK for EDI
        </h3>

        <div class="not-prose mb-24 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          <TechCard
            variant="simple"
            interactive={false}
            metadata="EDI_BENEFIT_01"
          >
            <div class="flex flex-col items-center text-center p-8">
              <div class="mb-4 text-primary opacity-80">
                <PiShieldCheck className="h-10 w-10" aria-hidden="true" />
              </div>
              <h4 class="text-foreground mb-2 text-lg font-bold font-display tracking-tight">
                99.99% Uptime SLA
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Mission-critical reliability for your most sensitive data streams
              </div>
            </div>
          </TechCard>

          <TechCard
            variant="simple"
            interactive={false}
            metadata="EDI_BENEFIT_02"
          >
            <div class="flex flex-col items-center text-center p-8">
              <div class="mb-4 text-primary opacity-80">
                <PiArrowsLeftRight className="h-10 w-10" aria-hidden="true" />
              </div>
              <h4 class="text-foreground mb-2 text-lg font-bold font-display tracking-tight">
                High-Velocity Processing
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Process thousands of transactions per second with low-latency throughput
              </div>
            </div>
          </TechCard>

          <TechCard
            variant="simple"
            interactive={false}
            metadata="EDI_BENEFIT_03"
          >
            <div class="flex flex-col items-center text-center p-8">
              <div class="mb-4 text-primary opacity-80">
                <PiCheckCircle className="h-10 w-10" aria-hidden="true" />
              </div>
              <h4 class="text-foreground mb-2 text-lg font-bold font-display tracking-tight">
                Proactive Compliance
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Stay ahead of retailer mandate changes with our active compliance monitoring
              </div>
            </div>
          </TechCard>

          <TechCard
            variant="simple"
            interactive={false}
            metadata="EDI_BENEFIT_04"
          >
            <div class="flex flex-col items-center text-center p-8">
              <div class="mb-4 text-primary opacity-80">
                <PiCurrencyDollar className="h-10 w-10" aria-hidden="true" />
              </div>
              <h4 class="text-foreground mb-2 text-lg font-bold font-display tracking-tight">
                Cost Efficiency
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Eliminate VAN fees and reduce operational overhead with direct connections
              </div>
            </div>
          </TechCard>

          <TechCard
            variant="simple"
            interactive={false}
            metadata="EDI_BENEFIT_05"
          >
            <div class="flex flex-col items-center text-center p-8">
              <div class="mb-4 text-primary opacity-80">
                <PiGlobe className="h-10 w-10" aria-hidden="true" />
              </div>
              <h4 class="text-foreground mb-2 text-lg font-bold font-display tracking-tight">
                Global Reach
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Connect with partners in any region with support for international standards
              </div>
            </div>
          </TechCard>

          <TechCard
            variant="simple"
            interactive={false}
            metadata="EDI_BENEFIT_06"
          >
            <div class="flex flex-col items-center text-center p-8">
              <div class="mb-4 text-primary opacity-80">
                <PiEye className="h-10 w-10" aria-hidden="true" />
              </div>
              <h4 class="text-foreground mb-2 text-lg font-bold font-display tracking-tight">
                Total Visibility
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                End-to-end tracking of every document in your supply chain
              </div>
            </div>
          </TechCard>
        </div>
        
        <div class="mt-24">
           <WhoThisIsFor
             title="Who This Is For"
             description="Built for teams moving high-volume EDI across complex partner networks."
             items={audience}
             client:visible
           />
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <h3 class="text-foreground mb-12 text-center text-3xl font-bold font-display tracking-tight">
           Frequently Asked Questions
        </h3>
        <TechnicalFAQ faqs={faqs} client:idle />
      </div>
    </section>

    <ImpactMetricsSection metrics={metrics} />

    <CTASection
      client:visible
      title="Ready to Scale Your Supply Chain?"
      description="Deploy an EDI infrastructure that moves as fast as your business. Secure, reliable, and built for the enterprise."
      primaryAction={{
        text: 'Schedule a Consultation',
        href: '/contact#chat',
        icon: 'sparkles',
      }}
    />
  </main>

  <Footer />
</Layout>
