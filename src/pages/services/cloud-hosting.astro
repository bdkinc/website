---
import { getEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import { ServiceCard, ServiceCardGrid } from '@/components/ServiceCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import WhoThisIsFor from '@/components/WhoThisIsFor';
import { Card } from '@/components/ui/card';
import {
  PiLock,
  PiLightning,
  PiUsers,
  PiShield,
  PiArrowsClockwise,
  PiCloud,
  PiClock,
  PiGearSix,
  PiCloudArrowUp,
  PiCheckCircle,
  PiTerminal,
  PiCpu,
  PiHardDrives,
  PiGraph,
  PiSquaresFour,
  PiGlobe,
  PiStack
} from 'react-icons/pi';
import { Code2, Server, Database, Cloud, Network, Laptop } from 'lucide-react';
import Footer from '@/components/Footer.astro';

const service = await getEntry('services', 'cloud-hosting');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');

const _serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.title,
  description:
    'Secure, scalable cloud solutions for the enterprise. BDKinc delivers intelligent orchestration across private, public, and hybrid environments with elite management and 24/7 support.',
  provider: {
    '@type': 'Organization',
    name: 'BDKinc',
    url: 'https://www.bdkinc.com',
  },
  serviceType: 'Cloud Hosting & Migration',
};

const relatedTags = ['cloud', 'security', 'infrastructure'];
const relatedPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((post) => post.data.tags?.some((tag) => relatedTags.includes(tag)))
  .slice(0, 3);

const metrics = [
  { value: '99.99%', label: 'UPTIME SLA', icon: PiShield },
  { value: '75+', label: 'CLOUD MIGRATIONS', icon: PiArrowsClockwise },
  { value: '1.5PB', label: 'DATA MANAGED', icon: PiCloud },
  { value: '24/7', label: 'OPERATIONS CENTER', icon: PiClock },
];

const detailColumns = [
  {
    title: 'Precision Migration',
    icon: PiCloudArrowUp,
    items: [
      'Deep architectural assessment of workloads and compliance',
      'Zero-disruption methodology for critical business systems',
      'Rigorous cutover playbooks to ensure data integrity',
    ],
  },
  {
    title: 'Elite Day-2 Operations',
    icon: PiGearSix,
    items: [
      '24/7 active monitoring of performance and security posture',
      'Continuous cost optimization and utilization reviews',
      'Unified security plane across private and public clouds',
    ],
  },
];

const faqs = [
  {
    question: "How do you determine the right mix of public vs. private cloud?",
    answer: "We conduct a deep architectural assessment of your workloads, compliance requirements, and budget. We typically recommend Private Cloud for predictable, data-heavy core systems, and Public Cloud for variable web workloads or rapid development cycles."
  },
  {
    question: "How do you handle compliance and security in a hybrid environment?",
    answer: "Security is our baseline. We implement a unified security plane across all environments—private and public—ensuring consistent policies, identity management, and threat detection that meet SOC 2, HIPAA, and other regulatory standards."
  },
  {
    question: "What does 'Managed Cloud' actually include?",
    answer: "It means total accountability. We handle patching, backups, security monitoring, performance tuning, and 24/7 incident response. You focus on your applications and business logic; we ensure the infrastructure never blinks."
  }
];

const providers = [
  { name: "IBM Cloud", icon: Server, desc: "Enterprise-grade reliability and Power Systems expertise" },
  { name: "AWS", icon: Cloud, desc: "Industry-leading breadth for diverse application ecosystems" },
  { name: "Microsoft Azure", icon: Database, desc: "Seamless integration for Microsoft-centric enterprises" },
  { name: "Cisco", icon: Network, desc: "Building on the world's most robust network backbone" },
  { name: "Google Cloud", icon: Code2, desc: "Advanced data analytics and AI capabilities" },
  { name: "Lenovo", icon: Laptop, desc: "High-performance hardware designed for modern business" },
];
---

<Layout
  title="Cloud Hosting & Migration Services | BDKinc"
  description="Secure, scalable cloud solutions for the enterprise. BDKinc delivers intelligent orchestration across private, public, and hybrid environments."
  ogDescription="BDKinc architects the perfect mix of Private, Hybrid, and Public environments to maximize performance and minimize cost across your entire organization."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(_serviceSchema)}
  />
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="circuit-overlay absolute inset-0 opacity-40"></div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="text-center">
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <h1
            class="mb-6 text-5xl font-bold md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <p
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
            class="text-muted-foreground mx-auto mb-12 max-w-3xl text-xl"
          >
            {service.data.description}
          </p>
        </div>

        {/* Hero Image Placeholder */}
        <div
          class="fill-mode-both animate-in fade-in zoom-in delay-300 duration-700"
        >
          <div
            class="glass border-primary/20 mx-auto max-w-5xl overflow-hidden rounded-2xl border shadow-lg"
          >
            <div
              class="from-primary/5 via-secondary/5 to-primary/5 flex aspect-video items-center justify-center bg-linear-to-br"
            >
              <div class="text-center">
                <div
                  class="text-muted-foreground/40 mb-2 text-sm font-medium tracking-wider uppercase"
                >
                  Service Hero Image
                </div>
                <div class="text-muted-foreground/60 text-lg">
                  Cloud Hosting Illustration
                </div>
                <div class="text-muted-foreground/40 mt-2 text-xs">
                  Recommended: 1400x800px
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--brand-accent]/50"
      >
      </div>
    </section>

    <!-- Content Section -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div
        class="animate-in fade-in slide-in-from-bottom-4 fill-mode-both space-y-12 delay-600 duration-700"
      >
        <div class="mx-auto max-w-7xl">
          <div class="service-content-wrapper">
            <div class="not-prose mx-auto max-w-4xl">
              <h2 class="text-foreground mb-6 text-center text-3xl font-bold">
                Intelligent Cloud Orchestration
              </h2>
              <div
                class="text-muted-foreground mb-10 text-center text-lg leading-relaxed"
              >
                One cloud does not fit all. We architect the perfect mix of <span class="text-primary font-semibold">private</span>, <span class="text-secondary font-semibold">hybrid</span>, and <span class="text-accent font-semibold">public</span> environments to maximize performance and minimize cost across your entire organization. BDKinc delivers the agility of the public cloud with the control and security of elite private infrastructure.
              </div>
            </div>

            <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
              Cloud Deployment Options
            </h3>

            {/* Cloud Deployment Grid - Polished with Scanlines & Accents via ServiceCard */}
            <ServiceCardGrid client:visible>
              <ServiceCard client:visible>
                <div class="mb-6 relative">
                  <div class="absolute inset-0 bg-primary/20 blur-xl rounded-full opacity-50"></div>
                  <PiLock
                    className="text-primary h-16 w-16 relative z-10"
                    aria-hidden="true"
                  />
                </div>
                <h4 class="text-foreground mb-4 text-2xl font-bold font-display">
                  Private Cloud
                </h4>
                <div class="text-foreground leading-relaxed mb-4">
                  Uncompromising Control. BDKinc’s Private Cloud offers dedicated resources in our secure datacenters, ensuring absolute data sovereignty, predictable performance, and compliance for sensitive workloads.
                </div>
                <div class="text-muted-foreground text-sm font-mono mt-auto">
                  <span class="text-primary">TARGET:</span> Healthcare, Finance, Gov
                </div>
              </ServiceCard>

              <ServiceCard client:visible>
                <div class="mb-6 relative">
                  <div class="absolute inset-0 bg-secondary/20 blur-xl rounded-full opacity-50"></div>
                  <PiStack
                    className="text-secondary h-16 w-16 relative z-10"
                    aria-hidden="true"
                  />
                </div>
                <h4 class="text-foreground mb-4 text-2xl font-bold font-display">
                  Hybrid Cloud
                </h4>
                <div class="text-foreground leading-relaxed mb-4">
                  Seamless Integration. Bridge the gap between on-premise legacy systems and modern cloud agility. Our hybrid architectures allow you to scale securely, keeping sensitive data close while leveraging public cloud power.
                </div>
                <div class="text-muted-foreground text-sm font-mono mt-auto">
                  <span class="text-secondary">TARGET:</span> Enterprise, Mixed Workloads
                </div>
              </ServiceCard>

              <ServiceCard client:visible>
                <div class="mb-6 relative">
                  <div class="absolute inset-0 bg-accent/20 blur-xl rounded-full opacity-50"></div>
                  <PiGlobe
                    className="text-accent h-16 w-16 relative z-10"
                    aria-hidden="true"
                  />
                </div>
                <h4 class="text-foreground mb-4 text-2xl font-bold font-display">
                  Public Cloud
                </h4>
                <div class="text-foreground leading-relaxed mb-4">
                  Infinite Scalability. Leverage the massive global reach of AWS, Azure, and IBM Cloud. We manage the complexity, optimizing your deployment for cost-efficiency, security, and performance at scale.
                </div>
                <div class="text-muted-foreground text-sm font-mono mt-auto">
                  <span class="text-accent">TARGET:</span> Startups, AI/ML, Big Data
                </div>
              </ServiceCard>
            </ServiceCardGrid>

            {/* BDK Private Cloud Advantage - Control Room Style */}
            <div class="not-prose my-16">
              <div class="relative overflow-hidden rounded-xl border border-primary/30 bg-black/80 p-8 md:p-12 shadow-[0_0_50px_rgba(0,212,255,0.1)]">
                {/* Background Tech Effects */}
                <div class="geometric-grid absolute inset-0 opacity-10"></div>
                <div class="circuit-overlay absolute inset-0 opacity-10"></div>
                <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-primary/50 to-transparent"></div>
                
                <div class="relative z-10 flex flex-col lg:flex-row items-start gap-10">
                  <div class="flex-shrink-0 w-full lg:w-1/3">
                    <div class="border border-primary/20 bg-primary/5 rounded-lg p-6 backdrop-blur-sm">
                      <div class="flex items-center justify-between mb-4 border-b border-primary/20 pb-2">
                         <span class="text-xs font-mono text-primary tracking-widest">SYSTEM_STATUS</span>
                         <div class="flex gap-1">
                           <div class="w-2 h-2 rounded-full bg-primary animate-pulse"></div>
                           <div class="w-2 h-2 rounded-full bg-primary/30"></div>
                           <div class="w-2 h-2 rounded-full bg-primary/30"></div>
                         </div>
                      </div>
                      <div class="grid grid-cols-2 gap-4">
                         <div class="text-center p-3 bg-black/40 rounded border border-primary/10">
                            <PiCpu className="h-6 w-6 text-primary mx-auto mb-1" />
                            <div class="text-[10px] text-muted-foreground font-mono">COMPUTE</div>
                            <div class="text-sm font-bold text-foreground">DEDICATED</div>
                         </div>
                         <div class="text-center p-3 bg-black/40 rounded border border-primary/10">
                            <PiHardDrives className="h-6 w-6 text-primary mx-auto mb-1" />
                            <div class="text-[10px] text-muted-foreground font-mono">STORAGE</div>
                            <div class="text-sm font-bold text-foreground">NVMe POOLS</div>
                         </div>
                         <div class="text-center p-3 bg-black/40 rounded border border-primary/10">
                            <PiGraph className="h-6 w-6 text-primary mx-auto mb-1" />
                            <div class="text-[10px] text-muted-foreground font-mono">LATENCY</div>
                            <div class="text-sm font-bold text-foreground">&lt;1MS LOCAL</div>
                         </div>
                         <div class="text-center p-3 bg-black/40 rounded border border-primary/10">
                            <PiSquaresFour className="h-6 w-6 text-primary mx-auto mb-1" />
                            <div class="text-[10px] text-muted-foreground font-mono">NODES</div>
                            <div class="text-sm font-bold text-foreground">SCALABLE</div>
                         </div>
                      </div>
                    </div>
                  </div>
                  
                  <div class="flex-1">
                    <div class="flex items-center gap-3 mb-4">
                      <PiBuildings className="text-primary h-8 w-8" aria-hidden="true" />
                      <h3 class="text-foreground text-2xl md:text-3xl font-bold font-display">
                        The BDK Private Cloud Advantage
                      </h3>
                    </div>
                    
                    <p class="text-muted-foreground mb-6 text-lg leading-relaxed border-l-2 border-primary/20 pl-4">
                      For organizations that demand more than the "shared responsibility" model. Our owned and operated datacenters offer white-glove security, direct access to engineers, and custom hardware configurations that hyperscalers simply cannot match.
                    </p>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                      <div class="flex items-center gap-2 text-sm text-foreground/80 bg-primary/5 p-2 rounded border border-primary/10">
                        <PiCheckCircle className="text-primary h-5 w-5" />
                        <span class="font-mono">SOC 2 TYPE II COMPLIANT</span>
                      </div>
                      <div class="flex items-center gap-2 text-sm text-foreground/80 bg-primary/5 p-2 rounded border border-primary/10">
                        <PiCheckCircle className="text-primary h-5 w-5" />
                        <span class="font-mono">HIPAA / HITECH READY</span>
                      </div>
                      <div class="flex items-center gap-2 text-sm text-foreground/80 bg-primary/5 p-2 rounded border border-primary/10">
                        <PiCheckCircle className="text-primary h-5 w-5" />
                        <span class="font-mono">MISSION-CRITICAL UPTIME</span>
                      </div>
                      <div class="flex items-center gap-2 text-sm text-foreground/80 bg-primary/5 p-2 rounded border border-primary/10">
                        <PiCheckCircle className="text-primary h-5 w-5" />
                        <span class="font-mono">DIRECT L3 ENGINEER ACCESS</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <h3 class="text-foreground mt-12 mb-6 text-center text-2xl font-bold">
              Multi-Provider Expertise
            </h3>

            <div class="not-prose mb-20">
              <p class="text-muted-foreground mb-10 text-center text-xl">
                Giants in Our Toolkit. We are certified experts leveraging the R&D and reliability of global technology leaders.
              </p>

              {/* Giants in Our Toolkit - Geometric Grid */}
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mx-auto max-w-6xl">
                {providers.map((provider, index) => (
                  <div class="group relative bg-card/40 border border-border overflow-hidden hover:border-primary/50 transition-colors duration-300">
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
                      <div class="absolute top-0 right-0 w-8 h-8 border-t-2 border-r-2 border-primary/40 rounded-tr-lg"></div>
                      <div class="absolute bottom-0 left-0 w-8 h-8 border-b-2 border-l-2 border-primary/40 rounded-bl-lg"></div>
                      <div class="absolute inset-0 bg-primary/5"></div>
                    </div>
                    
                    <div class="p-6 relative z-10">
                      <div class="flex items-center justify-between mb-3">
                         <div class="p-2 bg-background rounded-md border border-border group-hover:border-primary/30 transition-colors">
                            <provider.icon className="h-6 w-6 text-foreground group-hover:text-primary transition-colors" />
                         </div>
                         <div class="text-[10px] font-mono text-muted-foreground/50 group-hover:text-primary/50">
                            PRV_0{index + 1}
                         </div>
                      </div>
                      <h5 class="text-foreground font-bold text-lg mb-1 group-hover:text-primary transition-colors">{provider.name}</h5>
                      <p class="text-sm text-muted-foreground">{provider.desc}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
              Our Approach
            </h3>

            <div class="not-prose mb-20">
              <div class="grid items-center gap-8 md:grid-cols-2">
                {/* Approach Image Placeholder */}
                <div class="order-2 md:order-1">
                  <div
                    class="glass border-primary/20 overflow-hidden rounded-xl border"
                  >
                    <div
                      class="from-primary/5 via-secondary/5 to-primary/5 flex aspect-square items-center justify-center bg-linear-to-br"
                    >
                      <div class="p-4 text-center">
                        <div
                          class="text-muted-foreground/40 mb-1 text-xs font-medium tracking-wider uppercase"
                        >
                          Approach Visual
                        </div>
                        <div class="text-muted-foreground/60 text-sm">
                          Workflow Diagram
                        </div>
                        <div class="text-muted-foreground/40 mt-1 text-[10px]">
                          800x800px
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                {/* Approach Text */}
                <div class="order-1 md:order-2">
                  <div class="glass border-border rounded-xl border p-8">
                    <div
                      class="text-muted-foreground space-y-4 text-lg leading-relaxed"
                    >
                      <p>
                        <strong class="text-foreground">Precision Migration.</strong> We don't just "lift and shift." We assess, refactor, and migrate workloads with a zero-disruption methodology.
                      </p>
                      <p>
                        We ensure your business keeps running while your infrastructure transforms, maintaining strict data integrity throughout the transition.
                      </p>
                      <p>
                        From initial architectural assessment to final cutover, our team manages every detail of your cloud evolution.
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
              Key Benefits
            </h3>

            <div
              class="not-prose mb-20 grid gap-6 md:grid-cols-2 lg:grid-cols-3"
            >
              <Card
                size="default"
                interactive={false}
                className="flex flex-col items-center text-center"
              >
                <div class="mb-4">
                  <PiShield
                    className="text-primary h-10 w-10"
                    aria-hidden="true"
                  />
                </div>
                <h4 class="text-foreground mb-2 text-xl font-bold">
                  Enhanced Reliability
                </h4>
                <div class="text-muted-foreground">
                  Redundancy capabilities prevent downtime and protect your
                  critical business data
                </div>
              </Card>

              <Card
                size="default"
                interactive={false}
                className="flex flex-col items-center text-center"
              >
                <div class="mb-4">
                  <PiCurrencyDollar
                    className="text-primary h-10 w-10"
                    aria-hidden="true"
                  />
                </div>
                <h4 class="text-foreground mb-2 text-xl font-bold">
                  Cost Efficiency
                </h4>
                <div class="text-muted-foreground">
                  Reduce capital expenses by moving from physical infrastructure
                  to flexible cloud solutions
                </div>
              </Card>

              <Card
                size="default"
                interactive={false}
                className="flex flex-col items-center text-center"
              >
                <div class="mb-4">
                  <PiArrowsClockwise
                    className="text-primary h-10 w-10"
                    aria-hidden="true"
                  />
                </div>
                <h4 class="text-foreground mb-2 text-xl font-bold">
                  Business Continuity
                </h4>
                <div class="text-muted-foreground">
                  Built-in disaster recovery and backup solutions keep your
                  business running
                </div>
              </Card>

              <Card
                size="default"
                interactive={false}
                className="flex flex-col items-center text-center"
              >
                <div class="mb-4">
                  <PiUsers
                    className="text-primary h-10 w-10"
                    aria-hidden="true"
                  />
                </div>
                <h4 class="text-foreground mb-2 text-xl font-bold">
                  Expert Support
                </h4>
                <div class="text-muted-foreground">
                  60+ years of combined experience in cloud infrastructure and
                  migration
                </div>
              </Card>

              <Card
                size="default"
                interactive={false}
                className="flex flex-col items-center text-center"
              >
                <div class="mb-4">
                  <PiLock
                    className="text-primary h-10 w-10"
                    aria-hidden="true"
                  />
                </div>
                <h4 class="text-foreground mb-2 text-xl font-bold">Security</h4>
                <div class="text-muted-foreground">
                  Enterprise-grade security controls protect your data in the
                  cloud
                </div>
              </Card>

              <Card
                size="default"
                interactive={false}
                className="flex flex-col items-center text-center"
              >
                <div class="mb-4">
                  <PiLightning
                    className="text-primary h-10 w-10"
                    aria-hidden="true"
                  />
                </div>
                <h4 class="text-foreground mb-2 text-xl font-bold">
                  Flexibility
                </h4>
                <div class="text-muted-foreground">
                  Choose from public, private, or hybrid cloud configurations
                </div>
              </Card>
            </div>

            <div class="not-prose mb-20 grid gap-8 md:grid-cols-2">
              {
                detailColumns.map((column) => (
                  <div class="glass border-border rounded-2xl border p-8">
                    <div class="mb-6 flex items-center gap-3">
                      <column.icon
                        className="text-primary h-8 w-8"
                        aria-hidden="true"
                      />
                      <h4 class="text-foreground text-2xl font-bold">
                        {column.title}
                      </h4>
                    </div>
                    <div class="text-muted-foreground space-y-3">
                      {column.items.map((item) => (
                        <div class="flex items-start gap-2">
                          <PiCheckCircle
                            className="text-primary mt-1 h-5 w-5 shrink-0"
                            aria-hidden="true"
                          />
                          <span>{item}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                ))
              }
            </div>

            <WhoThisIsFor client:visible />

            <h3 class="text-foreground mb-8 text-center text-2xl font-bold">
              Common Questions
            </h3>

            {/* Replaced with TechnicalFAQ component */}
            <TechnicalFAQ client:visible faqs={faqs} />

            <div class="not-prose my-16 mx-auto max-w-4xl">
              <Card size="lg" interactive={false} className="border-secondary/20 bg-gradient-to-br from-card to-background">
                <div class="scanlines absolute inset-0 opacity-[0.02] pointer-events-none"></div>
                <div class="flex flex-col items-center text-center gap-6 relative z-10">
                  <div class="flex gap-6 items-center">
                    <div class="p-4 bg-secondary/10 rounded-xl border border-secondary/20">
                      <PiCloud className="text-secondary h-12 w-12" aria-hidden="true" />
                    </div>
                    <div class="h-px w-8 bg-border"></div>
                    <div class="p-4 bg-primary/10 rounded-xl border border-primary/20 relative">
                       <div class="absolute -top-1 -right-1 w-3 h-3 bg-primary rounded-full border-2 border-background animate-pulse"></div>
                       <PiTerminal className="text-primary h-12 w-12" aria-hidden="true" />
                    </div>
                  </div>
                  
                  <h3 class="text-foreground text-2xl font-bold">
                    Need Custom Applications Too?
                  </h3>
                  
                  <p class="text-muted-foreground text-lg max-w-2xl">
                    BDKinc is a full-service <strong class="text-primary">Dev Shop</strong>. We build custom applications tailored to your business and deploy them on infrastructure we manage. One partner, complete solution.
                  </p>
                  
                  <a
                    href="/services/application-development"
                    class="group relative inline-flex items-center gap-3 px-8 py-3 bg-primary/10 text-primary font-bold rounded-lg border border-primary/20 hover:bg-primary hover:text-primary-foreground transition-all duration-300 overflow-hidden"
                  >
                    <span class="relative z-10">Explore Development Services</span>
                    <Code2 className="h-5 w-5 relative z-10 group-hover:translate-x-1 transition-transform" />
                    <div class="absolute inset-0 bg-primary opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                  </a>
                </div>
              </Card>
            </div>
          </div>
        </div>

        <ImpactMetricsSection metrics={metrics} />

        {
          relatedPosts.length > 0 && (
            <section class="mx-auto max-w-5xl">
              <h2 class="text-foreground mb-6 text-center text-3xl font-bold">
                Related Resources
              </h2>
              <div class="grid gap-6 md:grid-cols-3">
                {relatedPosts.map((post) => (
                  <a
                    href={`/blog/${post.slug}`}
                    class="border-border hover:border-primary flex flex-col rounded-xl border p-6 transition-colors"
                  >
                    <h3 class="text-foreground mb-2 text-lg font-semibold">
                      {post.data.title}
                    </h3>
                    <p class="text-muted-foreground text-sm">
                      {post.data.description}
                    </p>
                    <span class="text-primary mt-4 text-sm font-medium">
                      Read Article →
                    </span>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        <CTASection
          client:visible
          title="Stop Settling for Standard Support."
          description="Partner with the elite experts who understand your scale. Let’s architect a cloud strategy that drives your business forward."
          buttonText="Consult with an Architect"
          buttonHref="/contact"
        />
      </div>
    </section>
  </main>

  <Footer />
</Layout>
