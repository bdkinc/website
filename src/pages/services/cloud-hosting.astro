---
import { getEntry, getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import { TechCard, TechCardGrid } from '@/components/TechCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import TechSpecs from '@/components/TechSpecs';
import WhoThisIsFor from '@/components/WhoThisIsFor';
import TechnicalSection from '@/components/TechnicalSection';
import CloudHostingVisualization from '@/components/visualizations/CloudHostingVisualization';
import FeatureCarousel from '@/components/FeatureCarousel';
import {
  PiLock,
  PiLightning,
  PiUsers,
  PiUsersThree,
  PiShield,
  PiArrowsClockwise,
  PiCloud,
  PiClock,
  PiGearSix,
  PiCloudArrowUp,
  PiCheckCircle,
  PiTerminal,
  PiCpu,
  PiHardDrives,
  PiGraph,
  PiSquaresFour,
  PiGlobe,
  PiStack,
  PiBuildings,
  PiCurrencyDollar,
  PiCode,
  PiDatabase,
  PiNetwork,
  PiLaptop,
  PiQuotesFill,
  PiMonitor,
  PiTrendUp,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';
const service = await getEntry('services', 'cloud-hosting');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');
const _serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.title,
  description:
    'Secure, scalable cloud solutions for the enterprise. BDKinc delivers intelligent orchestration across private, public, and hybrid environments with premier management and 24/7 support.',
  provider: {
    '@type': 'Organization',
    name: 'BDKinc',
    url: 'https://www.bdkinc.com',
  },
  serviceType: 'Cloud Hosting & Migration',
};
const relatedTags = ['cloud', 'security', 'infrastructure'];
const relatedPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((post) => post.data.tags?.some((tag) => relatedTags.includes(tag)))
  .slice(0, 3);
const metrics = [
  { value: '99.99%', label: 'Uptime SLA', icon: PiShield },
  { value: '75+', label: 'Cloud Migrations', icon: PiArrowsClockwise },
  { value: '1.5PB', label: 'Data Managed', icon: PiCloud },
  { value: '24/7', label: 'Operations Center', icon: PiClock },
];
const faqs = [
  {
    question: "How do you determine the right mix of public vs. private cloud?",
    answer: "We conduct a deep architectural assessment of your workloads, compliance requirements, and budget. We typically recommend Private Cloud for predictable, data-heavy core systems, and Public Cloud for variable web workloads or rapid development cycles."
  },
  {
    question: "How do you handle compliance and security in a hybrid environment?",
    answer: "Security is our baseline. We implement a unified security plane across all environments—private and public—ensuring consistent policies, identity management, and threat detection that meet SOC 2, HIPAA, and other regulatory standards."
  },
  {
    question: "What does 'Managed Cloud' actually include?",
    answer: "It means total accountability. We handle patching, backups, security monitoring, performance tuning, and 24/7 incident response. You focus on your applications and business logic; we ensure the infrastructure never blinks."
  }
];
const strategicFeatures = [
  {
    title: 'Orchestrated Agility',
    description:
      'Intelligent resource allocation across hybrid environments.',
    highlight: 'Intelligent resource allocation',
    icon: 'Stack',
    detail:
      "We design cloud architectures that adapt to your workload demands in real-time. By orchestrating resources across private and public clouds, we ensure you have the agility of the cloud with the control of dedicated infrastructure.",
  },
  {
    title: 'Architectural Sovereignty',
    description:
      'Absolute control over data location and security governance.',
    highlight: 'Absolute control over data',
    icon: 'Lock',
    detail:
      "For sensitive workloads, our private cloud environments offer dedicated hardware and direct engineer access, ensuring your data sovereignty and compliance requirements are met without compromise.",
  },
  {
    title: 'Cost Optimization',
    description:
      'Continuous utilization analysis to eliminate cloud waste.',
    highlight: 'Eliminate cloud waste',
    icon: 'CurrencyDollar',
    detail:
      "We don't just set it and forget it. Our engineers perform continuous reviews of your cloud spend and resource utilization, refactoring environments to ensure you're always getting the maximum value for your investment.",
  },
  {
    title: 'Zero-Disruption Migration',
    description:
      'Rigorous cutover playbooks ensuring 100% data integrity.',
    highlight: '100% data integrity',
    icon: 'CloudArrowUp',
    detail:
      "Migration shouldn't mean downtime. Our proven methodology uses phased transitions and automated synchronization to move your critical systems to the cloud with zero impact on your business operations.",
  },
];
const providers = [
  { name: "IBM Cloud", icon: PiCloud, desc: "Enterprise-grade reliability and Power Systems expertise" },
  { name: "AWS", icon: PiCloud, desc: "Industry-leading breadth for diverse application ecosystems" },
  { name: "Microsoft Azure", icon: PiDatabase, desc: "Seamless integration for Microsoft-centric enterprises" },
  { name: "Cisco", icon: PiNetwork, desc: "Building on the world's most robust network backbone" },
  { name: "Google Cloud", icon: PiCloud, desc: "Advanced data analytics and AI capabilities" },
  { name: "Lenovo", icon: PiLaptop, desc: "High-performance hardware designed for modern business" },
];
---
<Layout
  title="Cloud Hosting & Migration Services | BDKinc"
  description="Secure, scalable cloud solutions for the enterprise. BDKinc delivers intelligent orchestration across private, public, and hybrid environments."
  ogDescription="BDKinc architects the perfect mix of Private, Hybrid, and Public environments to maximize performance and minimize cost across your entire organization."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(_serviceSchema)}
  />
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="circuit-overlay absolute inset-0 opacity-40"></div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
          <!-- Badge -->
          <div
            class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
          >
            <div class="flex items-center gap-2 text-sm">
              <span>Secure & <span class="text-accent font-semibold">Scalable</span></span>
            </div>
          </div>
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <!-- Heading -->
          <h1
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold tracking-tight delay-100 duration-700 md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <!-- Subtitle -->
          <p
            class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 mx-auto mb-16 max-w-3xl text-xl leading-relaxed delay-200 duration-700"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            Secure, scalable cloud solutions for the enterprise. BDKinc delivers 
            intelligent orchestration across private, public, and hybrid environments 
            with premier management and 24/7 support.
          </p>
        </div>
        <!-- Visualization -->
        <div
          class="fill-mode-both animate-in fade-in zoom-in delay-300 duration-700"
        >
          <div class="mx-auto max-w-5xl">
            <CloudHostingVisualization client:visible />
          </div>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--brand-accent]/50"
      >
      </div>
    </section>
    <!-- Core Services -->
    <section class="bg-muted/30 dark:bg-white/[0.02] px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight normal-case md:text-4xl"
          >
            <span class="text-foreground">Deployment </span>
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >Options</span
            >
          </h2>
          <p
            class="text-muted-foreground mx-auto mt-4 max-w-2xl font-sans text-xl"
          >
            Intelligent cloud orchestration designed for the
            <span class="text-accent font-semibold">modern enterprise</span>.
          </p>
        </div>
        <TechCardGrid client:visible className="md:grid-cols-3">
          <TechCard
            variant="technical"
            interactive={true}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiLock
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Private Cloud
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed mb-6">
                Uncompromising Control. BDKinc’s Private Cloud offers dedicated 
                resources in our secure datacenters, ensuring absolute data 
                sovereignty, predictable performance, and compliance for sensitive workloads.
              </div>
              <div class="text-primary text-[10px] font-mono mt-auto tracking-widest bg-primary/5 px-2 py-1 border border-primary/10">
                Target: Healthcare, Finance, Gov
              </div>
            </div>
          </TechCard>
          <TechCard
            variant="technical"
            interactive={true}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiStack
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Hybrid Cloud
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed mb-6">
                Seamless Integration. Bridge the gap between on-premise legacy 
                systems and modern cloud agility. Our hybrid architectures 
                allow you to scale securely, keeping sensitive data close while leveraging public cloud power.
              </div>
              <div class="text-primary text-[10px] font-mono mt-auto tracking-widest bg-primary/5 px-2 py-1 border border-primary/10">
                Target: Enterprise, Mixed Workloads
              </div>
            </div>
          </TechCard>
          <TechCard
            variant="technical"
            interactive={true}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiGlobe
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Public Cloud
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed mb-6">
                Infinite Scalability. Leverage the massive global reach of AWS, 
                Azure, and IBM Cloud. We manage the complexity, optimizing your 
                deployment for cost-efficiency, security, and performance at scale.
              </div>
              <div class="text-primary text-[10px] font-mono mt-auto tracking-widest bg-primary/5 px-2 py-1 border border-primary/10">
                Target: Startups, AI/ML, Big Data
              </div>
            </div>
          </TechCard>
        </TechCardGrid>
      </div>
    </section>
    <!-- Strategic Leadership Section -->
    <section class="relative overflow-hidden py-24">
      <div
        class="via-primary/20 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-12 text-center">
          <h2
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-4xl font-bold tracking-tight duration-600 md:text-5xl"
          >
            <span class="text-foreground">Architectural </span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Vision</span
            >
          </h2>
        </div>
        <figure class="relative mx-auto max-w-3xl">
          <PiQuotesFill
            className="text-primary/25 pointer-events-none absolute -top-10 right-0 h-16 w-16"
            aria-hidden="true"
          />
          <blockquote
            class="border-secondary/50 text-muted-foreground border-l-4 pl-6 text-xl leading-relaxed font-light md:text-2xl"
          >
            "Cloud is not a destination; it's an operating model. We don't just 
            host your data; we architect
            <span class="text-accent font-semibold">
              intelligent ecosystems</span
            >
            that balance security, performance, and cost, ensuring your 
            infrastructure never blinks."
          </blockquote>
        </figure>
      </div>
      <div
        class="via-primary/20 absolute bottom-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
    </section>
    <!-- Strategic Advantage -->
    <section
      class="bg-linear-to-b from-transparent to-muted/20 dark:to-white/[0.02] px-4 py-24 sm:px-6 lg:px-8"
    >
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            The Strategic <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Advantage</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            Move beyond simple hosting with a partner who orchestrates 
            enterprise-grade cloud transformations.
          </p>
        </div>
        <FeatureCarousel client:visible features={strategicFeatures} />
      </div>
    </section>
    <!-- Partners Grid -->
    <section class="bg-muted/30 dark:bg-white/[0.02] px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            Multi-Provider <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Expertise</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            Certified expertise across leading cloud platforms and enterprise 
            infrastructure partners.
          </p>
        </div>
        <TechCardGrid client:visible className="md:grid-cols-3 grid-cols-1 gap-6 mx-auto max-w-6xl">
          {providers.map((provider) => (
            <TechCard
              variant="technical"
              interactive={true}
            >
              <div class="group/provider flex h-full flex-col p-8 text-center">
                {/* Visual Header */}
                <div class="mb-8 flex flex-col items-center justify-center">
                  <div class="relative">
                    <div class="absolute -inset-2 rounded-lg bg-primary/20 opacity-0 blur-lg transition-opacity duration-500 group-hover/provider:opacity-100"></div>
                    <div class="relative flex h-14 w-14 items-center justify-center rounded-xl border border-primary/20 bg-background/50 shadow-inner backdrop-blur-md transition-transform duration-500 group-hover/provider:scale-110 group-hover/provider:border-primary/40">
                      <provider.icon className="h-7 w-7 text-primary/70 transition-colors duration-500 group-hover/provider:text-primary" />
                    </div>
                  </div>
                </div>

                {/* Content */}
                <div class="flex-grow">
                  <h5 class="font-display mb-3 text-xl font-bold tracking-tight text-foreground transition-colors duration-300 group-hover/provider:text-primary">
                    {provider.name}
                  </h5>
                  <p class="font-sans text-sm leading-relaxed text-muted-foreground/80 transition-colors duration-300 group-hover/provider:text-muted-foreground">
                    {provider.desc}
                  </p>
                </div>
              </div>
            </TechCard>
          ))}
        </TechCardGrid>
      </div>
    </section>
    <!-- Key Benefits -->
    <section class="bg-muted/20 dark:bg-white/[0.01] px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            Key <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Benefits</span
            >
          </h2>
        </div>
        <div class="grid gap-x-12 gap-y-16 md:grid-cols-2 lg:grid-cols-3">
          <!-- Benefit 1 -->
          <div class="group flex flex-col items-center text-center">
            <PiShield
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              Enhanced Reliability
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Multi-region redundancy and high-availability clusters protect 
              your critical business data
            </p>
          </div>
          <!-- Benefit 2 -->
          <div class="group flex flex-col items-center text-center">
            <PiCurrencyDollar
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              Cost Efficiency
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Shift from volatile capital expenses to predictable, 
              value-driven operational models
            </p>
          </div>
          <!-- Benefit 3 -->
          <div class="group flex flex-col items-center text-center">
            <PiArrowsClockwise
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              Business Continuity
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Built-in disaster recovery and immutable backup solutions keep 
              your business running
            </p>
          </div>
          <!-- Benefit 4 -->
          <div class="group flex flex-col items-center text-center">
            <PiUsersThree
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              Architectural Expertise
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Direct access to senior cloud architects with decades of 
              enterprise migration experience
            </p>
          </div>
          <!-- Benefit 5 -->
          <div class="group flex flex-col items-center text-center">
            <PiLock
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              Security First
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Unified security plane across all environments ensures consistent 
              policy enforcement
            </p>
          </div>
          <!-- Benefit 6 -->
          <div class="group flex flex-col items-center text-center">
            <PiLightning
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              Infinite Flexibility
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Elastic capacity that adapts instantly to rapid growth, mergers, 
              and acquisitions
            </p>
          </div>
        </div>
      </div>
    </section>
    <WhoThisIsFor client:visible />

    <!-- FAQ -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
          Frequently Asked Questions
        </h3>
        <div class="mb-20">
          <TechnicalFAQ client:visible faqs={faqs} />
        </div>
      </div>
    </section>
    <!-- Related Resources -->
    {
      relatedPosts.length > 0 && (
        <section class="mx-auto max-w-5xl px-4 py-24">
          <h2 class="text-foreground mb-6 text-center text-3xl font-bold">
            Related Resources
          </h2>
          <div class="grid gap-6 md:grid-cols-3">
            {relatedPosts.map((post) => (
              <a
                href={`/blog/${post.slug}`}
                class="border-border hover:border-primary flex flex-col rounded-xl border p-6 transition-colors"
              >
                <h3 class="text-foreground mb-2 text-lg font-semibold">
                  {post.data.title}
                </h3>
                <p class="text-muted-foreground text-sm">
                  {post.data.description}
                </p>
                <span class="text-primary mt-4 text-sm font-medium">
                  Read Article →
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }
    <ImpactMetricsSection metrics={metrics} />
    <!-- CTA -->
    <CTASection
      client:visible
      title="Power Your Vision in the Cloud"
      description="Stop settling for standard hosting. Partner with the architects who understand your scale and security requirements."
      buttonText="Schedule a Cloud Strategy Session"
      buttonHref="/contact#chat"
    />
  </main>
  <Footer />
</Layout>
