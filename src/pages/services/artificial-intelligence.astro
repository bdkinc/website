---
import { getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import { ServiceCard, ServiceCardGrid } from '@/components/ServiceCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import NeuralPipeline from '@/components/NeuralPipeline';
import WatsonxSpotlight from '@/components/WatsonxSpotlight';
import WhoThisIsFor from '@/components/WhoThisIsFor';
import { Card } from '@/components/ui/card';
import {
  Sparkles,
  Zap,
  TrendingUp,
  Shield,
  Target,
  BarChart3,
  CheckCircle2,
  FileText,
  Lock,
  Brain,
  Network,
  Workflow,
  Cpu,
  Users,
  LineChart,
  ShieldCheck,
  Search,
  Server
} from 'lucide-react';
import Footer from '@/components/Footer.astro';

const service = await getEntry('services', 'artificial-intelligence');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');

const metrics = [
  { value: '100+', label: 'ENTERPRISE MODELS DEPLOYED', icon: Brain },
  { value: '6 WEEKS', label: 'MVP TO PRODUCTION', icon: Zap },
  { value: '40%', label: 'OPS EFFICIENCY GAIN', icon: TrendingUp },
  { value: '99.9%', label: 'INFERENCE UPTIME', icon: Shield },
];

const faqs = [
  {
    question: "How do you calculate ROI for an AI initiative?",
    answer: "We focus on measurable outcomes: reduced operational costs, increased throughput, or revenue uplift. Our Discovery Phase establishes clear KPIs, ensuring every model deployed drives tangible business value within 3-6 months."
  },
  {
    question: "Is my proprietary data safe when using Generative AI?",
    answer: "Absolutely. We utilize private model instances and RAG (Retrieval-Augmented Generation) architectures where your data is used strictly for context retrieval, never for public model training. Your intellectual property remains isolated and secure."
  },
  {
    question: "Can you integrate AI into our legacy ERP systems?",
    answer: "Yes. Our 'API-first' approach allows us to wrap legacy systems with modern AI interfaces. We can inject predictive insights or automated actions directly into your existing screens and workflows."
  }
];
---

<Layout
  title={`${service.data.title} - BDKinc`}
  description={service.data.description}
>
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="circuit-overlay absolute inset-0 opacity-40"></div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="text-center">
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <h1
            class="mb-6 text-5xl font-bold md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <p
            class="text-muted-foreground mx-auto mb-12 max-w-3xl text-xl"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            {service.data.description}
          </p>
        </div>

        {/* Hero Image Placeholder */}
        <div
          class="fill-mode-both animate-in fade-in zoom-in delay-300 duration-700"
        >
          <div
            class="glass border-primary/20 mx-auto max-w-5xl overflow-hidden rounded-2xl border shadow-lg"
          >
            <div
              class="from-primary/5 via-secondary/5 to-primary/5 flex aspect-video items-center justify-center bg-linear-to-br"
            >
              <div class="text-center">
                <div
                  class="text-muted-foreground/40 mb-2 text-sm font-medium tracking-wider uppercase"
                >
                  Enterprise AI Platform
                </div>
                <div class="text-muted-foreground/60 text-lg">
                  IBM watsonx & Machine Learning Ecosystem
                </div>
                <div class="text-muted-foreground/40 mt-2 text-xs">
                  Recommended: 1400x800px
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--brand-accent]/50"
      >
      </div>
    </section>

    <!-- Content Section -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div
        class="animate-in fade-in slide-in-from-bottom-4 fill-mode-both space-y-12 delay-600 duration-700"
      >
        <div class="mx-auto max-w-7xl">
          <div class="service-content-wrapper">
            <div class="not-prose mx-auto max-w-4xl">
              <h2 class="text-foreground mb-6 text-center text-3xl font-bold">
                Strategic AI Orchestration
              </h2>
              <div
                class="text-muted-foreground mb-10 text-center text-lg leading-relaxed"
              >
                We move beyond hype to deliver engineered intelligence. By leveraging the 
                IBM watsonx platform and advanced machine learning protocols, BDKinc architects 
                AI ecosystems that are secure, governed, and seamlessly integrated into your 
                core infrastructure. We turn unstructured data into decisive strategic advantages.
              </div>
            </div>

            <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
              Core Capabilities
            </h3>

            <ServiceCardGrid client:visible>
              <ServiceCard client:visible>
                <div class="mb-6">
                  <Brain
                    className="text-primary h-16 w-16"
                    aria-hidden="true"
                  />
                </div>
                <h4 class="text-foreground mb-4 text-2xl font-bold">
                  Generative AI & LLMs
                </h4>
                <div class="text-foreground leading-relaxed">
                  Build secure, domain-specific generative models using RAG architectures. 
                  We implement watsonx.ai to ensure your assistants and content engines 
                  are grounded in your proprietary data—never hallucinating, always compliant.
                </div>
              </ServiceCard>

              <ServiceCard client:visible>
                <div class="mb-6">
                  <LineChart
                    className="text-primary h-16 w-16"
                    aria-hidden="true"
                  />
                </div>
                <h4 class="text-foreground mb-4 text-2xl font-bold">
                  Predictive Analytics
                </h4>
                <div class="text-foreground leading-relaxed">
                  Transform historical data into future certainty. Our machine learning models 
                  forecast demand, identify supply chain risks, and optimize resource allocation 
                  with high-precision inference engines running on IBM Power Systems.
                </div>
              </ServiceCard>

              <ServiceCard client:visible>
                <div class="mb-6">
                  <Workflow className="text-primary h-16 w-16" aria-hidden="true" />
                </div>
                <h4 class="text-foreground mb-4 text-2xl font-bold">
                  Intelligent Automation
                </h4>
                <div class="text-foreground leading-relaxed">
                  Embed AI directly into operational workflows. From computer vision for 
                  quality control to NLP for document processing, we automate complex 
                  cognitive tasks to reduce manual overhead and accelerate throughput.
                </div>
              </ServiceCard>
            </ServiceCardGrid>

            {/* Watsonx Integration Spotlight */}
            <WatsonxSpotlight client:visible />

            <h3
              class="text-foreground mt-12 mb-6 text-center text-2xl font-bold"
            >
              Generative AI Solutions
            </h3>

            <div class="not-prose mb-20">
              <p class="text-muted-foreground mb-10 text-center text-xl">
                Enterprise-grade Large Language Models built for business utility
              </p>

              <div class="grid gap-6 md:grid-cols-2">
                <div
                  class="bg-background/50 border-border hover:border-primary flex items-start gap-4 rounded-lg border p-4 transition-colors"
                >
                  <div class="bg-primary mt-2 h-2 w-2 shrink-0 rounded-full">
                  </div>
                  <div>
                    <h5 class="text-foreground mb-1 text-lg font-bold">
                      Custom AI Assistants
                    </h5>
                    <div class="text-muted-foreground text-sm">
                      Deploy intelligent agents trained on your documentation, ensuring accurate, context-aware support for internal teams or customers.
                    </div>
                  </div>
                </div>

                <div
                  class="bg-background/50 border-border hover:border-primary flex items-start gap-4 rounded-lg border p-4 transition-colors"
                >
                  <div class="bg-primary mt-2 h-2 w-2 shrink-0 rounded-full">
                  </div>
                  <div>
                    <h5 class="text-foreground mb-1 text-lg font-bold">
                      Intelligent Document Processing
                    </h5>
                    <div class="text-muted-foreground text-sm">
                      Automate the extraction of critical data from contracts, invoices, and reports with NLP models achieving near-human accuracy.
                    </div>
                  </div>
                </div>

                <div
                  class="bg-background/50 border-border hover:border-primary flex items-start gap-4 rounded-lg border p-4 transition-colors"
                >
                  <div class="bg-primary mt-2 h-2 w-2 shrink-0 rounded-full">
                  </div>
                  <div>
                    <h5 class="text-foreground mb-1 text-lg font-bold">
                      Code Modernization
                    </h5>
                    <div class="text-muted-foreground text-sm">
                      Accelerate development cycles using AI to refactor legacy codebases, generate unit tests, and document complex systems.
                    </div>
                  </div>
                </div>

                <div
                  class="bg-background/50 border-border hover:border-primary flex items-start gap-4 rounded-lg border p-4 transition-colors"
                >
                  <div class="bg-primary mt-2 h-2 w-2 shrink-0 rounded-full">
                  </div>
                  <div>
                    <h5 class="text-foreground mb-1 text-lg font-bold">
                      Content Strategy at Scale
                    </h5>
                    <div class="text-muted-foreground text-sm">
                      Generate high-fidelity technical documentation, marketing copy, and personalized communications with brand-voice alignment.
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
              Predictive Analytics & Machine Learning
            </h3>

            <div class="not-prose mb-20">
              <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
                <div
                  class="bg-background/50 border-border flex flex-col items-center rounded-xl border p-6 text-center"
                >
                  <BarChart3
                    className="text-primary mb-4 h-12 w-12"
                    aria-hidden="true"
                  />
                  <h5 class="text-foreground mb-2 text-lg font-bold">
                    Demand Forecasting
                  </h5>
                  <div class="text-muted-foreground text-sm">
                    Anticipate market shifts with time-series analysis to optimize inventory levels.
                  </div>
                </div>

                <div
                  class="bg-background/50 border-border flex flex-col items-center rounded-xl border p-6 text-center"
                >
                  <Users
                    className="text-primary mb-4 h-12 w-12"
                    aria-hidden="true"
                  />
                  <h5 class="text-foreground mb-2 text-lg font-bold">
                    Churn Prevention
                  </h5>
                  <div class="text-muted-foreground text-sm">
                    Identify behavioral patterns indicating risk and trigger automated retention workflows.
                  </div>
                </div>

                <div
                  class="bg-background/50 border-border flex flex-col items-center rounded-xl border p-6 text-center"
                >
                  <Target
                    className="text-primary mb-4 h-12 w-12"
                    aria-hidden="true"
                  />
                  <h5 class="text-foreground mb-2 text-lg font-bold">
                    Anomaly Detection
                  </h5>
                  <div class="text-muted-foreground text-sm">
                    Real-time monitoring of operational data to flag irregularities in security or production.
                  </div>
                </div>

                <div
                  class="bg-background/50 border-border flex flex-col items-center rounded-xl border p-6 text-center"
                >
                  <Network
                    className="text-primary mb-4 h-12 w-12"
                    aria-hidden="true"
                  />
                  <h5 class="text-foreground mb-2 text-lg font-bold">
                    Logistics Optimization
                  </h5>
                  <div class="text-muted-foreground text-sm">
                    Route optimization and supply chain resilience modeling using graph neural networks.
                  </div>
                </div>
              </div>
            </div>

            <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
              AI Delivery Framework
            </h3>
            
            <div class="not-prose mb-20">
              <NeuralPipeline client:visible />
            </div>

            <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
              Why Choose BDK for AI?
            </h3>

            <div
              class="not-prose mb-20 grid gap-6 md:grid-cols-2 lg:grid-cols-3"
            >
              <Card
                size="default"
                interactive={false}
                className="flex flex-col items-center text-center"
              >
                <div class="mb-4">
                  <ShieldCheck
                    className="text-primary h-10 w-10"
                    aria-hidden="true"
                  />
                </div>
                <h4 class="text-foreground mb-2 text-xl font-bold">
                  Security First
                </h4>
                <div class="text-muted-foreground">
                  Enterprise-grade security controls, encryption, and compliance. Your data never trains public models.
                </div>
              </Card>

              <Card
                size="default"
                interactive={false}
                className="flex flex-col items-center text-center"
              >
                <div class="mb-4">
                  <Zap className="text-primary h-10 w-10" aria-hidden="true" />
                </div>
                <h4 class="text-foreground mb-2 text-xl font-bold">
                  Production-Ready
                </h4>
                <div class="text-muted-foreground">
                  Built for reliability and scale with proper MLOps pipelines, drift detection, and automated retraining.
                </div>
              </Card>

              <Card
                size="default"
                interactive={false}
                className="flex flex-col items-center text-center"
              >
                <div class="mb-4">
                  <Target
                    className="text-primary h-10 w-10"
                    aria-hidden="true"
                  />
                </div>
                <h4 class="text-foreground mb-2 text-xl font-bold">
                  Business-Focused
                </h4>
                <div class="text-muted-foreground">
                  We start with business objectives, not technology. Every model is tied to a measurable KPI.
                </div>
              </Card>

              <Card
                size="default"
                interactive={false}
                className="flex flex-col items-center text-center"
              >
                <div class="mb-4">
                  <FileText
                    className="text-primary h-10 w-10"
                    aria-hidden="true"
                  />
                </div>
                <h4 class="text-foreground mb-2 text-xl font-bold">
                  Transparent & Explainable
                </h4>
                <div class="text-muted-foreground">
                  Glass-box models that are interpretable. We prioritize explainability for informed decision-making.
                </div>
              </Card>

              <Card
                size="default"
                interactive={false}
                className="flex flex-col items-center text-center"
              >
                <div class="mb-4">
                  <Users
                    className="text-primary h-10 w-10"
                    aria-hidden="true"
                  />
                </div>
                <h4 class="text-foreground mb-2 text-xl font-bold">
                  Ongoing Support
                </h4>
                <div class="text-muted-foreground">
                  Continuous monitoring and refinement to ensure your AI systems adapt as your business evolves.
                </div>
              </Card>

              <Card
                size="default"
                interactive={false}
                className="flex flex-col items-center text-center"
              >
                <div class="mb-4">
                  <Cpu className="text-primary h-10 w-10" aria-hidden="true" />
                </div>
                <h4 class="text-foreground mb-2 text-xl font-bold">
                  Infrastructure Expertise
                </h4>
                <div class="text-muted-foreground">
                  Deep expertise in the underlying compute, storage, and networking required to run AI at scale.
                </div>
              </Card>
            </div>
            
            <WhoThisIsFor client:visible />

            <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
              Common Questions
            </h3>
            
            <div class="not-prose mb-20">
              <TechnicalFAQ client:visible faqs={faqs} />
            </div>

          </div>
        </div>
      </div>

      <ImpactMetricsSection metrics={metrics} />

      <CTASection
        client:load
        title="Architect Your AI Future"
        description="Stop experimenting and start scaling. Partner with BDKinc to build secure, governed, and high-impact AI solutions powered by IBM watsonx."
        primaryAction={{
          text: 'Schedule an AI Strategy Session',
          href: '/contact',
        }}
      />
    </section>
  </main>
</Layout>

<Footer />
