---
import { getEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import { ServiceCard, ServiceCardGrid } from '@/components/ServiceCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import { Card } from '@/components/ui/card';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import TechSpecs from '@/components/TechSpecs';
import WhoThisIsFor from '@/components/WhoThisIsFor';
import TechnicalSection from '@/components/TechnicalSection';
import { CornerBrackets } from '@/components/CornerBrackets';
import {
  PiHeadphones,
  PiCheckCircle,
  PiMapPin,
  PiClock,
  PiUsersThree,
  PiShieldCheck,
  PiTrendUp,
  PiLightning,
  PiMonitor,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';

const service = await getEntry('services', 'managed-it');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');

const _serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.title,
  description:
    'Elite managed IT services delivering 24/7 enterprise support, proactive infrastructure management, and strategic technology leadership for growth-focused organizations.',
  provider: {
    '@type': 'Organization',
    name: 'BDKinc',
    url: 'https://www.bdkinc.com',
  },
  serviceType: 'Managed IT Services',
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
  },
};

const relatedPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((post) => post.data.tags?.includes('managed-services'))
  .slice(0, 3);

const metrics = [
  { value: '10K+', label: 'TICKETS CLOSED', icon: PiHeadphones },
  { value: '98%', label: 'FIRST-CALL RESOLUTION', icon: PiCheckCircle },
  { value: '2', label: 'HOUR ONSITE SLA', icon: PiMapPin },
  { value: '24/7', label: 'SUPPORT COVERAGE', icon: PiClock },
];

const faqs = [
  {
    question: "How does BDKinc integrate with our existing internal IT team?",
    answer: "We function as a force multiplier for your internal team. Our Co-Managed IT model handles the heavy lifting of monitoring, patching, and Level 1 support, freeing your internal leaders to focus on high-value strategic initiatives and proprietary business applications."
  },
  {
    question: "What industries do you specialize in supporting?",
    answer: "We specialize in high-complexity, compliance-driven sectors including healthcare, finance, manufacturing, and logistics. Our engineers are well-versed in the regulatory requirements and operational demands of environments where downtime is not an option."
  },
  {
    question: "How do you handle rapid organizational scaling or M&A activity?",
    answer: "Our infrastructure is built for elasticity. We have extensive experience navigating the technical integration of mergers and acquisitions, standardizing disparate systems, and rapidly onboarding new users to ensure business continuity during critical growth phases."
  }
];
---

<Layout
  title="Elite Managed IT Services & Strategic Technology Management | BDKinc"
  description="Transform your technology into a competitive advantage. BDKinc provides elite managed IT services, 24/7 enterprise support, and strategic infrastructure leadership for growth-focused organizations."
  ogDescription="Elite managed IT services delivering 24/7 enterprise support, proactive infrastructure management, and strategic technology leadership for growth-focused organizations."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(_serviceSchema)}
  />
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="circuit-overlay absolute inset-0 opacity-40"></div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="text-center">
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <h1
            class="mb-6 text-5xl font-bold md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <p
            class="text-muted-foreground mx-auto mb-12 max-w-3xl text-xl"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            Technology shouldn't be a bottleneck; it should be an accelerator. We monitor your systems 24/7/365, preventing issues before they disrupt your operations, ensuring your infrastructure is always on, always optimized, and always ready.
          </p>
        </div>

        {/* Hero Image Placeholder */}
        <div
          class="fill-mode-both animate-in fade-in zoom-in delay-300 duration-700"
        >
          <div
            class="glass border-primary/20 mx-auto max-w-5xl overflow-hidden rounded-2xl border shadow-lg"
          >
            <div
              class="from-primary/5 via-secondary/5 to-primary/5 flex aspect-video items-center justify-center bg-linear-to-br"
            >
              <div class="text-center">
                <div
                  class="text-muted-foreground/40 mb-2 text-sm font-medium tracking-wider uppercase"
                >
                  Service Hero Image
                </div>
                <div class="text-muted-foreground/60 text-lg">
                  Managed IT Services Illustration
                </div>
                <div class="text-muted-foreground/40 mt-2 text-xs">
                  Recommended: 1400x800px
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--brand-accent]/50"
      >
      </div>
    </section>

    <!-- Content Section -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div
        class="animate-in fade-in slide-in-from-bottom-4 fill-mode-both space-y-12 delay-600 duration-700"
      >
        <div class="mx-auto max-w-7xl">
          <div class="service-content-wrapper">
            <div class="not-prose mx-auto max-w-4xl">
              <h2 class="text-foreground mb-6 text-center text-3xl font-bold">
                Strategic IT Leadership
              </h2>
              <div
                class="text-muted-foreground mb-10 text-center text-lg leading-relaxed"
              >
                True enterprise growth requires more than just keeping the lights on. It demands a technology strategy that anticipates challenges and scales with your ambition. BDKinc serves as your strategic partner, delivering the technical depth of a global consultancy with the accountability of a dedicated team. We architect, manage, and secure your infrastructure so you can focus on driving your business forward.
              </div>
            </div>

            <h3 class="text-foreground mb-12 text-center text-2xl font-bold font-display uppercase tracking-tight">
              Core Services
            </h3>

            <ServiceCardGrid client:visible>
              <ServiceCard variant="technical" interactive metadata="IT_SERV_01">
                <div class="p-8 flex flex-col items-center text-center h-full">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:scale-110 group-hover:bg-primary/10 transition-all duration-500">
                    <PiHeadphones
                      className="text-primary h-16 w-16"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-4 text-2xl font-bold font-display uppercase tracking-tight group-hover:text-primary transition-colors">
                    Enterprise Service Desk
                  </h4>
                  <div class="text-muted-foreground leading-relaxed text-sm">
                    Beyond basic troubleshooting. Our tiered support structure resolves 98% of incidents on first contact, providing your team with immediate access to senior engineers who understand your specific operational context.
                  </div>
                </div>
              </ServiceCard>

              <ServiceCard variant="technical" interactive metadata="IT_SERV_02">
                <div class="p-8 flex flex-col items-center text-center h-full">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:scale-110 group-hover:bg-primary/10 transition-all duration-500">
                    <PiTrendUp
                      className="text-primary h-16 w-16"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-4 text-2xl font-bold font-display uppercase tracking-tight group-hover:text-primary transition-colors">
                    Predictive Infrastructure Intelligence
                  </h4>
                  <div class="text-muted-foreground leading-relaxed text-sm">
                    We don't just react to alerts; we anticipate failures utilizing advanced telemetry and AI-driven analytics to identify anomalies and remediate performance bottlenecks before they impact your users.
                  </div>
                </div>
              </ServiceCard>

              <ServiceCard variant="technical" interactive metadata="IT_SERV_03">
                <div class="p-8 flex flex-col items-center text-center h-full">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:scale-110 group-hover:bg-primary/10 transition-all duration-500">
                    <PiUsersThree
                      className="text-primary h-16 w-16"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-4 text-2xl font-bold font-display uppercase tracking-tight group-hover:text-primary transition-colors">
                    Strategic Co-Management
                  </h4>
                  <div class="text-muted-foreground leading-relaxed text-sm">
                    Whether acting as your entire IT department or augmenting your internal team, we integrate seamlessly with your workflows, providing specialized expertise in cloud, security, and compliance exactly where you need it.
                  </div>
                </div>
              </ServiceCard>
            </ServiceCardGrid>

            <h3
              class="text-foreground mt-12 mb-12 text-center text-2xl font-bold font-display uppercase tracking-tight"
            >
              The Strategic Advantage of Elite Management
            </h3>

            <div class="not-prose mb-20">
              <p class="text-muted-foreground mb-12 text-center text-xl">
                Move beyond break/fix and operational drag
              </p>

              {/* Feature Image Placeholder */}
              <div class="mb-12 relative group">
                <CornerBrackets client:visible isHovered={true} className="z-30" />
                <div
                  class="glass border-primary/20 mx-auto max-w-3xl overflow-hidden rounded-xl border relative"
                >
                  <div
                    class="from-primary/5 via-secondary/5 to-primary/5 flex aspect-21/9 items-center justify-center bg-linear-to-br"
                  >
                    <div class="p-4 text-center">
                      <div
                        class="text-muted-foreground/40 mb-1 text-xs font-medium tracking-wider uppercase font-mono"
                      >
                        ADVANTAGE_VISUAL_INIT
                      </div>
                      <div class="text-muted-foreground/60 text-sm">
                        Strategic IT Lifecycle Illustration
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="grid gap-6 md:grid-cols-2">
                <ServiceCard variant="technical" interactive={false} metadata="ADV_STRAT_01">
                  <div class="flex items-start gap-4 p-6 group">
                    <div class="bg-primary/5 p-3 rounded-lg border border-primary/20 group-hover:bg-primary/10 transition-colors">
                      <div class="bg-primary h-2 w-2 shrink-0 rounded-full shadow-[0_0_8px_var(--color-primary)]">
                      </div>
                    </div>
                    <div>
                      <h5 class="text-foreground mb-2 text-lg font-bold font-display uppercase tracking-tight group-hover:text-primary transition-colors">
                        Operational Resilience
                      </h5>
                      <div class="text-muted-foreground text-sm leading-relaxed">
                        Systems designed for 99.99% uptime, ensuring your business never pauses.
                      </div>
                    </div>
                  </div>
                </ServiceCard>

                <ServiceCard variant="technical" interactive={false} metadata="ADV_STRAT_02">
                  <div class="flex items-start gap-4 p-6 group">
                    <div class="bg-primary/5 p-3 rounded-lg border border-primary/20 group-hover:bg-primary/10 transition-colors">
                      <div class="bg-primary h-2 w-2 shrink-0 rounded-full shadow-[0_0_8px_var(--color-primary)]">
                      </div>
                    </div>
                    <div>
                      <h5 class="text-foreground mb-2 text-lg font-bold font-display uppercase tracking-tight group-hover:text-primary transition-colors">
                        Scalable Architecture
                      </h5>
                      <div class="text-muted-foreground text-sm leading-relaxed">
                        Infrastructure that adapts instantly to mergers, acquisitions, and rapid user growth.
                      </div>
                    </div>
                  </div>
                </ServiceCard>

                <ServiceCard variant="technical" interactive={false} metadata="ADV_STRAT_03">
                  <div class="flex items-start gap-4 p-6 group">
                    <div class="bg-primary/5 p-3 rounded-lg border border-primary/20 group-hover:bg-primary/10 transition-colors">
                      <div class="bg-primary h-2 w-2 shrink-0 rounded-full shadow-[0_0_8px_var(--color-primary)]">
                      </div>
                    </div>
                    <div>
                      <h5 class="text-foreground mb-2 text-lg font-bold font-display uppercase tracking-tight group-hover:text-primary transition-colors">
                        Cost Predictability
                      </h5>
                      <div class="text-muted-foreground text-sm leading-relaxed">
                        Shift from volatile capital expenditures to predictable, value-driven operational models.
                      </div>
                    </div>
                  </div>
                </ServiceCard>

                <ServiceCard variant="technical" interactive={false} metadata="ADV_STRAT_04">
                  <div class="flex items-start gap-4 p-6 group">
                    <div class="bg-primary/5 p-3 rounded-lg border border-primary/20 group-hover:bg-primary/10 transition-colors">
                      <div class="bg-primary h-2 w-2 shrink-0 rounded-full shadow-[0_0_8px_var(--color-primary)]">
                      </div>
                    </div>
                    <div>
                      <h5 class="text-foreground mb-2 text-lg font-bold font-display uppercase tracking-tight group-hover:text-primary transition-colors">
                        Security Posture
                      </h5>
                      <div class="text-muted-foreground text-sm leading-relaxed">
                        Enterprise-grade defense mechanisms interwoven into daily operations, not bolted on as an afterthought.
                      </div>
                    </div>
                  </div>
                </ServiceCard>
              </div>
            </div>

            <h3 class="text-foreground mb-12 text-center text-2xl font-bold font-display uppercase tracking-tight">
              Key Benefits
            </h3>

            <div
              class="not-prose mb-20 grid gap-6 md:grid-cols-2 lg:grid-cols-3"
            >
              <ServiceCard
                variant="technical"
                interactive={false}
                metadata="CORE_BENEFIT_01"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiClock
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display uppercase tracking-tight">
                    24/7 Availability
                  </h4>
                  <div class="text-muted-foreground text-sm leading-relaxed">
                    Round-the-clock monitoring and support ensures your business
                    never stops
                  </div>
                </div>
              </ServiceCard>

              <ServiceCard
                variant="technical"
                interactive={false}
                metadata="CORE_BENEFIT_02"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiUsersThree
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display uppercase tracking-tight">
                    Expert Support
                  </h4>
                  <div class="text-muted-foreground text-sm leading-relaxed">
                    Access to experienced technicians with diverse technical
                    expertise
                  </div>
                </div>
              </ServiceCard>

              <ServiceCard
                variant="technical"
                interactive={false}
                metadata="CORE_BENEFIT_03"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiShieldCheck
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display uppercase tracking-tight">
                    Security First
                  </h4>
                  <div class="text-muted-foreground text-sm leading-relaxed">
                    Proactive security measures protect your data and systems
                  </div>
                </div>
              </ServiceCard>

              <ServiceCard
                variant="technical"
                interactive={false}
                metadata="CORE_BENEFIT_04"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiTrendUp
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display uppercase tracking-tight">
                    Business Growth
                  </h4>
                  <div class="text-muted-foreground text-sm leading-relaxed">
                    Technology that scales with your business objectives
                  </div>
                </div>
              </ServiceCard>

              <ServiceCard
                variant="technical"
                interactive={false}
                metadata="CORE_BENEFIT_05"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiLightning
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display uppercase tracking-tight">
                    Rapid Response
                  </h4>
                  <div class="text-muted-foreground text-sm leading-relaxed">
                    Quick issue resolution minimizes disruption to your operations
                  </div>
                </div>
              </ServiceCard>

              <ServiceCard
                variant="technical"
                interactive={false}
                metadata="CORE_BENEFIT_06"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiMonitor
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display uppercase tracking-tight">
                    Infrastructure Management
                  </h4>
                  <div class="text-muted-foreground text-sm leading-relaxed">
                    Complete oversight of your IT infrastructure and assets
                  </div>
                </div>
              </ServiceCard>
            </div>

            <TechnicalSection client:visible id="maturity-scale" overlayOpacity="opacity-10">
              <div class="grid items-stretch gap-8 md:grid-cols-2">
                {/* Approach Image Placeholder */}
                <div class="order-2 md:order-1 relative group">
                  <CornerBrackets client:visible isHovered={true} className="z-30" />
                  <div
                    class="glass border-primary/20 overflow-hidden rounded-xl border h-full min-h-[400px] relative"
                  >
                    <div className="scanlines absolute inset-0 opacity-[0.05] pointer-events-none" />
                    <div
                      class="from-primary/5 via-secondary/5 to-primary/5 flex h-full items-center justify-center bg-linear-to-br"
                    >
                      <div class="p-4 text-center">
                        <div
                          class="text-muted-foreground/40 mb-2 text-sm font-medium tracking-wider uppercase font-mono"
                        >
                          ARCHITECTURAL_BLUEPRINT_01
                        </div>
                        <div class="text-muted-foreground/60 text-lg">
                          Workflow Orchestration Diagram
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                {/* Approach Text */}
                <div class="order-1 md:order-2 flex flex-col">
                  <ServiceCard variant="technical" interactive={false} metadata="APPROACH_INTEL">
                    <div
                      class="text-muted-foreground space-y-6 text-lg leading-relaxed p-8"
                    >
                      <p>
                        We reject the "generic" approach to managed services. Your environment is unique, and your support model should be too. We begin with a deep-dive architectural review to align your technology roadmap with your business objectives.
                      </p>
                      <p>
                        Our "Giants in the Toolkit" philosophy leverages the proven reliability of IBM, Microsoft, and Cisco, integrated with our elite service layer. This ensures you benefit from world-class R&D while receiving the personalized attention of a boutique firm.
                      </p>
                      <p>
                        As you scale, we scale. From supporting distributed workforces to managing complex hybrid cloud environments, BDKinc provides the mature operational framework necessary to support an unstoppable enterprise.
                      </p>
                    </div>
                  </ServiceCard>
                </div>
              </div>
            </TechnicalSection>

            <h3 class="text-foreground mb-12 text-center text-2xl font-bold font-display uppercase tracking-tight">
              Service Details
            </h3>

            <TechSpecs />

            <WhoThisIsFor client:visible />

            <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
              Frequently Asked Questions
            </h3>
            <div class="mb-20">
              <TechnicalFAQ faqs={faqs} client:idle />
            </div>
          </div>
        </div>

        <!-- Related Resources -->
        {
          relatedPosts.length > 0 && (
            <section class="mx-auto max-w-5xl">
              <h2 class="text-foreground mb-6 text-center text-3xl font-bold">
                Related Resources
              </h2>
              <div class="grid gap-6 md:grid-cols-3">
                {relatedPosts.map((post) => (
                  <a
                    href={`/blog/${post.slug}`}
                    class="border-border hover:border-primary flex flex-col rounded-xl border p-6 transition-colors"
                  >
                    <h3 class="text-foreground mb-2 text-lg font-semibold">
                      {post.data.title}
                    </h3>
                    <p class="text-muted-foreground text-sm">
                      {post.data.description}
                    </p>
                    <span class="text-primary mt-4 text-sm font-medium">
                      Read Article →
                    </span>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        <ImpactMetricsSection metrics={metrics} />

        <!-- CTA -->
        <CTASection
          client:visible
          title="Power Your Growth with Elite IT"
          description="Stop settling for standard support. Partner with the experts who understand your scale."
          buttonText="Schedule a Strategy Session"
          buttonHref="/contact"
        />
      </div>
    </section>
  </main>

  <Footer />
</Layout>
