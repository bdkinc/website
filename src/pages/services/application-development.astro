---
import { getEntry, getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import { TechCard, TechCardGrid } from '@/components/TechCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import Footer from '@/components/Footer.astro';
import CapabilitiesGrid from '@/components/visualizations/CapabilitiesGrid';
import TechStackShowcase from '@/components/visualizations/TechStackShowcase';
import LifecycleVisualization from '@/components/visualizations/LifecycleVisualization';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import WhoThisIsFor from '@/components/WhoThisIsFor';
import TechnicalSection from '@/components/TechnicalSection';
import ApplicationDevelopmentVisualization from '@/components/visualizations/ApplicationDevelopmentVisualization';
import FeatureCarousel from '@/components/FeatureCarousel';
import {
  PiArrowsClockwise,
  PiNetworkX,
  PiCode,
  PiMedal,
  PiLink,
  PiRocket,
  PiTrendUp,
  PiQuotesFill,
  PiStack,
  PiCheckCircle,
  PiLightning,
  PiShieldCheck,
  PiMonitor,
  PiUsersThree,
} from 'react-icons/pi';
const service = await getEntry('services', 'application-development');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');
const _serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.title,
  description:
    'BDKinc is your full-service development shop for custom software, enterprise integration, and application modernization. Built to power your vision.',
  provider: {
    '@type': 'Organization',
    name: 'BDKinc',
    url: 'https://www.bdkinc.com',
  },
  serviceType: 'Custom Application Development',
  areaServed: ['United States'],
};
const relatedTags = [
  'application-development',
  'software-development',
  'modernization',
];
const relatedPosts = (await getCollection('blog'))
  .filter((post) => {
    const data = post.data as unknown as { tags?: string[]; draft?: boolean };
    if (data.draft) return false;
    return (
      Array.isArray(data.tags) &&
      data.tags.some((tag: string) => relatedTags.includes(tag))
    );
  })
  .slice(0, 3);
const metrics = [
  { value: '250+', label: 'Apps Delivered', icon: PiCode },
  { value: '92%', label: 'Client Retention', icon: PiMedal },
  { value: '60+', label: 'System Integrations', icon: PiLink },
  { value: '45', label: 'Annual Releases', icon: PiRocket },
];
const faqs = [
  {
    question: "How do you ensure the scalability of custom applications?",
    answer: "We design with an 'architecture-first' mindset. By utilizing cloud-native technologies, microservices where appropriate, and robust database optimization (SQL/NoSQL), we ensure your application can handle increased loads and expanding feature sets without performance degradation."
  },
  {
    question: "What is your approach to legacy system modernization?",
    answer: "We prioritize risk mitigation and business continuity. Our team analyzes your existing codebase to identify the best path forward—whether it's refactoring, re-platforming, or a complete rebuild. We ensure that critical business logic is preserved while transitioning you to a modern, secure tech stack."
  },
  {
    question: "Do you provide ongoing support after deployment?",
    answer: "Absolutely. As a full-service partner, we offer comprehensive post-deployment support, including monitoring, security updates, and feature enhancements. Because we can also host what we build, we have full visibility into the application's performance, allowing us to proactively address issues before they impact your business."
  }
];
const strategicFeatures = [
  {
    title: 'Architecture-First Mindset',
    description:
      'Scalable, cloud-native designs that grow with your vision.',
    highlight: 'Architecture-first mindset',
    icon: 'Stack',
    detail:
      "We don't just write code; we architect systems. By utilizing microservices, robust API design, and cloud-native patterns, we ensure your application is built for performance today and massive scale tomorrow.",
  },
  {
    title: 'Modernization Engineering',
    description:
      'Phased upgrades for legacy systems with zero business friction.',
    highlight: 'Zero business friction',
    icon: 'ArrowsClockwise',
    detail:
      "Legacy technical debt shouldn't hold you back. Our engineering teams specialize in the phased modernization of complex enterprise systems, refactoring critical business logic into modern, secure, and maintainable stacks.",
  },
  {
    title: 'Lifecycle Acceleration',
    description:
      'Rapid delivery cycles powered by automated CI/CD and DevOps.',
    highlight: 'Rapid delivery cycles',
    icon: 'Rocket',
    detail:
      "Speed to market is a competitive advantage. We implement end-to-end DevOps automation, ensuring that new features and security patches move from development to production with absolute reliability and speed.",
  },
  {
    title: 'Ecosystem Integration',
    description:
      'Seamlessly connecting disparate platforms into a unified data flow.',
    highlight: 'Unified data flow',
    icon: 'NetworkX',
    detail:
      "In a world of fragmented SaaS and legacy silos, we build the connective tissue. Our integration experts ensure that your data moves securely and reliably between platforms, creating a unified source of truth for your business.",
  },
];
---
<Layout
  title="Custom Application Development & Modernization | BDKinc"
  description="BDKinc is your full-service development shop for custom software, enterprise integration, and application modernization. Built to power your vision."
  ogDescription="BDKinc is your full-service development shop for custom software, enterprise integration, and application modernization. Built to power your vision."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(_serviceSchema)}
  />
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="circuit-overlay absolute inset-0 opacity-40"></div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
          <!-- Badge -->
          <div
            class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
          >
            <div class="flex items-center gap-2 text-sm">
              <span>Engineering <span class="text-accent font-semibold">Excellence</span></span>
            </div>
          </div>
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <!-- Heading -->
          <h1
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold tracking-tight delay-100 duration-700 md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <!-- Subtitle -->
          <p
            class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 mx-auto mb-16 max-w-3xl text-xl leading-relaxed delay-200 duration-700"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            Custom applications and modernization that fit your workflows. 
            BDKinc is your full-service development shop for custom software, 
            enterprise integration, and application modernization.
          </p>
        </div>
        <!-- Visualization -->
        <div
          class="fill-mode-both animate-in fade-in zoom-in delay-300 duration-700"
        >
          <div class="mx-auto max-w-5xl">
            <ApplicationDevelopmentVisualization client:visible />
          </div>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--brand-accent]/50"
      >
      </div>
    </section>
    <!-- Core Services -->
    <section class="bg-muted/30 dark:bg-white/[0.02] px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight normal-case md:text-4xl"
          >
            <span class="text-foreground">Core </span>
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >Capabilities</span
            >
          </h2>
          <p
            class="text-muted-foreground mx-auto mt-4 max-w-2xl font-sans text-xl"
          >
            Engineering enterprise systems designed for the
            <span class="text-accent font-semibold">modern business</span>.
          </p>
        </div>
        <TechCardGrid client:visible className="md:grid-cols-3">
          <TechCard
            variant="technical"
            interactive={true}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiCode
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Custom Applications
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Purpose-built software tailored to your workflows, with 
                automation and reporting that reduce manual steps for teams 
                and improve operational efficiency.
              </div>
            </div>
          </TechCard>
          <TechCard
            variant="technical"
            interactive={true}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiNetworkX
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Enterprise Integration
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Secure integrations that connect legacy platforms, cloud 
                services, and third-party APIs, ensuring your data moves 
                reliably across your entire ecosystem.
              </div>
            </div>
          </TechCard>
          <TechCard
            variant="technical"
            interactive={true}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiArrowsClockwise
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Application Modernization
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Modernize legacy apps with phased upgrades, performance tuning, 
                and security improvements while preserving the core business 
                logic that powers your organization.
              </div>
            </div>
          </TechCard>
        </TechCardGrid>
      </div>
    </section>
    <!-- Strategic Leadership Section -->
    <section class="relative overflow-hidden py-24">
      <div
        class="via-primary/20 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-12 text-center">
          <h2
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-4xl font-bold tracking-tight duration-600 md:text-5xl"
          >
            <span class="text-foreground">Engineering </span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Vision</span
            >
          </h2>
        </div>
        <figure class="relative mx-auto max-w-3xl">
          <PiQuotesFill
            className="text-primary/25 pointer-events-none absolute -top-10 right-0 h-16 w-16"
            aria-hidden="true"
          />
          <blockquote
            class="border-secondary/50 text-muted-foreground border-l-4 pl-6 text-xl leading-relaxed font-light md:text-2xl"
          >
            "Great software isn't just about features; it's about architecture 
            that empowers growth. We build
            <span class="text-accent font-semibold">
              resilient digital foundations</span
            >
            that automate complexity and transform your technology from a 
            cost center into a competitive advantage."
          </blockquote>
        </figure>
      </div>
      <div
        class="via-primary/20 absolute bottom-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
    </section>
    <!-- Strategic Advantage -->
    <section
      class="bg-linear-to-b from-transparent to-muted/20 dark:to-white/[0.02] px-4 py-24 sm:px-6 lg:px-8"
    >
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            The Strategic <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Advantage</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            Move beyond standard development with a partner who builds for 
            enterprise scale and long-term maintainability.
          </p>
        </div>
        <FeatureCarousel client:visible features={strategicFeatures} />
      </div>
    </section>
    <!-- Existing Visualizations Section -->
    <section class="bg-muted/30 dark:bg-white/[0.02] py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <CapabilitiesGrid client:visible />
        <div class="mt-24">
          <TechStackShowcase client:visible />
        </div>
        <div class="mt-24">
          <LifecycleVisualization client:visible />
        </div>
      </div>
    </section>
    <!-- Key Benefits -->
    <section class="bg-muted/20 dark:bg-white/[0.01] px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            Key <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Benefits</span
            >
          </h2>
        </div>
        <div class="grid gap-x-12 gap-y-16 md:grid-cols-2 lg:grid-cols-3">
          <!-- Benefit 1 -->
          <div class="group flex flex-col items-center text-center">
            <PiRocket
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              Rapid Delivery
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Automated CI/CD and DevOps workflows ensure features move from 
              concept to production at peak speed
            </p>
          </div>
          <!-- Benefit 2 -->
          <div class="group flex flex-col items-center text-center">
            <PiStack
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              Scalable Design
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Cloud-native architectures designed to grow seamlessly with your 
              user base and data volume
            </p>
          </div>
          <!-- Benefit 3 -->
          <div class="group flex flex-col items-center text-center">
            <PiShieldCheck
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              Security-First
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Robust security controls and vulnerability scanning integrated 
              directly into the development lifecycle
            </p>
          </div>
          <!-- Benefit 4 -->
          <div class="group flex flex-col items-center text-center">
            <PiMonitor
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              Unified Visibility
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Full-stack monitoring and observability providing real-time 
              insights into application health and performance
            </p>
          </div>
          <!-- Benefit 5 -->
          <div class="group flex flex-col items-center text-center">
            <PiUsersThree
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              Dedicated Teams
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Direct access to specialized engineers who embed with your 
              team to understand and solve business challenges
            </p>
          </div>
          <!-- Benefit 6 -->
          <div class="group flex flex-col items-center text-center">
            <PiLightning
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              Operational Agility
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Agile methodologies that allow for rapid pivoting and 
              iterative improvements based on real-world feedback
            </p>
          </div>
        </div>
      </div>
    </section>
    <TechnicalSection client:visible id="dev-shop-vault" overlayOpacity="opacity-10">
      <div class="relative z-10 flex flex-col items-center text-center">
        <div class="mb-6 flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1">
          <div class="h-2 w-2 animate-pulse rounded-full bg-primary"></div>
          <span class="text-xs font-bold tracking-widest text-primary font-display">BDK Dev Shop Operations</span>
        </div>
        <h3 class="mb-6 max-w-2xl text-3xl font-bold text-foreground font-display tracking-tight">
          Engineering Enterprise Systems. <span class="text-primary">Zero Legacy Friction.</span>
        </h3>
        <div class="mx-auto max-w-4xl text-lg leading-relaxed text-muted-foreground font-sans">
          We help you meet the demands of modern business by automating 
          workflows, connecting disparate data sources, and reducing technical 
          debt. Our full-stack teams own the architecture, delivery, and 
          modernization of your applications end-to-end, ensuring your 
          vision is powered by excellence.
        </div>
      </div>
    </TechnicalSection>
    <WhoThisIsFor client:visible />
    <!-- FAQ -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
          Frequently Asked Questions
        </h3>
        <div class="mb-20">
          <TechnicalFAQ client:visible faqs={faqs} />
        </div>
      </div>
    </section>
    <!-- Related Resources -->
    {
      relatedPosts.length > 0 && (
        <section class="mx-auto max-w-5xl px-4 py-24">
          <h2 class="text-foreground mb-6 text-center text-3xl font-bold">
            Related Insights
          </h2>
          <div class="grid gap-6 md:grid-cols-3">
            {relatedPosts.map((post) => (
              <a
                href={`/blog/${post.slug}`}
                class="border-border hover:border-primary flex flex-col rounded-xl border p-6 transition-colors group"
              >
                <h3 class="text-foreground mb-2 text-lg font-semibold group-hover:text-primary transition-colors">
                  {post.data.title}
                </h3>
                <p class="text-muted-foreground text-sm line-clamp-3">
                  {post.data.description}
                </p>
                <span class="text-primary mt-4 text-sm font-medium flex items-center gap-1">
                  Read Article <PiTrendUp className="h-3 w-3" aria-hidden="true" />
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }
    <ImpactMetricsSection metrics={metrics} />
    <!-- CTA -->
    <CTASection
      client:visible
      title="Build Your Vision with BDK"
      description="Ready to engineer the future of your business? Partner with a development shop that understands enterprise scale."
      buttonText="Start Your Project"
      buttonHref="/contact#chat"
    />
  </main>
  <Footer />
</Layout>
