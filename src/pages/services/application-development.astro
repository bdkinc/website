---
import { getEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import { ServiceCard, ServiceCardGrid } from '@/components/ServiceCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import CapabilitiesGrid from '@/components/visualizations/CapabilitiesGrid';
import TechStackShowcase from '@/components/visualizations/TechStackShowcase';
import LifecycleVisualization from '@/components/visualizations/LifecycleVisualization';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import WhoThisIsFor from '@/components/WhoThisIsFor';
import TechnicalSection from '@/components/TechnicalSection';
import ApplicationDevelopmentVisualization from '@/components/visualizations/ApplicationDevelopmentVisualization';
import {
  PiArrowsClockwise,
  PiNetworkX,
  PiCode,
  PiMedal,
  PiLink,
  PiRocket,
  PiTrendUp,
} from 'react-icons/pi';

const service = await getEntry('services', 'application-development');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');

const _serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.title,
  description:
    'BDKinc is your full-service development shop for custom software, enterprise integration, and application modernization. Built to power your vision.',
  provider: {
    '@type': 'Organization',
    name: 'BDKinc',
    url: 'https://www.bdkinc.com',
  },
  serviceType: 'Custom Application Development',
  areaServed: ['United States'],
};

const relatedTags = [
  'application-development',
  'software-development',
  'modernization',
];

const relatedPosts = (await getCollection('blog'))
  .filter((post) => {
    const data = post.data as unknown as { tags?: string[]; draft?: boolean };
    if (data.draft) return false;
    return (
      Array.isArray(data.tags) &&
      data.tags.some((tag: string) => relatedTags.includes(tag))
    );
  })
  .slice(0, 3);

const metrics = [
  { value: '250+', label: 'APPS DELIVERED', icon: PiCode },
  { value: '92%', label: 'CLIENT RETENTION', icon: PiMedal },
  { value: '60+', label: 'SYSTEM INTEGRATIONS', icon: PiLink },
  { value: '45', label: 'ANNUAL RELEASES', icon: PiRocket },
];

const faqs = [
  {
    question: "How do you ensure the scalability of custom applications?",
    answer: "We design with an 'architecture-first' mindset. By utilizing cloud-native technologies, microservices where appropriate, and robust database optimization (SQL/NoSQL), we ensure your application can handle increased loads and expanding feature sets without performance degradation."
  },
  {
    question: "What is your approach to legacy system modernization?",
    answer: "We prioritize risk mitigation and business continuity. Our team analyzes your existing codebase to identify the best path forward—whether it's refactoring, re-platforming, or a complete rebuild. We ensure that critical business logic is preserved while transitioning you to a modern, secure tech stack."
  },
  {
    question: "Do you provide ongoing support after deployment?",
    answer: "Absolutely. As a full-service partner, we offer comprehensive post-deployment support, including monitoring, security updates, and feature enhancements. Because we can also host what we build, we have full visibility into the application's performance, allowing us to proactively address issues before they impact your business."
  }
];
---

<Layout
  title="Custom Application Development & Modernization | BDKinc"
  description="BDKinc is your full-service development shop for custom software, enterprise integration, and application modernization. Built to power your vision."
  ogDescription="BDKinc is your full-service development shop for custom software, enterprise integration, and application modernization. Built to power your vision."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(_serviceSchema)}
  />
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="circuit-overlay absolute inset-0 opacity-40"></div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="text-center">
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <h1
            class="mb-6 text-5xl font-bold md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <p
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
            class="text-muted-foreground mx-auto mb-12 max-w-3xl text-xl"
          >
            Custom Software Built to Power Your Vision.
          </p>
        </div>

        {/* Hero Visualization */}
        <div
          class="fill-mode-both animate-in fade-in zoom-in delay-300 duration-700"
        >
          <div class="mx-auto max-w-5xl">
            <ApplicationDevelopmentVisualization client:load />
          </div>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--brand-accent]/50"
      >
      </div>
    </section>

    <!-- Content Section -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div
        class="animate-in fade-in slide-in-from-bottom-4 fill-mode-both space-y-12 delay-600 duration-700"
      >
        <div class="mx-auto max-w-7xl">
          <div class="service-content-wrapper">
            <TechnicalSection client:visible id="dev-innovation" overlayOpacity="opacity-10">
              <div class="relative z-10 flex flex-col items-center text-center">
                <div class="mb-6 flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1">
                  <div class="h-2 w-2 animate-pulse rounded-full bg-primary"></div>
                  <span class="text-xs font-bold tracking-widest text-primary font-display uppercase">BDK Dev Shop Operations</span>
                </div>
                
                <h4 class="mb-6 max-w-2xl text-3xl font-bold text-foreground font-display uppercase tracking-tight">
                  Engineering <span class="text-primary">Enterprise Innovation.</span>
                </h4>
                
                <div class="mx-auto max-w-4xl text-lg leading-relaxed text-muted-foreground font-sans">
                  We are more than just developers—we are a <span class="text-primary font-semibold">full-service Dev Shop</span> dedicated to engineering solutions that drive enterprise growth. From robust database architecture to seamless front-end experiences, our full-stack team delivers custom software that solves complex business challenges.
                </div>
              </div>
            </TechnicalSection>

            <WhoThisIsFor client:visible />

            <h3 class="text-foreground mb-12 text-center text-2xl font-bold font-display uppercase tracking-tight">
              Solutions Built for Your Business
            </h3>

            <ServiceCardGrid client:visible>
              <ServiceCard variant="technical" interactive metadata="DEV_SOL_01">
                <div class="p-8 flex flex-col items-center text-center h-full">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:scale-110 group-hover:bg-primary/10 transition-all duration-500">
                    <PiCode
                      className="text-primary h-16 w-16"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-4 text-2xl font-bold font-display uppercase tracking-tight group-hover:text-primary transition-colors">
                    Custom Business Applications
                  </h4>
                  <div class="text-muted-foreground leading-relaxed text-sm">
                    We engineer purpose-built software tailored to your exact operational requirements. Our solutions eliminate inefficiencies, automate complex workflows, and provide a user experience that empowers your workforce to achieve more.
                  </div>
                </div>
              </ServiceCard>

              <ServiceCard variant="technical" interactive metadata="DEV_SOL_02">
                <div class="p-8 flex flex-col items-center text-center h-full">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:scale-110 group-hover:bg-primary/10 transition-all duration-500">
                    <PiNetworkX
                      className="text-primary h-16 w-16"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-4 text-2xl font-bold font-display uppercase tracking-tight group-hover:text-primary transition-colors">
                    Enterprise Integration
                  </h4>
                  <div class="text-muted-foreground leading-relaxed text-sm">
                    Unify your digital ecosystem. We architect secure, high-performance integrations that bridge the gap between legacy systems, modern cloud platforms, and third-party APIs—ensuring your data flows seamlessly across the enterprise.
                  </div>
                </div>
              </ServiceCard>

              <ServiceCard variant="technical" interactive metadata="DEV_SOL_03">
                <div class="p-8 flex flex-col items-center text-center h-full">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:scale-110 group-hover:bg-primary/10 transition-all duration-500">
                    <PiArrowsClockwise
                      className="text-primary h-16 w-16"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-4 text-2xl font-bold font-display uppercase tracking-tight group-hover:text-primary transition-colors">
                    Application Modernization
                  </h4>
                  <div class="text-muted-foreground leading-relaxed text-sm">
                    Future-proof your critical assets. We transform legacy applications into modern, scalable, cloud-native solutions. Our modernization strategies preserve your core business logic while upgrading performance, security, and maintainability.
                  </div>
                </div>
              </ServiceCard>
            </ServiceCardGrid>

            <CapabilitiesGrid client:visible />

            <TechStackShowcase client:visible />

            <LifecycleVisualization client:visible />

            <div class="mx-auto max-w-4xl mt-24 mb-16">
              <h3 class="text-foreground mb-8 text-center text-2xl font-bold">
                Frequently Asked Questions
              </h3>
              <TechnicalFAQ client:visible faqs={faqs} />
            </div>

            {
              relatedPosts.length > 0 && (
                <section class="mx-auto max-w-5xl mt-24">
                  <h2 class="text-foreground mb-6 text-center text-3xl font-bold">
                    Related Insights
                  </h2>
                  <div class="grid gap-6 md:grid-cols-3">
                    {relatedPosts.map((post) => (
                      <a
                        href={`/blog/${post.slug}`}
                        class="border-border hover:border-primary flex flex-col rounded-xl border p-6 transition-colors group"
                      >
                        <h3 class="text-foreground mb-2 text-lg font-semibold group-hover:text-primary transition-colors">
                          {post.data.title}
                        </h3>
                        <p class="text-muted-foreground text-sm line-clamp-3">
                          {post.data.description}
                        </p>
                        <span class="text-primary mt-4 text-sm font-medium flex items-center gap-1">
                          Read Article <PiTrendUp className="h-3 w-3" />
                        </span>
                      </a>
                    ))}
                  </div>
                </section>
              )
            }

            <ImpactMetricsSection metrics={metrics} />

            <CTASection
              client:visible
              title="Build Your Vision with BDK"
              description="Ready to engineer the future of your business? Partner with a development shop that understands enterprise scale."
              buttonText="Start Your Project"
              buttonHref="/contact"
            />
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
