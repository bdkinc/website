---
import { getEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import { TechCard, TechCardGrid } from '@/components/TechCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import { PowerSystemsConsole } from '@/components/PowerSystemsConsole';
import { ModernizationRoadmap } from '@/components/ModernizationRoadmap';
import WhoThisIsFor from '@/components/WhoThisIsFor';
import TechnicalSection from '@/components/TechnicalSection';
import IBMPowerVisualization from '@/components/visualizations/IBMPowerVisualization';
import FeatureCarousel from '@/components/FeatureCarousel';
import {
  PiDesktopTower,
  PiShieldCheck,
  PiUsers,
  PiMedal,
  PiArrowsClockwise,
  PiQuotesFill,
  PiPulse,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';
const service = await getEntry('services', 'ibm-power');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');
const metrics = [
  { value: '500+', label: 'LPARs Managed', icon: PiDesktopTower },
  { value: '99.99%', label: 'Availability Target', icon: PiShieldCheck },
  { value: '24/7', label: 'Operations Coverage', icon: PiArrowsClockwise },
  { value: '30+', label: 'Power Engineers', icon: PiUsers },
];
const faqs = [
  {
    question: "Can you host our IBM i / AS/400 applications without rewriting them?", 
    answer: "Yes. We specialize in 'lift and shift' strategies that move your exact workload to modern hardware without code changes, often improving performance and reliability."
  },
  {
    question: "What is your approach to modernizing green-screen interfaces?",
    answer: "We offer multiple paths, from web-facing refacing tools to developing new API layers that allow modern front-ends (React, Mobile) to interact with your rock-solid backend logic."
  },
  {
    question: "How do you handle Disaster Recovery for IBM i?",
    answer: "We utilize logical replication and hardware-based replication technologies to mirror your system in real-time to our secure datacenters, targeting minute-level RTO/RPOs depending on architecture."
  }
];
const strategicFeatures = [
  {
    title: 'Orchestrated Mastery',
    description:
      'Decades of engineering expertise across AS/400 and iSeries legacy.',
    highlight: '25+ years of mastery',
    icon: 'Medal',
    detail:
      "We don't just support IBM Power; we live it. Our deep bench of engineers spans generations of hardware and software evolution, providing you with the expert-level management required for environments that generalist MSPs won't touch.",
  },
  {
    title: 'Modernization Without Friction',
    description:
      "Zero-code 'lift and shift' strategies for mission-critical workloads.",
    highlight: 'Zero-code modernization',
    icon: 'ArrowsClockwise',
    detail:
      "Your legacy is your foundation, not your limit. We specialize in phased modernization paths that move your exact workloads to modern Power10 hardware or secure cloud instances without requiring a single line of code to be rewritten.",
  },
  {
    title: 'Hybrid Resilience',
    description:
      'Low-latency interconnects between IBM Power and modern x86 cloud.',
    highlight: 'Unified hybrid architecture',
    icon: 'Stack',
    detail:
      "Break down the silos between your rock-solid IBM i backend and your modern web frontends. We architect low-latency private interconnects that allow your modern applications to query legacy databases in real-time, creating a unified, resilient ecosystem.",
  },
  {
    title: 'SLA-Backed Operations',
    description:
      'High-availability targets aligned strictly with business uptime.',
    highlight: '99.99% availability target',
    icon: 'ShieldCheck',
    detail:
      "Downtime isn't just an inconvenience; it's a failure. Our operations are driven by aggressive SLAs and proactive monitoring, utilizing logical and hardware-based replication to ensure your core business systems never blink.",
  },
];
---
<Layout
  title="IBM Power Systems - Managed Hosting & Modernization | BDKinc"
  description="Maximize your AS/400 and iSeries legacy. Premier IBM Power orchestration, managed hosting, and modernization services for high-availability enterprise environments."
>
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="circuit-overlay absolute inset-0 opacity-40"></div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
          <!-- Badge -->
          <div
            class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
          >
            <div class="flex items-center gap-2 text-sm">
              <span>Power Systems <span class="text-accent font-semibold">Experts</span></span>
            </div>
          </div>
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <!-- Heading -->
          <h1
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold tracking-tight delay-100 duration-700 md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <!-- Subtitle -->
          <p
            class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 mx-auto mb-16 max-w-3xl text-xl leading-relaxed delay-200 duration-700"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            Maximize your AS/400 and iSeries legacy. Premier IBM Power 
            orchestration, managed hosting, and modernization services for 
            high-availability enterprise environments.
          </p>
        </div>
        <!-- Visualization -->
        <div
          class="fill-mode-both animate-in fade-in zoom-in delay-300 duration-700"
        >
          <div class="mx-auto max-w-5xl">
            <IBMPowerVisualization client:visible />
          </div>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--brand-accent]/50"
      >
      </div>
    </section>
    <!-- Core Services -->
    <section class="bg-black/20 px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight normal-case md:text-4xl"
          >
            <span class="text-foreground">Infrastructure </span>
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >Control</span
            >
          </h2>
          <p
            class="text-muted-foreground mx-auto mt-4 max-w-2xl font-sans text-xl"
          >
            Expert-level Power Systems management designed for
            <span class="text-accent font-semibold">critical uptime</span>.
          </p>
        </div>
        <PowerSystemsConsole client:load />
      </div>
    </section>
    <!-- Strategic Leadership Section -->
    <section class="relative overflow-hidden py-24">
      <div
        class="via-primary/20 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-12 text-center">
          <h2
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-4xl font-bold tracking-tight duration-600 md:text-5xl"
          >
            <span class="text-foreground">Architectural </span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Legacy</span
            >
          </h2>
        </div>
        <figure class="relative mx-auto max-w-3xl">
          <PiQuotesFill
            className="text-primary/25 pointer-events-none absolute -top-10 right-0 h-16 w-16"
            aria-hidden="true"
          />
          <blockquote
            class="border-secondary/50 text-muted-foreground border-l-4 pl-6 text-xl leading-relaxed font-light md:text-2xl"
          >
            "IBM Power is the heartbeat of the enterprise. We don't just host 
            legacy systems; we architect
            <span class="text-accent font-semibold">
              modernized foundations</span
            >
            that preserve your rock-solid logic while empowering your next 
            decade of business innovation."
          </blockquote>
        </figure>
      </div>
      <div
        class="via-primary/20 absolute bottom-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
    </section>
    <!-- Strategic Advantage -->
    <section
      class="bg-linear-to-b from-transparent to-black/10 px-4 py-24 sm:px-6 lg:px-8"
    >
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            The Strategic <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Advantage</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            Move beyond standard support with a partner who speaks the 
            language of Power Systems.
          </p>
        </div>
        <FeatureCarousel client:visible features={strategicFeatures} />
      </div>
    </section>
    <!-- Roadmap Section -->
    <section class="bg-black/20 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            Modernization <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Roadmap</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            Phased strategies to evolve your core systems without business disruption.
          </p>
        </div>
        <ModernizationRoadmap client:load />
      </div>
    </section>
    <!-- Key Benefits -->
    <section class="bg-black/10 px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            Key <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Benefits</span
            >
          </h2>
        </div>
        <div class="grid gap-x-12 gap-y-16 md:grid-cols-2 lg:grid-cols-3">
          <!-- Benefit 1 -->
          <div class="group flex flex-col items-center text-center">
            <PiMedal
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              25+ Years Mastery
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Decades of deep engineering expertise across IBM hardware and 
              software evolution
            </p>
          </div>
          <!-- Benefit 2 -->
          <div class="group flex flex-col items-center text-center">
            <PiShieldCheck
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              Certified Partner
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              IBM Silver Partner status providing direct access to IBM labs 
              and tier-3 global support
            </p>
          </div>
          <!-- Benefit 3 -->
          <div class="group flex flex-col items-center text-center">
            <PiShieldCheck
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              'Black Box' Expertise
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              We thrive in complex, legacy environments that generalist MSPs 
              simply won't touch
            </p>
          </div>
          <!-- Benefit 4 -->
          <div class="group flex flex-col items-center text-center">
            <PiShieldCheck
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              Enterprise Security
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Hardening and continuous compliance for your most sensitive 
              legacy and modern datasets
            </p>
          </div>
          <!-- Benefit 5 -->
          <div class="group flex flex-col items-center text-center">
            <PiDesktopTower
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              Single Partner
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Unified premier support for IBM i, AIX, and Linux, 
              simplifying your operational complexity
            </p>
          </div>
          <!-- Benefit 6 -->
          <div class="group flex flex-col items-center text-center">
            <PiPulse
              className="text-primary mb-6 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              aria-hidden="true"
            />
            <h4
              class="text-foreground font-display mb-3 text-xl font-bold tracking-tight"
            >
              SLA-Driven
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Operations aligned strictly to business uptime with 
              aggressive resolution targets
            </p>
          </div>
        </div>
      </div>
    </section>
    <!-- Technical Section -->
    <TechnicalSection client:visible id="power-vault" overlayOpacity="opacity-10">
      <div class="relative z-10 flex flex-col items-center text-center">
        <div class="mb-6 flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1">
          <div class="h-2 w-2 animate-pulse rounded-full bg-primary"></div>
          <span class="text-xs font-bold tracking-widest text-primary font-display">IBM Power Command Vault</span>
        </div>
        <h3 class="mb-6 max-w-2xl text-3xl font-bold text-foreground font-display tracking-tight">
          Elite Orchestration. <span class="text-primary">Zero Business Failure.</span>
        </h3>
        <div class="mx-auto max-w-4xl text-lg leading-relaxed text-muted-foreground font-sans">
          Your IBM Power infrastructure is the heartbeat of your enterprise. 
          We combine disciplined operations with modernization where it 
          matters—delivering predictable uptime, controlled costs, and a clear 
          roadmap across IBM i, AIX, VIOS, Red Hat, and Ubuntu.
        </div>
      </div>
    </TechnicalSection>
    <WhoThisIsFor 
      client:visible 
      title="Built for the High-Stakes Enterprise"
      description="Our Power Systems services are engineered for organizations where downtime is not just an inconvenience—it's a critical failure."
    />
    <!-- FAQ -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
          Frequently Asked Questions
        </h3>
        <div class="mb-20">
          <TechnicalFAQ client:visible faqs={faqs} />
        </div>
      </div>
    </section>
    <ImpactMetricsSection metrics={metrics} />
    <!-- CTA -->
    <CTASection
      client:visible
      title="Your Power Systems Deserve Expert Hands"
      description="Don't let your legacy become a liability. Secure, optimize, and modernize your IBM investment with a team that knows it best."
      buttonText="Schedule a Power Assessment"
      buttonHref="/contact#chat"
    />
  </main>
  <Footer />
</Layout>
