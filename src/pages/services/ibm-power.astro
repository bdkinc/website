---
import { getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import { ServiceCard, ServiceCardGrid } from '@/components/ServiceCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import CTASection from '@/components/CTASection';
import { Card } from '@/components/ui/card';
import { PowerSystemsConsole } from '@/components/PowerSystemsConsole';
import { ModernizationRoadmap } from '@/components/ModernizationRoadmap';
import WhoThisIsFor from '@/components/WhoThisIsFor';
import TechnicalSection from '@/components/TechnicalSection';
import { CornerBrackets } from '@/components/CornerBrackets';
import {
  PiDesktopTower,
  PiCloud,
  PiShieldCheck,
  PiUsers,
  PiMedal,
  PiWrench,
  PiArrowsClockwise,
  PiCheckCircle,
  PiTrendUp,
  PiMagnifyingGlass,
  PiLock,
  PiPulse,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';

const service = await getEntry('services', 'ibm-power');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');

const metrics = [
  { value: '500+', label: 'LPARS MANAGED', icon: PiDesktopTower },
  { value: '99.99%', label: 'AVAILABILITY TARGET', icon: PiShieldCheck },
  { value: '24/7', label: 'OPERATIONS COVERAGE', icon: PiArrowsClockwise },
  { value: '30+', label: 'POWER ENGINEERS', icon: PiUsers },
];

const faqs = [
  {
    question: "Can you host our legacy AS/400 applications without rewriting them?",
    answer: "Yes. We specialize in 'lift and shift' strategies that move your exact workload to modern hardware without requiring code changes, instantly improving performance and reliability."
  },
  {
    question: "What is your approach to modernizing green-screen interfaces?",
    answer: "We offer multiple paths, from web-facing refacing tools to developing new API layers that allow modern front-ends (React, Mobile) to interact with your rock-solid backend logic."
  },
  {
    question: "How do you handle Disaster Recovery for IBM i?",
    answer: "We utilize logical replication and hardware-based replication technologies to mirror your system in real-time to our secure datacenters, providing RTOs and RPOs measured in minutes."
  }
];
---

<Layout
  title="IBM Power Systems - Managed Hosting & Modernization | BDKinc"
  description="Maximize your AS/400 and iSeries legacy. Elite IBM Power orchestration, managed hosting, and modernization services for high-availability enterprise environments."
>
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="circuit-overlay absolute inset-0 opacity-40"></div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="text-center">
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4"
            transition:name={`service-icon-${service.id}`}
            transition:animate="initial"
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <h1
            class="mb-6 text-5xl font-bold md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <p
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
            class="text-muted-foreground mx-auto mb-12 max-w-3xl text-xl"
          >
            {service.data.description}
          </p>
        </div>

        {/* Hero Image Placeholder */}
        <div
          class="fill-mode-both animate-in fade-in zoom-in relative delay-300 duration-700"
        >
          <div className="scanlines absolute inset-0 opacity-[0.05] pointer-events-none" />
          <div className="absolute top-0 right-0 h-16 w-16">
            <div className="absolute top-4 right-4 h-px w-8 bg-primary/40" />
            <div className="absolute top-4 right-4 h-8 w-px bg-primary/40" />
          </div>
          <div
            class="glass border-primary/20 mx-auto max-w-5xl overflow-hidden rounded-2xl border shadow-lg"
          >
            <div
              class="from-primary/5 via-secondary/5 to-primary/5 flex aspect-video items-center justify-center bg-linear-to-br"
            >
              <div class="text-center">
                <div
                  class="text-muted-foreground/40 mb-2 text-sm font-medium tracking-wider uppercase font-mono"
                >
                  SYSTEM_DASHBOARD_INIT
                </div>
                <div class="text-muted-foreground/60 text-lg">
                  IBM Power Systems Visualization
                </div>
                <div class="text-muted-foreground/40 mt-2 text-xs font-mono">
                  VERSION 10.4.0
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--brand-accent]/50"
      >
      </div>
    </section>

    <!-- Content Section -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div
        class="animate-in fade-in slide-in-from-bottom-4 fill-mode-both space-y-12 delay-600 duration-700"
      >
        <div class="mx-auto max-w-7xl">
          <div class="service-content-wrapper">
            <TechnicalSection client:visible id="power-orchestration" overlayOpacity="opacity-10">
              <div class="relative z-10 flex flex-col items-center text-center">
                <div class="mb-6 flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1">
                  <div class="h-2 w-2 animate-pulse rounded-full bg-primary"></div>
                  <span class="text-xs font-bold tracking-widest text-primary font-display uppercase">Power Systems Command</span>
                </div>
                
                <h4 class="mb-6 max-w-2xl text-3xl font-bold text-foreground font-display uppercase tracking-tight">
                  Elite IBM Power <span class="text-primary">Orchestration.</span>
                </h4>
                
                <div class="mx-auto max-w-4xl text-lg leading-relaxed text-muted-foreground font-sans">
                  Your IBM Power infrastructure is the heartbeat of your enterprise. From legacy AS/400 
                  and iSeries environments to modern Power10 architectures, BDKinc provides the 
                  expert-level management, modernization, and high-availability hosting.
                </div>
              </div>
            </TechnicalSection>

            <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
              Infrastructure Control Console
            </h3>

            <PowerSystemsConsole client:visible />

            <div class="my-32">
              <ModernizationRoadmap client:visible />
            </div>

            <h3
              class="text-foreground mt-12 mb-12 text-center text-2xl font-bold font-display uppercase tracking-tight"
            >
              Why IBM Power for the Enterprise?
            </h3>

            <div class="not-prose mb-20">
              <p class="text-muted-foreground mb-12 text-center text-xl">
                IBM Power delivers the reliability, security, and scalability
                enterprises require for core business systems across IBM i, AIX,
                and Linux.
              </p>

              {/* Feature Image Placeholder */}
              <div class="mb-12 relative">
                <div className="scanlines absolute inset-0 opacity-[0.03] pointer-events-none" />
                <div
                  class="glass border-primary/20 mx-auto max-w-4xl overflow-hidden rounded-2xl border"
                >
                  <div
                    class="from-primary/5 via-secondary/5 to-primary/5 flex items-center justify-center bg-linear-to-br"
                    style="aspect-ratio: 21/9;"
                  >
                    <div class="text-center">
                      <div
                        class="text-muted-foreground/40 mb-2 text-sm font-medium tracking-wider uppercase font-mono"
                      >
                        CORE_INFRASTRUCTURE
                      </div>
                      <div class="text-muted-foreground/60 text-lg">
                        IBM Power10 Integration
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="grid gap-6 md:grid-cols-2">
                <ServiceCard
                  variant="technical"
                  interactive={false}
                  metadata="POWER_FEAT_01"
                >
                  <div class="flex items-start gap-4 p-6 group">
                    <div class="bg-primary/5 p-3 rounded-lg border border-primary/20 group-hover:bg-primary/10 transition-colors">
                      <PiShieldCheck className="h-6 w-6 text-primary" />
                    </div>
                    <div>
                      <h5 class="text-foreground mb-2 text-lg font-bold font-display uppercase tracking-tight group-hover:text-primary transition-colors">
                        Defense-Grade Security
                      </h5>
                      <div class="text-muted-foreground text-sm leading-relaxed">
                        Power architecture and OS controls reduce attack surface
                        while enabling compliant operations across regulated
                        industries.
                      </div>
                    </div>
                  </div>
                </ServiceCard>

                <ServiceCard
                  variant="technical"
                  interactive={false}
                  metadata="POWER_FEAT_02"
                >
                  <div class="flex items-start gap-4 p-6 group">
                    <div class="bg-primary/5 p-3 rounded-lg border border-primary/20 group-hover:bg-primary/10 transition-colors">
                      <PiTrendUp className="h-6 w-6 text-primary" />
                    </div>
                    <div>
                      <h5 class="text-foreground mb-2 text-lg font-bold font-display uppercase tracking-tight group-hover:text-primary transition-colors">
                        Rock-Solid Uptime
                      </h5>
                      <div class="text-muted-foreground text-sm leading-relaxed">
                        Proven availability for mission-critical ERP, EDI, and
                        analytics workloads with built-in redundancy options.
                      </div>
                    </div>
                  </div>
                </ServiceCard>

                <ServiceCard
                  variant="technical"
                  interactive={false}
                  metadata="POWER_FEAT_03"
                >
                  <div class="flex items-start gap-4 p-6 group">
                    <div class="bg-primary/5 p-3 rounded-lg border border-primary/20 group-hover:bg-primary/10 transition-colors">
                      <PiCloud className="h-6 w-6 text-primary" />
                    </div>
                    <div>
                      <h5 class="text-foreground mb-2 text-lg font-bold font-display uppercase tracking-tight group-hover:text-primary transition-colors">
                        Multi-OS Flexibility
                      </h5>
                      <div class="text-muted-foreground text-sm leading-relaxed">
                        Run IBM i (IBMi), AIX, and enterprise Linux (Red Hat,
                        Ubuntu) side-by-side, optimized on a single platform.
                      </div>
                    </div>
                  </div>
                </ServiceCard>

                <ServiceCard
                  variant="technical"
                  interactive={false}
                  metadata="POWER_FEAT_04"
                >
                  <div class="flex items-start gap-4 p-6 group">
                    <div class="bg-primary/5 p-3 rounded-lg border border-primary/20 group-hover:bg-primary/10 transition-colors">
                      <PiArrowsClockwise className="h-6 w-6 text-primary" />
                    </div>
                    <div>
                      <h5 class="text-foreground mb-2 text-lg font-bold font-display uppercase tracking-tight group-hover:text-primary transition-colors">
                        Future-Ready
                      </h5>
                      <div class="text-muted-foreground text-sm leading-relaxed">
                        Modern capabilities and backward compatibility keep core
                        systems stable while you innovate.
                      </div>
                    </div>
                  </div>
                </ServiceCard>
              </div>
            </div>

            <WhoThisIsFor 
              client:visible 
              title="Built for the High-Stakes Enterprise"
              description="Our Power Systems services are engineered for organizations where downtime is not just an inconvenience—it's a critical failure."
            />

            <h3 class="text-foreground mb-12 text-center text-2xl font-bold font-display uppercase tracking-tight">
              Why <span class="text-primary">BDKinc</span> for IBM
              Power Support
            </h3>

            <div
              class="not-prose mb-20 grid gap-6 md:grid-cols-2 lg:grid-cols-3"
            >
              {[
                {
                  title: "25+ Years of Mastery",
                  desc: "We grew up with this technology. Our deep bench of engineers spans generations of IBM hardware and software evolution.",
                  icon: PiMedal,
                  meta: "POWER_EXP_01"
                },
                {
                  title: "IBM Silver Partner",
                  desc: "Certified excellence. Direct access to IBM labs and support, ensuring you're never alone in a crisis.",
                  icon: PiShieldCheck,
                  meta: "POWER_EXP_02"
                },
                {
                  title: "The 'Black Box' Experts",
                  desc: "We thrive in complex, legacy environments that generalist MSPs won't touch. We speak the language of Power.",
                  icon: PiMagnifyingGlass,
                  meta: "POWER_EXP_03"
                },
                {
                  title: "Enterprise Security",
                  desc: "Hardening and compliance (SOC2, HIPAA) for your most sensitive legacy and modern data.",
                  icon: PiLock,
                  meta: "POWER_EXP_04"
                },
                {
                  title: "Single Partner, Multi-OS",
                  desc: "One elite team for IBM i, AIX, and Linux—simplifying your operational overhead.",
                  icon: PiDesktopTower,
                  meta: "POWER_EXP_05"
                },
                {
                  title: "SLA-Driven",
                  desc: "Operations aligned strictly to your business uptime requirements with aggressive resolution targets.",
                  icon: PiPulse,
                  meta: "POWER_EXP_06"
                }
              ].map((item) => (
                <ServiceCard variant="technical" interactive={false} metadata={item.meta}>
                  <div class="flex flex-col items-center text-center p-8">
                    <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                      <item.icon className="text-primary h-10 w-10" aria-hidden="true" />
                    </div>
                    <h4 class="text-foreground mb-3 text-xl font-bold font-display uppercase tracking-tight">
                      {item.title}
                    </h4>
                    <div class="text-muted-foreground text-sm leading-relaxed">
                      {item.desc}
                    </div>
                  </div>
                </ServiceCard>
              ))}
            </div>

            <TechnicalSection client:visible id="power-approach" overlayOpacity="opacity-10">
              <div class="grid gap-8 md:grid-cols-2">
                {/* Left: Image Placeholder */}
                <div
                  class="glass border-primary/20 overflow-hidden rounded-xl border relative group"
                >
                  <CornerBrackets client:visible isHovered={true} className="z-30" />
                  <div className="scanlines absolute inset-0 opacity-[0.05] pointer-events-none" />
                  <div
                    class="from-primary/5 via-secondary/5 to-primary/5 flex h-full min-h-[300px] items-center justify-center bg-linear-to-br"
                  >
                    <div class="text-center">
                      <div
                        class="text-muted-foreground/40 mb-2 text-sm font-medium tracking-wider uppercase font-mono"
                      >
                        STRATEGY_VISUAL
                      </div>
                      <div class="text-muted-foreground/60 text-lg">
                        IBM Power Management Lifecycle
                      </div>
                    </div>
                  </div>
                </div>

                {/* Right: Text Card */}
                <ServiceCard
                  variant="technical"
                  interactive={false}
                  metadata="APPROACH_SUMMARY"
                >
                  <div class="text-muted-foreground text-lg leading-relaxed p-8 relative z-10">
                    Your IBM Power environment is the backbone of the business. We
                    combine disciplined operations with modernization where it
                    matters—delivering predictable uptime, controlled costs, and a
                    clear roadmap across IBM i (IBMi), AIX, VIOS, Red Hat, and
                    Ubuntu.
                  </div>
                </ServiceCard>
              </div>
            </TechnicalSection>
          </div>
        </div>

        <h3 class="text-foreground mb-6 text-center text-2xl font-bold uppercase tracking-widest text-muted-foreground font-display">
          Common Questions
        </h3>
        <div class="mb-20">
          <TechnicalFAQ client:visible faqs={faqs} />
        </div>

        <ImpactMetricsSection metrics={metrics} />

        <CTASection
          client:load
          title="Your Power Systems deserve elite hands."
          description="Don't let your legacy become a liability. Secure, optimize, and modernize your IBM investment with the experts who know it best."
          primaryAction={{
            text: 'Consult with a Power Architect',
            href: '/contact',
            icon: 'phone',
          }}
        />
      </div>
    </section>
  </main>

  <Footer />
</Layout>
