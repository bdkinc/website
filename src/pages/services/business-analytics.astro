---
import { getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { ServiceCard } from '@/components/ServiceCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import { Card } from '@/components/ui/card';
import DataOrchestrationDashboard from '@/components/DataOrchestrationDashboard';
import AnalyticsLifecycle from '@/components/AnalyticsLifecycle';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import WhoThisIsFor from '@/components/WhoThisIsFor';
import TechnicalSection from '@/components/TechnicalSection';
import {
  PiChartBar,
  PiTrendUp,
  PiClock,
  PiDatabase,
  PiTarget,
  PiCheckCircle,
  PiLayout,
  PiNetwork,
  PiBrain,
  PiShieldCheck,
  PiUsers,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';

const service = await getEntry('services', 'business-analytics');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');

const metrics = [
  { value: '300+', label: 'DASHBOARDS BUILT', icon: PiLayout },
  { value: '80%', label: 'REPORT TIME SAVED', icon: PiClock },
  { value: '200+', label: 'DATA SOURCES LINKED', icon: PiNetwork },
  { value: '99.9%', label: 'DATA ACCURACY', icon: PiTarget },
];

const faqs = [
  {
    question: "How do you ensure data security and compliance across distributed systems?",
    answer: "Security is foundational to our architecture. We implement granular role-based access control (RBAC), end-to-end encryption, and rigorous audit trails to ensure your data ecosystem meets enterprise compliance standards and protects sensitive intelligence."
  },
  {
    question: "Can your solutions integrate with legacy on-premise infrastructure?",
    answer: "Yes. Our data engineering capabilities bridge the gap between legacy silos and modern cloud architectures. We design hybrid integration layers that securely extract value from established systems without disrupting critical operations."
  },
  {
    question: "What is the typical latency for real-time analytics dashboards?",
    answer: "Latency is architected to match operational requirements. For mission-critical streams, we deploy event-driven architectures capable of sub-second processing, while strategic dashboards are optimized for high-performance querying of aggregated datasets."
  }
];
---

<Layout
  title={`${service.data.title} - BDKinc`}
  description="Turn Data into Decisions. Strategic Intelligence at Scale. Transform raw data into competitive advantage with our advanced analytics, predictive modeling, and real-time BI dashboards."
>
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="circuit-overlay absolute inset-0 opacity-40"></div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="text-center">
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <PiChartBar
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <h1
            class="mb-6 text-5xl font-bold md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <p
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
            class="text-muted-foreground mx-auto mb-12 max-w-3xl text-xl"
          >
            Turn Data into Decisions. Strategic Intelligence at Scale.
          </p>
        </div>

        {/* Hero Image Placeholder */}
        <div
          class="fill-mode-both animate-in fade-in zoom-in delay-300 duration-700"
        >
          <div
            class="glass border-primary/20 mx-auto max-w-5xl overflow-hidden rounded-2xl border shadow-lg"
          >
            <div
              class="from-primary/5 via-secondary/5 to-primary/5 flex aspect-video items-center justify-center bg-linear-to-br"
            >
              <div class="text-center">
                <div
                  class="text-muted-foreground/40 mb-2 text-sm font-medium tracking-wider uppercase"
                >
                  Service Hero Image
                </div>
                <div class="text-muted-foreground/60 text-lg">
                  Business Analytics Illustration
                </div>
                <div class="text-muted-foreground/40 mt-2 text-xs">
                  Recommended: 1400x800px
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--brand-accent]/50"
      >
      </div>
    </section>

    <!-- Content Section -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div
        class="animate-in fade-in slide-in-from-bottom-4 fill-mode-both space-y-12 delay-600 duration-700"
      >
        <div class="mx-auto max-w-7xl">
          <div class="service-content-wrapper">
            <TechnicalSection client:visible id="analytics-advantage" overlayOpacity="opacity-10">
              <div class="relative z-10 flex flex-col items-center text-center">
                <div class="mb-6 flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1">
                  <div class="h-2 w-2 animate-pulse rounded-full bg-primary"></div>
                  <span class="text-xs font-bold tracking-widest text-primary font-display uppercase">Analytics Command Center</span>
                </div>
                
                <h4 class="mb-6 max-w-2xl text-3xl font-bold text-foreground font-display uppercase tracking-tight">
                  Turn Data into <span class="text-primary">Actionable Intelligence.</span>
                </h4>
                
                <div class="mx-auto max-w-4xl text-lg leading-relaxed text-muted-foreground font-sans">
                  We architect robust data ecosystems that unify disparate sources into a single source of truth. 
                  From real-time ingestion to predictive modeling, our solutions empower your organization to 
                  navigate complexity with precision and foresight.
                </div>
              </div>
            </TechnicalSection>

            {/* Core Services / Dashboard UI */}
            <DataOrchestrationDashboard client:visible />

            {/* Lifecycle Section */}
            <AnalyticsLifecycle />

            <h3
              class="text-foreground mt-12 mb-12 text-center text-2xl font-bold font-display uppercase tracking-tight"
            >
              Key Benefits
            </h3>

            <div
              class="not-prose mb-20 grid gap-6 md:grid-cols-2 lg:grid-cols-3"
            >
              <ServiceCard
                variant="technical"
                interactive={false}
                metadata="BA_BENEFIT_01"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiClock
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display uppercase tracking-tight">
                    Operational Velocity
                  </h4>
                  <div class="text-muted-foreground text-sm leading-relaxed">
                    Eliminate manual latency with automated report generation
                  </div>
                </div>
              </ServiceCard>

              <ServiceCard
                variant="technical"
                interactive={false}
                metadata="BA_BENEFIT_02"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiShieldCheck
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display uppercase tracking-tight">
                    Data Integrity
                  </h4>
                  <div class="text-muted-foreground text-sm leading-relaxed">
                    Automated validation protocols significantly reduce error rates
                  </div>
                </div>
              </ServiceCard>

              <ServiceCard
                variant="technical"
                interactive={false}
                metadata="BA_BENEFIT_03"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiTarget
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display uppercase tracking-tight">
                    Strategic Precision
                  </h4>
                  <div class="text-muted-foreground text-sm leading-relaxed">
                    Real-time intelligence supports high-stakes decision making
                  </div>
                </div>
              </ServiceCard>

              <ServiceCard
                variant="technical"
                interactive={false}
                metadata="BA_BENEFIT_04"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiTrendUp
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display uppercase tracking-tight">
                    Market Intelligence
                  </h4>
                  <div class="text-muted-foreground text-sm leading-relaxed">
                    Identify and capitalize on emerging patterns earlier
                  </div>
                </div>
              </ServiceCard>

              <ServiceCard
                variant="technical"
                interactive={false}
                metadata="BA_BENEFIT_05"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiUsers
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display uppercase tracking-tight">
                    Performance Transparency
                  </h4>
                  <div class="text-muted-foreground text-sm leading-relaxed">
                    Clear, objective metrics align teams with organizational goals
                  </div>
                </div>
              </ServiceCard>

              <ServiceCard
                variant="technical"
                interactive={false}
                metadata="BA_BENEFIT_06"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiDatabase
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display uppercase tracking-tight">
                    Unified Ecosystem
                  </h4>
                  <div class="text-muted-foreground text-sm leading-relaxed">
                    Seamlessly aggregate data from heterogeneous systems
                  </div>
                </div>
              </ServiceCard>
            </div>

            {/* Who This Is For Section */}
            <WhoThisIsFor client:visible />

            {/* FAQ Section */}
            <div class="not-prose mb-20">
                <h3 class="text-foreground mb-8 text-center text-2xl font-bold">
                  Technical FAQ
                </h3>
                <TechnicalFAQ faqs={faqs} />
            </div>

          </div>
        </div>
      </div>

      <ImpactMetricsSection metrics={metrics} />

      <CTASection
        client:load
        title="The BDK Analytics Advantage"
        description="Our analytics solutions are not standalone silos; they are integral components of the BDK Elite Toolkit. We fuse deep technical expertise with strategic business acumen to deliver systems that are secure, scalable, and seamlessly integrated into your existing infrastructure."
        primaryAction={{
          text: 'Initialize Intelligence Strategy',
          href: '/contact',
        }}
        icon="sparkles"
      />
    </section>
  </main>
</Layout>

<Footer />
