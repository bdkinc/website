---
import { getEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import { TechCard } from '@/components/TechCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import WhoThisIsFor from '@/components/WhoThisIsFor';
import TechnicalSection from '@/components/TechnicalSection';
import { ERPPerformanceConsole } from '@/components/ERPPerformanceConsole';
import { GlobalNetworkMap } from '@/components/GlobalNetworkMap';
import HostedERPVisualization from '@/components/visualizations/HostedERPVisualization';
import {
  PiArrowUp,
  PiDatabase,
  PiHeadphones,
  PiLightning,
  PiGlobe,
  PiStack,
  PiShieldCheck,
  PiTrendUp,
  PiCheckCircle,
  PiLock,
  PiCurrencyDollar,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';

const service = await getEntry('services', 'hosted-erp');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');

// Updated Metrics for "Technical Authority"
const metrics = [
  { value: '99.99%', label: 'SLA Uptime', icon: PiArrowUp },
  { value: 'Sub-ms', label: 'Network Latency', icon: PiLightning },
  { value: 'Tier-3', label: 'Data Centers', icon: PiDatabase },
  { value: '24/7', label: 'NOC Monitoring', icon: PiHeadphones },
];

const detailColumns = [
  {
    title: 'Migration & Onboarding',
    icon: PiArrowUp,
    items: [
      'Comprehensive fit-gap analysis and infrastructure assessment',
      'Parallel sandbox environments for zero-risk data migration',
      'Custom integration mapping for EDI, MES, and WMS endpoints',
    ],
  },
  {
    title: 'Managed Operations',
    icon: PiStack,
    items: [
      'Automated patch management and security hardening',
      'Performance tuning for high-throughput transaction processing',
      'Real-time compliance auditing and immutable log retention',
    ],
  },
];

const faqs = [
  {
    question: "How do you handle migration from legacy on-premise hardware?",
    answer: "We utilize a phased 'lift-and-shift' or 're-platform' methodology. Our engineers perform full system imaging and data verification in a parallel sandbox environment before cutover, ensuring zero data loss and minimal operational downtime."
  },
  {
    question: "Can you support hybrid environments with both cloud and IBM Power Systems?",
    answer: "Yes. Our infrastructure seamlessly integrates IBM Power (AS/400, iSeries) with x86 cloud environments. We establish low-latency private interconnects, allowing modern web applications to query legacy databases in real-time without synchronization lag."
  },
  {
    question: "How is compliance and data sovereignty managed for global operations?",
    answer: "We strictly adhere to GDPR, CCPA, and industry-specific mandates. Data residency controls allow you to lock specific datasets to geographic regions, while our immutable audit logs provide complete transparency for regulatory reporting."
  }
];
---

<Layout
  title={`${service.data.title} - BDKinc`}
  description={service.data.description}
>
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="circuit-overlay absolute inset-0 opacity-40"></div>
       <div class="relative z-10 mx-auto max-w-7xl">
         <div class="mx-auto max-w-4xl text-center">
           <div
             class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
           >
             <span class="text-sm">
               <span class="text-accent font-semibold">BDKinc</span> Service
             </span>
           </div>
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <h1
             class="mb-6 text-5xl font-bold tracking-tight md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground">
              {titleFirst ? `${titleFirst} ` : ''}
            </span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <p
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
            class="text-muted-foreground mx-auto mb-12 max-w-3xl text-xl"
          >
            {service.data.description}
          </p>
        </div>

        {/* Hero Visualization */}
        <div
          class="fill-mode-both animate-in fade-in zoom-in delay-300 duration-700"
        >
          <div class="mx-auto max-w-5xl">
            <HostedERPVisualization client:visible />
          </div>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--brand-accent]/50"
      >
      </div>
    </section>

    <!-- Content Section -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div
        class="animate-in fade-in slide-in-from-bottom-4 fill-mode-both space-y-12 delay-600 duration-700"
      >
        <div class="mx-auto max-w-7xl">
          <div class="service-content-wrapper">
            <TechnicalSection client:visible id="erp-infrastructure" overlayOpacity="opacity-10">
              <div class="relative z-10 flex flex-col items-center text-center">
                <div class="mb-6 flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1">
                  <div class="h-2 w-2 animate-pulse rounded-full bg-primary"></div>
                  <span class="text-xs font-bold tracking-widest text-primary font-display">Enterprise Backbone Operations</span>
                </div>
                
                <h2 class="mb-6 max-w-2xl text-3xl font-bold text-foreground font-display tracking-tight">
                  Advanced ERP <span class="text-primary">Infrastructure Management.</span>
                </h2>
                
                <div class="mx-auto max-w-4xl text-lg leading-relaxed text-muted-foreground font-sans">
                  We deliver precision-engineered hosting environments for mission-critical ERP systems. 
                  Whether you operate Oracle, SAP, Microsoft Dynamics, or custom legacy platforms, 
                  our infrastructure targets sub-millisecond latency and global availability.
                </div>
              </div>
            </TechnicalSection>

            <h3 class="text-foreground mb-12 text-center text-2xl font-bold font-display">
              Core Capabilities
            </h3>

            <div class="mb-24">
              <ERPPerformanceConsole client:visible />
            </div>

            <h3
              class="text-foreground mt-12 mb-12 text-center text-2xl font-bold font-display tracking-tight"
            >
              Enterprise-Grade Capabilities
            </h3>

            <div class="not-prose mb-20">
              <p class="text-muted-foreground mb-12 text-center text-xl">
                Built for security, speed, and sovereignty
              </p>

              {/* Global Network Map */}
              <div class="mb-12">
                <GlobalNetworkMap client:visible />
              </div>

              <div class="grid gap-6 md:grid-cols-3">
                <TechCard
                  variant="technical"
                  interactive={false}
                  metadata="ERP_CAP_01"
                >
                  <div class="flex flex-col items-center text-center p-8">
                    <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                      <PiGlobe
                        className="text-primary h-12 w-12"
                        aria-hidden="true"
                      />
                    </div>
                    <h5 class="text-foreground mb-2 text-lg font-bold font-display tracking-tight">
                      Global Availability
                    </h5>
                    <div class="text-muted-foreground text-sm leading-relaxed">
                      Low-latency edge nodes and redundant failover regions ensuring business continuity.
                    </div>
                  </div>
                </TechCard>

                <TechCard
                  variant="technical"
                  interactive={false}
                  metadata="ERP_CAP_02"
                >
                  <div class="flex flex-col items-center text-center p-8">
                    <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                      <PiStack
                        className="text-primary h-12 w-12"
                        aria-hidden="true"
                      />
                    </div>
                    <h5 class="text-foreground mb-2 text-lg font-bold font-display tracking-tight">
                      Multi-Platform Support
                    </h5>
                    <div class="text-muted-foreground text-sm leading-relaxed">
                      Native support for SAP, Oracle, Microsoft Dynamics, and custom legacy builds.
                    </div>
                  </div>
                </TechCard>

                <TechCard
                  variant="technical"
                  interactive={false}
                  metadata="ERP_CAP_03"
                >
                  <div class="flex flex-col items-center text-center p-8">
                    <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                      <PiShieldCheck
                        className="text-primary h-12 w-12"
                        aria-hidden="true"
                      />
                    </div>
                    <h5 class="text-foreground mb-2 text-lg font-bold font-display tracking-tight">
                      Data Sovereignty
                    </h5>
                    <div class="text-muted-foreground text-sm leading-relaxed">
                      Regional locking and strict compliance adherence for GDPR, CCPA, and industry mandates.
                    </div>
                  </div>
                </TechCard>
              </div>
            </div>

            <h3 class="text-foreground mb-12 text-center text-2xl font-bold font-display tracking-tight">
              Operational Advantages
            </h3>

            <div
              class="not-prose mb-20 grid gap-6 md:grid-cols-2 lg:grid-cols-3"
            >
              <TechCard
                variant="technical"
                interactive={false}
                metadata="ERP_BENEFIT_01"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiTrendUp
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display tracking-tight">
                    Predictable Performance
                  </h4>
                  <div class="text-muted-foreground text-sm leading-relaxed">
                     Provisioned IOPS and throughput targets for data-intensive transaction processing.
                  </div>
                </div>
              </TechCard>

              <TechCard
                variant="technical"
                interactive={false}
                metadata="ERP_BENEFIT_02"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiLightning
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display tracking-tight">
                    Rapid Scalability
                  </h4>
                  <div class="text-muted-foreground text-sm leading-relaxed">
                    Dynamic resource allocation to handle peak loads and seasonal spikes.
                  </div>
                </div>
              </TechCard>

              <TechCard
                variant="technical"
                interactive={false}
                metadata="ERP_BENEFIT_03"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiCheckCircle
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display tracking-tight">
                    Compliance Ready
                  </h4>
                  <div class="text-muted-foreground text-sm leading-relaxed">
                     Infrastructure aligned with SOC 2, HIPAA, and PCI DSS standards.
                  </div>
                </div>
              </TechCard>

              <TechCard
                variant="technical"
                interactive={false}
                metadata="ERP_BENEFIT_04"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiDatabase
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display tracking-tight">
                    Disaster Recovery
                  </h4>
                  <div class="text-muted-foreground text-sm leading-relaxed">
                     Automated snapshots and geo-redundant backups for low RPO/RTO targets.
                  </div>
                </div>
              </TechCard>

              <TechCard
                variant="technical"
                interactive={false}
                metadata="ERP_BENEFIT_05"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiCurrencyDollar
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display tracking-tight">
                    OpEx Efficiency
                  </h4>
                  <div class="text-muted-foreground text-sm leading-relaxed">
                    Shift from heavy CapEx hardware cycles to a predictable monthly operating model.
                  </div>
                </div>
              </TechCard>

              <TechCard
                variant="technical"
                interactive={false}
                metadata="ERP_BENEFIT_06"
              >
                <div class="flex flex-col items-center text-center p-8">
                  <div class="mb-6 p-3 rounded-lg bg-primary/5 border border-primary/20 group-hover:bg-primary/10 transition-colors">
                    <PiLock
                      className="text-primary h-10 w-10"
                      aria-hidden="true"
                    />
                  </div>
                  <h4 class="text-foreground mb-3 text-xl font-bold font-display tracking-tight">
                    Zero Trust Security
                  </h4>
                  <div class="text-muted-foreground text-sm leading-relaxed">
                    Micro-segmentation, encryption at rest/transit, and real-time threat detection.
                  </div>
                </div>
              </TechCard>
            </div>

            <h3 class="text-foreground mb-6 text-center text-2xl font-bold font-display">
              Technical Execution
            </h3>

            <div class="not-prose mb-20 grid gap-8 md:grid-cols-2">
              {
                detailColumns.map((column) => (
                  <div class="glass border-border rounded-2xl border p-8">
                    <div class="mb-6 flex items-center gap-3">
                      <column.icon
                        className="text-primary h-8 w-8"
                        aria-hidden="true"
                      />
                      <h4 class="text-foreground text-2xl font-bold font-display">
                        {column.title}
                      </h4>
                    </div>
                    <div class="text-muted-foreground space-y-3">
                      {column.items.map((item) => (
                        <div class="flex items-start gap-2">
                          <PiCheckCircle
                            className="text-primary mt-1 h-5 w-5 shrink-0"
                            aria-hidden="true"
                          />
                          <span>{item}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                ))
              }
            </div>

            <h3 class="text-foreground mb-6 text-center text-2xl font-bold font-display">
               Frequently Asked Questions
            </h3>
            
            <div class="not-prose mb-20">
               <TechnicalFAQ client:visible faqs={faqs} />
            </div>

            <WhoThisIsFor client:visible />

          </div>
        </div>

        <ImpactMetricsSection metrics={metrics} />

<CTASection
  client:visible
          title="Why Choose BDK for Hosted ERP?"
          description="High-availability SLAs, defense-in-depth security, and specialized expertise in complex ERP ecosystems. We design, migrate, and operate the ERP backbone with measurable outcomes."
          primaryAction={{
            text: 'Schedule ERP Assessment',
            href: '/contact#chat',
            icon: 'arrow',
          }}
        />
      </div>
    </section>
  </main>

  <Footer />
</Layout>
