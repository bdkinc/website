---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation';
import CTASection from '@/components/CTASection';
import { getCollection } from 'astro:content';
import { getNavigationData } from '@/lib/navigation-data';
import Footer from '@/components/Footer.astro';
import { BlogList } from '@/components/BlogList';

const { servicesData, recentPosts } = await getNavigationData();

// Get all blog posts, sorted by date (newest first), exclude drafts
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Calculate read time
const postsWithReadTime = sortedPosts.map((post) => {
  const wordsPerMinute = 200;
  const words = post.body ? post.body.trim().split(/\s+/).length : 0;
  const minutes = Math.ceil(words / wordsPerMinute);
  return {
    ...post,
    readTime: `${minutes} min read`,
  };
});
---

<Layout title="Technical Intelligence - BDKinc">
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="circuit-overlay absolute inset-0 opacity-40"></div>
      <div class="relative z-10 mx-auto max-w-7xl text-center">
        {/* Badge */}
        <div
          class="glass border-primary/20 animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center gap-2 rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
        >
          <div class="h-2 w-2 rounded-full bg-primary animate-pulse"></div>
          <span class="text-sm font-mono tracking-wider">
            SYSTEM STATUS: <span class="font-bold text-primary">ACTIVE</span>
          </span>
        </div>

        <h1
          class="fill-mode-both animate-in fade-in slide-in-from-top-6 mb-6 text-5xl font-bold delay-100 duration-700 md:text-7xl tracking-tight"
        >
          <span class="text-foreground">Technical </span>
          <span class="text-primary"> Intelligence </span>
        </h1>
        <p
          class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-4 mx-auto max-w-3xl text-xl delay-200 duration-600 font-light"
        >
          Deep-dive analysis on infrastructure, security, and enterprise development.
          Authoritative briefings for modern IT decision makers.
        </p>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-px bg-gradient-to-r to-[--brand-accent]/50"
      >
      </div>
    </section>

    <!-- Blog Posts List -->
    <section class="px-4 py-24 sm:px-6 lg:px-8 relative">
      <div class="mx-auto max-w-7xl relative z-10">
        <BlogList client:load posts={postsWithReadTime} />
      </div>
    </section>

    <!-- CTA Section -->
    <CTASection
      client:visible
      title="Require Detailed Analysis?"
      description="Our engineering team provides comprehensive audits and strategic roadmaps tailored to your infrastructure."
      buttonText="Initiate Consultation"
      buttonHref="/contact"
    />
  </main>

  <Footer />
</Layout>
