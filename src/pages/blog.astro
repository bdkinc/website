---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import CTASection from '@/components/CTASection';
import { getCollection } from 'astro:content';
import { getNavigationData } from '@/lib/navigation-data';
import Footer from '@/components/Footer.astro';
import { BlogList } from '@/components/BlogList';
import { PiArrowRight, PiCpu } from 'react-icons/pi';

const { servicesData, recentPosts } = await getNavigationData();


// Get all blog posts, sorted by date (newest first), exclude drafts
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Calculate read time
const postsWithReadTime = sortedPosts.map((post) => {
  const wordsPerMinute = 200;
  const words = post.body ? post.body.trim().split(/\s+/).length : 0;
  const minutes = Math.ceil(words / wordsPerMinute);
  return {
    ...post,
    readTime: `${minutes} min read`,
  };
});

// Separate featured post (latest) from list
const featuredPost = postsWithReadTime[0];
const remainingPosts = postsWithReadTime.slice(1);

---

<Layout title="Technical Intelligence - BDKinc">
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 overflow-hidden">
      <div class="absolute inset-0 gradient-mesh opacity-20" />
      <div class="absolute inset-0 circuit-overlay opacity-30" />

      <div class="relative z-10 max-w-7xl mx-auto text-center px-4">
        <!-- Badge -->
        <div
          class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-8 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
        >
          <div class="text-sm">
            Strategic <span class="text-accent font-semibold">Technical Insights</span>
          </div>
        </div>

        <!-- Title -->
        <h1 class="text-5xl md:text-7xl font-display font-bold tracking-tight mb-6">
          <span class="text-foreground">News & </span>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary">Insights</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-xl text-muted-foreground max-w-2xl mx-auto font-light">
          Technical deep-dives, industry updates, and BDKinc events.
        </p>
      </div>

      <!-- Bottom Ticker Border (Visual only) -->
      <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary/30 to-transparent" />
    </section>

    <!-- Featured Post Section -->
    <section class="relative z-20 border-b border-border/10 bg-card/20">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <a
          href={`/blog/${featuredPost.slug}`}
          class="group relative block overflow-hidden rounded-3xl border border-primary/20 bg-card/40 backdrop-blur-md transition-all duration-500 hover:border-primary/40 hover:bg-card/50"
        >
          <!-- Background Effects -->
          <div
            class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-secondary/5 opacity-50"
          >
          </div>
          <div
            class="absolute -top-20 -right-20 h-96 w-96 rounded-full bg-primary/10 blur-3xl transition-all duration-700 group-hover:bg-primary/20"
          >
          </div>

          <div class="relative z-10 grid gap-8 p-8 md:p-12 lg:grid-cols-2 lg:gap-16">
            <div class="flex flex-col justify-center space-y-6">
              <!-- Meta Badge -->
              <div class="flex items-center gap-4">
                <span
                  class="inline-flex items-center rounded-sm border border-primary/20 bg-primary/5 px-2 py-1 text-xs font-medium text-primary/90"
                >
                  Featured
                </span>
                <span
                  class="text-xs font-medium text-muted-foreground/60"
                >
                  {
                    new Intl.DateTimeFormat('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    }).format(featuredPost.data.pubDate)
                  }
                </span>
              </div>


              <!-- Title -->
              <h2
                class="font-display text-3xl font-bold tracking-tight text-foreground md:text-4xl lg:text-5xl lg:leading-tight"
              >
                {featuredPost.data.title}
              </h2>



              <!-- Description -->
              <p
                class="text-lg leading-relaxed text-muted-foreground md:text-xl"
              >
                {featuredPost.data.description}
              </p>

              <!-- Action -->
              <div class="pt-4">
                <span
                  class="inline-flex items-center gap-2 text-sm font-bold tracking-widest text-primary transition-all group-hover:gap-4"
                >
                  Read Analysis
                  <PiArrowRight className="h-4 w-4" />
                </span>
              </div>

            </div>

            <!-- Abstract Visual / Right Column -->
            <div
              class="relative hidden min-h-[300px] overflow-hidden rounded-xl border border-white/5 bg-black/20 lg:block"
            >
              <!-- Abstract Circuit Pattern or Code Placeholder -->
              <div
                class="absolute inset-0 flex items-center justify-center opacity-30"
              >
                <div class="grid grid-cols-6 gap-4">
                  {
                    Array.from({ length: 24 }).map((_, i) => (
                      <div key={i} class="h-1.5 w-1.5 rounded-full bg-primary/40" />
                    ))
                  }
                </div>
              </div>
              <!-- Large Icon Overlay -->
              <div class="absolute inset-0 flex items-center justify-center">
                <PiCpu className="h-32 w-32 text-primary/20" />
              </div>
            </div>
          </div>
        </a>
      </div>
    </section>

    <!-- Blog Posts List -->
    <section>

      <div class="px-4 py-24 sm:px-6 lg:px-8 relative z-10 mx-auto max-w-7xl">
        <BlogList client:load posts={remainingPosts} />
      </div>
    </section>

    <!-- CTA Section -->
    <CTASection
      client:visible
      title="Require Detailed Analysis?"
      description="Our engineering team provides comprehensive audits and strategic roadmaps tailored to your infrastructure."
      buttonText="Initiate Consultation"
      buttonHref="/contact"
      icon="arrow"
    />

  </main>

  <Footer />
</Layout>
