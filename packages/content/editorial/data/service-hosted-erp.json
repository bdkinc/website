    "strategy": {
      "heading": "The Strategic",
      "headingAccent": "Advantage",
      "body": "Move beyond standard hosting with a partner who specializes in the complexity of enterprise ERP ecosystems.",
      "features": {
        "missionCriticalAvailability": {
          "title": "Mission-Critical Availability",
          "description": "Tier-3 infrastructure targeting 99.99% uptime for core systems.",
          "highlight": "99.99% uptime target",
          "detail": "Your ERP is the backbone of your business. We provide precision-engineered hosting environments with redundant power, cooling, and network paths, ensuring that your mission-critical applications are always available when you need them most."
        },
        "zeroRiskMigration": {
          "title": "Zero-Risk Migration",
          "description": "Phased 'lift-and-shift' methodology with parallel verification.",
          "highlight": "Parallel data verification",
          "detail": "Moving your ERP shouldn't be a gamble. Our engineers perform full system imaging and data verification in parallel sandbox environments before cutover, eliminating migration risk and ensuring a seamless transition with minimal downtime."
        },
        "crossPlatformIntegration": {
          "title": "Cross-Platform Integration",
          "description": "Unified connectivity between IBM Power Systems and x86 cloud.",
          "highlight": "Unified cross-platform connectivity",
          "detail": "Don't let platform silos fragment your operations. We establish low-latency private interconnects between legacy IBM Power environments and modern x86 cloud stacks, allowing for real-time data flow and unified management across your entire estate."
