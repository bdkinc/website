    "faqs": {
      "canYouHostOurIbmIAs": {
        "question": "Can you host our IBM i / AS/400 applications without rewriting them?",
        "answer": "Yes. We specialize in 'lift and shift' strategies that move your exact workload to modern hardware without code changes, often improving performance and reliability."
      },
      "whatIsYourApproachToModernizingGreen": {
        "question": "What is your approach to modernizing green-screen interfaces?",
        "answer": "We offer multiple paths, from web-facing refacing tools to developing new API layers that allow modern front-ends (React, Mobile) to interact with your rock-solid backend logic."
      },
      "howDoYouHandleDisasterRecoveryFor": {
        "question": "How do you handle Disaster Recovery for IBM i?",
        "answer": "We utilize logical replication and hardware-based replication technologies to mirror your system in real-time to our secure datacenters, targeting minute-level RTO/RPOs depending on architecture."
      }
    },
