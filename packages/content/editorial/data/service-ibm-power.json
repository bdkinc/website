  "defaults": {
    "faqHeading": "Frequently Asked Questions",
    "hero": {
      "badgePrefix": "Power Systems",
      "badgeAccent": "Experts",
      "body": "Maximize your AS/400 and iSeries legacy. Premier IBM Power orchestration, managed hosting, and modernization services for high-availability enterprise environments.",
      "backgroundLogo": "/logos/partners/ibm.svg"
    },
    "leadership": {
      "heading": "Architectural",
      "headingAccent": "Legacy",
      "quoteBefore": "“IBM Power is the heartbeat of the enterprise. We don’t just host legacy systems; we architect",
      "quoteAccent": "battle-hardened foundations",
      "quoteAfter": "that preserve your rock-solid logic while empowering your next decade of business innovation.”"
    },
    "strategy": {
      "heading": "The Strategic",
      "headingAccent": "Advantage",
      "body": "Move beyond standard support with a partner who speaks the language of Power Systems.",
      "features": {
        "orchestratedMastery": {
          "title": "Orchestrated Mastery",
          "description": "Decades of engineering expertise across AS/400 and iSeries legacy.",
          "highlight": "25+ years of mastery",
          "detail": "We don't just support IBM Power; we live it. Our deep bench of engineers spans generations of hardware and software evolution, providing you with the expert-level management required for environments that generalist MSPs won't touch."
        },
        "modernizationWithoutFriction": {
          "title": "Modernization Without Friction",
          "description": "Zero-code 'lift and shift' strategies for mission-critical workloads.",
          "highlight": "Zero-code modernization",
          "detail": "Your legacy is your foundation, not your limit. We specialize in phased modernization paths that move your exact workloads to modern Power10 hardware or secure cloud instances without requiring a single line of code to be rewritten."
        },
        "hybridResilience": {
          "title": "Hybrid Resilience",
          "description": "Low-latency interconnects between IBM Power and modern x86 cloud.",
          "highlight": "Unified hybrid architecture",
          "detail": "Break down the silos between your rock-solid IBM i backend and your modern web frontends. We architect low-latency private interconnects that allow your modern applications to query legacy databases in real-time, creating a unified, resilient ecosystem."
        },
        "slaBackedOperations": {
          "title": "SLA-Backed Operations",
          "description": "High-availability targets aligned strictly with business uptime.",
          "highlight": "99.99% availability target",
          "detail": "Downtime isn't just an inconvenience; it's a failure. Our operations are driven by aggressive SLAs and proactive monitoring, utilizing logical and hardware-based replication to ensure your core business systems never blink."
        }
      }
    },
    "infrastructure": {
      "heading": "Infrastructure",
      "headingAccent": "Control",
      "bodyBefore": "Expert-level Power Systems management designed for",
      "bodyAccent": "critical uptime",
      "bodyAfter": ".",
      "services": {
        "managedHosting": {
          "title": "Managed Hosting",
          "desc": "Secure, scalable hosting for IBM i, AIX, and Linux with 99.99% availability.",
          "tag": "Core"
        },
        "modernization": {
          "title": "Modernization",
          "desc": "RPG/COBOL modernization and integration with modern API-driven workflows.",
          "tag": "Innovate"
        },
        "disasterRecovery": {
          "title": "Disaster Recovery",
          "desc": "Real-time replication and rapid recovery protocols for business continuity.",
          "tag": "Protect"
        },
        "performanceTuning": {
          "title": "Performance Tuning",
          "desc": "Deep-layer optimization of CPW, memory, and I/O for peak efficiency.",
          "tag": "Optimize"
        },
        "osLifecycle": {
          "title": "OS Lifecycle",
          "desc": "Precision management of version upgrades, PTFs, and security patches.",
          "tag": "Manage"
        },
        "hybridIntegration": {
          "title": "Hybrid Integration",
          "desc": "Connecting Power workloads with Azure, AWS, and modern cloud stacks.",
          "tag": "Scale"
        }
      }
    },
    "roadmap": {
      "heading": "Modernization",
      "headingAccent": "Roadmap",
      "body": "Phased strategies to evolve your core systems without business disruption.",
      "steps": {
        "legacyFoundation": {
          "title": "Legacy Foundation",
          "description": "Stabilize AS/400 & iSeries workloads. Hardware refresh, OS upgrades, and security hardening."
        },
        "hybridIntegration": {
          "title": "Hybrid Integration",
          "description": "Connect legacy data to modern workflows. REST APIs, cloud connectors, and bi-directional sync."
