    "hero": {
      "badgePrefix": "Trading Partner Network —",
      "badgeAccent": "Live",
      "body": "Orchestrate global EDI with a managed platform that keeps partners connected, documents flowing, and transactions visible in real time."
    },
    "capabilities": {
      "heading": "Core",
      "headingAccent": "Capabilities",
      "bodyBefore": "Comprehensive document orchestration designed for the",
      "bodyAccent": "modern supply chain",
      "bodyAfter": ".",
      "globalIntegration": {
        "title": "Global Integration",
        "description": "Rapidly onboard retailers, suppliers, and 3PLs across any region. We maintain certified maps for thousands of trading partners, ensuring effortless compliance."
      },
      "automatedWorkflows": {
        "title": "Automated Workflows",
        "description": "Eliminate manual intervention. Automate POs, invoices, and ASNs to reduce manual errors and accelerate your order-to-cash cycles."
      },
      "agnosticProtocol": {
        "title": "Agnostic Protocol",
        "description": "Secure transmission across AS2, SFTP, FTPS, and VAN. Our architecture adapts to your partners' technical constraints seamlessly."
      }
    },
    "leadership": {
      "heading": "Supply Chain",
      "headingAccent": "Orchestration",
      "quoteBefore": "“Commerce moves at the speed of data. We don’t just connect systems; we architect",
      "quoteAccent": "zero-friction, real-time document orchestration",
      "quoteAfter": "that ensures compliance and powers your global supply chain with 24/7 visibility.”"
    },
    "strategy": {
      "heading": "The Strategic",
      "headingAccent": "Advantage",
      "body": "Move beyond simple connections with a partner who orchestrates enterprise-grade supply chain intelligence.",
      "features": {
        "supplyChainOrchestration": {
          "title": "Supply Chain Orchestration",
          "description": "Synchronized document flow across global partner networks.",
          "highlight": "Synchronized document flow",
          "detail": "Modern commerce is a precision game. We orchestrate your entire supply chain data flow, ensuring that orders, invoices, and shipping updates move instantly between you and your trading partners with zero manual friction."
        },
        "protocolAgnosticIntegration": {
          "title": "Protocol Agnostic Integration",
          "description": "Secure transmission across AS2, SFTP, FTPS, and VAN networks.",
          "highlight": "Secure transmission",
          "detail": "Don't let your partners' technical constraints slow you down. Our architecture acts as a universal translator, adapting to any protocol or standard (ANSI X12, EDIFACT, XML) while maintaining a clean, consistent interface for your internal systems."
        },
        "highVelocityThroughput": {
          "title": "High-Velocity Throughput",
          "description": "Elastic infrastructure designed for peak enterprise transaction volumes.",
          "highlight": "Peak transaction volumes",
          "detail": "Built on elastic cloud infrastructure, our platform automatically scales to handle your most demanding spikes—whether it's seasonal retail surges or rapid market expansion—ensuring consistent throughput and zero message loss."
        },
        "complianceContinuity": {
          "title": "Compliance Continuity",
          "description": "Certified maps and active monitoring for thousands of trading partners.",
          "highlight": "Certified partner maps",
          "detail": "We maintain a massive library of certified trading partner maps and actively monitor for mandate changes. This means you stay compliant with major retailers like Walmart, Amazon, and Target without ever touching a line of code."
        }
      }
