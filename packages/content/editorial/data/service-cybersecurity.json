  "defaults": {
    "faqHeading": "Frequently Asked Questions",
    "hero": {
      "badgePrefix": "24/7 Threat",
      "badgeAccent": "Protection",
      "body": "Fortified security for a complex world. Enterprise-grade threat resilience, managed detection and response, and rigorous compliance engineering for high-stakes environments."
    },
    "capabilities": {
      "heading": "Core",
      "headingAccent": "Capabilities",
      "bodyBefore": "Comprehensive security management designed for the",
      "bodyAccent": "modern enterprise",
      "bodyAfter": ".",
      "managedDetection": {
        "title": "Managed Detection & Response",
        "description": "24/7/365 surveillance of your entire digital estate. Our SOC analysts leverage advanced telemetry to detect anomalies, investigate threats, and neutralize attacks before they impact operations."
      },
      "ransomwareDefense": {
        "title": "Ransomware Defense",
        "description": "Zero-trust architecture combined with immutable backups. We implement rigorous prevention strategies and rapid recovery protocols to ensure business continuity in the face of extortion attempts."
      },
      "complianceEngineering": {
        "title": "Compliance Engineering",
        "description": "We don't just consult on compliance; we engineer it. Our team implements the technical controls required for HIPAA, PCI DSS, SOC 2, and NIST frameworks to prepare you for audits."
      }
    },
    "leadership": {
      "heading": "Security",
      "headingAccent": "Leadership",
      "quoteBefore": "“In an era of sophisticated attacks, reactive security is failure. We architect",
      "quoteAccent": "proactive resilience",
      "quoteAfter": "into every layer of your digital estate, ensuring your data is protected and your operations are audit-ready 24/7.”"
    },
    "strategy": {
      "heading": "The Strategic",
      "headingAccent": "Advantage",
      "body": "Move beyond antivirus and basic firewalls with a partner who builds defense-in-depth security architectures.",
      "features": {
        "adaptiveThreatIntelligence": {
          "title": "Adaptive Threat Intelligence",
          "description": "Real-time defense that evolves with the threat landscape.",
          "highlight": "Real-time defense",
          "detail": "We don't just react to known threats; we use advanced telemetry and global intelligence feeds to anticipate and block emerging attack vectors before they reach your network."
        },
        "zeroTrustArchitecture": {
          "title": "Zero-Trust Architecture",
          "description": "Verify every user and device, every time, regardless of location.",
          "highlight": "Verify every user",
          "detail": "Our security models are built on the principle of 'never trust, always verify.' We implement robust identity management and micro-segmentation to prevent lateral movement within your infrastructure."
        },
        "complianceEngineering": {
          "title": "Compliance Engineering",
          "description": "Automating evidence collection and technical controls for rigorous audits.",
          "highlight": "Automating evidence collection",
          "detail": "We map your technical controls directly to HIPAA, PCI, and SOC 2 frameworks, turning compliance from a yearly burden into a continuous, automated property of your IT operations."
        },
        "resilientRecovery": {
          "title": "Resilient Recovery",
          "description": "Immutable backups and rapid containment protocols to neutralize ransomware.",
          "highlight": "Immutable backups",
          "detail": "In the event of an incident, our rapid-response protocols isolate threats instantly while our immutable backup systems ensure you can restore operations without paying a ransom."
