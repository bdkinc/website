  "defaults": {
    "faqHeading": "Frequently Asked Questions",
    "hero": {
      "badgePrefix": "Actionable",
      "badgeAccent": "Intelligence",
      "body": "Turn Data into Decisions. Strategic Intelligence at Scale. We architect robust data ecosystems that unify disparate sources into a single source of truth."
    },
    "leadership": {
      "heading": "Strategic",
      "headingAccent": "Intelligence",
      "quoteBefore": "“Data without direction is overhead. We transform raw telemetry into",
      "quoteAccent": "actionable foresight",
      "quoteAfter": ", aligning your entire organization around a single source of objective truth that drives actual business value.”"
    },
    "strategy": {
      "heading": "The Strategic",
      "headingAccent": "Advantage",
      "body": "Move beyond static reports with a partner who builds high-performance data ecosystems.",
      "features": {
        "orchestratedIntelligence": {
          "title": "Orchestrated Intelligence",
          "description": "Unifying disparate data sources into a single source of truth.",
          "highlight": "Single source of truth",
          "detail": "We architect data ecosystems that break down operational silos. By orchestrating data from across your enterprise into a unified plane, we ensure that your analytics are based on a consistent, governed, and accurate foundation."
        },
        "predictiveForesight": {
          "title": "Predictive Foresight",
          "description": "Moving beyond historical reporting to forward-looking insights.",
          "highlight": "Forward-looking insights",
          "detail": "Don't just react to what happened yesterday. Our predictive modeling capabilities identify emerging market trends and operational risks before they manifest, allowing you to navigate complexity with proactive precision."
        },
        "realTimeVelocity": {
          "title": "Real-Time Velocity",
          "description": "High-performance data pipelines for sub-second operational awareness.",
          "highlight": "Sub-second awareness",
          "detail": "In high-stakes environments, latency is a liability. We build event-driven architectures that process and visualize critical data streams in real-time, providing your leadership with the velocity required to make split-second decisions."
        },
        "strategicTransparency": {
          "title": "Strategic Transparency",
          "description": "Objective performance metrics aligned with organizational goals.",
          "highlight": "Performance alignment",
          "detail": "Align your entire team around objective truth. Our strategic dashboards translate complex datasets into clear, actionable KPIs, ensuring that every level of your organization is focused on the metrics that drive actual business value."
        }
      }
    },
