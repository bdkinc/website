PAYLOAD_SECRET=replace-with-a-long-random-secret
DATABASE_URI=mongodb://127.0.0.1:27017/bdkinc_cms
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
FRONTEND_URL=http://localhost:4321
PORT=3001
SEED_ON_INIT=true

# Rebuild webhook called by Payload on publish/update
SITE_REBUILD_WEBHOOK_URL=http://localhost:4321/api/rebuild
SITE_REBUILD_WEBHOOK_SECRET=change-me
SITE_REBUILD_WEBHOOK_SECRET_HEADER=x-rebuild-secret
SITE_REBUILD_WEBHOOK_TIMEOUT_MS=5000

# Protects manual CMS endpoint POST /api/ops/trigger-rebuild
CMS_OPS_SECRET=change-me

# One-time admin bootstrap command
CMS_ADMIN_EMAIL=admin@bdkinc.com
CMS_ADMIN_PASSWORD=change-this-password
