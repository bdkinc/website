{
  "name": "@bdkinc/cms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run generate:importmap",
    "dev": "node ./scripts/dev.mjs",
    "prebuild": "npm run generate:importmap",
    "build": "next build",
    "prestart": "npm run generate:importmap",
    "start": "next start -p 3001",
    "generate:importmap": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload generate:importmap",
    "types": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload generate:types",
    "seed": "tsx src/scripts/seed.ts",
    "bootstrap:admin": "tsx src/scripts/bootstrapAdmin.ts"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "^3.69.0",
    "@payloadcms/next": "^3.69.0",
    "@payloadcms/richtext-lexical": "^3.69.0",
    "dotenv": "^16.6.1",
    "graphql": "^16.12.0",
    "next": "^15.5.3",
    "payload": "^3.69.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
