MYSQL_ROOT_PASSWORD=CHANGE-ME
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=CHANGE-ME

WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080
FRONTEND_URL=http://localhost:4321
# Optional temporary apps/design-editorial and apps/design-systems; omit in production.
BDK_PREVIEW_EDITORIAL_URL=http://localhost:4322
BDK_PREVIEW_SYSTEMS_URL=http://localhost:4323

AUTH_KEY=CHANGE-ME
SECURE_AUTH_KEY=CHANGE-ME
LOGGED_IN_KEY=CHANGE-ME
NONCE_KEY=CHANGE-ME
AUTH_SALT=CHANGE-ME
SECURE_AUTH_SALT=CHANGE-ME
LOGGED_IN_SALT=CHANGE-ME
NONCE_SALT=CHANGE-ME

WP_DEBUG=true
WP_ENVIRONMENT_TYPE=local

WP_ADMIN_USER=admin
WP_ADMIN_PASS=CHANGE-ME
WP_ADMIN_EMAIL=dev@example.com

# Marketer login. Generated app passwords live in ignored scripts/.local files.
WP_EDITOR_USER=marketer
WP_EDITOR_PASS=CHANGE-ME
WP_EDITOR_EMAIL=marketer@example.com
# Production: an actual host/CI deployment URL. Blank means not configured.
BDK_DEPLOY_HOOK_URL=
BDK_DEPLOY_HOOK_TOKEN=
BDK_PREVIEW_SECRET=CHANGE-ME
