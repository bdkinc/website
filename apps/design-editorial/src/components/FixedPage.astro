---
import Hero from '@/components/Hero.astro';
import CopySection from '@/components/CopySection.astro';
import CallToAction from '@/components/CallToAction.astro';
import EditorialIcon from '@/components/EditorialIcon.astro';
import { serviceIcons } from '@/lib/service-icons';
import { object, text, heading, body, records, type Copy } from '@/lib/copy';
import type { ContentReader } from '@bdkinc/content/reader';
import type { PageData, SiteSettings } from '@bdkinc/content';
import ContactChat from '@bdkinc/design-system/contact-chat';
interface Props { pageKey: string; copy: Copy; source: ContentReader; settings: SiteSettings }
const { pageKey, copy, source, settings } = Astro.props;
const hero = object(copy.hero);
const legal = pageKey === 'privacy' || pageKey === 'terms';
const sections = legal ? Object.entries(copy).filter(([key])=>!['metadata','hero','contents'].includes(key)) : [];
const services = pageKey === 'services' || pageKey.startsWith('location-') ? await source.getCollection('services') : [];
const posts = pageKey === 'blog' ? await source.getCollection('blog') : [];
const locations = pageKey.startsWith('location-') ? (await source.getCollection('locations')).filter(l=>l.data.state===(pageKey.includes('maryland')?'Maryland':'Delaware')) : [];
const contact = object(copy.directContact);
const story = object(copy.foundingStory);
const aboutPartners = pageKey === 'about' ? await source.getCollection('partners') : [];
const chat = object(copy.chat);
const chatSuggestions = pageKey === 'contact' ? Object.values(object(chat.pageFallbackSuggestions)).map(text) : [];
const notFound = object(copy.error);
const featuredCities = object(copy.featuredCities);
---
<Hero title={pageKey==='not-found'?text(notFound.heading):heading(hero)} description={pageKey==='not-found'?text(notFound.description):pageKey==='contact'?body(contact):body(hero)} eyebrow={pageKey==='not-found'?'404':[hero.badge || hero.badgeLead || hero.badgePrefix,hero.badgeAccent,hero.badgeEnd].map(text).join(' ')} />
{hero.updatedDate && <p class="wrap updated">{text(hero.updatedLabel)} {text(hero.updatedDate)}</p>}
{pageKey === 'not-found' && <div class="wrap recovery"><a class="button" href="/">{text(notFound.homeText)}</a><a class="text-link" href="/services">{settings.navigation.services}</a></div>}
{pageKey === 'services' && <section class="wrap service-index"><p class="section-label"><span>01</span>Services</p><div class="service-rows has-icons">{services.sort((a,b)=>a.data.order-b.data.order).map((service,i)=>{const icon = serviceIcons[service.id];return <a href={`/services/${service.id}`}><span class="item-number">{String(i+1).padStart(2,'0')}</span><h2>{icon && <span class="service-icon"><EditorialIcon name={icon} /></span>}{service.data.title}</h2><p>{service.data.description}</p><span class="row-arrow" aria-hidden="true">›</span></a>})}</div></section>}
{pageKey === 'blog' && <section class="wrap article-index"><p class="section-label"><span>01</span>Articles</p>{posts.sort((a,b)=>b.data.pubDate.getTime()-a.data.pubDate.getTime()).map(post=><article><div class="article-date"><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</time><span>{post.data.category}</span></div><div>{post.data.image && <img src={post.data.image} alt="" width="960" height="540" loading="lazy" />}<h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2><p>{post.data.description}</p><a class="text-link" href={`/blog/${post.id}`}>{text(object(copy.posts).readAction)} <span class="more-arrow" aria-hidden="true">›</span></a></div></article>)}</section>}
{pageKey === 'contact' && <div class="wrap contact-desk">
  <section class="contact-chat-section" id="chat" aria-label={text(chat.sectionLabel)}><p class="section-label"><span>01</span>Assistant</p><div class="contact-chat-scope"><div class="contact-chat"><ContactChat client:only="react" initialSuggestions={chatSuggestions} copy={copy.chat as PageData<'contact'>['chat']} /></div></div></section>
  <section class="contact-directory" aria-labelledby="contact-directory-heading"><p class="section-label"><span>02</span>Directory</p><h2 id="contact-directory-heading">{heading(contact)}</h2><div>{['phone','email','headquarters'].map(key=>{const item=object(contact[key]);return <article><p class="field-label">{text(item.label)}</p><h3><a href={text(item.linkUrl || item.mapUrl)}>{text(item.value || item.location)}</a></h3><p>{text(item.availability || item.description || item.address)}</p></article>})}</div></section>
</div>}
{legal && <div class="wrap legal-layout"><nav aria-label={text(object(copy.contents).heading)}><h2>{text(object(copy.contents).heading)}</h2>{sections.map(([key,value])=><a href={`#${key}`}>{heading(value)}</a>)}</nav><div class="prose">{sections.map(([key,value])=>{const section=object(value);return <section id={key}><h2>{heading(section)}</h2>{Object.entries(section).filter(([k,v])=>typeof v==='string'&&!['heading','organization','email','phone','emailUrl','phoneUrl','emailLabel','phoneLabel'].includes(k)).map(([,v])=><p>{text(v)}</p>)}{section.organization && <p>{text(section.organization)}</p>}{section.emailUrl && <p><a href={text(section.emailUrl)}>{text(section.emailLabel)} {text(section.email)}</a></p>}{section.phoneUrl && <p><a href={text(section.phoneUrl)}>{text(section.phoneLabel)} {text(section.phone)}</a></p>}</section>})}</div></div>}
{pageKey === 'about' && <>
  {hero.image && <figure class="wrap feature-image"><img src={text(hero.image)} alt={text(hero.imageAlt)} width="1200" height="675" /></figure>}
  <section class="copy-section wrap story"><p class="section-label"><span>01</span>Story</p><h2>{heading(story)}</h2><div>{['origin','partnership','today'].map(key=>{const p=object(story[key]);return <p>{text(p.beforeEmphasis)} <strong>{text(p.emphasis)}</strong> {text(p.afterEmphasis)}</p>})}{story.image && <img src={text(story.image)} alt={text(story.imageAlt)} width="960" height="540" loading="lazy" />}</div></section>
  <div class="wrap two-col mission"><p class="section-label"><span>02</span>Mission</p>{['mission','vision'].map(key=><section><h2>{heading(copy[key])}</h2><p>{body(copy[key])}</p></section>)}</div>
  <CopySection copy={copy.values} label={{ number: '03', text: 'Values' }} />
  <section class="copy-section wrap"><p class="section-label"><span>04</span>Journey</p><h2>{heading(copy.journey)}</h2><div class="timeline">{records(copy.journey).map(item=><article><span>{text(item.year)}</span><div><h3>{text(item.title)}</h3><p>{text(item.description)}</p></div></article>)}</div></section>
  <section class="copy-section wrap"><p class="section-label"><span>05</span>Partners</p><h2>{heading(copy.partners)}</h2><div class="partners">{aboutPartners.filter(p=>p.data.showOnAbout).map(p=><article>{p.data.logo&&<img src={p.data.logo} alt={p.data.name} width="140" height="64" loading="lazy" />}<h3>{p.data.name}</h3><p>{p.data.description}</p><p>{p.data.detail}</p></article>)}</div></section>
</>}
{pageKey.startsWith('location-') && <>
  <section class="copy-section wrap"><p class="section-label"><span>01</span>Cities</p><h2>{heading(copy.featuredCities)}</h2><div class="location-index">{locations.map(location=><a href={`/services/managed-it/${location.id}`}><h3>{location.data.name}</h3><p>{[location.data.counties?.join(', ') ?? '', text(featuredCities.countySeparator)].filter(Boolean).join(' ')}</p><span>{text(featuredCities.linkText).replace(/→|↗/g, '›')}</span></a>)}</div></section>
  <section class="copy-section wrap"><p class="section-label"><span>02</span>Services</p><h2>{heading(copy.servicesByLocation)}</h2><div class="two-col">{['managedServices','focusAreas'].map(key=>{const section=object(object(copy.servicesByLocation)[key]);return <article><h3>{heading(section)}</h3><ul>{Object.entries(section).filter(([name])=>name!=='heading').map(([,value])=><li>{text(value)}</li>)}</ul></article>})}</div></section>
  <section class="copy-section wrap"><p class="section-label"><span>03</span>Locations</p><h2>{heading(copy.serviceLocations)}</h2>{services.map(service=><details class="location-services"><summary>{service.data.title}</summary><div class="link-cloud">{locations.map(location=><a href={`/services/${service.id}/${location.id}`}>{location.data.name}</a>)}</div></details>)}</section>
</>}
{copy.cta && <CallToAction copy={copy.cta} settings={settings} />}

<style>
  .story > .section-label,
  .mission > .section-label { grid-column: 1 / -1; }
  .service-rows.has-icons h2 { display: flex; align-items: center; gap: .875rem; }
  .service-rows.has-icons .service-icon { display: inline-flex; flex-shrink: 0; color: var(--ink); }
  .service-rows.has-icons .service-icon svg { display: block; width: 24px; height: 24px; }
  .service-rows.has-icons a:hover .service-icon { color: var(--cyan); }
  .article-index > article { grid-template-columns: 1fr 1fr; gap: 5rem; }
  .article-index .more-arrow { color: var(--muted); }
  /* Services index: symmetric outer tracks with intro-scale gutters, so the
     description column starts on the site-wide text axis (second column of
     .section-intro). Scoped to this component, so home rows are unaffected. */
  @media (min-width: 681px) {
    .service-index .service-rows > a { grid-template-columns: 2.5rem 1fr 1fr 2.5rem; column-gap: 5rem; }
  }
  @media (min-width: 681px) and (max-width: 1000px) {
    .service-index .service-rows > a { column-gap: 2rem; }
  }
  @media (max-width: 1000px) {
    .article-index > article { gap: 2rem; }
  }
  @media (max-width: 680px) {
    .article-index > article { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
