---
import Hero from '@/components/Hero.astro';
import HeroGeometry from '@/components/HeroGeometry';
import CallToAction from '@/components/CallToAction.astro';
import EditorialIcon, { type IconName } from '@/components/EditorialIcon.astro';
import { serviceIcons } from '@/lib/service-icons';
import type { ContentReader } from '@bdkinc/content/reader';
import type { SiteSettings } from '@bdkinc/content';
interface Props { source: ContentReader; settings: SiteSettings }
const { source, settings } = Astro.props;
const [copy, services, partners, testimonials, posts] = await Promise.all([source.getPage('home'), source.getCollection('services'), source.getCollection('partners'), source.getCollection('testimonials'), source.getCollection('blog')]);
services.sort((a,b) => a.data.order-b.data.order);
const why = [
  { copy: copy.whyUs.response, icon: 'lightning' },
  { copy: copy.whyUs.expertise, icon: 'medal' },
  { copy: copy.whyUs.service, icon: 'handshake' },
] satisfies { copy: typeof copy.whyUs.response; icon: IconName }[];
const practices: { key: string; title: string; intro: string; ids: string[] }[] = [
  { key: 'infrastructure', title: 'Infrastructure & Operations', intro: 'Keep systems running, protected and supported.', ids: ['managed-it', 'cybersecurity', 'cloud-hosting'] },
  { key: 'platforms', title: 'Business Platforms', intro: 'Run and modernize business-critical systems.', ids: ['ibm-power', 'hosted-erp', 'edi-solutions'] },
  { key: 'software', title: 'Software & Data', intro: 'Build software and turn data into decisions.', ids: ['application-development', 'business-analytics', 'artificial-intelligence'] },
];
const serviceById = new Map(services.map((service) => [service.id, service]));
const unmapped = services.filter((service) => !practices.some((practice) => practice.ids.includes(service.id)));
const practiceGroups = practices.map((practice, index) => ({
  ...practice,
  number: String(index + 1).padStart(2, '0'),
  items: [
    ...practice.ids.map((id) => serviceById.get(id)).filter((service) => service !== undefined),
    ...(index === practices.length - 1 ? unmapped : []),
  ],
}));
const metrics = [
  [String(new Date().getFullYear()-copy.hero.experienceStartYear)+copy.hero.yearsSuffix, copy.hero.yearsLabel],
  [String(copy.hero.clients)+copy.hero.clientsSuffix, copy.hero.clientsLabel],
  [`${copy.hero.supportHours}${copy.hero.supportSeparator}${copy.hero.supportDays}`, copy.hero.supportLabel],
];
---
<div class="home-hero">
  <div aria-hidden="true"><HeroGeometry client:idle /></div>
  <Hero title={copy.hero.heading} description={copy.hero.body} eyebrow={copy.hero.badge} home>
    <div class="hero-actions">
      <a class="button" href={copy.hero.primaryCTALink}>
        {copy.hero.primaryCTAText}
      </a>
      <a class="text-link" href={copy.hero.secondaryCTALink}>
        {copy.hero.secondaryCTAText}
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v16m-6-6 6 6 6-6" /></svg>
      </a>
    </div>
  </Hero>
  <dl class="home-metrics wrap">{metrics.map(([value,label]) => <div><dt>{value}</dt><dd>{label}</dd></div>)}</dl>
</div>
<section class="wrap service-index home-service-index"><p class="home-label"><span>01</span>Services</p><div class="section-intro"><h2>{copy.services.headingLead} {copy.services.headingAccent}</h2><p>{copy.services.bodyLead} <strong>{copy.services.bodyAccent}</strong> {copy.services.bodyEnd}</p></div><div class="practice-grid">{practiceGroups.map((practice) => <section class="practice" aria-labelledby={`practice-${practice.key}`}><header class="practice-head"><span class="item-number">{practice.number}</span><h3 id={`practice-${practice.key}`}>{practice.title}</h3><p>{practice.intro}</p></header><div class="service-rows home-services">{practice.items.map((service) => {
  const icon = serviceIcons[service.id];
  return <a href={`/services/${service.id}`} data-editorial-reveal>{icon && <span class="service-icon"><EditorialIcon name={icon} /></span>}<h4>{service.data.title}</h4><p>{service.data.description}</p><span class="row-arrow" aria-hidden="true">›</span></a>;
})}</div></section>)}</div></section>
<section class="copy-section wrap"><p class="home-label"><span>02</span>Why BDK</p><div class="section-intro"><h2>{copy.whyUs.headingLead} {copy.whyUs.brandLead}{copy.whyUs.brandEnd}</h2><p>{copy.whyUs.bodyLead} {copy.whyUs.bodyAccent}{copy.whyUs.bodyEnd}</p></div><div class="three-col home-benefits">{why.map((item,i) => <article data-editorial-reveal><div class="benefit-marker"><span class="item-number">{String(i+1).padStart(2,'0')}</span><EditorialIcon name={item.icon} /></div><h3>{item.copy.title}</h3><p>{item.copy.description}</p><p>{item.copy.detail}</p></article>)}</div></section>
<section class="copy-section wrap home-testimonials"><p class="home-label"><span>03</span>Testimonials</p><div class="section-intro"><h2>{copy.testimonials.headingLead} {copy.testimonials.headingAccent}</h2><p>{copy.testimonials.bodyLead} {copy.testimonials.bodyAccent} {copy.testimonials.bodyEnd}</p></div><div class="rail-controls" hidden><p class="rail-count" aria-live="polite"><span>01</span> / {String(testimonials.length).padStart(2, '0')}</p><button type="button" class="rail-btn" data-rail-prev aria-label="Previous testimonial">‹</button><button type="button" class="rail-btn" data-rail-next aria-label="Next testimonial">›</button></div><div class="quotes home-rail" role="region" aria-label="Testimonials" tabindex="0">{testimonials.map(item => <figure><blockquote>{item.data.quote}</blockquote><figcaption>{item.data.author}<span>{item.data.company} · {item.data.industry}</span></figcaption></figure>)}</div></section>
<section class="copy-section wrap"><p class="home-label"><span>04</span>Partners</p><div class="section-intro"><h2>{copy.trust.headingLead} {copy.trust.headingAccent}</h2><p>{copy.trust.bodyLead} {copy.trust.bodyAccent} {copy.trust.bodyEnd}</p></div><div class="partners">{partners.sort((a,b)=>(a.data.order||0)-(b.data.order||0)).map(partner => <div>{partner.data.logo && <img src={partner.data.logo} alt={partner.data.name} width="140" height="64" loading="lazy" />}<h3>{partner.data.name}</h3><p>{partner.data.description}</p></div>)}</div></section>
<section class="copy-section wrap"><p class="home-label"><span>05</span>Blog</p><div class="section-intro"><h2>{settings.navigation.recentPosts}</h2><a class="text-link" href="/blog">{settings.navigation.allPosts}</a></div><div class="three-col home-blog">{posts.slice(0,3).map(post => <article><p class="eyebrow">{post.data.category}</p><h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3><p>{post.data.description}</p></article>)}</div></section>
<CallToAction settings={settings} />

<script>
  const observer = new IntersectionObserver((entries) => {
    const entering = entries.filter(entry => entry.isIntersecting && entry.intersectionRatio >= 0.25);
    entering.forEach((entry, index) => {
      const element = entry.target as HTMLElement;
      element.style.setProperty('--reveal-delay', `${Math.min(index, 3) * 60}ms`);
      element.classList.replace('is-waiting', 'is-entered');
      observer.unobserve(element);
    });
  }, { threshold: 0.25, rootMargin: '0px 0px -48px 0px' });
  document.querySelectorAll('[data-editorial-reveal]').forEach(element => {
    element.classList.add('is-waiting');
    observer.observe(element);
  });
  document.querySelectorAll('.home-testimonials').forEach((section) => {
    const rail = section.querySelector('.home-rail');
    const controls = section.querySelector('.rail-controls');
    if (!(rail instanceof HTMLElement) || !(controls instanceof HTMLElement)) return;
    controls.removeAttribute('hidden');
    const prev = controls.querySelector('[data-rail-prev]');
    const next = controls.querySelector('[data-rail-next]');
    const current = controls.querySelector('.rail-count > span');
    const cards = Array.from(rail.querySelectorAll('figure'));
    const pad = (value: number) => String(value).padStart(2, '0');
    const firstVisible = () => {
      const railLeft = rail.getBoundingClientRect().left;
      for (let i = 0; i < cards.length; i += 1) {
        if (cards[i].getBoundingClientRect().left >= railLeft - 4) return i;
      }
      return Math.max(cards.length - 1, 0);
    };
    const snapLeft = (index: number) => {
      const first = cards[0];
      const target = cards[Math.max(0, Math.min(index, cards.length - 1))];
      if (!first || !target) return rail.scrollLeft;
      return target.offsetLeft - first.offsetLeft;
    };
    const update = () => {
      const atEnd = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 4;
      const index = atEnd ? Math.max(cards.length - 1, 0) : firstVisible();
      const label = pad(index + 1);
      if (current && current.textContent !== label) current.textContent = label;
      if (prev instanceof HTMLButtonElement) prev.disabled = rail.scrollLeft <= 4;
      if (next instanceof HTMLButtonElement) next.disabled = atEnd;
    };
    if (prev instanceof HTMLButtonElement) prev.addEventListener('click', () => rail.scrollTo({ left: snapLeft(firstVisible() - 1), behavior: 'auto' }));
    if (next instanceof HTMLButtonElement) next.addEventListener('click', () => rail.scrollTo({ left: snapLeft(firstVisible() + 1), behavior: 'auto' }));
    let ticking = false;
    rail.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { update(); ticking = false; });
    }, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

<style is:global>
  .hero-home, .home-hero, .home-services, .home-benefits {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
  }
  .hero-home .hero-bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }
  .hero-home .hero-actions {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    gap: .75rem 1.75rem;
    min-width: 0;
    margin-top: 0;
  }
  .hero-home .hero-actions .button {
    justify-content: center;
    gap: 1rem;
    min-height: 52px;
    padding: .875rem 1.375rem;
    border-radius: 4px;
    font-size: .875rem;
  }
  .hero-home .hero-actions .text-link {
    justify-content: flex-start;
    gap: .625rem;
    min-height: 48px;
    border: 0;
    color: var(--muted);
    font-size: .875rem;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }
  .hero-home .hero-actions .text-link:hover,
  .hero-home .hero-actions .text-link:focus-visible {
    color: var(--ink);
    text-decoration-line: underline;
  }
  .hero-home .hero-actions svg { flex-shrink: 0; }
  .service-icon {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--ink);
  }
  .service-icon svg { display: block; }
  .home-services a:focus-visible .service-icon { color: var(--cyan); }
  .home-services a .row-arrow { transition: none; }
  .home-services a:hover .row-arrow { transform: none; }
  .home-benefits .benefit-marker {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.8rem;
    color: var(--ink);
  }
  .home-benefits .benefit-marker .item-number { margin: 0; }
  .home-benefits .benefit-marker svg { width: 32px; height: 32px; }

  @media (hover: hover) and (pointer: fine) {
    .home-services a:hover .service-icon { color: var(--cyan); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-home .hero-bottom > .lead {
      animation: editorial-reveal 600ms var(--ease-out) 80ms both;
    }
    .hero-home .hero-actions {
      animation: editorial-reveal 600ms var(--ease-out) 160ms both;
    }
    .hero-home .hero-actions:focus-within { animation: none; }
    .home-benefits > .is-waiting,
    .home-services > .is-waiting .service-icon {
      opacity: 0;
      transform: translateY(8px);
    }
    .home-benefits > .is-entered,
    .home-services > .is-entered .service-icon {
      animation: editorial-reveal 600ms var(--ease-out) var(--reveal-delay, 0ms) both;
    }
    .home-services > a:focus-visible .service-icon {
      opacity: 1;
      transform: none;
      animation: none;
    }
    @media (hover: hover) and (pointer: fine) {
      .home-services a .row-arrow { transition: transform 160ms var(--ease-out); }
      .home-services a:hover .row-arrow { transform: translateX(2px); }
    }
  }
  @keyframes editorial-reveal {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  @media (max-width: 680px) {
    .home-services .service-icon svg { width: 24px; height: 24px; }
    .home-benefits .benefit-marker { margin-bottom: 1rem; }
  }
</style>
