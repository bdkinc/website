---
import type { SiteSettings } from '@bdkinc/content';
import '@/styles/editorial.css';
import BrandLogo from '@/components/BrandLogo.astro';
import type { ContentReader } from '@bdkinc/content/reader';
interface Props { source: ContentReader; settings: SiteSettings; title: string; description?: string; path: string; preview?: boolean }
const { source, settings: s, title, description = s.defaultDescription, path, preview } = Astro.props;
const isServices = path === '/services' || path.startsWith('/services/');
const isBlog = path === '/blog' || path.startsWith('/blog/');
const svcEntries = (await source.getCollection('services')).sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
const practices = [
  { key: 'infrastructure', title: 'Infrastructure & Operations', ids: ['managed-it', 'cybersecurity', 'cloud-hosting'] },
  { key: 'platforms', title: 'Business Platforms', ids: ['ibm-power', 'hosted-erp', 'edi-solutions'] },
  { key: 'software', title: 'Software & Data', ids: ['application-development', 'business-analytics', 'artificial-intelligence'] },
];
const svcById = new Map(svcEntries.map((service) => [service.id, service]));
const recentPosts = (await source.getCollection('blog')).sort((a, b) => {
  const ta = a.data.pubDate instanceof Date ? a.data.pubDate.getTime() : 0;
  const tb = b.data.pubDate instanceof Date ? b.data.pubDate.getTime() : 0;
  return tb - ta;
}).slice(0, 5);
const groups = practices.map((practice, index) => ({
  ...practice,
  number: String(index + 1).padStart(2, '0'),
  items: practice.ids.flatMap((id) => {
    const service = svcById.get(id);
    return service ? [service] : [];
  }),
}));
---
<!doctype html>
<html lang="en">
  <head>
    {import.meta.env.DEV && <link rel="stylesheet" href="/virtual:stylex.css" />}
    {import.meta.env.DEV && <script is:inline type="module" src="/@id/virtual:stylex:runtime"></script>}
    {!import.meta.env.DEV && (
      <link
        rel="stylesheet"
        href={`${import.meta.env.BASE_URL}assets/stylex.css`}
      />
    )}
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
    <title>{title}</title><meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" /><meta name="referrer" content="no-referrer" />
    <link rel="canonical" href={new URL(path, 'https://www.bdkinc.com').href} />
    <link rel="icon" href={s.brand.favicon} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const preference = window.matchMedia('(prefers-color-scheme: dark)');
        let saved;
        try { saved = localStorage.getItem('theme'); } catch {}
        let explicit = saved === 'light' || saved === 'dark';
        const apply = (dark) => {
          root.dataset.theme = dark ? 'dark' : 'light';
          const button = document.querySelector('[data-theme-toggle]');
          if (button) {
            button.setAttribute('aria-checked', String(dark));
          }
        };
        apply(explicit ? saved === 'dark' : preference.matches);
        preference.addEventListener('change', (event) => {
          if (!explicit) apply(event.matches);
        });
        document.addEventListener('DOMContentLoaded', () => {
          apply(root.dataset.theme === 'dark');
          document.querySelector('[data-theme-toggle]').addEventListener('click', () => {
            apply(root.dataset.theme !== 'dark');
            explicit = true;
            try { localStorage.setItem('theme', root.dataset.theme); } catch {}
          });
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="review-bar">
      <span>Editorial concept · Local design review</span>
      <span class="review-note">{preview ? 'Private copy preview' : s.footer.signature}</span>
      <button class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Dark mode" title="Toggle light and dark mode" data-theme-toggle>
        <span class="theme-track" aria-hidden="true">
          <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="3.5" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 13.2A8.5 8.5 0 0 1 10.8 3.5a8.5 8.5 0 1 0 9.7 9.7Z" /></svg>
        </span>
      </button>
    </div>
    <div class="site-header-bar" data-menu-root><header class="site-header wrap">
      <a class="wordmark" href="/" aria-label={s.navigation.homeLabel}>{s.brand.logo ? <img src={s.brand.logo} alt={s.brand.logoAlt} width="140" height="42" /> : <BrandLogo label={s.brand.logoAlt} />}</a>
      <nav aria-label="Main navigation">
        <a href="/about" aria-current={path === '/about' ? 'page' : undefined}>{s.navigation.about}</a>
        <a href="/services" data-svc-link aria-haspopup="true" aria-expanded="false" aria-controls="mega-panel" aria-current={isServices ? 'page' : undefined}><span>{s.navigation.services}</span><svg class="svc-caret" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" /></svg></a>
        <a href="/blog" data-blog-link aria-haspopup="true" aria-expanded="false" aria-controls="blog-panel" aria-current={isBlog ? 'page' : undefined}><span>{s.navigation.blog}</span><svg class="svc-caret" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" /></svg></a>
      </nav>
      <a class="contact-link" href={s.navigation.contactHref}>{s.navigation.contact}</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-panel" aria-label="Menu" data-menu-toggle>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M3 7h18M3 12h18M3 17h18" /></svg>
      </button>
    </header>
      <div class="mega" id="mega-panel" hidden data-mega>
        <div class="wrap mega-inner">
          <div class="mega-grid">
            {groups.map((group) => (
              <section aria-labelledby={`mega-${group.key}`}>
                <p class="mega-kicker" id={`mega-${group.key}`}><span>{group.number}</span>{group.title}</p>
                <ul>
                  {group.items.map((service) => (
                    <li><a href={`/services/${service.id}`}><span class="mega-item-title">{service.data.title}</span><span class="mega-item-desc">{service.data.description}</span></a></li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
          <p class="mega-all"><a href="/services">All services<span aria-hidden="true"> ›</span></a></p>
        </div>
      </div>
      <div class="mega blog-panel" id="blog-panel" hidden data-blog>
        <div class="wrap mega-inner">
          <section aria-labelledby="blog-latest">
            <p class="mega-kicker" id="blog-latest"><span>01</span>Latest</p>
            <ul class="blog-list">
              {recentPosts.map((post) => (
                <li><a href={`/blog/${post.id}`}><span class="mega-item-title">{post.data.title}</span>{post.data.pubDate instanceof Date && <span class="blog-meta"><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time></span>}</a></li>
              ))}
            </ul>
          </section>
          <p class="mega-all"><a href="/blog">All articles<span aria-hidden="true"> ›</span></a></p>
        </div>
      </div>
      <div class="mobile-panel" id="mobile-panel" hidden data-mobile>
        <div class="wrap mobile-inner">
          <a class="mobile-top" href="/about">{s.navigation.about}</a>
          <a class="mobile-top" href="/blog">{s.navigation.blog}</a>
          <section aria-label="Recent articles">
            <p class="mobile-group">Recent articles</p>
            <ul>
              {recentPosts.map((post) => (
                <li><a href={`/blog/${post.id}`}>{post.data.title}</a></li>
              ))}
            </ul>
          </section>
          <p class="mega-kicker"><a href="/services">{s.navigation.services}<span aria-hidden="true"> ›</span></a></p>
          {groups.map((group) => (
            <section aria-label={group.title}>
              <p class="mobile-group">{group.title}</p>
              <ul>
                {group.items.map((service) => (
                  <li><a href={`/services/${service.id}`}>{service.data.title}</a></li>
                ))}
              </ul>
            </section>
          ))}
          <a class="mobile-top" href={s.navigation.contactHref}>{s.navigation.contact}</a>
        </div>
      </div>
    </div>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <div class="footer-top"><div><a class="wordmark" href="/"><BrandLogo label={s.brand.logoAlt} /></a><p>{s.footer.tagline}</p></div><div><h2>{s.footer.companyHeading}</h2><a href="/about">{s.footer.about}</a><a href="/services">{s.footer.services}</a><a href="/blog">{s.footer.blog}</a><a href="/contact">{s.footer.contact}</a></div><div><h2>{s.footer.expertiseHeading}</h2><a href="/services/managed-it">{s.footer.managedIT}</a><a href="/services/cloud-hosting">{s.footer.cloudHosting}</a><a href="/services/cybersecurity">{s.footer.cybersecurity}</a><a href="/services/ibm-power">{s.footer.ibmPower}</a></div><address><a href={s.contact.emailHref}>{s.contact.email}</a><a href={s.contact.phoneHref}>{s.contact.phoneDisplay}</a><p>{s.organization.streetAddress}<br />{s.organization.addressLocality}, {s.organization.addressRegion} {s.organization.postalCode}</p></address></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} {s.siteName}{s.footer.rights}</span><a href="/privacy">{s.footer.privacy}</a><a href="/terms">{s.footer.terms}</a><a href={s.footer.linkedin} aria-label={s.footer.linkedinLabel}>LinkedIn</a></div>
    </footer>
    <script>
      (() => {
        const root = document.querySelector('[data-menu-root]');
        if (!(root instanceof HTMLElement)) return;
        root.dataset.js = 'true';
        const svcLink = root.querySelector('[data-svc-link]');
        const mega = root.querySelector('[data-mega]');
        const blogLink = root.querySelector('[data-blog-link]');
        const blog = root.querySelector('[data-blog]');
        const toggle = root.querySelector('[data-menu-toggle]');
        const mobile = root.querySelector('[data-mobile]');
        if (!(svcLink instanceof HTMLAnchorElement) || !(mega instanceof HTMLElement)) return;
        if (!(blogLink instanceof HTMLAnchorElement) || !(blog instanceof HTMLElement)) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
        const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
        const wide = window.matchMedia('(min-width: 681px)');
        const DURATION = 180;
        const closeTimers = new Map<HTMLElement, number>();
        let hoverOpened = false;
        const show = (panel: HTMLElement, trigger: HTMLElement) => {
          window.clearTimeout(closeTimers.get(panel));
          panel.hidden = false;
          void panel.offsetWidth;
          panel.setAttribute('data-open', '');
          trigger.setAttribute('aria-expanded', 'true');
        };
        const hide = (panel: HTMLElement, trigger: HTMLElement, refocus: boolean) => {
          panel.removeAttribute('data-open');
          trigger.setAttribute('aria-expanded', 'false');
          window.clearTimeout(closeTimers.get(panel));
          if (reduce.matches) {
            panel.hidden = true;
          } else {
            closeTimers.set(panel, window.setTimeout(() => {
              if (!panel.hasAttribute('data-open')) panel.hidden = true;
            }, DURATION));
          }
          if (refocus) trigger.focus();
        };
        const isOpen = (panel: HTMLElement): boolean => panel.hasAttribute('data-open');
        const closeOther = (panel: HTMLElement) => {
          if (panel !== mega && isOpen(mega)) hide(mega, svcLink, false);
          if (panel !== blog && isOpen(blog)) hide(blog, blogLink, false);
        };
        const closeAll = () => {
          if (isOpen(mega)) hide(mega, svcLink, false);
          if (isOpen(blog)) hide(blog, blogLink, false);
          if (mobile instanceof HTMLElement && toggle instanceof HTMLButtonElement && isOpen(mobile)) hide(mobile, toggle, false);
        };
        const wireToggle = (trigger: HTMLAnchorElement, panel: HTMLElement) => {
          trigger.addEventListener('click', (event) => {
            if (!wide.matches) return;
            event.preventDefault();
            hoverOpened = false;
            hoverTrigger = null;
            if (isOpen(panel)) {
              hide(panel, trigger, false);
            } else {
              closeOther(panel);
              if (mobile instanceof HTMLElement && toggle instanceof HTMLButtonElement && isOpen(mobile)) hide(mobile, toggle, false);
              show(panel, trigger);
            }
          });
        };
        wireToggle(svcLink, mega);
        wireToggle(blogLink, blog);
        if (toggle instanceof HTMLButtonElement && mobile instanceof HTMLElement) {
          toggle.addEventListener('click', () => {
            if (isOpen(mobile)) {
              hide(mobile, toggle, false);
            } else {
              closeAll();
              show(mobile, toggle);
            }
          });
        }
        document.addEventListener('click', (event) => {
          if (event.target instanceof Node && !root.contains(event.target)) closeAll();
        });
        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;
          if (isOpen(blog)) {
            hide(blog, blogLink, true);
            hoverTrigger = null;
            hoverOpened = false;
          } else if (isOpen(mega)) {
            hide(mega, svcLink, true);
            hoverOpened = false;
          } else if (mobile instanceof HTMLElement && toggle instanceof HTMLButtonElement && isOpen(mobile)) {
            hide(mobile, toggle, true);
          }
        });
        let hoverTimer = 0;
        let hoverTrigger: HTMLAnchorElement | null = null;
        const wireHover = (trigger: HTMLAnchorElement, panel: HTMLElement) => {
          trigger.addEventListener('mouseenter', () => {
            if (!fine.matches || !wide.matches || isOpen(panel)) return;
            window.clearTimeout(hoverTimer);
            hoverTimer = window.setTimeout(() => {
              closeOther(panel);
              show(panel, trigger);
              hoverTrigger = trigger;
              hoverOpened = true;
            }, 120);
          });
          trigger.addEventListener('mouseleave', () => window.clearTimeout(hoverTimer));
        };
        wireHover(svcLink, mega);
        wireHover(blogLink, blog);
        root.addEventListener('mouseleave', () => {
          window.clearTimeout(hoverTimer);
          if (hoverOpened && hoverTrigger instanceof HTMLAnchorElement) {
            const panel = hoverTrigger === blogLink ? blog : mega;
            if (isOpen(panel) && document.activeElement !== hoverTrigger && !panel.contains(document.activeElement)) {
              hide(panel, hoverTrigger, false);
              hoverOpened = false;
              hoverTrigger = null;
            }
          }
        });
        wide.addEventListener('change', () => closeAll());
      })();
    </script>
    <style>
      .site-header-bar {
        position: relative;
      }
      [data-svc-link],
      [data-blog-link] {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
      }
      .svc-caret {
        flex-shrink: 0;
      }
      [data-svc-link][aria-expanded='true'] .svc-caret,
      [data-blog-link][aria-expanded='true'] .svc-caret {
        transform: rotate(180deg);
      }
      .menu-toggle {
        display: none;
        align-items: center;
        justify-content: center;
        min-width: 44px;
        min-height: 44px;
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--ink);
        cursor: pointer;
      }
      .menu-toggle:hover {
        color: var(--cyan);
      }
      .mega,
      .mobile-panel {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 60;
        background: var(--paper);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
      }
      .mega[data-open],
      .mobile-panel[data-open] {
        visibility: visible;
        opacity: 1;
        pointer-events: auto;
      }
      .mega-inner {
        padding-block: 2rem 1.5rem;
      }
      .mega-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2.5rem;
      }
      .mega-kicker {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0 0 0.5rem;
      }
      .mega-kicker > span {
        color: var(--cyan);
        margin-right: 0.75rem;
      }
      .mega-kicker a:hover {
        color: var(--cyan);
      }
      .mega ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .mega li > a {
        display: block;
        padding: 0.8rem 0;
        border-top: 1px solid var(--line);
      }
      .mega li:first-child > a {
        border-top: 0;
      }
      .mega-item-title {
        display: block;
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 700;
        letter-spacing: -0.025em;
        line-height: 1.3;
      }
      .mega li > a:hover .mega-item-title {
        color: var(--cyan);
      }
      .mega-item-desc {
        display: block;
        font-size: 0.82rem;
        line-height: 1.6;
        color: var(--muted);
        margin-top: 0.25rem;
      }
      .mega-all {
        margin: 1rem 0 0;
        padding-top: 1rem;
        border-top: 1px solid var(--line);
        font-size: 0.85rem;
        font-weight: 600;
      }
      .mega-all a:hover {
        color: var(--cyan);
      }
      .blog-list {
        max-width: 44rem;
      }
      .blog-meta {
        display: block;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
        margin-top: 0.25rem;
      }
      .mobile-panel {
        display: none;
      }
      .mobile-inner {
        padding-block: 1rem 1.5rem;
        max-height: calc(100dvh - 140px);
        overflow-y: auto;
      }
      .mobile-top {
        display: flex;
        align-items: center;
        min-height: 48px;
        font-size: 0.95rem;
        font-weight: 700;
        font-family: var(--font-display);
        letter-spacing: -0.02em;
        border-top: 1px solid var(--line);
      }
      .mobile-inner > .mega-kicker {
        margin: 0;
        border-top: 1px solid var(--line);
        padding: 1rem 0 0.25rem;
      }
      .mobile-inner > .mega-kicker a {
        display: flex;
        align-items: center;
        min-height: 44px;
        color: var(--muted);
      }
      .mobile-group {
        font-size: 0.85rem;
        font-weight: 600;
        margin: 0.75rem 0 0;
      }
      .mobile-panel ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .mobile-panel li > a {
        display: flex;
        align-items: center;
        min-height: 44px;
        font-size: 0.9rem;
        color: var(--muted);
        border-top: 1px solid var(--line);
      }
      .mobile-panel li > a:hover {
        color: var(--cyan);
      }
      @media (prefers-reduced-motion: no-preference) {
        .mega,
        .mobile-panel {
          transform: translateY(6px);
          transition:
            opacity 180ms var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1)),
            transform 180ms var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1)),
            visibility 0s linear 180ms;
        }
        .mega[data-open],
        .mobile-panel[data-open] {
          transform: none;
          transition:
            opacity 180ms var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1)),
            transform 180ms var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1));
        }
        [data-svc-link] .svc-caret,
        [data-blog-link] .svc-caret {
          transition: transform 180ms var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1));
        }
      }
      @media (min-width: 681px) {
        .mobile-panel {
          display: none;
        }
      }
      @media (max-width: 680px) {
        .mega {
          display: none;
        }
        .site-header-bar[data-js='true'] .site-header nav,
        .site-header-bar[data-js='true'] .contact-link {
          display: none;
        }
        .site-header-bar[data-js='true'] .menu-toggle {
          display: inline-flex;
        }
        .site-header-bar[data-js='true'] .mobile-panel {
          display: block;
        }
      }
    </style>
  </body>
</html>
