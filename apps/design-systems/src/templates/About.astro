---
import type { Reader } from '@/lib/content';
import { asset } from '@/lib/content';
import EditorialGroup from '@/components/EditorialGroup.astro';
import CTA from '@/components/CTA.astro';
interface Props {
  content: Reader;
}
const { content } = Astro.props;
const [c, s] = await Promise.all([
  content.getPage('about'),
  content.getSettings(),
]);
---

<div class="wrap">
  <section class="hero">
    <p class="eyebrow">{c.hero.badgeLead} {c.hero.badgeAccent}</p><h1>
      {c.hero.heading}
    </h1><p class="intro">{c.hero.body}</p>{
      c.hero.image && (
        <img
          class="hero-image"
          src={asset(c.hero.image)}
          alt={c.hero.imageAlt}
        />
      )
    }
  </section>
  <section class="section">
    <header class="section-head">
      <span class="section-index">01 /</span><h2>
        {c.foundingStory.headingLead}
        <em>{c.foundingStory.headingAccent}</em>
      </h2>
    </header><div class="section-body prose">
      {
        [
          c.foundingStory.origin,
          c.foundingStory.partnership,
          c.foundingStory.today,
        ].map((p) => (
          <p>
            {p.beforeEmphasis} <em>{p.emphasis}</em> {p.afterEmphasis}
          </p>
        ))
      }{
        c.foundingStory.image && (
          <figure>
            <>
              <img
                src={asset(c.foundingStory.image)}
                alt={c.foundingStory.imageAlt}
                loading="lazy"
              />
              <figcaption>{c.foundingStory.caption}</figcaption>
            </>
          </figure>
        )
      }
    </div>
  </section>
  <section class="section">
    <div class="open-grid">
      {
        [c.mission, c.vision].map((x) => (
          <article>
            <>
              <h2>{x.heading}</h2>
              <p>{x.body}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section class="section">
    <header class="section-head">
      <span class="section-index">02 /</span><div>
        <h2>{c.values.heading}</h2><p>{c.values.subheading}</p>
      </div>
    </header><div class="section-body open-grid three">
      {
        [
          c.values.clientFocus,
          c.values.innovation,
          c.values.reliability,
          c.values.partnership,
          c.values.excellence,
          c.values.support,
        ].map((v) => (
          <article class="open-item">
            <>
              <h3>{v.title}</h3>
              <p>{v.description}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section class="section">
    <header class="section-head">
      <span class="section-index">03 /</span><div>
        <h2>{c.journey.heading}</h2><p>{c.journey.subheading}</p>
      </div>
    </header><div class="section-body">
      {
        [
          c.journey.foundation,
          c.journey.expansion,
          c.journey.cloudHosting,
          c.journey.infrastructure,
          c.journey.publicCloud,
          c.journey.premierPartnership,
          c.journey.artificialIntelligence,
        ].map((event) => (
          <article class="article-row">
            <>
              <span class="section-index">{event.year}</span>
              <div>
                <>
                  <h3>{event.title}</h3>
                  <p>{event.description}</p>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section class="section">
    <header class="section-head">
      <span class="section-index">04 /</span><div>
        <h2>{c.partners.headingLead} <em>{c.partners.headingAccent}</em></h2><p>
          {c.partners.bodyLead}
          {c.partners.bodyEmphasis}
          {c.partners.bodyEnd}
        </p>
      </div>
    </header><div class="section-body open-grid three">
      {
        [
          c.partners.ibm,
          c.partners.microsoft,
          c.partners.cisco,
          c.partners.lenovo,
          c.partners.cloudflare,
          c.partners.vmware,
        ].map((p) => <EditorialGroup data={p} />)
      }
    </div>
  </section><CTA copy={c.cta} settings={s} />
</div>
