---
import type { ContentReader } from '@bdkinc/content/reader';
import type { PageKey } from '@bdkinc/content';
import { group, text, heading, body, entries } from '@/lib/editorial';
import EditorialGroup from '@/components/EditorialGroup.astro';
import CTA from '@/components/CTA.astro';
import Icon from '@/components/Icon.astro';
interface Props {
  content: ContentReader;
  pageKey: PageKey;
}
const { content, pageKey } = Astro.props;
const [copy, s, services] = await Promise.all([
  content.getPage(pageKey),
  content.getSettings(),
  content.getCollection('services'),
]);
const c = group(copy),
  hero = group(c.hero);
const service = services.find((entry) => 'service-' + entry.id === pageKey);
if (!service) throw new Error('Service entry unavailable');
const heroHeights: Record<string, number> = {
  'managed-it': 1024,
  'cloud-hosting': 1024,
  cybersecurity: 864,
  'application-development': 1024,
  'ibm-power': 1024,
  'business-analytics': 864,
  'edi-solutions': 614,
  'hosted-erp': 864,
  'artificial-intelligence': 864,
};
const heroHeight = heroHeights[service.id];
const order = [
  'leadership',
  'capabilities',
  'deployment',
  'strategy',
  'comparison',
  'benefits',
  'solutions',
  'lifecycle',
  'maturity',
  'framework',
  'pipeline',
  'watsonx',
  'infrastructure',
  'roadmap',
  'network',
  'specifications',
  'standards',
  'providers',
  'techStack',
  'operations',
];
const sections = order.filter((key) => c[key]);
const posts = c.resources
  ? (await content.getCollection('blog'))
      .filter((p) =>
        p.data.tags?.some((tag) =>
          [service.id, 'software-development', 'modernization'].includes(tag)
        )
      )
      .slice(0, 3)
  : [];
---

<div class="wrap">
  <section class="hero hero-service">
    {
      heroHeight && (
        <div class="service-hero-image" aria-hidden="true">
          <img
            src={`/images/services/${service.id}.webp`}
            srcset={`/images/services/${service.id}-768.webp 768w, /images/services/${service.id}.webp 1536w`}
            sizes="(max-width: 650px) 88vw, (max-width: 1000px) calc(92vw - 60px), (min-width: 1588px) 1340px, calc(90vw - 88px)"
            width="1536" height={heroHeight} alt=""
            loading="eager" fetchpriority="high" decoding="async"
          />
        </div>
      )
    }
    <p class="eyebrow">{text(hero.badgePrefix)} {text(hero.badgeAccent)}</p><h1>
      {service.data.title}
    </h1><p class="intro">
      {text(hero.body) || service.data.description}{
        hero.bodySuffix && <> {text(hero.bodySuffix)}</>
      }
    </p><div class="actions">
      <a
        class="button primary"
        href={text(group(c.cta).buttonHref) || s.navigation.contactHref}
        >{text(group(c.cta).buttonText)}<span class="arrow" aria-hidden="true"
          ><Icon name="chat-circle" /></span
        ></a
      ><a class="button" href="/services">{s.navigation.allServices}</a>
    </div>
  </section>
  {
    c.metrics && (
      <dl class="metrics">
        {entries(c.metrics).map(([, m]) => (
          <div>
            <dd>{text(m.value)}</dd>
            <dt>{text(m.label)}</dt>
          </div>
        ))}
      </dl>
    )
  }
  {
    sections.map((key, i) => {
      const section = group(c[key]);
      return (
        <section class="section" id={key}>
          <>
            <header class="section-head">
              <>
                <span class="section-index">
                  {String(i + 1).padStart(2, '0')} /
                </span>
                <div>
                  <h2>
                    {heading(section) ||
                      (key === 'benefits' ? s.benefits.title : '')}
                  </h2>
                  {body(section) && <p>{body(section)}</p>}
                </div>
              </>
            </header>
            <div class="section-body">
              <EditorialGroup
                data={{
                  ...section,
                  heading: undefined,
                  headingLead: undefined,
                  headingAccent: undefined,
                  title: undefined,
                  body: undefined,
                  description: undefined,
                  bodyBefore: undefined,
                  bodyLead: undefined,
                  bodyAccent: undefined,
                  bodyAfter: undefined,
                  bodyEnd: undefined,
                }}
              />
            </div>
          </>
        </section>
      );
    })
  }
  {
    c.faqs && (
      <section class="section">
        <>
          <header class="section-head">
            <>
              <span class="section-index">? /</span>
              <h2>{text(c.faqHeading)}</h2>
            </>
          </header>
          <div class="section-body">
            {entries(c.faqs).map(([, faq]) => (
              <details class="faq">
                <summary>{text(faq.question)}</summary>
                <p>{text(faq.answer)}</p>
              </details>
            ))}
          </div>
        </>
      </section>
    )
  }
  {
    posts.length > 0 && (
      <section class="section">
        <>
          <h2>{text(group(c.resources).heading)}</h2>
          <div class="article-list">
            {posts.map((p) => (
              <a class="article-row" href={'/blog/' + p.id}>
                <time datetime={p.data.pubDate.toISOString()}>
                  {p.data.pubDate.toLocaleDateString('en-US', {
                    month: 'short',
                    year: 'numeric',
                    timeZone: 'UTC',
                  })}
                </time>
                <div>
                  <h3>{p.data.title}</h3>
                  <p>{p.data.description}</p>
                  <p>{text(group(c.resources).articleLinkLabel)}</p>
                </div>
                <span class="arrow" aria-hidden="true">
                  <Icon name="article" />
                </span>
              </a>
            ))}
          </div>
        </>
      </section>
    )
  }
  <CTA copy={group(c.cta)} settings={s} />
</div>

<style>
  .hero-service {
    isolation: isolate;
  }
  .service-hero-image {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .service-hero-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
  }
  .service-hero-image::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Px stops track the copy column (.intro 680px, h1 1100px); narrower heroes clamp to the opaque end. */
    background: linear-gradient(90deg, var(--bg) 0, color-mix(in srgb, var(--bg) 94%, transparent) 720px, color-mix(in srgb, var(--bg) 50%, transparent) 1100px, color-mix(in srgb, var(--bg) 25%, transparent) 100%);
  }
</style>
