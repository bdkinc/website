---
import Icon from '@/components/Icon.astro';
import type { ContentReader } from '@bdkinc/content/reader';
import ContactChat from '@bdkinc/design-system/contact-chat';
interface Props {
  content: ContentReader;
}
const { content } = Astro.props;
const c = await content.getPage('contact');
const d = c.directContact;
const chatSuggestions = Object.values(c.chat.pageFallbackSuggestions);
---

<div class="wrap">
  <section class="hero">
    <p class="eyebrow">{c.hero.badgeLead} {c.hero.badgeAccent}</p><h1>
      {c.hero.headingLead}
      <em>{c.hero.headingAccent}</em>
    </h1><p class="intro">{d.description}</p>
  </section><section class="section" id="chat" aria-label={c.chat.sectionLabel}>
    <header class="section-head">
      <span class="section-index">01 /</span><h2>{c.hero.invitation}</h2>
    </header><div class="section-body contact-desk">
      <div class="contact-chat-scope"><div class="contact-chat"><ContactChat client:only="react" initialSuggestions={chatSuggestions} copy={c.chat} /></div></div>
      <section class="contact-directory" aria-labelledby="contact-directory-heading">
        <header class="contact-directory-head">
          <span class="section-index">02 /</span><h2 id="contact-directory-heading">
            {d.headingLead}
            <em>{d.headingAccent}</em>
          </h2>
        </header><div class="contact-grid">
          <article>
            <h3>{d.phone.label}</h3><a href={d.phone.linkUrl}>{d.phone.value} <Icon name="phone" /></a
            ><p>{d.phone.availability}</p>
          </article><article>
            <h3>{d.email.label}</h3><a href={d.email.linkUrl}>{d.email.value} <Icon name="envelope-simple" /></a
            ><p>{d.email.description}</p>
          </article><article>
            <h3>{d.headquarters.label}</h3><a href={d.headquarters.mapUrl}
              >{d.headquarters.location} <Icon name="map-pin" /></a
            ><address>{d.headquarters.address}</address>
          </article><article>
            <h3>{d.support.label}</h3><p>{d.support.description}</p>
          </article>
        </div>
      </section>
    </div>
  </section>
</div>
