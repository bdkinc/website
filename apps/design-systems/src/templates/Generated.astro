---
import type { ContentReader } from '@bdkinc/content/reader';
import type { SiteRoute } from '@bdkinc/content/routes';
import { substitute } from '@/lib/editorial';
import CTA from '@/components/CTA.astro';
import Icon from '@/components/Icon.astro';
interface Props {
  content: ContentReader;
  route: Extract<
    SiteRoute,
    { template: 'service-location' | 'industry-location' }
  >;
}
const { content, route } = Astro.props;
const [catalog, s, locations] = await Promise.all([
  content.getPage(route.template),
  content.getSettings(),
  content.getCollection('locations'),
]);
const location = locations.find((l) => l.id === route.locationId);
if (!location) throw new Error('Location unavailable');
const entries =
  route.template === 'service-location'
    ? await content.getCollection(route.collectionKey)
    : await content.getCollection('pseoIndustries');
const entry = entries.find(
  (e) =>
    e.id ===
    (route.template === 'service-location'
      ? route.serviceSlug
      : route.industrySlug)
);
if (!entry) throw new Error('Service unavailable');
const vars = {
  serviceTitle: entry.data.title,
  industryTitle: entry.data.title,
  locationName: location.data.name,
  state: location.data.state,
  region: location.data.region,
  counties:
    location.data.counties?.join(catalog.benefits.regional.countySeparator) ||
    catalog.benefits.regional.countyFallback,
};
const c = substitute(catalog, vars);
const nearby = locations.filter(
  (l) => l.id !== location.id && l.data.state === location.data.state
);
---

<div class="wrap">
  <section class="hero">
    <p class="eyebrow">{c.hero.badge}</p><h1>
      {c.hero.headingLead}<br /><em>{c.hero.headingAccent}</em>
    </h1><p class="intro">{c.hero.description}</p><div class="actions">
      <a class="button primary" href={s.navigation.contactHref}
        >{c.hero.buttonText} <Icon name="chat-circle" /></a
      ><a class="button" href={s.contact.phoneHref}>{s.contact.phoneDisplay}</a>
    </div>
  </section><section class="section">
    <header class="section-head">
      <span class="section-index">01 /</span><div>
        <h2>{entry.data.title}</h2><p>{entry.data.description}</p>
      </div>
    </header><div class="section-body">
      <h3>
        {c.localAdvantages.headingLead}
        {c.localAdvantages.headingAccent}
      </h3><div class="open-grid">
        {
          [
            c.localAdvantages.expertise,
            c.localAdvantages.response,
            c.localAdvantages.monitoring,
            c.localAdvantages.team,
          ].map((v) => (
            <article class="open-item">
              <>
                <h3>{v.title}</h3>
                <p>{v.description}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section><section class="section">
    <header class="section-head">
      <span class="section-index">02 /</span><h2>
        {c.benefits.headingLead}
        {c.benefits.headingAccent}
      </h2>
    </header><div class="section-body open-grid">
      {
        [c.benefits.comprehensive, c.benefits.regional].map((v) => (
          <article>
            <>
              <h3>{v.heading}</h3>
              <ul>
                {Object.entries(v)
                  .filter(
                    ([k]) =>
                      ![
                        'heading',
                        'countyFallback',
                        'countySeparator',
                      ].includes(k)
                  )
                  .map(([, value]) => (
                    <li>{value}</li>
                  ))}
              </ul>
            </>
          </article>
        ))
      }
    </div>
  </section><section class="section">
    <h2>{c.nearbyLocations.heading}</h2><ul class="location-list">
      {
        nearby.map((l) => (
          <li>
            <a
              href={
                route.template === 'service-location'
                  ? `/services/${route.serviceSlug}/${l.id}`
                  : `/industries/${route.industrySlug}/${l.id}`
              }
            >
              {l.data.name} <Icon name="map-pin" />
            </a>
          </li>
        ))
      }
    </ul>
  </section><CTA copy={c.cta} settings={s} />
</div>
