# Public pages are static by default; WordPress provides published build content.
# Preview/media endpoints require the Node adapter runtime.

# Required at build time: published WordPress content (no authentication).
WORDPRESS_URL=http://localhost:8080
# Server-only runtime preview credentials; never use PUBLIC_ prefixes.
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
BDK_PREVIEW_SECRET=
BDK_PREVIEW_AUDIENCE=http://localhost:4321

# Optional GA4 measurement ID (G-...). Disabled until the visitor allows analytics.
# Static pages require this value when building; /contact also reads it at runtime.
BDK_GA4_ID=
# Explicitly opt in to local analytics testing; normally leave blank.
BDK_ANALYTICS_DEV=
