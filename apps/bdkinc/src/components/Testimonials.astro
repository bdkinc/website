---
import type { ContentProps, ContentReader } from '@/lib/content';
import type { PageData } from '@bdkinc/content';
interface Props extends ContentProps {
  reader: ContentReader;
  copy: PageData<'home'>['testimonials'];
}
const { reader, copy } = Astro.props;
import TestimonialsCarousel from '@/components/TestimonialsCarousel';

const testimonials = (await reader.getCollection('testimonials'))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map(({ data }) => ({
    quote: data.quote,
    author: data.author,
    company: data.company,
    industry: data.industry,
    order: data.order ?? 0,
  }));
---

<section
  class="bg-muted/30 dark:bg-background relative px-4 py-24 sm:px-6 lg:px-8"
>
  <div
    class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
  >
  </div>
  <div class="relative z-10 mx-auto max-w-7xl space-y-12">
    <div class="mx-auto max-w-2xl space-y-4 text-center">
      <h2 class="font-display text-4xl font-bold tracking-tight md:text-5xl">
        <span class="text-foreground">{copy.headingLead.trim()} </span>
        <span
          class="from-primary to-secondary bg-linear-to-br bg-clip-text font-extrabold text-transparent"
        >
          {copy.headingAccent}
        </span>
      </h2>
      <p class="text-muted-foreground mx-auto font-sans text-xl">
        {copy.bodyLead.trim()}{' '}<span class="text-accent font-semibold">{copy.bodyAccent}</span>{' '}{copy.bodyEnd.trim()}
      </p>
    </div>

    <div class="mx-auto mt-4 flex justify-center">
      <div class="w-full max-w-7xl">
        <TestimonialsCarousel client:visible testimonials={testimonials} />
      </div>
    </div>
  </div>
  <div
    class="via-border/60 absolute bottom-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
  >
  </div>
</section>
