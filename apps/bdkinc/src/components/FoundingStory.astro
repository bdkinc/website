---
import { PiUsersThree, PiBuildings } from 'react-icons/pi';

import type { PageData } from '@bdkinc/content';
interface Props { copy: PageData<'about'>['foundingStory']; }
const { copy } = Astro.props;
---

<section class="relative overflow-hidden py-24">
  <!-- Subtle Background Gradient for depth -->
  <div
    class="bg-primary/5 pointer-events-none absolute top-1/2 -left-64 -z-10 h-[500px] w-[500px] -translate-y-1/2 rounded-full blur-3xl"
  >
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-16 lg:grid-cols-2 lg:gap-24">
      <!-- Text Content -->
      <div class="flex flex-col gap-6">
        <h2
          class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-4 text-3xl font-bold tracking-tight duration-700 md:text-4xl"
        >
          <span class="text-foreground">{copy.headingLead}{' '}</span>
          <span
            class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
            >{copy.headingAccent}</span
          >
        </h2>

        <div
          class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 space-y-6 text-lg leading-relaxed delay-200 duration-700"
        >
          <p>
            {copy.origin.beforeEmphasis}{' '}<strong
              class="text-foreground font-semibold"
              >{copy.origin.emphasis}</strong
            >{copy.origin.afterEmphasis}
          </p>

          <p>
            {copy.partnership.beforeEmphasis}{' '}<strong class="text-foreground font-semibold"
              >{copy.partnership.emphasis}</strong
            >{' '}{copy.partnership.afterEmphasis}
          </p>

          <p>
            {copy.today.beforeEmphasis}{' '}<strong
              class="text-foreground font-semibold"
              >{copy.today.emphasis}</strong
            >{copy.today.afterEmphasis}
          </p>
        </div>
      </div>

      <!-- Visual/Image Placeholder -->
      <div
        class="fill-mode-both animate-in fade-in zoom-in relative mx-auto w-full max-w-lg delay-300 duration-700 lg:max-w-none"
      >
        <!-- The Card -->
        <div
          class="glass border-border group relative aspect-video w-full overflow-hidden rounded-xl border shadow-2xl"
        >
          <!-- Inner Gradient/Background -->
          <div
            class="from-primary/5 via-background to-secondary/5 absolute inset-0 bg-linear-to-br"
          >
          </div>

          <!-- Placeholder Content -->
          {copy.image ? <img src={copy.image} alt={copy.imageAlt} class="absolute inset-0 h-full w-full object-cover" /> : <div
            class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-8 text-center"
          >
            <div
              class="bg-muted/50 rounded-full p-6 ring-1 ring-white/10 backdrop-blur-sm"
            >
              <PiUsersThree
                aria-hidden="true"
                className="text-muted-foreground/50 h-12 w-12"
              />
            </div>
            <div>
              <div
                class="text-muted-foreground/60 text-sm font-medium tracking-widest"
              >
                {copy.imagePlaceholder}
              </div>
              <div class="text-muted-foreground/40 mt-1 text-xs">
                {copy.imagePeriod}
              </div>
            </div>
          </div>}

          <!-- Hover Effect Overlay -->
          <div
            class="bg-primary/5 absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
          >
          </div>
        </div>

        <!-- Caption/Tagline below image -->
        <div
          class="text-muted-foreground/60 mt-4 flex items-center justify-center gap-2 text-sm"
        >
          <PiBuildings aria-hidden="true" className="h-4 w-4" />
          <span>{copy.caption}</span>
        </div>
      </div>
    </div>
  </div>
</section>
