---
import Logo from '@/components/Logo';
import {
  PiLinkedinLogo,
  PiFacebookLogo,
  PiInstagramLogo,
} from 'react-icons/pi';

import type { ContentProps, ContentReader } from '@/lib/content';
import EditSection from '@/components/preview/EditSection.astro';
interface Props extends ContentProps {
  reader: ContentReader;
}
const { reader } = Astro.props;
const settings = await reader.getSettings();
const { footer: copy, contact } = settings;
const currentYear = new Date().getFullYear();

const linkClass =
  'hover:text-primary focus-visible:ring-ring focus-visible:ring-offset-background inline-flex min-h-11 items-center rounded-sm transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none';

const socialLinks = [
  {
    label: copy.linkedinLabel,
    href: copy.linkedin,
    Icon: PiLinkedinLogo,
  },
  {
    label: copy.facebookLabel,
    href: copy.facebook,
    Icon: PiFacebookLogo,
  },
  {
    label: copy.instagramLabel,
    href: copy.instagram,
    Icon: PiInstagramLogo,
  },
];

const companyLinks = [
  { href: '/about', label: copy.about },
  { href: '/services', label: copy.services },
  { href: '/blog', label: copy.blog },
  { href: '/contact', label: copy.contact },
];

const expertiseLinks = [
  { href: '/services/cybersecurity', label: copy.cybersecurity },
  { href: '/services/managed-it', label: copy.managedIT },
  { href: '/services/cloud-hosting', label: copy.cloudHosting },
  { href: '/services/ibm-power', label: copy.ibmPower },
];
---

<EditSection record="settings" section="footer">
<footer
  class="border-border/60 from-secondary/3 via-background to-background relative border-t bg-linear-to-b px-4 py-10 sm:px-6 lg:px-8"
>
  {/* Tri-color gradient bar at top */}
  <div
    class="from-primary/50 via-secondary/50 absolute top-0 right-0 left-0 h-1 bg-linear-to-r to-[--accent]/50"
    aria-hidden="true"
  >
  </div>

  {/* Gradient mesh background */}
  <div
    class="gradient-mesh noise-texture pointer-events-none absolute inset-0 opacity-40"
    aria-hidden="true"
  >
  </div>

  {/* Radial gradient spotlight - navy focal */}
  <div
    class="pointer-events-none absolute inset-0"
    aria-hidden="true"
    style="background: radial-gradient(circle at top center, rgba(36, 64, 143, 0.08), transparent 50%);"
  >
  </div>
  <div
    class="text-muted-foreground relative z-10 mx-auto flex max-w-7xl flex-col gap-8 text-[0.95rem] sm:text-sm"
  >
    <div
      class="flex flex-col items-center justify-between gap-6 text-center md:flex-row md:items-start md:text-left"
    >
      <div
        class="flex flex-col items-center gap-3 md:items-start md:self-start"
      >
        <a
          href="/"
          class="focus-visible:ring-ring focus-visible:ring-offset-background mb-4 origin-top-left scale-[1.15] rounded-sm focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none sm:scale-[1.25]"
          aria-label={settings.navigation.homeLabel}
        >
          <Logo copy={settings.brand} />
        </a>
        <p
          class="text-muted-foreground max-w-md text-[0.8rem] sm:text-[0.9rem]"
        >
          {copy.tagline}
        </p>

        <ul class="flex items-center gap-1" aria-label={copy.socialLabel}>
          {
            socialLinks.map(({ label, href, Icon }) => (
              <li>
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${label} (opens in a new tab)`}
                  class="text-muted-foreground hover:text-primary hover:border-primary/40 border-border/60 focus-visible:ring-ring focus-visible:ring-offset-background flex h-11 w-11 items-center justify-center rounded-full border transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
                >
                  <Icon className="h-5 w-5" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="grid w-full max-w-xl grid-cols-2 gap-8 text-[0.8rem] sm:text-[0.9rem] md:grid-cols-3"
      >
        <nav aria-labelledby="footer-company-heading" class="space-y-2">
          <h2
            id="footer-company-heading"
            class="text-foreground text-[0.75rem] font-semibold tracking-[0.18em] sm:text-xs"
          >
            {copy.companyHeading}
          </h2>
          <ul class="text-muted-foreground space-y-1.5">
            {
              companyLinks.map(({ href, label }) => (
                <li>
                  <a href={href} class={linkClass}>
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav aria-labelledby="footer-expertise-heading" class="space-y-2">
          <h2
            id="footer-expertise-heading"
            class="text-foreground text-[0.75rem] font-semibold tracking-[0.18em] sm:text-xs"
          >
            {copy.expertiseHeading}
          </h2>
          <ul class="text-muted-foreground space-y-1.5">
            {
              expertiseLinks.map(({ href, label }) => (
                <li>
                  <a href={href} class={linkClass}>
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="space-y-2">
          <h2
            id="footer-contact-heading"
            class="text-foreground text-[0.75rem] font-semibold tracking-[0.18em] sm:text-xs"
          >
            {copy.contact}
          </h2>
          <address
            class="text-muted-foreground space-y-1.5 not-italic"
            aria-labelledby="footer-contact-heading"
          >
            <div>
              <a
                href={contact.phoneHref}
                class={linkClass}
                aria-label={contact.phoneLabel}
              >
                {contact.phoneDisplay}
              </a>
            </div>
            <div>
              <a
                href={contact.emailHref}
                class={linkClass}
                aria-label={contact.emailLabel}
              >
                {contact.email}
              </a>
            </div>
          </address>
        </div>
      </div>
    </div>

    <div
      class="border-border/40 text-muted-foreground flex flex-col items-center justify-between gap-3 border-t pt-4 text-[0.8rem] sm:flex-row sm:text-[0.85rem]"
    >
      <p>
        &copy; <time datetime={String(currentYear)}>{currentYear}</time>
        <span class="font-display font-semibold">{settings.siteName}</span>{copy.rights}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <nav aria-label="Legal" class="flex items-center gap-4">
          <a href="/privacy" class={linkClass}>{copy.privacy}</a>
          <a href="/terms" class={linkClass}>{copy.terms}</a>
        </nav>
        <span
          class="bg-border/60 hidden h-3 w-px sm:inline-block"
          aria-hidden="true"></span>
        <p>{copy.signature}</p>
      </div>
    </div>
  </div>
</footer>
</EditSection>
