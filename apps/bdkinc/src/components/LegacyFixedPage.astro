---
/**
 * Static shell for legacy production pages kept at their original paths
 * (team, community, public & private hosting, watsonx). Copy comes from each
 * page's own CMS record; the leaf renders its body sections into the default
 * slot and may replace the hero image through the `hero-media` slot.
 * No islands beyond the shared Navigation; Footer and CTA render as static HTML.
 */
import { conceptAPagePaths } from '@bdkinc/content/routes';
import type { ContentContext, ContentReader } from '@/lib/content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import Footer from '@/components/Footer.astro';
import CTAButton from '@/components/CTAButton';
import EditSection from '@/components/preview/EditSection.astro';
import { getNavigationData } from '@/lib/navigation-data';
import { breadcrumbListSchema, serializeSchema } from '@/lib/schema';

export type LegacyFixedPageKey = 'the-bdk-team' | 'bdk-in-the-community' | 'public-private-hosting' | 'ibm-watsonx';

export interface LegacyImage {
  src: string;
  alt: string;
  width: number;
  height: number;
}
export interface LegacyHero {
  logo?: LegacyImage;
  headingLines: string[];
  subheading: string;
  image?: LegacyImage;
  buttonText?: string;
  buttonHref?: string;
}
export interface LegacyCta {
  kicker?: string;
  heading: string;
  body: string;
  buttonText: string;
  buttonHref: string;
}
interface Props {
  reader: ContentReader;
  contentContext?: ContentContext;
  publicPath: string;
  pageKey: LegacyFixedPageKey;
  /** Developer-owned production path of this page (registry entry pending). */
  path: string;
  /** Include the About crumb for pages that live under /about. */
  underAbout?: boolean;
  hero: LegacyHero;
  cta?: LegacyCta;
  seo: { title: string; description: string; ogDescription: string; image: string };
}

const { reader, contentContext, publicPath, pageKey, path, underAbout = false, hero, cta, seo } = Astro.props;
const settings = await reader.getSettings();
const { servicesData, recentPosts } = await getNavigationData(reader);

const lines = hero.headingLines.map((line) => line.trim()).filter(Boolean);
const breadcrumb = breadcrumbListSchema(
  [
    { name: settings.navigation.home, item: conceptAPagePaths.home },
    ...(underAbout ? [{ name: settings.navigation.about, item: conceptAPagePaths.about }] : []),
    { name: lines.join(' '), item: path },
  ],
  Astro.site?.origin ?? settings.organization.url
);
const paragraphs = (value = '') => value.split(/\n+/).map((line) => line.trim()).filter(Boolean);
const ctaParagraphs = paragraphs(cta?.body);
const hasHeroMedia = Astro.slots.has('hero-media');
const divider =
  'via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent';
---

<Layout
  reader={reader}
  title={seo.title}
  description={seo.description}
  ogDescription={seo.ogDescription}
  ogImage={seo.image || undefined}
  contentContext={contentContext}
  publicPath={publicPath}
>
  <script is:inline type="application/ld+json" set:html={serializeSchema(breadcrumb)} />
  <EditSection record="settings" section="navigation">
    <Navigation
      client:load
      services={servicesData}
      blogPosts={recentPosts}
      currentPath={publicPath}
      copy={settings.navigation}
      brand={settings.brand}
    />
  </EditSection>
  <main id="main-content" class="services-page-shell">
    <EditSection record={pageKey} section="hero">
      <section class="relative overflow-hidden px-4 pt-32 pb-16 sm:px-6 md:pb-24 lg:px-8">
        <div class="gradient-mesh absolute inset-0 opacity-30"></div>
        <div class="scanlines pointer-events-none absolute inset-0 opacity-50"></div>
        <div class="relative z-10 mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
          <div>
            {hero.logo?.src && (
              <img
                src={hero.logo.src}
                alt={hero.logo.alt}
                width={hero.logo.width}
                height={hero.logo.height}
                class="mb-8 h-auto w-56 md:w-64"
                decoding="async"
              />
            )}
            <h1 class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold tracking-tight text-balance duration-700 md:text-6xl">
              {lines.length > 1
                ? lines.map((line, index) => (
                    <span class:list={['block', index === lines.length - 1 ? 'from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent' : 'text-foreground']}>
                      {line}
                    </span>
                  ))
                : (() => {
                    const words = (lines[0] ?? '').split(/\s+/);
                    const accent = words.pop() ?? '';
                    return (
                      <>
                        {words.length > 0 && <span class="text-foreground">{words.join(' ')} </span>}
                        <span class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent">{accent}</span>
                      </>
                    );
                  })()}
            </h1>
            {hero.subheading.trim() && (
              <p class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 max-w-xl text-xl leading-relaxed text-pretty delay-200 duration-700">
                {hero.subheading}
              </p>
            )}
            {hero.buttonText?.trim() && hero.buttonHref && (
              <div class="mt-10">
                <CTAButton href={hero.buttonHref} size="lg" icon="arrow">
                  {hero.buttonText}
                </CTAButton>
              </div>
            )}
          </div>
          {hasHeroMedia ? (
            <div>
              <slot name="hero-media" />
            </div>
          ) : hero.image?.src && (
            <div class="border-border/50 bg-background/40 overflow-hidden rounded-3xl border shadow-2xl">
              <img
                src={hero.image.src}
                alt={hero.image.alt}
                width={hero.image.width}
                height={hero.image.height}
                class="h-auto w-full"
                fetchpriority="high"
                decoding="async"
              />
            </div>
          )}
        </div>
        <div class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--accent]/50"></div>
      </section>
    </EditSection>

    <slot />

    {
      cta && (cta.heading.trim() || ctaParagraphs.length > 0) && (
        <EditSection record={pageKey} section="cta">
          <section class="relative px-4 py-24 sm:px-6 md:py-32 lg:px-8">
            <div class={divider}></div>
            <div class="mx-auto max-w-3xl text-center">
              {cta.kicker?.trim() && <p class="text-primary mb-4 font-mono text-sm">{cta.kicker}</p>}
              {cta.heading.trim() && (
                <h2 class="font-display text-foreground mb-6 text-3xl font-bold tracking-tight text-balance md:text-4xl">
                  {cta.heading}
                </h2>
              )}
              <div class="space-y-5">
                {ctaParagraphs.map((text) => (
                  <p class="text-muted-foreground text-lg leading-relaxed text-pretty">{text}</p>
                ))}
              </div>
              {cta.buttonText.trim() && cta.buttonHref && (
                <div class="mt-10 flex justify-center">
                  <CTAButton href={cta.buttonHref} size="lg" icon="arrow">
                    {cta.buttonText}
                  </CTAButton>
                </div>
              )}
            </div>
          </section>
        </EditSection>
      )
    }
  </main>
  <Footer reader={reader} contentContext={contentContext} />
</Layout>
