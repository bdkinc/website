---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getSettings, type ContentProps } from '@/lib/content';
import PreviewEditor from '@/components/preview/PreviewEditor.astro';

interface Props extends ContentProps {
  title: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  twitterCard?: string;
  ogType?: string;
  robots?: string | null;
}

const { contentContext } = Astro.props;
const settings = await getSettings(contentContext);
const {
  title,
  description = settings.defaultDescription,
  publicPath = Astro.url.pathname,
  canonical = publicPath,
  ogTitle = title,
  ogDescription = description,
  ogImage = settings.defaultImage,
  ogImageAlt = settings.defaultImageAlt,
  twitterCard = 'summary_large_image',
  ogType = 'website',
  robots = 'index,follow',
} = Astro.props;

const siteOrigin = Astro.site?.origin ?? settings.organization.url;
const canonicalUrl = canonical.startsWith('http')
  ? canonical
  : new URL(canonical, siteOrigin).toString();
const ogImageUrl = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, siteOrigin).toString();
---

<!doctype html>
<html lang="en">
  <head>
    {
      import.meta.env.DEV && (
        <link rel="stylesheet" href="/virtual:stylex.css" />
      )
    }
    {
      import.meta.env.DEV && (
        <style
          is:inline
          id="__stylex_virtual__"
          transition:persist="stylex-dev-css"
        />
      )
    }
    {
      import.meta.env.DEV && (
        <script is:inline type="module" src="/@id/virtual:stylex:runtime" />
      )
    }
    {
      !import.meta.env.DEV && (
        <link
          rel="stylesheet"
          href={`${import.meta.env.BASE_URL}assets/stylex.css`}
        />
      )
    }
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      robots && (
        <meta
          name="robots"
          content={contentContext ? 'noindex,nofollow' : robots}
        />
      )
    }
    <link rel="icon" href={settings.brand.favicon} />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph Meta Tags -->
    <meta property="og:site_name" content={settings.siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <title>{title}</title>

    <!-- View Transitions -->
    {!contentContext && <ClientRouter />}

    <script is:inline>
      // Apply theme function - used on initial load and after swaps
      function applyTheme() {
        const theme =
          localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light');
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      }

      // Apply theme immediately on initial page load
      applyTheme();

      // Apply theme after each page transition to prevent flash
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body>
    <!-- Skip to main content link -->
    <a
      href="#main-content"
      class="focus:bg-primary focus:text-primary-foreground sr-only focus:not-sr-only focus:fixed focus:top-0 focus:left-0 focus:z-50 focus:p-4"
    >
      Skip to main content
    </a>
    <slot />
    {
      contentContext && (
        <PreviewEditor adminUrl={contentContext.snapshot.bdk_admin} />
      )
    }
  </body>
</html>
