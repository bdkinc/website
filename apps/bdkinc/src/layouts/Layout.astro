---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import type { ContentProps, ContentReader } from '@/lib/content';
import { getRouteSeo } from '@bdkinc/content/seo';
import type { SEO } from '@bdkinc/content/schemas';
import PreviewEditor from '@/components/preview/PreviewEditor.astro';
import { themeBootstrap } from '@/lib/theme';

interface Props extends ContentProps {
  reader: ContentReader;
  title: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  twitterCard?: string;
  ogType?: string;
  robots?: string | null;
}

const { contentContext, reader } = Astro.props;
const settings = await reader.getSettings();
const {
  title,
  description = settings.defaultDescription,
  publicPath = Astro.url.pathname,
  canonical = publicPath,
  ogTitle = title,
  ogDescription = description,
  ogImage = settings.defaultImage,
  ogImageAlt = settings.defaultImageAlt,
  twitterCard = 'summary_large_image',
  ogType = 'website',
  robots = 'index,follow',
} = Astro.props;

const previewPath = contentContext?.publicPath ?? publicPath;
const routeSeo: SEO = await getRouteSeo(reader, previewPath);
const resolvedTitle = routeSeo.title || title;
const resolvedDescription = routeSeo.description || description;
const resolvedOgImage = routeSeo.image || ogImage;
const resolvedOgImageAlt = routeSeo.imageAlt || ogImageAlt;
const resolvedOgTitle = routeSeo.title || Astro.props.ogTitle || title;
const resolvedOgDescription = routeSeo.description || Astro.props.ogDescription || description;
const propNoindex = robots?.includes('noindex') ?? false;
const effectiveRobots = routeSeo.noindex === true || propNoindex ? 'noindex,nofollow' : robots;

const siteOrigin = Astro.site?.origin ?? settings.organization.url;
const canonicalUrl = canonical.startsWith('http')
  ? canonical
  : new URL(canonical, siteOrigin).toString();
const ogImageUrl = resolvedOgImage.startsWith('http')
  ? resolvedOgImage
  : new URL(resolvedOgImage, siteOrigin).toString();
---

<!doctype html>
<html lang="en">
  <head>
    {
      import.meta.env.DEV && (
        <link rel="stylesheet" href="/virtual:stylex.css" />
      )
    }
    {
      import.meta.env.DEV && (
        <style
          is:inline
          id="__stylex_virtual__"
          transition:persist="stylex-dev-css"
        />
      )
    }
    {
      import.meta.env.DEV && (
        <script is:inline type="module" src="/@id/virtual:stylex:runtime" />
      )
    }
    {
      !import.meta.env.DEV && (
        <link
          rel="stylesheet"
          href={`${import.meta.env.BASE_URL}assets/stylex.css`}
        />
      )
    }
    <meta charset="UTF-8" />
    <meta name="description" content={resolvedDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      robots && (
        <meta
          name="robots"
          content={contentContext ? 'noindex,nofollow' : effectiveRobots}
        />
      )
    }
    <link rel="icon" href={settings.brand.favicon} />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph Meta Tags -->
    <meta property="og:site_name" content={settings.siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={resolvedOgImageAlt} />

    <title>{resolvedTitle}</title>

    <!-- View Transitions -->
    {!contentContext && <ClientRouter />}

    <script is:inline set:html={themeBootstrap} />
  </head>
  <body>
    <!-- Skip to main content link -->
    <a
      href="#main-content"
      class="focus:bg-primary focus:text-primary-foreground sr-only focus:not-sr-only focus:fixed focus:top-0 focus:left-0 focus:z-50 focus:p-4"
    >
      Skip to main content
    </a>
    <slot />
    {
      contentContext && (
        <PreviewEditor adminUrl={contentContext.snapshot.bdk_admin} />
      )
    }
  </body>
</html>
