---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import CTASection from '@/components/CTASection';
import { getNavigationData } from '@/lib/navigation-data';
import Footer from '@/components/Footer.astro';
import CoreProtocols from '@/components/CoreProtocols';
import DevelopmentLogTimeline from '@/components/DevelopmentLogTimeline';
import { MissionCard, VisionCard } from '@/components/MissionVision';
import FoundingStory from '@/components/FoundingStory.astro';
import TrustShowcase from '@/components/TrustShowcase';
import PageHeroEffects from '@/components/PageHeroEffects';
import EditSection from '@/components/preview/EditSection.astro';

import { createAppContentReader, type ContentProps } from '@/lib/content';
interface Props extends ContentProps {}
const { contentContext, publicPath = Astro.url.pathname, reader: suppliedReader } = Astro.props;
const reader = suppliedReader ?? createAppContentReader(contentContext);
const [copy, settings, home, partnerEntries] = await Promise.all([
  reader.getPage('about'), reader.getSettings(),
  reader.getPage('home'), reader.getCollection('partners'),
]);
const partners = partnerEntries
  .filter((partner) => partner.data.showOnAbout)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((partner) => ({ id: partner.id, ...partner.data }));
const { servicesData, recentPosts } = await getNavigationData(reader);

const aboutTitle = copy.metadata.title;
const aboutDescription = copy.metadata.description;
const aboutHeroHeading = copy.hero.heading;
const aboutHeroBody = copy.hero.body;
const aboutHeadingWords = aboutHeroHeading.trim().split(/\s+/);
const aboutHeadingAccent = aboutHeadingWords.pop();
const aboutHeadingLead = aboutHeadingWords.join(' ');
const aboutValuesHeading = copy.values.heading;
const aboutValuesSubheading = copy.values.subheading;
const aboutJourneyHeading = copy.journey.heading;
const aboutJourneySubheading = copy.journey.subheading;
const aboutCTATitle = copy.cta.title;
const aboutCTADescription = copy.cta.description;
const aboutCTAButtonText = copy.cta.buttonText;
const aboutCTAButtonHref = copy.cta.buttonHref;
const aboutValuesWords = aboutValuesHeading.trim().split(/\s+/);
const aboutValuesAccent = aboutValuesWords.pop();
const aboutValuesLead = aboutValuesWords.join(' ');
const aboutJourneyWords = aboutJourneyHeading.trim().split(/\s+/);
const aboutJourneyAccent = aboutJourneyWords.pop();
const aboutJourneyLead = aboutJourneyWords.join(' ');

// Icons and presentation order remain code-owned.
const valuesData = [
  { icon: 'Target', ...copy.values.clientFocus },
  { icon: 'Lightbulb', ...copy.values.innovation },
  { icon: 'Shield', ...copy.values.reliability },
  { icon: 'Users', ...copy.values.partnership },
  { icon: 'Award', ...copy.values.excellence },
  { icon: 'Clock', ...copy.values.support },
];
const milestonesData = [copy.journey.foundation, copy.journey.expansion,
  copy.journey.cloudHosting, copy.journey.infrastructure, copy.journey.publicCloud,
  copy.journey.premierPartnership, copy.journey.artificialIntelligence];
---

<Layout reader={reader}
  contentContext={contentContext}
  publicPath={publicPath}
  title={aboutTitle}
  description={aboutDescription}
  ogDescription={aboutDescription}
>
  <!-- AboutPage Schema Markup -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'AboutPage',
      mainEntity: {
        '@type': 'Organization',
        name: copy.organization.name,
        foundingDate: copy.organization.foundingDate,
        description: copy.organization.description,
        url: copy.organization.websiteUrl,
        numberOfEmployees: {
          '@type': 'QuantitativeValue',
          value: copy.organization.employeeCount,
        },
        knowsAbout: [
          copy.organization.expertise.managedIt, copy.organization.expertise.cloud,
          copy.organization.expertise.security, copy.organization.expertise.ibm,
          copy.organization.expertise.ai, copy.organization.expertise.applications,
        ],
      },
    })}
  />
  <EditSection record="settings" section="navigation">
    <Navigation
      client:load
      services={servicesData}
      blogPosts={recentPosts}
      currentPath={publicPath}
      copy={settings.navigation}
      brand={settings.brand}
    />
  </EditSection>
  <main id="main-content">
    <EditSection record="about" section="hero">
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <PageHeroEffects client:idle />
      <div class="relative z-10 mx-auto max-w-4xl text-center">
        <div
          class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
        >
          <div class="text-sm">
            {copy.hero.badgeLead}{' '}<span class="text-accent font-semibold"
              >{copy.hero.badgeAccent}</span
            >
          </div>
        </div>

        <h1
          class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold delay-100 duration-700 md:text-6xl"
        >
          <span class="text-foreground">{aboutHeadingLead} </span>
          <span
            class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
          >
            {aboutHeadingAccent}
          </span>
        </h1>
        <p
          class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 text-xl leading-relaxed delay-200 duration-700 md:text-2xl"
        >
          {aboutHeroBody}
        </p>

        <div
          class="fill-mode-both animate-in fade-in zoom-in group relative mt-12 delay-400 duration-700"
        >
          <div
            class="glass border-primary/20 relative mx-auto max-w-4xl overflow-hidden rounded-xl border shadow-lg"
          >
            {copy.hero.image ? <img src={copy.hero.image} alt={copy.hero.imageAlt} class="aspect-video w-full object-cover" /> : <div
              class="from-primary/5 via-secondary/5 to-primary/5 flex aspect-video items-center justify-center bg-linear-to-br"
            >
              <div class="text-center">
                <div
                  class="text-muted-foreground/40 mb-2 text-sm font-medium tracking-wider"
                >
                  {copy.hero.imagePlaceholder}
                </div>
                <div class="text-muted-foreground/60 text-lg">
                  {copy.hero.imageDescription}
                </div>
                <div class="text-muted-foreground/40 mt-2 text-xs">
                  {copy.hero.imageRecommendation}
                </div>
              </div>
            </div>}
          </div>
        </div>
      </div>

      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--accent]/50"
      >
      </div>
    </section>
    </EditSection>

    <EditSection record="about" section="foundingStory">
      <FoundingStory copy={copy.foundingStory} />
    </EditSection>

    <section class="mx-auto max-w-7xl py-24">
      <div class="grid gap-8 md:grid-cols-2">
        <EditSection record="about" section="mission">
          <MissionCard client:visible copy={copy.mission} />
        </EditSection>
        <EditSection record="about" section="vision">
          <VisionCard client:visible copy={copy.vision} />
        </EditSection>
      </div>
    </section>

    <EditSection record="about" section="values">
    <section class="relative overflow-hidden">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-7xl py-24">
        <div class="mb-16 text-center">
          <h2
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-4 text-4xl font-bold tracking-tight duration-600 md:text-5xl"
          >
            <span class="text-foreground">{aboutValuesLead} </span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{aboutValuesAccent}</span
            >
          </h2>
          <p
            class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-4 mx-auto max-w-2xl text-xl delay-100 duration-600"
          >
            {aboutValuesSubheading}
          </p>
        </div>

        <CoreProtocols values={valuesData} client:visible />
      </div>
    </section>
    </EditSection>

    <EditSection record="about" section="journey">
    <section class="relative px-4 py-24 sm:px-6 lg:px-8">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="mx-auto max-w-5xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-4 text-4xl font-bold tracking-tight duration-600 md:text-5xl"
          >
            <span class="text-foreground">{aboutJourneyLead} </span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{aboutJourneyAccent}</span
            >
          </h2>
          <p
            class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-4 mx-auto max-w-2xl text-xl delay-100 duration-600"
          >
            {aboutJourneySubheading}
          </p>
        </div>

        <DevelopmentLogTimeline
          milestones={milestonesData}
          foundingBrand={copy.journey.foundingBrand}
          client:visible
        />
      </div>
    </section>
    </EditSection>

    <EditSection record="home" section="trust">
      <TrustShowcase client:visible showAllPartners copy={home.trust} partners={partners} />
    </EditSection>

    <EditSection record="about" section="cta">
      <CTASection
        copy={settings.cta}
        client:visible
        title={aboutCTATitle}
        description={aboutCTADescription}
        buttonText={aboutCTAButtonText}
        buttonHref={aboutCTAButtonHref}
      />
    </EditSection>
  </main>

  <Footer reader={reader} contentContext={contentContext} />
</Layout>
