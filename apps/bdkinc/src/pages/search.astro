---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import Footer from '@/components/Footer.astro';
import SearchResults from '@/components/SearchResults';
import { getNavigationData } from '@/lib/navigation-data';
import { createAppContentReader } from '@/lib/content';
import { SEARCH_INDEX_PATH, SEARCH_PATH } from '@/lib/search';

// Static shell; results come from the lazily fetched /search-index.json.
export const prerender = true;

const reader = createAppContentReader();
const settings = await reader.getSettings();
const { servicesData, recentPosts } = await getNavigationData(reader);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
---

<Layout
  reader={reader}
  title={`Search | ${settings.siteName}`}
  description={`Search ${settings.siteName} services, locations, and blog posts.`}
  robots="noindex,nofollow"
>
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={SEARCH_PATH}
    copy={settings.navigation}
    brand={settings.brand}
  />
  <main id="main-content">
    <section class="relative overflow-hidden px-4 pt-32 pb-24 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-x-0 top-0 h-80 opacity-30"></div>
      <div class="relative z-10 mx-auto max-w-3xl">
        <h1 class="text-foreground mb-3 text-4xl font-bold tracking-tight md:text-5xl">
          Search
        </h1>
        <p class="text-muted-foreground mb-8 text-lg leading-relaxed">
          Find {settings.siteName} services, local service areas, industries, and blog posts.
        </p>
        <SearchResults
          client:load
          indexUrl={href(SEARCH_INDEX_PATH)}
          searchUrl={href(SEARCH_PATH)}
          base={base}
        />
        <noscript>
          <p class="text-muted-foreground mt-6">
            Search results need JavaScript. Use the menu above to browse services and blog posts.
          </p>
        </noscript>
      </div>
    </section>
  </main>
  <Footer reader={reader} />
</Layout>
