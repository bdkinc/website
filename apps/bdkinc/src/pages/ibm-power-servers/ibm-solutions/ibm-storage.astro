---
import LegacyIbmEmbed from '@/components/LegacyIbmEmbed.astro';
import Footer from '@/components/Footer.astro';
import Navigation from '@/components/Navigation';
import EditSection from '@/components/preview/EditSection.astro';
import Layout from '@/layouts/Layout.astro';
import { createAppContentReader, type ContentProps } from '@/lib/content';
import { getNavigationData } from '@/lib/navigation-data';

interface Props extends ContentProps {}
const { contentContext, publicPath = '/ibm-power-servers/ibm-solutions/ibm-storage', reader: suppliedReader } = Astro.props;
const reader = suppliedReader ?? createAppContentReader(contentContext);
const [copy, settings, { servicesData, recentPosts }] = await Promise.all([
  reader.getPage('ibm-storage'),
  reader.getSettings(),
  getNavigationData(reader),
]);
---

<Layout {reader} {contentContext} {publicPath} title={copy.seo.title} description={copy.seo.description.trim() || undefined}>
  <EditSection record="settings" section="navigation">
    <Navigation client:load services={servicesData} blogPosts={recentPosts} currentPath={publicPath} copy={settings.navigation} brand={settings.brand} />
  </EditSection>
  <main id="main-content">
    <EditSection record="ibm-storage" section="heading">
      <LegacyIbmEmbed heading={copy.heading} embed="storage" />
    </EditSection>
  </main>
  <Footer {reader} {contentContext} />
</Layout>
