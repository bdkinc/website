---
import { getEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import AnalyticsLifecycle from '@/components/AnalyticsLifecycle';
import TechnicalFAQ from '@/components/TechnicalFAQ';

import TechnicalSection from '@/components/TechnicalSection';
import BusinessAnalyticsVisualization from '@/components/visualizations/BusinessAnalyticsVisualization';
import FeatureCarousel from '@/components/FeatureCarousel';
import {
  PiClock,
  PiDatabase,
  PiTarget,
  PiLayout,
  PiNetwork,
  PiQuotesFill,
  PiBriefcase,
  PiChartBar,
  PiGear,
  PiBuildings,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';
const service = await getEntry('services', 'business-analytics');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');
const metrics = [
  { value: '300+', label: 'Dashboards Built', icon: PiLayout },
  { value: '80%', label: 'Report Time Saved', icon: PiClock },
  { value: '200+', label: 'Data Sources Linked', icon: PiNetwork },
  { value: '99.9%', label: 'Data Accuracy', icon: PiTarget },
];
const faqs = [
  {
    question:
      'How do you ensure data security and compliance across distributed systems?',
    answer:
      'Security is foundational to our architecture. We implement granular role-based access control (RBAC), end-to-end encryption, and rigorous audit trails to ensure your data ecosystem meets enterprise compliance standards and protects sensitive intelligence.',
  },
  {
    question:
      'Can your solutions integrate with legacy on-premise infrastructure?',
    answer:
      'Yes. Our data engineering capabilities bridge the gap between legacy silos and modern cloud architectures. We design hybrid integration layers that securely extract value from established systems without disrupting critical operations.',
  },
  {
    question: 'What is the typical latency for real-time analytics dashboards?',
    answer:
      'Latency is architected to match operational requirements. For mission-critical streams, we deploy event-driven architectures capable of sub-second processing, while strategic dashboards are optimized for high-performance querying of aggregated datasets.',
  },
];
const strategicFeatures = [
  {
    title: 'Orchestrated Intelligence',
    description:
      'Unifying disparate data sources into a single source of truth.',
    highlight: 'Single source of truth',
    icon: 'Database',
    detail:
      'We architect data ecosystems that break down operational silos. By orchestrating data from across your enterprise into a unified plane, we ensure that your analytics are based on a consistent, governed, and accurate foundation.',
  },
  {
    title: 'Predictive Foresight',
    description:
      'Moving beyond historical reporting to forward-looking insights.',
    highlight: 'Forward-looking insights',
    icon: 'ChartLine',
    detail:
      "Don't just react to what happened yesterday. Our predictive modeling capabilities identify emerging market trends and operational risks before they manifest, allowing you to navigate complexity with proactive precision.",
  },
  {
    title: 'Real-Time Velocity',
    description:
      'High-performance data pipelines for sub-second operational awareness.',
    highlight: 'Sub-second awareness',
    icon: 'Lightning',
    detail:
      'In high-stakes environments, latency is a liability. We build event-driven architectures that process and visualize critical data streams in real-time, providing your leadership with the velocity required to make split-second decisions.',
  },
  {
    title: 'Strategic Transparency',
    description:
      'Objective performance metrics aligned with organizational goals.',
    highlight: 'Performance alignment',
    icon: 'Target',
    detail:
      'Align your entire team around objective truth. Our strategic dashboards translate complex datasets into clear, actionable KPIs, ensuring that every level of your organization is focused on the metrics that drive actual business value.',
  },
];
---

<Layout
  title={`${service.data.title} - BDKinc`}
  description="Turn Data into Decisions. Strategic Intelligence at Scale. Transform raw data into competitive advantage with our advanced analytics, predictive modeling, and real-time BI dashboards."
>
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <!-- Analytics-specific: data-grid table row overlay -->
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.035]"
        style="background-image: repeating-linear-gradient(0deg, oklch(0.65 0.18 210) 0px, oklch(0.65 0.18 210) 1px, transparent 1px, transparent 32px), repeating-linear-gradient(90deg, oklch(0.65 0.18 210) 0px, oklch(0.65 0.18 210) 1px, transparent 1px, transparent 120px); background-size: 120px 32px;"
        aria-hidden="true"
      >
      </div>
      <div class="circuit-overlay absolute inset-0 opacity-40"></div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
          <!-- Badge -->
          <div
            class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
          >
            <div class="flex items-center gap-2 text-sm">
              <span
                >Actionable <span class="text-accent font-semibold"
                  >Intelligence</span
                ></span
              >
            </div>
          </div>
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <!-- Heading -->
          <h1
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold tracking-tight delay-100 duration-700 md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <!-- Subtitle -->
          <p
            class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 mx-auto mb-16 max-w-3xl text-xl leading-relaxed delay-200 duration-700"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            Turn Data into Decisions. Strategic Intelligence at Scale. We
            architect robust data ecosystems that unify disparate sources into a
            single source of truth.
          </p>
        </div>
        <!-- Visualization -->
        <div
          class="fill-mode-both animate-in fade-in zoom-in delay-300 duration-700"
        >
          <div class="mx-auto max-w-5xl">
            <BusinessAnalyticsVisualization client:visible />
          </div>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--accent]/50"
      >
      </div>
    </section>
    <!-- Analytics Lifecycle -->
    <section
      class="bg-muted/30 px-4 py-24 sm:px-6 lg:px-8 dark:bg-white/[0.02]"
    >
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight normal-case md:text-4xl"
          >
            <span class="text-foreground">Analytics </span>
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >Lifecycle</span
            >
          </h2>
        </div>
        <AnalyticsLifecycle client:visible />
      </div>
    </section>
    <!-- Strategic Leadership Section -->
    <section class="relative overflow-hidden py-24">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-4xl font-bold tracking-tight duration-600 md:text-5xl"
          >
            <span class="text-foreground">Strategic </span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Intelligence</span
            >
          </h2>
        </div>

        <!-- Glass Quote Container -->
        <div class="relative mx-auto max-w-4xl">
          <!-- Floating Icon -->
          <div class="text-primary absolute -top-10 -left-6 z-20 md:-left-10">
            <PiQuotesFill
              className="h-20 w-20 rotate-[-12deg] drop-shadow-xl filter"
              aria-hidden="true"
            />
          </div>

          <!-- Glass Card -->
          <div
            class="relative z-10 overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-10 backdrop-blur-xl md:p-14 dark:border-white/[0.05] dark:bg-white/[0.03]"
          >
            <!-- Ambient Glow -->
            <div
              class="bg-primary/20 absolute -top-24 -right-24 h-64 w-64 rounded-full opacity-50 blur-3xl"
            >
            </div>
            <div
              class="bg-secondary/20 absolute -bottom-24 -left-24 h-64 w-64 rounded-full opacity-50 blur-3xl"
            >
            </div>

            <!-- Background Watermark -->
            <div
              class="pointer-events-none absolute top-0 right-0 z-0 opacity-[0.03]"
            >
              <PiQuotesFill
                className="h-64 w-64 translate-x-1/4 -translate-y-1/4 -rotate-12"
                aria-hidden="true"
              />
            </div>

            <blockquote
              class="font-display text-foreground relative z-10 text-center text-2xl leading-relaxed font-medium md:text-3xl"
            >
              &ldquo;Data without direction is overhead. We transform raw
              telemetry into
              <span class="text-accent"> actionable foresight</span>, aligning
              your entire organization around a single source of objective truth
              that drives actual business value.&rdquo;
            </blockquote>
          </div>
        </div>
      </div>
      <div
        class="via-primary/20 absolute bottom-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
    </section>
    <!-- Data Maturity Model -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            Your Data <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Maturity Journey</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            Where are you today — and where do we take you?
          </p>
        </div>
        <div class="relative">
          <!-- Horizontal progress bar -->
          <div
            class="from-border via-primary/40 to-primary absolute top-8 right-[3rem] left-[3rem] hidden h-px bg-linear-to-r md:block"
            aria-hidden="true"
          >
          </div>
          <div class="grid gap-8 md:grid-cols-4">
            {
              [
                {
                  stage: '01',
                  label: 'Ad-Hoc',
                  tone: 'text-muted-foreground',
                  borderTone: 'border-border',
                  bgTone: 'bg-muted/30',
                  desc: 'Siloed spreadsheets, manual pull requests, no single source of truth. Decisions based on gut feel.',
                  current: false,
                },
                {
                  stage: '02',
                  label: 'Descriptive',
                  tone: 'text-muted-foreground',
                  borderTone: 'border-border',
                  bgTone: 'bg-muted/30',
                  desc: 'Basic BI dashboards showing what happened. Historical reporting, monthly cadence.',
                  current: false,
                },
                {
                  stage: '03',
                  label: 'Predictive',
                  tone: 'text-primary',
                  borderTone: 'border-primary/40',
                  bgTone: 'bg-primary/5',
                  desc: 'ML models forecast what will happen. Proactive decisions on demand, risk, and resource allocation.',
                  current: true,
                },
                {
                  stage: '04',
                  label: 'Prescriptive',
                  tone: 'text-secondary',
                  borderTone: 'border-secondary/40',
                  bgTone: 'bg-secondary/5',
                  desc: 'AI recommends specific actions. Real-time optimization and automated decision pathways.',
                  current: false,
                },
              ].map(
                ({ stage, label, tone, borderTone, bgTone, desc, current }) => (
                  <div
                    class={`relative rounded-xl border ${borderTone} ${bgTone} p-6`}
                  >
                    {current && (
                      <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                        <span class="text-primary bg-primary/15 border-primary/30 rounded-full border px-3 py-1 font-mono text-[10px] font-bold tracking-widest whitespace-nowrap">
                          BDK Target
                        </span>
                      </div>
                    )}
                    <div class="bg-background mb-4 flex h-12 w-12 items-center justify-center rounded-full border border-current/30">
                      <span class={`font-mono text-sm font-bold ${tone}`}>
                        {stage}
                      </span>
                    </div>
                    <h3 class={`font-display mb-3 text-lg font-bold ${tone}`}>
                      {label}
                    </h3>
                    <p class="text-muted-foreground text-sm leading-relaxed">
                      {desc}
                    </p>
                  </div>
                )
              )
            }
          </div>
        </div>
      </div>
    </section>
    <!-- Strategic Advantage -->
    <section
      class="to-muted/20 bg-linear-to-b from-transparent px-4 py-24 sm:px-6 lg:px-8 dark:to-white/[0.02]"
    >
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            The Strategic <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Advantage</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            Move beyond static reports with a partner who builds
            high-performance data ecosystems.
          </p>
        </div>
        <FeatureCarousel client:visible features={strategicFeatures} />
      </div>
    </section>
    <!-- Role-Based Benefits: Who Gets Value -->
    <section
      class="bg-muted/20 px-4 py-24 sm:px-6 lg:px-8 dark:bg-white/[0.01]"
    >
      <div class="mx-auto max-w-6xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            Built for <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Decision-Makers</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            Every role in your organization gets a direct line to the
            intelligence they need.
          </p>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            [
              {
                Icon: PiBriefcase,
                role: 'CFO',
                pain: 'Spending hours consolidating financial reports from 6 systems',
                gain: 'One live dashboard — P&L, cash flow, and variance analysis in real time',
              },
              {
                Icon: PiGear,
                role: 'COO',
                pain: 'Operational bottlenecks visible only after they&rsquo;ve already caused delays',
                gain: 'Predictive alerts surface inefficiencies 2–3 weeks before they escalate',
              },
              {
                Icon: PiChartBar,
                role: 'VP Sales',
                pain: 'Pipeline reporting that&rsquo;s 2 weeks stale and manually assembled',
                gain: 'Real-time revenue intelligence with forecast accuracy models',
              },
              {
                Icon: PiDatabase,
                role: 'Data / IT Team',
                pain: 'Fielding ad-hoc data requests that consume 40% of sprint capacity',
                gain: 'Self-serve analytics layer so business teams answer their own questions',
              },
              {
                Icon: PiBuildings,
                role: 'CEO / Board',
                pain: 'Strategic decisions made on incomplete or conflicting data signals',
                gain: 'Executive scorecard aligned to OKRs with drill-down to source data',
              },
              {
                Icon: PiNetwork,
                role: 'Supply Chain',
                pain: 'Demand planning based on last quarter&rsquo;s numbers and gut instinct',
                gain: 'ML-driven demand forecasting reducing inventory over/under by up to 35%',
              },
            ].map(({ Icon, role, pain, gain }) => (
              <div class="group border-border bg-card/30 hover:border-primary/30 relative overflow-hidden rounded-xl border p-6 transition-[border-color,box-shadow] duration-300 hover:shadow-[0_0_20px_oklch(0.65_0.18_210_/_0.06)]">
                <div class="mb-4 flex items-center gap-3">
                  <div class="bg-primary/10 group-hover:bg-primary/20 rounded-lg p-2 transition-[background-color] duration-300">
                    <Icon className="h-5 w-5 text-primary" aria-hidden="true" />
                  </div>
                  <span class="font-display text-foreground text-sm font-bold">
                    {role}
                  </span>
                </div>
                <div class="mb-3">
                  <p
                    class="text-muted-foreground/70 decoration-destructive/40 text-xs leading-relaxed line-through"
                    set:html={pain}
                  />
                </div>
                <div class="border-primary/10 border-t pt-3">
                  <p
                    class="text-foreground text-sm leading-relaxed"
                    set:html={gain}
                  />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>
    <TechnicalSection
      client:visible
      id="analytics-vault"
      overlayOpacity="opacity-10"
    >
      <div class="relative z-10 flex flex-col items-center text-center">
        <div
          class="border-primary/30 bg-primary/10 mb-6 flex items-center gap-2 rounded-full border px-4 py-1"
        >
          <div class="bg-primary h-2 w-2 animate-pulse rounded-full"></div>
          <span
            class="text-primary font-display text-xs font-bold tracking-widest"
            >Analytics Insight Vault</span
          >
        </div>
        <h3
          class="text-foreground font-display mb-6 max-w-2xl text-3xl font-bold tracking-tight"
        >
          Engineered Clarity. <span class="text-primary"
            >Actionable Foresight.</span
          >
        </h3>
        <div
          class="text-muted-foreground mx-auto max-w-4xl font-sans text-lg leading-relaxed"
        >
          We transform raw data into a competitive asset. From real-time
          ingestion to predictive modeling, our solutions empower your
          organization to navigate complexity with precision and foresight,
          ensuring every decision is backed by objective, governed intelligence.
        </div>
      </div>
    </TechnicalSection>

    <!-- FAQ -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
          Frequently Asked Questions
        </h3>
        <div class="mb-20">
          <TechnicalFAQ client:visible faqs={faqs} />
        </div>
      </div>
    </section>
    <ImpactMetricsSection metrics={metrics} />
    <!-- CTA -->
    <CTASection
      client:visible
      title="Turn Data into Your Greatest Asset"
      description="Stop guessing and start knowing. Let’s architect an intelligence strategy that drives measurable business outcomes."
      buttonText="Request an Analytics Audit"
      buttonHref="/contact#chat"
    />
  </main>
  <Footer />
</Layout>
