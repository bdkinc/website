---
import { createAppContentReader, type ContentProps } from '@/lib/content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import AnalyticsLifecycle from '@/components/AnalyticsLifecycle';
import TechnicalFAQ from '@/components/TechnicalFAQ';

import CohesiveOrbit from '@/components/visualizations/CohesiveOrbit';
import FeatureCarousel, { type Feature } from '@/components/FeatureCarousel';
import ServiceBlockquote from '@/components/ServiceBlockquote.astro';
import BenefitGrid from '@/components/BenefitGrid.astro';
import {
  PiClock,
  PiDatabase,
  PiTarget,
  PiLayout,
  PiNetwork,
  PiBriefcase,
  PiChartBar,
  PiGear,
  PiBuildings,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';
import EditSection from '@/components/preview/EditSection.astro';
import { servicePageSchemas } from '@/lib/schema';
interface Props extends ContentProps {}
const { contentContext, publicPath = Astro.url.pathname, reader: suppliedReader } = Astro.props;
const reader = suppliedReader ?? createAppContentReader(contentContext);
const copy = await reader.getPage('service-business-analytics');
const settings = await reader.getSettings();
const service = (await reader.getCollection('services')).find((entry) => entry.id === 'business-analytics');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData(reader);
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');
const metrics = [
  { ...copy.metrics.dashboardsBuilt, icon: PiLayout },
  { ...copy.metrics.reportTimeSaved, icon: PiClock },
  { ...copy.metrics.dataSourcesLinked, icon: PiNetwork },
  { ...copy.metrics.dataAccuracy, icon: PiTarget },
];
const faqs = [
  copy.faqs.howDoYouEnsureDataSecurityAnd,
  copy.faqs.canYourSolutionsIntegrateWithLegacyOn,
  copy.faqs.whatIsTheTypicalLatencyForReal,
];
const { breadcrumb: breadcrumbSchema, faq: faqSchema } = servicePageSchemas({
  copy: settings.navigation,
  serviceName: service.data.title,
  servicePath: `/services/${service.id}`,
  faqs,
});
const strategicFeatures: Feature[] = [
  { ...copy.strategy.features.orchestratedIntelligence, icon: 'Database' },
  { ...copy.strategy.features.predictiveForesight, icon: 'ChartLine' },
  { ...copy.strategy.features.realTimeVelocity, icon: 'Lightning' },
  { ...copy.strategy.features.strategicTransparency, icon: 'Target' },
];

const roleBenefits = [
  { Icon: PiBriefcase, ...copy.benefits.roles.cfo },
  { Icon: PiGear, ...copy.benefits.roles.coo },
  { Icon: PiChartBar, ...copy.benefits.roles.vpSales },
  { Icon: PiDatabase, ...copy.benefits.roles.dataItTeam },
  { Icon: PiBuildings, ...copy.benefits.roles.ceoBoard },
  { Icon: PiNetwork, ...copy.benefits.roles.supplyChain },
];
---

<Layout reader={reader}
  contentContext={contentContext}
  publicPath={publicPath}
  title={`${service.data.title} - BDKinc`}
  description={copy.seo.description}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema)}
  />
  <EditSection record="settings" section="navigation">
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={publicPath}
    copy={settings.navigation}
    brand={settings.brand}
  />
  </EditSection>
  <main id="main-content" class="services-page-shell">
    <EditSection record="service-business-analytics" section="hero">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="scanlines pointer-events-none absolute inset-0 opacity-50">
      </div>
      <div
        class="pointer-events-none absolute inset-0 z-0 flex items-center justify-center opacity-80 md:opacity-100"
      >
        <CohesiveOrbit client:idle />
      </div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
          <!-- Badge -->
          <div
            class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
          >
            <div class="flex items-center gap-2 text-sm">
              <span
                >{copy.hero.badgePrefix}{' '}<span
                  class="text-accent font-semibold"
                  >{copy.hero.badgeAccent}</span
                ></span
              >
            </div>
          </div>
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <!-- Heading -->
          <h1
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold tracking-tight delay-100 duration-700 md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <!-- Subtitle -->
          <p
            class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 mx-auto mb-16 max-w-3xl text-xl leading-relaxed delay-200 duration-700"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            {copy.hero.body}
          </p>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--accent]/50"
      >
      </div>
    </section>
    </EditSection>
    <EditSection record="service-business-analytics" section="lifecycle">
    <!-- Analytics Lifecycle -->
    <section class="px-4 py-24">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight normal-case md:text-4xl"
          >
            <span class="text-foreground">{copy.lifecycle.heading}{' '}</span>
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.lifecycle.headingAccent}</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-lg">
            {copy.lifecycle.body}
          </p>
        </div>
        <AnalyticsLifecycle client:visible copy={copy.lifecycle.steps} />
      </div>
    </section>
    </EditSection>
    <EditSection record="service-business-analytics" section="leadership">
    <!-- Strategic Leadership Section -->
    <section class="relative overflow-hidden py-24">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-4xl font-bold tracking-tight duration-600 md:text-5xl"
          >
            <span class="text-foreground">{copy.leadership.heading}{' '}</span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.leadership.headingAccent}</span
            >
          </h2>
        </div>

        <ServiceBlockquote>
          {copy.leadership.quoteBefore}{' '}<span class="text-accent"
            >{copy.leadership.quoteAccent}</span
          >{copy.leadership.quoteAfter}
        </ServiceBlockquote>
      </div>
      <div
        class="via-primary/20 absolute bottom-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
    </section>
    </EditSection>
    <EditSection record="service-business-analytics" section="maturity">
    <!-- Data Maturity Model -->
    <section class="relative overflow-hidden px-4 py-32 sm:px-6 lg:px-8">
      <!-- Background effects -->
      <div
        class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-20"
      >
        <div
          class="bg-primary/20 h-[500px] w-[800px] rounded-full blur-[120px]"
        >
        </div>
      </div>

      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="mb-24 text-center">
          <h2
            class="font-display mb-6 text-4xl font-bold tracking-tight md:text-5xl"
          >
            {copy.maturity.heading}{' '}<span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.maturity.headingAccent}</span
            >
          </h2>
          <p
            class="text-muted-foreground mx-auto max-w-2xl text-xl leading-relaxed"
          >
            {copy.maturity.body}
          </p>
        </div>

        <div class="relative">
          <!-- Connecting Path (Desktop) -->
          <div
            class="absolute top-8 right-[10%] left-[10%] hidden h-0.5 overflow-hidden rounded-full md:block"
          >
            <!-- Base Line -->
            <div class="bg-muted/30 absolute inset-0"></div>
            <!-- Steady Gradient Background -->
            <div
              class="from-muted-foreground via-primary to-accent absolute inset-0 bg-linear-to-r opacity-20"
            >
            </div>
            <!-- Animated Progress Beam -->
            <div
              class="via-primary absolute top-0 bottom-0 left-0 w-1/2 animate-[shimmer_3s_linear_infinite] bg-linear-to-r from-transparent to-transparent opacity-80 blur-sm"
              style="animation-name: slide-right; animation-duration: 3s; animation-iteration-count: infinite;"
            >
            </div>
            <!-- Add keyframes for this specific local animation if not global -->
            <style>
              @keyframes slide-right {
                0% {
                  transform: translateX(-100%);
                }
                100% {
                  transform: translateX(200%);
                }
              }
            </style>
          </div>

          <div class="grid gap-8 md:grid-cols-4">
            {
              [
                {
                  stage: '01',
                  ...copy.maturity.stages.adHoc,
                  color: 'foreground',
                },
                {
                  stage: '02',
                  ...copy.maturity.stages.descriptive,
                  color: 'primary',
                },
                {
                  stage: '03',
                  ...copy.maturity.stages.predictive,
                  color: 'secondary',
                },
                {
                  stage: '04',
                  ...copy.maturity.stages.prescriptive,
                  color: 'accent',
                },
              ].map(({ stage, label, color, desc }) => {
                // Map color names to Tailwind classes
                const colorScales = {
                  primary: {
                    border: 'border-primary/30 hover:border-primary',
                    bg: 'bg-primary/5',
                    text: 'text-primary',
                    iconBg: 'bg-primary/10',
                    connector: 'from-primary',
                  },
                  secondary: {
                    border: 'border-secondary/30 hover:border-secondary',
                    bg: 'bg-secondary/5',
                    text: 'text-secondary',
                    iconBg: 'bg-secondary/10',
                    connector: 'from-secondary',
                  },
                  accent: {
                    border: 'border-accent/30 hover:border-accent',
                    bg: 'bg-accent/5',
                    text: 'text-accent',
                    iconBg: 'bg-accent/10',
                    connector: 'from-accent',
                  },
                  foreground: {
                    border: 'border-foreground/30 hover:border-foreground',
                    bg: 'bg-foreground/5',
                    text: 'text-foreground',
                    iconBg: 'bg-foreground/10',
                    connector: 'from-foreground',
                  },
                };

                const theme = colorScales[color as keyof typeof colorScales];

                return (
                  <div class="group relative flex h-full flex-col pt-16">
                    {/* Node on the path */}
                    <div class="absolute top-8 left-1/2 z-20 hidden -translate-x-1/2 -translate-y-1/2 md:block">
                      <div
                        class={`bg-background h-4 w-4 rounded-full border-2 transition-transform duration-300 group-hover:scale-150 ${theme.border.split(' ')[0]} ${theme.text}`}
                      />
                    </div>

                    {/* Vertical connector line */}
                    <div
                      class={`absolute top-8 left-1/2 hidden h-8 w-px -translate-x-1/2 bg-linear-to-b to-transparent md:block ${theme.connector}`}
                    />

                    {/* Card */}
                    <div
                      class={`relative z-10 flex h-full flex-col rounded-3xl border p-8 backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl ${theme.border} ${theme.bg}`}
                    >
                      {/* Subtle gradient overlay */}
                      <div class="pointer-events-none absolute inset-0 rounded-3xl bg-linear-to-br from-white/5 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100 dark:from-white/5" />

                      <div class="mb-6 flex items-center justify-between">
                        <span
                          class={`font-mono text-5xl font-black opacity-20 ${theme.text}`}
                        >
                          {stage}
                        </span>
                        <div
                          class={`flex h-12 w-12 items-center justify-center rounded-2xl border border-current/20 ${theme.iconBg} ${theme.text}`}
                        >
                          <div class="h-2 w-2 animate-pulse rounded-full bg-current" />
                        </div>
                      </div>

                      <h3
                        class={`font-display mb-4 text-2xl font-bold ${theme.text}`}
                      >
                        {label}
                      </h3>

                      <p class="text-muted-foreground leading-relaxed">
                        {desc}
                      </p>
                    </div>
                  </div>
                );
              })
            }
          </div>
        </div>
      </div>
    </section>
    </EditSection>
    <EditSection record="service-business-analytics" section="strategy">
    <!-- Strategic Advantage -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            {copy.strategy.heading}{' '}<span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.strategy.headingAccent}</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            {copy.strategy.body}
          </p>
        </div>
        <FeatureCarousel client:visible features={strategicFeatures} />
      </div>
    </section>
    </EditSection>
    <EditSection record="service-business-analytics" section="benefits">
    <!-- Role-Based Benefits: Who Gets Value -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <BenefitGrid
          copy={settings.benefits}
          benefits={roleBenefits.map(({ Icon, role, pain, gain }) => ({
            icon: Icon,
            title: role,
            pain,
            gain,
          }))}
          title={copy.benefits.title}
          subtitle={copy.benefits.subtitle}
        />
      </div>
    </section>

    </EditSection>
    <EditSection record="service-business-analytics" section="faqs" also={['faqHeading']}>
    <!-- FAQ -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
          {copy.faqHeading}
        </h3>
        <div class="mb-20">
          <TechnicalFAQ client:visible faqs={faqs} />
        </div>
      </div>
    </section>
    </EditSection>
    <EditSection record="service-business-analytics" section="metrics">
    <ImpactMetricsSection metrics={metrics} copy={settings.metrics} />
    </EditSection>
    <EditSection record="service-business-analytics" section="cta">
    <!-- CTA -->
    <CTASection client:visible copy={settings.cta} {...copy.cta} />
    </EditSection>
  </main>
  <Footer reader={reader} contentContext={contentContext} />
</Layout>
