---
import { getEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import { TechCard, TechCardGrid } from '@/components/TechCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import FeatureCarousel from '@/components/FeatureCarousel';
import CohesiveOrbit from '@/components/visualizations/CohesiveOrbit';
import ServiceBlockquote from '@/components/ServiceBlockquote.astro';

import {
  PiHeadphones,
  PiCheckCircle,
  PiMapPin,
  PiClock,
  PiUsersThree,
  PiShieldCheck,
  PiTrendUp,
  PiLightning,
  PiMonitor,
  PiArrowRight,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';
const service = await getEntry('services', 'managed-it');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');
const _serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.title,
  description:
    'Elite managed IT services delivering 24/7 enterprise support, proactive infrastructure management, and strategic technology leadership for growth-focused organizations.',
  provider: {
    '@type': 'Organization',
    name: 'BDKinc',
    url: 'https://www.bdkinc.com',
  },
  serviceType: 'Managed IT Services',
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
  },
};
const metrics = [
  { value: '10K+', label: 'Tickets Closed', icon: PiHeadphones },
  { value: '98%', label: 'First-Call Resolution', icon: PiCheckCircle },
  { value: '2', label: 'Hour Onsite SLA', icon: PiMapPin },
  { value: '24/7', label: 'Support Coverage', icon: PiClock },
];
const faqs = [
  {
    question: 'How does BDKinc integrate with our existing internal IT team?',
    answer:
      'We function as a force multiplier for your internal team. Our Co-Managed IT model handles the heavy lifting of monitoring, patching, and Level 1 support, freeing your internal leaders to focus on high-value strategic initiatives and proprietary business applications.',
  },
  {
    question: 'What industries do you specialize in supporting?',
    answer:
      'We specialize in high-complexity, compliance-driven sectors including healthcare, finance, manufacturing, and logistics. Our engineers are well-versed in the regulatory requirements and operational demands of environments where downtime is not an option.',
  },
  {
    question: 'How do you handle rapid organizational scaling or M&A activity?',
    answer:
      'Our infrastructure is built for elasticity. We have extensive experience navigating the technical integration of mergers and acquisitions, standardizing disparate systems, and rapidly onboarding new users to ensure business continuity during critical growth phases.',
  },
];
const strategicFeatures = [
  {
    title: 'Operational Resilience',
    description:
      'Systems designed for 99.99% uptime, ensuring your business never pauses.',
    highlight: '99.99% uptime',
    icon: 'CheckCircle',
    detail:
      "Our managed infrastructure is built on high-availability clusters and redundant network paths. We don't just aim for uptime; we guarantee it through rigorous architectural standards and automated failover protocols that keep your critical applications running even during hardware failures.",
  },
  {
    title: 'Scalable Architecture',
    description:
      'Infrastructure that adapts instantly to mergers, acquisitions, and rapid user growth.',
    highlight: 'adapts instantly',
    icon: 'TrendUp',
    detail:
      "Growth shouldn't be painful. Whether you're onboarding 50 new employees or integrating a newly acquired branch, our cloud-first architecture allows for rapid resource provisioning. We eliminate the 'wait-and-see' approach to hardware procurement, replacing it with elastic capacity.",
  },
  {
    title: 'Cost Predictability',
    description:
      'Shift from volatile capital expenditures to predictable, value-driven operational models.',
    highlight: 'value-driven operational models',
    icon: 'Lightning',
    detail:
      "Eliminate the 'surprise' IT bill. Our flat-fee managed services model turns your IT spend into a predictable monthly utility. This allows for better financial planning and ensures that our incentives are perfectly aligned with yours: keeping your systems running perfectly.",
  },
  {
    title: 'Security Posture',
    description:
      'Enterprise-grade defense mechanisms interwoven into daily operations, not bolted on.',
    highlight: 'interwoven into daily operations',
    icon: 'ShieldCheck',
    detail:
      "Security is not a separate department; it's a fundamental property of every system we manage. From endpoint protection and multi-factor authentication to continuous vulnerability scanning, we build a 'defense-in-depth' strategy that protects your intellectual property and customer data.",
  },
];
---

<Layout
  title="Elite Managed IT Services & Strategic Technology Management | BDKinc"
  description="Transform your technology into a competitive advantage. BDKinc provides elite managed IT services, 24/7 enterprise support, and strategic infrastructure leadership for growth-focused organizations."
  ogDescription="Elite managed IT services delivering 24/7 enterprise support, proactive infrastructure management, and strategic technology leadership for growth-focused organizations."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(_serviceSchema)}
  />
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content" class="services-page-shell">
    <!-- Hero Section -->
    <section
      class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 md:pt-32 md:pb-24 lg:px-8"
    >
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="scanlines pointer-events-none absolute inset-0 opacity-50"></div>

      <!-- Visualization -->
      <div
        class="pointer-events-none absolute inset-0 z-0 flex items-center justify-center opacity-80 md:opacity-100"
      >
        <CohesiveOrbit client:load />
      </div>

      <div class="relative z-10 mx-auto max-w-7xl">
        <div
          class="relative z-10 mx-auto flex max-w-4xl flex-col items-center text-center"
        >
          <!-- Badge -->
          <div
            class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
          >
            <div class="flex items-center gap-2 text-sm">
              <span
                >24/7 Business <span class="text-accent font-semibold"
                  >Support</span
                ></span
              >
            </div>
          </div>
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <!-- Heading -->
          <h1
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold tracking-tight delay-100 duration-700 md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <!-- Subtitle -->
          <p
            class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 mx-auto mb-16 max-w-3xl text-xl leading-relaxed delay-200 duration-700"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            Technology shouldn&rsquo;t be a bottleneck; it should be an
            accelerator. We monitor your systems 24/7, preventing issues before
            they disrupt your operations.
          </p>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--accent]/50"
      >
      </div>
    </section>
    <!-- Core Services -->
    <section class="relative px-4 py-24 sm:px-6 md:py-32 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight normal-case md:text-4xl"
          >
            <span class="text-foreground">Core </span>
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >Capabilities</span
            >
          </h2>
          <p
            class="text-muted-foreground mx-auto mt-4 max-w-2xl font-sans text-xl"
          >
            Comprehensive infrastructure management designed for the
            <span class="text-accent font-semibold">modern enterprise</span>.
          </p>
        </div>
        <TechCardGrid client:visible className="md:grid-cols-3">
          <TechCard
            variant="technical"
            interactive={true}
            trackingColor={'primary'}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="from-primary/10 to-primary/5 border-primary/20 group-hover:border-primary/50 mx-auto mb-6 flex w-fit items-center justify-center rounded-xl border bg-linear-to-br p-5 transition-colors duration-500 group-hover:scale-110"
              >
                <PiHeadphones
                  className="text-primary h-10 w-10"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Enterprise Service Desk
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Beyond basic troubleshooting. Our tiered support structure
                resolves 98% of incidents on first contact, providing your team
                with immediate access to senior engineers.
              </div>
            </div>
          </TechCard>
          <TechCard
            variant="technical"
            interactive={true}
            trackingColor={'secondary'}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="from-secondary/10 to-secondary/5 border-secondary/20 group-hover:border-secondary/50 mx-auto mb-6 flex w-fit items-center justify-center rounded-xl border bg-linear-to-br p-5 transition-colors duration-500 group-hover:scale-110"
              >
                <PiTrendUp
                  className="text-secondary h-10 w-10"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-secondary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Predictive Intelligence
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                We don't just react to alerts; we anticipate failures utilizing
                advanced telemetry and AI-driven analytics to identify anomalies
                before they impact your users.
              </div>
            </div>
          </TechCard>
          <TechCard
            variant="technical"
            interactive={true}
            trackingColor={'accent'}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="from-accent/20 to-accent/10 border-accent/30 group-hover:border-accent/60 mx-auto mb-6 flex w-fit items-center justify-center rounded-xl border bg-linear-to-br p-5 transition-colors duration-500 group-hover:scale-110"
              >
                <PiUsersThree
                  className="text-accent h-10 w-10"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-accent mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Strategic Co-Management
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Whether acting as your entire IT department or augmenting your
                internal team, we integrate seamlessly with your workflows and
                provide specialized expertise.
              </div>
            </div>
          </TechCard>
        </TechCardGrid>
      </div>
    </section>
    <!-- Strategic Leadership Section -->
    <section class="relative overflow-hidden py-24 md:py-32">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-4xl font-bold tracking-tight duration-600 md:text-5xl"
          >
            <span class="text-foreground">Technology </span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Leadership</span
            >
          </h2>
        </div>

        <ServiceBlockquote>
          &ldquo;True business growth requires more than keeping the lights on.
          It demands a technology strategy that
          <span class="text-accent"> anticipates challenges</span>
          and scales with your ambition. We architect, manage, and secure your
          infrastructure so you can focus on driving your business forward.&rdquo;
        </ServiceBlockquote>
      </div>
      <div
        class="via-primary/20 absolute bottom-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
    </section>
    <!-- Technology Leadership -->
    <section class="relative px-4 py-24 sm:px-6 md:py-32 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            The Strategic <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Advantage</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            Move beyond break/fix and operational drag with a partner who builds
            for the future.
          </p>
        </div>
        <FeatureCarousel client:visible features={strategicFeatures} />
      </div>
    </section>
    <!-- The Shift: Before/After Contrast Section -->
    <section class="relative px-4 py-24 sm:px-6 md:py-32 lg:px-8">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="mx-auto max-w-6xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-4xl font-bold tracking-tight text-balance md:text-5xl lg:text-6xl"
          >
            Stop Managing IT.{' '}
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Start Leading It.</span
            >
          </h2>
          <p
            class="text-muted-foreground mx-auto max-w-2xl text-xl text-balance"
          >
            Here&rsquo;s what changes when BDK takes ownership of your
            infrastructure.
          </p>
        </div>
        <div
          class="border-border/50 bg-background/40 relative grid gap-0 overflow-hidden rounded-3xl border shadow-2xl backdrop-blur-xl md:grid-cols-2"
        >
          <!-- Center Arrow (Desktop) -->
          <div
            class="absolute top-1/2 left-1/2 z-20 hidden -translate-x-1/2 -translate-y-1/2 items-center justify-center md:flex"
          >
            <div
              class="border-border/50 bg-background relative flex h-14 w-14 items-center justify-center rounded-full border shadow-xl"
            >
              <div
                class="bg-primary/10 flex h-10 w-10 items-center justify-center rounded-full"
              >
                <PiArrowRight
                  className="text-primary h-5 w-5"
                  aria-hidden="true"
                />
              </div>
            </div>
          </div>
          <!-- Left: What You Stop Worrying About -->
          <div class="bg-muted/30 relative p-8 md:p-12 dark:bg-white/[0.02]">
            <div
              class="from-destructive/10 pointer-events-none absolute inset-0 bg-linear-to-br via-transparent to-transparent"
            >
            </div>
            <div
              class="pointer-events-none absolute inset-0 opacity-[0.02]"
              style="background-image: repeating-linear-gradient(45deg, #000 0, #000 1px, transparent 0, transparent 50%); background-size: 10px 10px;"
            >
            </div>
            <div class="relative z-10">
              <div class="mb-10 flex items-center gap-4">
                <div
                  class="bg-destructive/10 border-destructive/20 flex h-12 w-12 items-center justify-center rounded-xl border"
                >
                  <PiMonitor
                    className="text-destructive h-6 w-6"
                    aria-hidden="true"
                  />
                </div>
                <h3
                  class="font-display text-foreground/80 text-2xl font-bold tracking-tight"
                >
                  The Old Way
                </h3>
              </div>
              <ul class="space-y-6">
                {
                  [
                    {
                      icon: PiClock,
                      text: '3am alerts waking your team for server issues',
                    },
                    {
                      icon: PiShieldCheck,
                      text: 'Patch cycles slipping and creating security gaps',
                    },
                    {
                      icon: PiLightning,
                      text: 'Unexpected hardware failures disrupting operations',
                    },
                    {
                      icon: PiMonitor,
                      text: 'Shadow IT and unmanaged endpoints',
                    },
                    {
                      icon: PiUsersThree,
                      text: 'Recruiting and retaining specialized IT talent',
                    },
                    {
                      icon: PiTrendUp,
                      text: 'Unpredictable capital expenses for infrastructure',
                    },
                  ].map(({ icon: Icon, text }) => (
                    <li class="group flex items-start gap-4 transition-all duration-300 hover:translate-x-1">
                      <div class="bg-destructive/10 border-destructive/20 group-hover:bg-destructive/20 mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border transition-colors">
                        <Icon
                          className="text-destructive/80 h-3.5 w-3.5"
                          aria-hidden="true"
                        />
                      </div>
                      <span class="text-muted-foreground group-hover:text-foreground leading-relaxed transition-colors">
                        {text}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
          <!-- Right: The BDK Way -->
          <div
            class="bg-card border-border/50 relative overflow-hidden border-t p-8 md:border-t-0 md:border-l md:p-12"
          >
            <div
              class="from-primary/10 pointer-events-none absolute inset-0 bg-linear-to-br via-transparent to-transparent"
            >
            </div>
            <div
              class="bg-primary/20 pointer-events-none absolute -top-24 -right-24 h-64 w-64 rounded-full opacity-50 blur-3xl"
            >
            </div>
            <div class="relative z-10">
              <div class="mb-10 flex items-center gap-4">
                <div
                  class="bg-primary/20 border-primary/30 flex h-12 w-12 items-center justify-center rounded-xl border shadow-[0_0_15px_rgba(var(--color-primary),0.3)]"
                >
                  <PiCheckCircle
                    className="text-primary h-6 w-6"
                    aria-hidden="true"
                  />
                </div>
                <h3
                  class="font-display text-foreground text-2xl font-bold tracking-tight"
                >
                  The BDK Way
                </h3>
              </div>
              <ul class="space-y-6">
                {
                  [
                    {
                      icon: PiHeadphones,
                      text: '24/7 NOC coverage with sub-15 minute response SLAs',
                    },
                    {
                      icon: PiShieldCheck,
                      text: 'Automated patch management with 99%+ compliance',
                    },
                    {
                      icon: PiLightning,
                      text: 'Predictive failure detection before impact occurs',
                    },
                    {
                      icon: PiMonitor,
                      text: 'Complete asset visibility across every endpoint',
                    },
                    {
                      icon: PiUsersThree,
                      text: 'Dedicated senior engineers who know your environment',
                    },
                    {
                      icon: PiTrendUp,
                      text: 'Flat-fee model: predictable monthly IT spend',
                    },
                  ].map(({ icon: Icon, text }) => (
                    <li class="group flex items-start gap-4 transition-all duration-300 hover:translate-x-1">
                      <div class="bg-primary/15 border-primary/30 group-hover:bg-primary/25 mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border shadow-none transition-all group-hover:shadow-[0_0_10px_rgba(var(--color-primary),0.2)]">
                        <Icon
                          className="text-primary h-3.5 w-3.5"
                          aria-hidden="true"
                        />
                      </div>
                      <div class="min-w-0 flex-1">
                        <span class="text-foreground leading-relaxed font-medium">
                          {text}
                        </span>
                      </div>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="relative px-4 py-24 sm:px-6 md:py-32 lg:px-8">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="mx-auto max-w-5xl">
        <h2 class="text-foreground mb-12 text-center text-3xl font-bold">
          Frequently Asked Questions
        </h2>
        <div>
          <TechnicalFAQ client:visible faqs={faqs} />
        </div>
      </div>
    </section>

    <div class="relative">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <ImpactMetricsSection metrics={metrics} />
    </div>

    <!-- CTA -->
    <div class="relative">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <CTASection
        client:visible
        title="Stop Managing IT. Start Leading It."
        description="Your team deserves to focus on strategy, not servers. Let BDK own the infrastructure so you can own the future."
        buttonText="Schedule a Strategy Session"
        buttonHref="/contact#chat"
      />
    </div>
  </main>
  <Footer />
</Layout>
