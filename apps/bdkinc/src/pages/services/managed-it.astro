---
import { getEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { getBlogPosts } from '@/lib/blog';
import { iconMap } from '@/lib/icons';
import { TechCard, TechCardGrid } from '@/components/TechCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import ManagedITVisualization from '@/components/visualizations/ManagedITVisualization';
import FeatureCarousel from '@/components/FeatureCarousel';
import TechnicalSection from '@/components/TechnicalSection';

import {
  PiHeadphones,
  PiCheckCircle,
  PiMapPin,
  PiClock,
  PiUsersThree,
  PiQuotesFill,
  PiShieldCheck,
  PiTrendUp,
  PiLightning,
  PiMonitor,
  PiArrowRight,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';
const service = await getEntry('services', 'managed-it');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');
const _serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.title,
  description:
    'Elite managed IT services delivering 24/7 enterprise support, proactive infrastructure management, and strategic technology leadership for growth-focused organizations.',
  provider: {
    '@type': 'Organization',
    name: 'BDKinc',
    url: 'https://www.bdkinc.com',
  },
  serviceType: 'Managed IT Services',
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
  },
};
const relatedPosts = (await getBlogPosts())
  .filter((post) => post.tags?.includes('managed-services'))
  .slice(0, 3);
const metrics = [
  { value: '10K+', label: 'Tickets Closed', icon: PiHeadphones },
  { value: '98%', label: 'First-Call Resolution', icon: PiCheckCircle },
  { value: '2', label: 'Hour Onsite SLA', icon: PiMapPin },
  { value: '24/7', label: 'Support Coverage', icon: PiClock },
];
const faqs = [
  {
    question: 'How does BDKinc integrate with our existing internal IT team?',
    answer:
      'We function as a force multiplier for your internal team. Our Co-Managed IT model handles the heavy lifting of monitoring, patching, and Level 1 support, freeing your internal leaders to focus on high-value strategic initiatives and proprietary business applications.',
  },
  {
    question: 'What industries do you specialize in supporting?',
    answer:
      'We specialize in high-complexity, compliance-driven sectors including healthcare, finance, manufacturing, and logistics. Our engineers are well-versed in the regulatory requirements and operational demands of environments where downtime is not an option.',
  },
  {
    question: 'How do you handle rapid organizational scaling or M&A activity?',
    answer:
      'Our infrastructure is built for elasticity. We have extensive experience navigating the technical integration of mergers and acquisitions, standardizing disparate systems, and rapidly onboarding new users to ensure business continuity during critical growth phases.',
  },
];
const strategicFeatures = [
  {
    title: 'Operational Resilience',
    description:
      'Systems designed for 99.99% uptime, ensuring your business never pauses.',
    highlight: '99.99% uptime',
    icon: 'CheckCircle',
    detail:
      "Our managed infrastructure is built on high-availability clusters and redundant network paths. We don't just aim for uptime; we guarantee it through rigorous architectural standards and automated failover protocols that keep your critical applications running even during hardware failures.",
  },
  {
    title: 'Scalable Architecture',
    description:
      'Infrastructure that adapts instantly to mergers, acquisitions, and rapid user growth.',
    highlight: 'adapts instantly',
    icon: 'TrendUp',
    detail:
      "Growth shouldn't be painful. Whether you're onboarding 50 new employees or integrating a newly acquired branch, our cloud-first architecture allows for rapid resource provisioning. We eliminate the 'wait-and-see' approach to hardware procurement, replacing it with elastic capacity.",
  },
  {
    title: 'Cost Predictability',
    description:
      'Shift from volatile capital expenditures to predictable, value-driven operational models.',
    highlight: 'value-driven operational models',
    icon: 'Lightning',
    detail:
      "Eliminate the 'surprise' IT bill. Our flat-fee managed services model turns your IT spend into a predictable monthly utility. This allows for better financial planning and ensures that our incentives are perfectly aligned with yours: keeping your systems running perfectly.",
  },
  {
    title: 'Security Posture',
    description:
      'Enterprise-grade defense mechanisms interwoven into daily operations, not bolted on.',
    highlight: 'interwoven into daily operations',
    icon: 'ShieldCheck',
    detail:
      "Security is not a separate department; it's a fundamental property of every system we manage. From endpoint protection and multi-factor authentication to continuous vulnerability scanning, we build a 'defense-in-depth' strategy that protects your intellectual property and customer data.",
  },
];
---
<Layout
  title="Elite Managed IT Services & Strategic Technology Management | BDKinc"
  description="Transform your technology into a competitive advantage. BDKinc provides elite managed IT services, 24/7 enterprise support, and strategic infrastructure leadership for growth-focused organizations."
  ogDescription="Elite managed IT services delivering 24/7 enterprise support, proactive infrastructure management, and strategic technology leadership for growth-focused organizations."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(_serviceSchema)}
  />
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="circuit-overlay absolute inset-0 opacity-40"></div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
          <!-- Badge -->
          <div
            class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
          >
            <div class="flex items-center gap-2 text-sm">
              <span>24/7 Business <span class="text-accent font-semibold">Support</span></span>
            </div>
          </div>
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <!-- Heading -->
          <h1
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold tracking-tight delay-100 duration-700 md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <!-- Subtitle -->
          <p
            class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 mx-auto mb-16 max-w-3xl text-xl leading-relaxed delay-200 duration-700"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            Technology shouldn&rsquo;t be a bottleneck; it should be an accelerator.
            We monitor your systems 24/7, preventing issues before they
            disrupt your operations.
          </p>
        </div>
        <!-- Visualization -->
        <div
          class="fill-mode-both animate-in fade-in zoom-in delay-300 duration-700"
        >
          <div class="mx-auto max-w-5xl">
            <ManagedITVisualization client:load />
          </div>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--accent]/50"
      >
      </div>
    </section>
    <!-- Core Services -->
    <section class="bg-muted/30 px-4 py-24 dark:bg-white/[0.02] sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight normal-case md:text-4xl"
          >
            <span class="text-foreground">Core </span>
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >Capabilities</span
            >
          </h2>
          <p
            class="text-muted-foreground mx-auto mt-4 max-w-2xl font-sans text-xl"
          >
            Comprehensive infrastructure management designed for the
            <span class="text-accent font-semibold">modern enterprise</span>.
          </p>
        </div>
        <TechCardGrid client:visible className="md:grid-cols-3">
          <TechCard
            variant="technical"
            interactive={true}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiHeadphones
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Enterprise Service Desk
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Beyond basic troubleshooting. Our tiered support structure
                resolves 98% of incidents on first contact, providing your team
                with immediate access to senior engineers.
              </div>
            </div>
          </TechCard>
          <TechCard
            variant="technical"
            interactive={true}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiTrendUp
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Predictive Intelligence
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                We don't just react to alerts; we anticipate failures utilizing
                advanced telemetry and AI-driven analytics to identify anomalies
                before they impact your users.
              </div>
            </div>
          </TechCard>
          <TechCard
            variant="technical"
            interactive={true}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiUsersThree
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Strategic Co-Management
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Whether acting as your entire IT department or augmenting your
                internal team, we integrate seamlessly with your workflows and
                provide specialized expertise.
              </div>
            </div>
          </TechCard>
        </TechCardGrid>
      </div>
    </section>
    <!-- Strategic Leadership Section -->
    <section class="relative overflow-hidden py-24">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-4xl font-bold tracking-tight duration-600 md:text-5xl"
          >
            <span class="text-foreground">Technology </span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Leadership</span
            >
          </h2>
        </div>
        
        <!-- Glass Quote Container -->
        <div class="relative mx-auto max-w-4xl">
          <!-- Floating Icon -->
          <div class="absolute -top-10 -left-6 z-20 text-primary md:-left-10">
            <PiQuotesFill className="h-20 w-20 rotate-[-12deg] drop-shadow-xl filter" aria-hidden="true" />
          </div>
          
          <!-- Glass Card -->
          <div class="relative z-10 overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-10 backdrop-blur-xl md:p-14 dark:bg-white/[0.03] dark:border-white/[0.05]">
            <!-- Ambient Glow -->
            <div class="absolute -top-24 -right-24 h-64 w-64 rounded-full bg-primary/20 blur-3xl opacity-50"></div>
            <div class="absolute -bottom-24 -left-24 h-64 w-64 rounded-full bg-secondary/20 blur-3xl opacity-50"></div>
            
            <!-- Background Watermark -->
            <div class="absolute top-0 right-0 z-0 opacity-[0.03] pointer-events-none">
               <PiQuotesFill className="h-64 w-64 -rotate-12 translate-x-1/4 -translate-y-1/4" aria-hidden="true" />
            </div>

            <blockquote class="relative z-10 font-display text-2xl font-medium leading-relaxed text-foreground md:text-3xl text-center">
              &ldquo;True business growth requires more than keeping the lights on. It
              demands a technology strategy that
              <span class="text-accent">
                anticipates challenges</span
              >
              and scales with your ambition. We architect, manage, and secure your
              infrastructure so you can focus on driving your business forward.&rdquo;
            </blockquote>
          </div>
        </div>
      </div>
      <div
        class="via-primary/20 absolute bottom-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
    </section>
    <!-- Technology Leadership -->
    <section
      class="bg-linear-to-b from-transparent to-muted/20 px-4 py-24 dark:to-white/[0.02] sm:px-6 lg:px-8"
    >
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            The Strategic <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Advantage</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            Move beyond break/fix and operational drag with a partner who builds
            for the future.
          </p>
        </div>
        <FeatureCarousel client:visible features={strategicFeatures} />
      </div>
    </section>
    <!-- The Shift: Before/After Contrast Section -->
    <section class="bg-muted/30 px-4 py-24 dark:bg-white/[0.02] sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mb-16 text-center">
          <h2 class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl">
            Stop Managing IT. <span class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent">Start Leading It.</span>
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            Here&rsquo;s what changes when BDK takes ownership of your infrastructure.
          </p>
        </div>
        <div class="grid gap-0 overflow-hidden rounded-2xl border border-border md:grid-cols-2">
          <!-- Left: What You Stop Worrying About -->
          <div class="bg-muted/60 dark:bg-white/[0.03] p-8 md:p-10">
            <div class="mb-8 flex items-center gap-3">
              <div class="rounded-lg bg-destructive/10 p-2">
                <PiMonitor className="h-5 w-5 text-destructive" aria-hidden="true" />
              </div>
              <h3 class="font-display text-lg font-bold tracking-tight text-muted-foreground">What You Stop Worrying About</h3>
            </div>
            <ul class="space-y-5">
              {[
                { icon: PiClock, text: "3am alerts waking your team for server issues" },
                { icon: PiShieldCheck, text: "Patch cycles slipping and creating security gaps" },
                { icon: PiLightning, text: "Unexpected hardware failures disrupting operations" },
                { icon: PiMonitor, text: "Shadow IT and unmanaged endpoints" },
                { icon: PiUsersThree, text: "Recruiting and retaining specialized IT talent" },
                { icon: PiTrendUp, text: "Unpredictable capital expenses for infrastructure" },
              ].map(({ icon: Icon, text }) => (
                <li class="flex items-start gap-3">
                  <div class="mt-0.5 rounded-full bg-destructive/10 p-1 shrink-0">
                    <Icon className="h-3.5 w-3.5 text-destructive/70" aria-hidden="true" />
                  </div>
                  <span class="text-muted-foreground text-sm leading-relaxed">{text}</span>
                </li>
              ))}
            </ul>
          </div>
          <!-- Right: What You Gain -->
          <div class="bg-primary/5 dark:bg-primary/10 border-t border-border md:border-t-0 md:border-l p-8 md:p-10">
            <div class="mb-8 flex items-center gap-3">
              <div class="rounded-lg bg-primary/15 p-2">
                <PiCheckCircle className="h-5 w-5 text-primary" aria-hidden="true" />
              </div>
              <h3 class="font-display text-lg font-bold tracking-tight text-foreground">What You Gain</h3>
            </div>
            <ul class="space-y-5">
              {[
                { text: "24/7 NOC coverage with sub-15 minute response SLAs", stat: "15 min SLA" },
                { text: "Automated patch management with 99%+ compliance rates", stat: "99% compliant" },
                { text: "Predictive failure detection before impact occurs", stat: "Proactive" },
                { text: "Complete asset visibility across every endpoint", stat: "Full coverage" },
                { text: "Dedicated senior engineers who know your environment", stat: "Expert team" },
                { text: "Flat-fee model: predictable monthly IT spend", stat: "OpEx model" },
              ].map(({ text, stat }) => (
                <li class="flex items-start gap-3">
                  <div class="mt-0.5 shrink-0">
                    <PiCheckCircle className="h-4 w-4 text-primary" aria-hidden="true" />
                  </div>
                  <div class="flex-1 min-w-0">
                    <span class="text-foreground text-sm leading-relaxed">{text}</span>
                  </div>
                  <span class="font-mono text-[10px] font-bold tracking-widest text-primary bg-primary/10 px-2 py-0.5 rounded shrink-0 self-center">{stat}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <TechnicalSection client:visible id="managed-it-vault" overlayOpacity="opacity-10">
      <div class="relative z-10 flex flex-col items-center text-center">
        <div class="mb-6 flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1">
          <div class="h-2 w-2 animate-pulse rounded-full bg-primary"></div>
          <span class="text-xs font-bold tracking-widest text-primary font-display">BDK Operations Center</span>
        </div>
        <h3 class="mb-6 max-w-2xl text-3xl font-bold text-foreground font-display tracking-tight">
          Proactive Infrastructure. <span class="text-primary">Zero Surprises.</span>
        </h3>
        <div class="mx-auto max-w-4xl text-lg leading-relaxed text-muted-foreground font-sans">
          We don&rsquo;t wait for your systems to fail. Our NOC monitors your entire 
          infrastructure 24/7, applying predictive telemetry and automated remediation 
          to neutralize issues before they become incidents. Your team stays focused 
          on business priorities. We handle the infrastructure.
        </div>
      </div>
    </TechnicalSection>
    <!-- FAQ -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h2 class="text-foreground mb-6 text-center text-2xl font-bold">
          Frequently Asked Questions
        </h2>
        <div class="mb-20">
          <TechnicalFAQ client:visible faqs={faqs} />
        </div>
      </div>
    </section>
    <!-- Related Resources -->
    {
      relatedPosts.length > 0 && (
        <section class="mx-auto max-w-5xl px-4 py-24">
          <h2 class="text-foreground mb-6 text-center text-3xl font-bold">
            Related Resources
          </h2>
          <div class="grid gap-6 md:grid-cols-3">
            {relatedPosts.map((post) => (
              <a
                href={`/blog/${post.slug}`}
                class="border-border hover:border-primary group flex flex-col rounded-xl border p-6 transition-colors focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
              >
                <h3 class="text-foreground group-hover:text-primary mb-2 text-lg font-semibold transition-colors">
                  {post.title}
                </h3>
                <p class="text-muted-foreground text-sm line-clamp-3">
                  {post.description}
                </p>
                <span class="text-primary mt-4 text-sm font-medium flex items-center gap-1">
                  Read Article <PiArrowRight className="h-3 w-3" aria-hidden="true" />
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }
    <ImpactMetricsSection metrics={metrics} />
    <!-- CTA -->
    <CTASection
      client:visible
      title="Stop Managing IT. Start Leading It."
      description="Your team deserves to focus on strategy, not servers. Let BDK own the infrastructure so you can own the future."
      buttonText="Schedule a Strategy Session"
      buttonHref="/contact#chat"
    />
  </main>
  <Footer />
</Layout>
