---
import { getEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { getBlogPosts } from '@/lib/blog';
import { iconMap } from '@/lib/icons';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import ManagedITVisualization from '@/components/visualizations/ManagedITVisualization';

import {
  PiHeadphones,
  PiCheckCircle,
  PiMapPin,
  PiClock,
  PiUsersThree,
  PiQuotesFill,
  PiShieldCheck,
  PiTrendUp,
  PiLightning,
  PiMonitor,
  PiArrowRight,
  PiCaretRight,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';
const service = await getEntry('services', 'managed-it');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');
const _serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.title,
  description:
    'Elite managed IT services delivering 24/7 enterprise support, proactive infrastructure management, and strategic technology leadership for growth-focused organizations.',
  provider: {
    '@type': 'Organization',
    name: 'BDKinc',
    url: 'https://www.bdkinc.com',
  },
  serviceType: 'Managed IT Services',
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
  },
};
const relatedPosts = (await getBlogPosts())
  .filter((post) => post.tags?.includes('managed-services'))
  .slice(0, 3);
const faqs = [
  {
    question: 'How does BDKinc integrate with our existing internal IT team?',
    answer:
      'We function as a force multiplier for your internal team. Our Co-Managed IT model handles the heavy lifting of monitoring, patching, and Level 1 support, freeing your internal leaders to focus on high-value strategic initiatives and proprietary business applications.',
  },
  {
    question: 'What industries do you specialize in supporting?',
    answer:
      'We specialize in high-complexity, compliance-driven sectors including healthcare, finance, manufacturing, and logistics. Our engineers are well-versed in the regulatory requirements and operational demands of environments where downtime is not an option.',
  },
  {
    question: 'How do you handle rapid organizational scaling or M&A activity?',
    answer:
      'Our infrastructure is built for elasticity. We have extensive experience navigating the technical integration of mergers and acquisitions, standardizing disparate systems, and rapidly onboarding new users to ensure business continuity during critical growth phases.',
  },
];
---

<Layout
  title="Elite Managed IT Services & Strategic Technology Management | BDKinc"
  description="Transform your technology into a competitive advantage. BDKinc provides elite managed IT services, 24/7 enterprise support, and strategic infrastructure leadership for growth-focused organizations."
  ogDescription="Elite managed IT services delivering 24/7 enterprise support, proactive infrastructure management, and strategic technology leadership for growth-focused organizations."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(_serviceSchema)}
  />
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  
  <main id="main-content" class="bg-background selection:bg-primary selection:text-primary-foreground">
    <!-- Hero Section (Editorial Swiss Style) -->
    <section class="relative flex min-h-[90vh] items-end border-b border-border px-4 pt-40 pb-20 sm:px-6 lg:px-8">
      <div class="mx-auto grid w-full max-w-7xl gap-16 lg:grid-cols-12 lg:items-end">
        
        <!-- Massive Typographic Hero -->
        <div class="lg:col-span-8">
          <div class="mb-12 flex items-center gap-4">
             <div class="h-px w-12 bg-primary"></div>
             <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">Service — Managed IT</p>
          </div>
          
          <h1
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-8 text-[4rem] font-light leading-[0.9] tracking-tighter text-foreground sm:text-[6rem] lg:text-[7.5rem] xl:text-[9rem]"
            transition:name={`service-title-${service.id}`}
          >
            Strategic<br/>
            <span class="font-medium text-primary">Infrastructure.</span>
          </h1>
        </div>

        <!-- Description & Visualization -->
        <div class="flex flex-col lg:col-span-4 lg:pb-4">
          <div class="mb-12 hidden lg:block opacity-60 mix-blend-plus-lighter saturate-0 transition-all duration-1000 hover:saturate-100 hover:opacity-100">
             <ManagedITVisualization client:load />
          </div>
          <p
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-6 mb-10 text-xl font-light leading-relaxed text-muted-foreground"
            transition:name={`service-description-${service.id}`}
          >
            Technology shouldn&rsquo;t be a bottleneck; it should be an accelerator. We monitor your systems 24/7, preventing issues before they disrupt operations.
          </p>
          <a href="/contact#chat" class="group flex w-max items-center gap-3 border-b border-foreground/30 pb-2 text-sm font-semibold uppercase tracking-wider text-foreground transition-colors hover:border-primary hover:text-primary">
            Initiate Strategy Session
            <PiArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true"/>
          </a>
        </div>

      </div>
    </section>

    <!-- Core Capabilities (Architectural List) -->
    <section class="relative border-b border-border py-32">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-16 lg:grid-cols-12">
          
          <div class="lg:col-span-4">
             <h2 class="font-display sticky top-32 text-4xl font-light tracking-tight md:text-5xl">
               Core<br/>
               <span class="font-medium">Capabilities</span>
             </h2>
             <p class="mt-8 max-w-sm text-lg font-light text-muted-foreground">
               Comprehensive infrastructure management designed for the modern enterprise.
             </p>
          </div>

          <div class="grid gap-12 lg:col-span-8">
            {[
              {
                icon: PiHeadphones,
                title: 'Enterprise Service Desk',
                desc: 'Beyond basic troubleshooting. Our tiered support structure resolves 98% of incidents on first contact, providing your team with immediate access to senior engineers.'
              },
              {
                icon: PiTrendUp,
                title: 'Predictive Intelligence',
                desc: "We don't just react to alerts; we anticipate failures utilizing advanced telemetry and AI-driven analytics to identify anomalies before they impact your users."
              },
              {
                icon: PiUsersThree,
                title: 'Strategic Co-Management',
                desc: 'Whether acting as your entire IT department or augmenting your internal team, we integrate seamlessly with your workflows and provide specialized expertise.'
              }
            ].map((feature, idx) => (
              <div class="group relative border-t border-border pt-10">
                <div class="absolute left-0 top-0 h-[1px] w-0 bg-primary transition-all duration-700 ease-out group-hover:w-full"></div>
                <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
                  <div class="flex items-center gap-6">
                    <span class="font-mono text-sm text-muted-foreground/50">0{idx + 1}</span>
                    <h3 class="font-display text-3xl text-foreground transition-colors group-hover:text-primary md:text-4xl">{feature.title}</h3>
                  </div>
                  <p class="max-w-md text-lg font-light leading-relaxed text-muted-foreground md:text-right">
                    {feature.desc}
                  </p>
                </div>
              </div>
            ))}
          </div>

        </div>
      </div>
    </section>

    <!-- Stark Quote Section -->
    <section class="bg-foreground py-32 text-background md:py-48">
      <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
        <PiQuotesFill className="mx-auto mb-16 h-16 w-16 opacity-20" aria-hidden="true"/>
        <blockquote class="font-display text-4xl font-light leading-tight tracking-tight md:text-5xl lg:text-6xl">
          &ldquo;True business growth requires more than keeping the lights on. It demands a technology strategy that
          <span class="font-medium text-primary">anticipates challenges</span>
          and scales with your ambition.&rdquo;
        </blockquote>
      </div>
    </section>

    <!-- The Shift: Brutalist Split Layout -->
    <section class="grid border-b border-border lg:grid-cols-2">
      <!-- The Old Way -->
      <div class="bg-muted/20 border-b border-border p-12 lg:border-b-0 lg:border-r lg:p-24">
        <p class="mb-12 font-mono text-xs font-semibold tracking-[0.2em] text-destructive uppercase">The Old Way</p>
        <h2 class="font-display mb-20 text-5xl font-light tracking-tight text-foreground md:text-6xl">Reactive &<br/> Unpredictable</h2>
        
        <ul class="space-y-12">
          {[
            { icon: PiClock, text: '3am alerts waking your team for urgent server issues' },
            { icon: PiShieldCheck, text: 'Patch cycles constantly slipping, creating major security gaps' },
            { icon: PiLightning, text: 'Unexpected hardware failures halting critical operations' },
            { icon: PiMonitor, text: 'Shadow IT spreading across unmanaged, vulnerable endpoints' },
            { icon: PiUsersThree, text: 'Constantly recruiting and training specialized internal IT talent' },
            { icon: PiTrendUp, text: 'Unpredictable capital expenses destroying annual IT budgets' },
          ].map(({ icon: Icon, text }) => (
            <li class="flex items-start gap-6 border-t border-border/50 pt-8">
              <Icon className="mt-1.5 h-6 w-6 shrink-0 text-destructive/40" aria-hidden="true" />
              <span class="text-xl font-light text-muted-foreground">{text}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- The BDK Way -->
      <div class="relative overflow-hidden bg-background p-12 lg:p-24">
        <div class="absolute right-0 top-0 -mr-24 -mt-24 opacity-[0.02]">
          <PiCheckCircle className="h-[40rem] w-[40rem]" aria-hidden="true" />
        </div>
        <p class="relative z-10 mb-12 font-mono text-xs font-semibold tracking-[0.2em] text-primary uppercase">The BDK Way</p>
        <h2 class="font-display relative z-10 mb-20 text-5xl font-medium tracking-tight text-foreground md:text-6xl">Strategic &<br/> Managed</h2>
        
        <ul class="relative z-10 space-y-12">
          {[
            { icon: PiClock, text: '24/7 NOC coverage ensuring you sleep through the night', stat: '2 HOUR SLA' },
            { icon: PiShieldCheck, text: 'Automated patch management ensuring ironclad security', stat: '99% COMPLIANT' },
            { icon: PiLightning, text: 'Predictive failure detection solving issues before impact', stat: 'PROACTIVE' },
            { icon: PiMonitor, text: 'Complete asset visibility locking down every endpoint', stat: 'FULL COVERAGE' },
            { icon: PiUsersThree, text: 'Dedicated senior engineering teams leading your strategy', stat: 'EXPERT TEAM' },
            { icon: PiTrendUp, text: 'Flat-fee operational models creating predictable spend', stat: 'OPEX MODEL' },
          ].map(({ icon: Icon, text, stat }) => (
            <li class="group flex items-start gap-6 border-t border-primary/20 pt-8 transition-colors hover:border-primary/50">
              <Icon className="mt-1 h-6 w-6 shrink-0 text-primary transition-transform duration-500 group-hover:scale-125 group-hover:text-primary" aria-hidden="true" />
              <div class="flex flex-1 flex-col justify-between gap-4 sm:flex-row sm:items-center">
                <span class="text-xl font-light text-foreground">{text}</span>
                <span class="shrink-0 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 font-mono text-xs tracking-widest text-primary">
                  {stat}
                </span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FAQ (Editorial) -->
    <section class="border-b border-border py-32">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-20 text-center">
          <h2 class="font-display text-4xl font-light tracking-tight md:text-5xl">
            Frequently Asked <span class="font-medium">Questions</span>
          </h2>
        </div>
        <TechnicalFAQ client:visible faqs={faqs} />
      </div>
    </section>

    <!-- Related Resources -->
    {relatedPosts.length > 0 && (
      <section class="border-b border-border bg-muted/10 py-32">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="mb-16 flex items-end justify-between">
            <h2 class="font-display text-3xl font-light tracking-tight md:text-4xl">
              Related <span class="font-medium">Thinking</span>
            </h2>
            <a href="/blog" class="hidden font-mono text-sm uppercase tracking-widest text-muted-foreground hover:text-primary md:block">View All</a>
          </div>
          <div class="grid gap-px bg-border md:grid-cols-3">
            {relatedPosts.map((post) => (
              <a href={`/blog/${post.slug}`} class="group bg-background p-10 transition-colors hover:bg-muted/30">
                <h3 class="font-display mb-4 text-2xl font-medium text-foreground transition-colors group-hover:text-primary">
                  {post.title}
                </h3>
                <p class="mb-12 font-light text-muted-foreground line-clamp-3">
                  {post.description}
                </p>
                <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-primary">
                  Read Article
                  <PiArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-2" aria-hidden="true" />
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Brutalist CTA -->
    <section class="bg-primary py-32 text-primary-foreground selection:bg-foreground selection:text-background">
      <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
        <h2 class="font-display mb-8 text-5xl font-medium tracking-tighter md:text-7xl">
          Stop Managing IT.<br/> Start Leading It.
        </h2>
        <p class="mx-auto mb-16 max-w-2xl text-xl font-light opacity-90">
          Your team deserves to focus on strategy, not servers. Let BDK own the infrastructure so you can own the future.
        </p>
        <a href="/contact#chat" class="inline-flex h-16 items-center justify-center bg-background px-10 font-mono text-sm font-semibold uppercase tracking-[0.2em] text-foreground transition-transform hover:scale-105 hover:bg-white focus:outline-none focus:ring-4 focus:ring-background/20">
          Schedule Strategy Session
        </a>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
