---
import { getContentEntry, getPageCopy, getSettings, type ContentProps } from '@/lib/content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import TechnicalFAQ from '@/components/TechnicalFAQ';

import TechnicalSection from '@/components/TechnicalSection';
import { GlobalNetworkMap } from '@/components/GlobalNetworkMap';
import CohesiveOrbit from '@/components/visualizations/CohesiveOrbit';
import FeatureCarousel from '@/components/FeatureCarousel';
import BenefitGrid from '@/components/BenefitGrid.astro';
import ServiceBlockquote from '@/components/ServiceBlockquote.astro';
import {
  PiArrowUp,
  PiDatabase,
  PiHeadphones,
  PiLightning,
  PiStack,
  PiShieldCheck,
  PiCheckCircle,
  PiLock,
  PiCurrencyDollar,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';
import EditSection from '@/components/preview/EditSection.astro';
import { servicePageSchemas } from '@/lib/schema';
interface Props extends ContentProps {}
const { contentContext, publicPath = Astro.url.pathname } = Astro.props;
const [service, copy, settings] = await Promise.all([
  getContentEntry('services', 'hosted-erp', contentContext),
  getPageCopy('service-hosted-erp', contentContext),
  getSettings(contentContext),
]);
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData(contentContext);
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');
const metrics = [
  { ...copy.metrics.slaUptime, icon: PiArrowUp },
  { ...copy.metrics.networkLatency, icon: PiLightning },
  { ...copy.metrics.dataCenters, icon: PiDatabase },
  { ...copy.metrics.nocMonitoring, icon: PiHeadphones },
];
const migration = copy.specifications.columns.migrationOnboarding;
const operations = copy.specifications.columns.managedOperations;
const detailColumns = [
  { ...migration, icon: PiArrowUp, items: [
    migration.items.comprehensiveFitGapAnalysisAndInfrastructureAssessment,
    migration.items.parallelSandboxEnvironmentsForZeroRiskData,
    migration.items.customIntegrationMappingForEdiMesAnd,
  ] },
  { ...operations, icon: PiStack, items: [
    operations.items.automatedPatchManagementAndSecurityHardening,
    operations.items.performanceTuningForHighThroughputTransactionProcessing,
    operations.items.realTimeComplianceAuditingAndImmutableLog,
  ] },
];
const faqs = [
  copy.faqs.howDoYouHandleMigrationFromLegacy,
  copy.faqs.canYouSupportHybridEnvironmentsWithBoth,
  copy.faqs.howIsComplianceAndDataSovereigntyManaged,
];
const { breadcrumb: breadcrumbSchema, faq: faqSchema } = servicePageSchemas({
  serviceName: service.data.title,
  servicePath: `/services/${service.id}`,
  faqs,
  copy: settings.navigation,
});
const strategicFeatures = [
  { ...copy.strategy.features.missionCriticalAvailability, icon: 'ShieldCheck' },
  { ...copy.strategy.features.zeroRiskMigration, icon: 'ArrowUp' },
  { ...copy.strategy.features.crossPlatformIntegration, icon: 'Stack' },
  { ...copy.strategy.features.continuousHardening, icon: 'Lock' },
];
const keyBenefits = [
  { ...copy.benefits.items.item9999Uptime, icon: PiCheckCircle },
  { ...copy.benefits.items.rapidScalability, icon: PiLightning },
  { ...copy.benefits.items.ibmPowerNative, icon: PiShieldCheck },
  { ...copy.benefits.items.disasterRecovery, icon: PiDatabase },
  { ...copy.benefits.items.opexEfficiency, icon: PiCurrencyDollar },
  { ...copy.benefits.items.zeroTrustSecurity, icon: PiLock },
];
---

<Layout
  contentContext={contentContext}
  publicPath={publicPath}
  title={`${service.data.title} - ${settings.siteName}`}
  description={service.data.description}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema)}
  />
  <EditSection record="settings" section="navigation">
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={publicPath}
    copy={settings.navigation}
    brand={settings.brand}
  />
  </EditSection>
  <main id="main-content" class="services-page-shell">
    <EditSection record="service-hosted-erp" section="hero">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="scanlines pointer-events-none absolute inset-0 opacity-50">
      </div>
      <div
        class="pointer-events-none absolute inset-0 z-0 flex items-center justify-center opacity-80 md:opacity-100"
      >
        <CohesiveOrbit client:idle />
      </div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
          <!-- Badge -->
          <div
            class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
          >
            <div class="flex items-center gap-2 text-sm">
              <span
                >{copy.hero.badgePrefix}{' '}<span class="text-accent font-semibold"
                  >{copy.hero.badgeAccent}</span
                ></span
              >
            </div>
          </div>
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <!-- Heading -->
          <h1
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold tracking-tight delay-100 duration-700 md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground">
              {titleFirst ? `${titleFirst} ` : ''}
            </span>
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <!-- Subtitle -->
          <p
            class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 mx-auto mb-16 max-w-3xl text-xl leading-relaxed delay-200 duration-700"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            {service.data.description}{' '}{copy.hero.bodySuffix}
          </p>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--accent]/50"
      >
      </div>
    </section>
    </EditSection>
    <EditSection record="service-hosted-erp" section="leadership">
    <!-- Strategic Leadership Section -->
    <section class="relative overflow-hidden py-24">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-4xl font-bold tracking-tight duration-600 md:text-5xl"
          >
            <span class="text-foreground">{copy.leadership.heading}{' '}</span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.leadership.headingAccent}</span
            >
          </h2>
        </div>

        <ServiceBlockquote>
          {copy.leadership.quoteBefore}{' '}
          <span class="text-accent">{copy.leadership.quoteAccent}</span>{' '}
          {copy.leadership.quoteAfter}
        </ServiceBlockquote>
      </div>
      <div
        class="via-primary/20 absolute bottom-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
    </section>
    </EditSection>
    <EditSection record="service-hosted-erp" section="strategy">
    <!-- Strategic Advantage -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            {copy.strategy.heading}{' '}<span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.strategy.headingAccent}</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            {copy.strategy.body}
          </p>
        </div>
        <FeatureCarousel client:visible features={strategicFeatures} />
      </div>
    </section>
    </EditSection>
    <EditSection record="service-hosted-erp" section="network">
    <!-- Network Section -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            {copy.network.heading}{' '}<span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.network.headingAccent}</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            {copy.network.body}
          </p>
        </div>
        <div class="mb-12">
          <GlobalNetworkMap client:visible copy={copy.network.map} />
        </div>
      </div>
    </section>
    </EditSection>
    <EditSection record="service-hosted-erp" section="benefits">
    <!-- Key Benefits -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <BenefitGrid benefits={keyBenefits} copy={settings.benefits} />
      </div>
    </section>
    </EditSection>
    <EditSection record="service-hosted-erp" section="specifications">
    <!-- Technical Execution Section -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="text-foreground font-display mb-6 text-3xl font-bold tracking-tight md:text-4xl"
          >
            {copy.specifications.heading}{' '}<span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.specifications.headingAccent}</span
            >
          </h2>
        </div>
        <div class="grid gap-8 md:grid-cols-2">
          {
            detailColumns.map((column, idx) => (
              <div
                class={`rounded-2xl border p-8 ${idx === 0 ? 'border-primary/20 bg-primary/5 dark:bg-primary/10' : 'border-secondary/20 bg-secondary/5 dark:bg-secondary/10'}`}
              >
                <div class="mb-2">
                  <span
                    class={`font-mono text-[10px] font-bold tracking-widest ${idx === 0 ? 'text-primary' : 'text-secondary'} uppercase`}
                  >
                    {column.phaseLabel}
                  </span>
                </div>
                <div class="mb-6 flex items-center gap-3">
                  <column.icon
                    className={`h-8 w-8 ${idx === 0 ? 'text-primary' : 'text-secondary'}`}
                    aria-hidden="true"
                  />
                  <h4 class="text-foreground text-2xl font-bold">
                    {column.title}
                  </h4>
                </div>
                <div class="text-muted-foreground space-y-3">
                  {column.items.map((item) => (
                    <div class="flex items-start gap-2">
                      <PiCheckCircle
                        className={`mt-1 h-5 w-5 shrink-0 ${idx === 0 ? 'text-primary' : 'text-secondary'}`}
                        aria-hidden="true"
                      />
                      <span>{item}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    </EditSection>
    <EditSection record="service-hosted-erp" section="operations">
    <TechnicalSection client:visible id="erp-vault" overlayOpacity="opacity-10">
      <div class="relative z-10 flex flex-col items-center text-center">
        <div
          class="border-primary/30 bg-primary/10 mb-6 flex items-center gap-2 rounded-full border px-4 py-1"
        >
          <div class="bg-primary h-2 w-2 animate-pulse rounded-full"></div>
          <span
            class="text-primary font-display text-xs font-bold tracking-widest"
            >{copy.operations.badge}</span
          >
        </div>
        <h3
          class="text-foreground font-display mb-6 max-w-2xl text-3xl font-bold tracking-tight"
        >
          {copy.operations.heading}{' '}<span class="text-primary"
            >{copy.operations.headingAccent}</span
          >
        </h3>
        <div
          class="text-muted-foreground mx-auto max-w-4xl font-sans text-lg leading-relaxed"
        >
          {copy.operations.body}
        </div>
      </div>
    </TechnicalSection>
    </EditSection>
    <EditSection record="service-hosted-erp" section="faqs" also={['faqHeading']}>
    <!-- FAQ -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
          {copy.faqHeading}
        </h3>
        <div class="mb-20">
          <TechnicalFAQ client:visible faqs={faqs} />
        </div>
      </div>
    </section>
    </EditSection>
    <EditSection record="service-hosted-erp" section="metrics">
    <ImpactMetricsSection metrics={metrics} copy={settings.metrics} />
    </EditSection>
    <EditSection record="service-hosted-erp" section="cta">
    <!-- CTA -->
    <CTASection
      client:visible
      copy={settings.cta}
      {...copy.cta}
    />
    </EditSection>
  </main>
  <Footer contentContext={contentContext} />
</Layout>
