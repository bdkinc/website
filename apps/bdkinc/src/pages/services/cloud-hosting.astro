---
import { getEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import { TechCard, TechCardGrid } from '@/components/TechCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import Logo from '@/components/Logo';

import CohesiveOrbit from '@/components/visualizations/CohesiveOrbit';
import FeatureCarousel from '@/components/FeatureCarousel';
import BenefitGrid from '@/components/BenefitGrid.astro';
import ServiceBlockquote from '@/components/ServiceBlockquote.astro';
import {
  PiLock,
  PiLightning,
  PiUsersThree,
  PiShield,
  PiArrowsClockwise,
  PiCloud,
  PiClock,
  PiGlobe,
  PiStack,
  PiCurrencyDollar,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';
import { servicePageSchemas } from '@/lib/schema';
const service = await getEntry('services', 'cloud-hosting');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');
const _serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.title,
  description:
    'Secure, scalable cloud solutions for the enterprise. BDKinc delivers intelligent orchestration across private, public, and hybrid environments with premier management and 24/7 support.',
  provider: {
    '@type': 'Organization',
    name: 'BDKinc',
    url: 'https://www.bdkinc.com',
  },
  serviceType: 'Cloud Hosting & Migration',
};
const metrics = [
  { value: '99.99%', label: 'Uptime SLA', icon: PiShield },
  { value: '75+', label: 'Cloud Migrations', icon: PiArrowsClockwise },
  { value: '1.5PB', label: 'Data Managed', icon: PiCloud },
  { value: '24/7', label: 'Operations Center', icon: PiClock },
];
const faqs = [
  {
    question: 'How do you determine the right mix of public vs. private cloud?',
    answer:
      'We conduct a deep architectural assessment of your workloads, compliance requirements, and budget. We typically recommend Private Cloud for predictable, data-heavy core systems, and Public Cloud for variable web workloads or rapid development cycles.',
  },
  {
    question:
      'How do you handle compliance and security in a hybrid environment?',
    answer:
      'Security is our baseline. We implement a unified security plane across all environments—private and public—ensuring consistent policies, identity management, and threat detection that meet SOC 2, HIPAA, and other regulatory standards.',
  },
  {
    question: "What does 'Managed Cloud' actually include?",
    answer:
      'It means total accountability. We handle patching, backups, security monitoring, performance tuning, and 24/7 incident response. You focus on your applications and business logic; we ensure the infrastructure never blinks.',
  },
];
const { breadcrumb: breadcrumbSchema, faq: faqSchema } = servicePageSchemas({
  serviceName: service.data.title,
  servicePath: `/services/${service.id}`,
  faqs,
});
const strategicFeatures = [
  {
    title: 'Orchestrated Agility',
    description: 'Intelligent resource allocation across hybrid environments.',
    highlight: 'Intelligent resource allocation',
    icon: 'Stack',
    detail:
      'We design cloud architectures that adapt to your workload demands in real-time. By orchestrating resources across private and public clouds, we ensure you have the agility of the cloud with the control of dedicated infrastructure.',
  },
  {
    title: 'Architectural Sovereignty',
    description: 'Absolute control over data location and security governance.',
    highlight: 'Absolute control over data',
    icon: 'Lock',
    detail:
      'For sensitive workloads, our private cloud environments offer dedicated hardware and direct engineer access, ensuring your data sovereignty and compliance requirements are met without compromise.',
  },
  {
    title: 'Cost Optimization',
    description: 'Continuous utilization analysis to eliminate cloud waste.',
    highlight: 'Eliminate cloud waste',
    icon: 'CurrencyDollar',
    detail:
      "We don't just set it and forget it. Our engineers perform continuous reviews of your cloud spend and resource utilization, refactoring environments to ensure you're always getting the maximum value for your investment.",
  },
  {
    title: 'Zero-Disruption Migration',
    description: 'Rigorous cutover playbooks ensuring 100% data integrity.',
    highlight: '100% data integrity',
    icon: 'CloudArrowUp',
    detail:
      "Migration shouldn't mean downtime. Our proven methodology uses phased transitions and automated synchronization to move your critical systems to the cloud with zero impact on your business operations.",
  },
];
const providers = [
  {
    name: 'IBM Cloud',
    logo: '/logos/partners/ibm.svg',
    desc: 'Enterprise-grade reliability and Power Systems expertise',
  },
  {
    name: 'AWS',
    logo: '/logos/partners/aws.svg',
    desc: 'Industry-leading breadth for diverse application ecosystems',
  },
  {
    name: 'Microsoft Azure',
    logo: '/logos/partners/azure.svg',
    desc: 'Seamless integration for Microsoft-centric enterprises',
  },
  {
    name: 'Google Cloud',
    logo: '/logos/partners/google-cloud.svg',
    desc: 'Advanced data analytics and AI capabilities',
  },
  {
    name: 'BDKcloud',
    logo: null,
    desc: 'Private cloud infrastructure powered by the BDK platform',
  },
  {
    name: 'Cloudflare',
    logo: '/logos/partners/cloudflare.svg',
    desc: 'Global edge network for security and performance',
  },
];

const keyBenefits = [
  {
    title: 'Enhanced Reliability',
    description:
      'Multi-region redundancy and high-availability clusters protect your critical business data.',
    icon: PiShield,
  },
  {
    title: 'Cost Efficiency',
    description:
      'Shift from volatile capital expenses to predictable, value-driven operational models.',
    icon: PiCurrencyDollar,
  },
  {
    title: 'Business Continuity',
    description:
      'Built-in disaster recovery and immutable backup solutions keep your business running.',
    icon: PiArrowsClockwise,
  },
  {
    title: 'Architectural Expertise',
    description:
      'Direct access to senior cloud architects with decades of enterprise migration experience.',
    icon: PiUsersThree,
  },
  {
    title: 'Security First',
    description:
      'Unified security plane across all environments ensures consistent policy enforcement.',
    icon: PiLock,
  },
  {
    title: 'Infinite Flexibility',
    description:
      'Elastic capacity that adapts instantly to rapid growth, mergers, and acquisitions.',
    icon: PiLightning,
  },
];
---

<Layout
  title="Cloud Hosting & Migration Services | BDKinc"
  description="Secure, scalable cloud solutions for the enterprise. BDKinc delivers intelligent orchestration across private, public, and hybrid environments."
  ogDescription="BDKinc architects the perfect mix of Private, Hybrid, and Public environments to maximize performance and minimize cost across your entire organization."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(_serviceSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema)}
  />
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content" class="services-page-shell">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="scanlines pointer-events-none absolute inset-0 opacity-50">
      </div>
      <div
        class="pointer-events-none absolute inset-0 z-0 flex items-center justify-center opacity-80 md:opacity-100"
      >
        <CohesiveOrbit client:idle />
      </div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
          <!-- Badge -->
          <div
            class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
          >
            <div class="flex items-center gap-2 text-sm">
              <span
                >Secure & <span class="text-accent font-semibold">Scalable</span
                ></span
              >
            </div>
          </div>
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <!-- Heading -->
          <h1
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold tracking-tight delay-100 duration-700 md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <!-- Subtitle -->
          <p
            class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 mx-auto mb-16 max-w-3xl text-xl leading-relaxed delay-200 duration-700"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            Secure, scalable cloud solutions for the enterprise. BDKinc delivers
            intelligent orchestration across private, public, and hybrid
            environments with premier management and 24/7 support.
          </p>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--accent]/50"
      >
      </div>
    </section>
    <!-- Core Services -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight normal-case md:text-4xl"
          >
            <span class="text-foreground">Deployment </span>
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >Options</span
            >
          </h2>
          <p
            class="text-muted-foreground mx-auto mt-4 max-w-2xl font-sans text-xl"
          >
            Intelligent cloud orchestration designed for the
            <span class="text-accent font-semibold">modern enterprise</span>.
          </p>
        </div>
        <TechCardGrid client:visible className="md:grid-cols-3">
          <TechCard
            variant="technical"
            interactive={true}
            trackingColor={'primary'}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="from-primary/10 to-primary/5 border-primary/20 group-hover:from-primary/20 group-hover:to-primary/10 mb-6 rounded-lg border bg-linear-to-br p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiLock className="text-primary h-16 w-16" aria-hidden="true" />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Private Cloud
              </h4>
              <div class="text-muted-foreground mb-6 text-sm leading-relaxed">
                Uncompromising Control. BDKinc’s Private Cloud offers dedicated
                resources in our secure datacenters, ensuring absolute data
                sovereignty, predictable performance, and compliance for
                sensitive workloads.
              </div>
            </div>
          </TechCard>
          <TechCard
            variant="technical"
            interactive={true}
            trackingColor={'secondary'}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="from-secondary/10 to-secondary/5 border-secondary/20 group-hover:from-secondary/20 group-hover:to-secondary/10 mb-6 rounded-lg border bg-linear-to-br p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiStack
                  className="text-secondary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-secondary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Hybrid Cloud
              </h4>
              <div class="text-muted-foreground mb-6 text-sm leading-relaxed">
                Seamless Integration. Bridge the gap between on-premise legacy
                systems and modern cloud agility. Our hybrid architectures allow
                you to scale securely, keeping sensitive data close while
                leveraging public cloud power.
              </div>
            </div>
          </TechCard>
          <TechCard
            variant="technical"
            interactive={true}
            trackingColor={'accent'}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="from-accent/20 to-accent/10 border-accent/20 group-hover:from-accent/30 group-hover:to-accent/20 mb-6 rounded-lg border bg-linear-to-br p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiGlobe className="text-accent h-16 w-16" aria-hidden="true" />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-accent mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Public Cloud
              </h4>
              <div class="text-muted-foreground mb-6 text-sm leading-relaxed">
                Infinite Scalability. Leverage the massive global reach of AWS,
                Azure, and IBM Cloud. We manage the complexity, optimizing your
                deployment for cost-efficiency, security, and performance at
                scale.
              </div>
            </div>
          </TechCard>
        </TechCardGrid>
      </div>
    </section>
    <!-- Strategic Leadership Section -->
    <section class="relative overflow-hidden py-24">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-4xl font-bold tracking-tight duration-600 md:text-5xl"
          >
            <span class="text-foreground">Architectural </span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Vision</span
            >
          </h2>
        </div>

        <ServiceBlockquote>
          &ldquo;Cloud is not a destination; it&rsquo;s an operating model. We
          don&rsquo;t just host your data; we architect
          <span class="text-accent"> intelligent ecosystems</span>
          that balance security, performance, and cost, ensuring your infrastructure
          never blinks.&rdquo;
        </ServiceBlockquote>
      </div>
      <div
        class="via-primary/20 absolute bottom-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
    </section>
    <!-- Strategic Advantage -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            The Strategic <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Advantage</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            Move beyond simple hosting with a partner who orchestrates
            enterprise-grade cloud transformations.
          </p>
        </div>
        <FeatureCarousel client:visible features={strategicFeatures} />
      </div>
    </section>
    <!-- Partners Grid -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            Multi-Provider <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Expertise</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            Certified expertise across leading cloud platforms and enterprise
            infrastructure partners.
          </p>
        </div>
        <TechCardGrid
          client:visible
          className="mx-auto max-w-6xl grid-cols-1 gap-6 md:grid-cols-3"
        >
          {
            providers.map((provider) => (
              <TechCard
                variant="blog"
                interactive={true}
                trackingColor={'secondary'}
              >
                <div class="group/provider flex h-full flex-col p-8 text-center">
                  {/* Visual Header */}
                  <div class="mb-8 flex h-20 flex-col items-center justify-center">
                    <div class="relative">
                      <div class="bg-primary/5 absolute -inset-4 rounded-full opacity-0 blur-xl transition-opacity duration-500 group-hover/provider:opacity-100" />
                      {provider.logo ? (
                        <img
                          src={provider.logo}
                          alt={provider.name}
                          width="180"
                          height="64"
                          class="relative h-16 w-auto max-w-[180px] object-contain transition-transform duration-500 group-hover/provider:scale-110"
                        />
                      ) : (
                        <div class="relative flex h-16 w-[180px] items-center justify-center transition-transform duration-500 group-hover/provider:scale-110">
                          <Logo />
                        </div>
                      )}
                    </div>
                  </div>

                  {/* Content */}
                  <div class="grow">
                    <h5 class="font-display text-foreground group-hover/provider:text-primary mb-3 text-xl font-bold tracking-tight transition-colors duration-300">
                      {provider.name}
                    </h5>
                    <p class="text-muted-foreground/80 group-hover/provider:text-muted-foreground font-sans text-sm leading-relaxed transition-colors duration-300">
                      {provider.desc}
                    </p>
                  </div>
                </div>
              </TechCard>
            ))
          }
        </TechCardGrid>
      </div>
    </section>
    <!-- Key Benefits -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <BenefitGrid benefits={keyBenefits} />
      </div>
    </section>

    <!-- FAQ -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
          Frequently Asked Questions
        </h3>
        <div class="mb-20">
          <TechnicalFAQ client:visible faqs={faqs} />
        </div>
      </div>
    </section>
    <ImpactMetricsSection metrics={metrics} />
    <!-- CTA -->
    <CTASection
      client:visible
      title="Power Your Vision in the Cloud"
      description="Stop settling for standard hosting. Partner with the architects who understand your scale and security requirements."
      buttonText="Schedule a Cloud Strategy Session"
      buttonHref="/contact#chat"
    />
  </main>
  <Footer />
</Layout>
