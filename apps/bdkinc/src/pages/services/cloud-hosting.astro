---
import { getContentEntry, getPageCopy, getSettings, type ContentProps } from '@/lib/content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import { TechCard, TechCardGrid } from '@/components/TechCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import Logo from '@/components/Logo';

import CohesiveOrbit from '@/components/visualizations/CohesiveOrbit';
import FeatureCarousel from '@/components/FeatureCarousel';
import BenefitGrid from '@/components/BenefitGrid.astro';
import ServiceBlockquote from '@/components/ServiceBlockquote.astro';
import {
  PiLock,
  PiLightning,
  PiUsersThree,
  PiShield,
  PiArrowsClockwise,
  PiCloud,
  PiClock,
  PiGlobe,
  PiStack,
  PiCurrencyDollar,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';
import EditSection from '@/components/preview/EditSection.astro';
import { servicePageSchemas } from '@/lib/schema';
interface Props extends ContentProps {}
const { contentContext, publicPath = Astro.url.pathname } = Astro.props;
const [service, copy, settings] = await Promise.all([
  getContentEntry('services', 'cloud-hosting', contentContext),
  getPageCopy('service-cloud-hosting', contentContext),
  getSettings(contentContext),
]);
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData(contentContext);
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');
const _serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.title,
  description: copy.serviceSchema.description,
  provider: {
    '@type': 'Organization',
    name: settings.siteName,
    url: settings.organization.url,
  },
  serviceType: copy.serviceSchema.serviceType,
};
const metrics = [
  { ...copy.metrics.uptimeSla, icon: PiShield },
  { ...copy.metrics.cloudMigrations, icon: PiArrowsClockwise },
  { ...copy.metrics.dataManaged, icon: PiCloud },
  { ...copy.metrics.operationsCenter, icon: PiClock },
];
const faqs = [
  copy.faqs.howDoYouDetermineTheRightMix,
  copy.faqs.howDoYouHandleComplianceAndSecurity,
  copy.faqs.whatDoesManagedCloudActuallyInclude,
];
const { breadcrumb: breadcrumbSchema, faq: faqSchema } = servicePageSchemas({
  serviceName: service.data.title,
  servicePath: '/services/cloud-hosting',
  faqs,
  copy: settings.navigation,
});
const strategicFeatures = [
  { ...copy.strategy.features.orchestratedAgility, icon: 'Stack' },
  { ...copy.strategy.features.architecturalSovereignty, icon: 'Lock' },
  { ...copy.strategy.features.costOptimization, icon: 'CurrencyDollar' },
  { ...copy.strategy.features.zeroDisruptionMigration, icon: 'CloudArrowUp' },
];
const providers = [
  copy.providers.items.ibmCloud,
  copy.providers.items.aws,
  copy.providers.items.microsoftAzure,
  copy.providers.items.googleCloud,
  { ...copy.providers.items.bdkcloud, logo: null },
  copy.providers.items.cloudflare,
];

const keyBenefits = [
  { ...copy.benefits.items.enhancedReliability, icon: PiShield },
  { ...copy.benefits.items.costEfficiency, icon: PiCurrencyDollar },
  { ...copy.benefits.items.businessContinuity, icon: PiArrowsClockwise },
  { ...copy.benefits.items.architecturalExpertise, icon: PiUsersThree },
  { ...copy.benefits.items.securityFirst, icon: PiLock },
  { ...copy.benefits.items.infiniteFlexibility, icon: PiLightning },
];
---

<Layout
  title={copy.seo.title}
  description={copy.seo.description}
  ogDescription={copy.seo.ogDescription}
  contentContext={contentContext}
  publicPath={publicPath}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(_serviceSchema).replace(/</g, '\\u003c')}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbSchema).replace(/</g, '\\u003c')}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema).replace(/</g, '\\u003c')}
  />
  <EditSection record="settings" section="navigation">
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={publicPath}
    copy={settings.navigation}
    brand={settings.brand}
  />
  </EditSection>
  <main id="main-content" class="services-page-shell">
    <EditSection record="service-cloud-hosting" section="hero">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="scanlines pointer-events-none absolute inset-0 opacity-50">
      </div>
      <div
        class="pointer-events-none absolute inset-0 z-0 flex items-center justify-center opacity-80 md:opacity-100"
      >
        <CohesiveOrbit client:idle />
      </div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
          <!-- Badge -->
          <div
            class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
          >
            <div class="flex items-center gap-2 text-sm">
              <span
                >{copy.hero.badgePrefix}{' '}<span class="text-accent font-semibold">{copy.hero.badgeAccent}</span
                ></span
              >
            </div>
          </div>
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <!-- Heading -->
          <h1
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold tracking-tight delay-100 duration-700 md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <!-- Subtitle -->
          <p
            class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 mx-auto mb-16 max-w-3xl text-xl leading-relaxed delay-200 duration-700"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            {copy.hero.body}
          </p>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--accent]/50"
      >
      </div>
    </section>
    </EditSection>
    <EditSection record="service-cloud-hosting" section="deployment">
    <!-- Core Services -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight normal-case md:text-4xl"
          >
            <span class="text-foreground">{copy.deployment.heading}{' '}</span>
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.deployment.headingAccent}</span
            >
          </h2>
          <p
            class="text-muted-foreground mx-auto mt-4 max-w-2xl font-sans text-xl"
          >
            {copy.deployment.bodyBefore}{' '}<span class="text-accent font-semibold">{copy.deployment.bodyAccent}</span>{copy.deployment.bodyAfter}
          </p>
        </div>
        <TechCardGrid client:visible className="md:grid-cols-3">
          <TechCard
            variant="technical"
            interactive={true}
            trackingColor={'primary'}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="from-primary/10 to-primary/5 border-primary/20 group-hover:from-primary/20 group-hover:to-primary/10 mb-6 rounded-lg border bg-linear-to-br p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiLock className="text-primary h-16 w-16" aria-hidden="true" />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                {copy.deployment.privateCloud.title}
              </h4>
              <div class="text-muted-foreground mb-6 text-sm leading-relaxed">
                {copy.deployment.privateCloud.description}
              </div>
            </div>
          </TechCard>
          <TechCard
            variant="technical"
            interactive={true}
            trackingColor={'secondary'}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="from-secondary/10 to-secondary/5 border-secondary/20 group-hover:from-secondary/20 group-hover:to-secondary/10 mb-6 rounded-lg border bg-linear-to-br p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiStack
                  className="text-secondary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-secondary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                {copy.deployment.hybridCloud.title}
              </h4>
              <div class="text-muted-foreground mb-6 text-sm leading-relaxed">
                {copy.deployment.hybridCloud.description}
              </div>
            </div>
          </TechCard>
          <TechCard
            variant="technical"
            interactive={true}
            trackingColor={'accent'}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="from-accent/20 to-accent/10 border-accent/20 group-hover:from-accent/30 group-hover:to-accent/20 mb-6 rounded-lg border bg-linear-to-br p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiGlobe className="text-accent h-16 w-16" aria-hidden="true" />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-accent mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                {copy.deployment.publicCloud.title}
              </h4>
              <div class="text-muted-foreground mb-6 text-sm leading-relaxed">
                {copy.deployment.publicCloud.description}
              </div>
            </div>
          </TechCard>
        </TechCardGrid>
      </div>
    </section>
    </EditSection>
    <EditSection record="service-cloud-hosting" section="leadership">
    <!-- Strategic Leadership Section -->
    <section class="relative overflow-hidden py-24">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-4xl font-bold tracking-tight duration-600 md:text-5xl"
          >
            <span class="text-foreground">{copy.leadership.heading}{' '}</span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.leadership.headingAccent}</span
            >
          </h2>
        </div>

        <ServiceBlockquote>
          {copy.leadership.quoteBefore}{' '}<span class="text-accent">{copy.leadership.quoteAccent}</span>{' '}{copy.leadership.quoteAfter}
        </ServiceBlockquote>
      </div>
      <div
        class="via-primary/20 absolute bottom-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
    </section>
    </EditSection>
    <EditSection record="service-cloud-hosting" section="strategy">
    <!-- Strategic Advantage -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            {copy.strategy.heading}{' '}<span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.strategy.headingAccent}</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            {copy.strategy.body}
          </p>
        </div>
        <FeatureCarousel client:visible features={strategicFeatures} />
      </div>
    </section>
    </EditSection>
    <EditSection record="service-cloud-hosting" section="providers">
    <!-- Partners Grid -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            {copy.providers.heading}{' '}<span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.providers.headingAccent}</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            {copy.providers.body}
          </p>
        </div>
        <TechCardGrid
          client:visible
          className="mx-auto max-w-6xl grid-cols-1 gap-6 md:grid-cols-3"
        >
          {
            providers.map((provider) => (
              <TechCard
                variant="blog"
                interactive={true}
                trackingColor={'secondary'}
              >
                <div class="group/provider flex h-full flex-col p-8 text-center">
                  {/* Visual Header */}
                  <div class="mb-8 flex h-20 flex-col items-center justify-center">
                    <div class="relative">
                      <div class="bg-primary/5 absolute -inset-4 rounded-full opacity-0 blur-xl transition-opacity duration-500 group-hover/provider:opacity-100" />
                      {provider.logo ? (
                        <img
                          src={provider.logo}
                          alt={provider.name}
                          width="180"
                          height="64"
                          class="relative h-16 w-auto max-w-[180px] object-contain transition-transform duration-500 group-hover/provider:scale-110"
                        />
                      ) : (
                        <div class="relative flex h-16 w-[180px] items-center justify-center transition-transform duration-500 group-hover/provider:scale-110">
                          <Logo copy={settings.brand} />
                        </div>
                      )}
                    </div>
                  </div>

                  {/* Content */}
                  <div class="grow">
                    <h5 class="font-display text-foreground group-hover/provider:text-primary mb-3 text-xl font-bold tracking-tight transition-colors duration-300">
                      {provider.name}
                    </h5>
                    <p class="text-muted-foreground/80 group-hover/provider:text-muted-foreground font-sans text-sm leading-relaxed transition-colors duration-300">
                      {provider.desc}
                    </p>
                  </div>
                </div>
              </TechCard>
            ))
          }
        </TechCardGrid>
      </div>
    </section>
    </EditSection>
    <EditSection record="service-cloud-hosting" section="benefits">
    <!-- Key Benefits -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <BenefitGrid benefits={keyBenefits} copy={settings.benefits} />
      </div>
    </section>

    </EditSection>
    <EditSection record="service-cloud-hosting" section="faqs" also={['faqHeading']}>
    <!-- FAQ -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
          {copy.faqHeading}
        </h3>
        <div class="mb-20">
          <TechnicalFAQ client:visible faqs={faqs} />
        </div>
      </div>
    </section>
    </EditSection>
    <EditSection record="service-cloud-hosting" section="metrics">
    <ImpactMetricsSection metrics={metrics} copy={settings.metrics} />
    </EditSection>
    <EditSection record="service-cloud-hosting" section="cta">
    <!-- CTA -->
    <CTASection
      client:visible
      copy={settings.cta}
      {...copy.cta}
    />
    </EditSection>
  </main>
  <Footer contentContext={contentContext} />
</Layout>
