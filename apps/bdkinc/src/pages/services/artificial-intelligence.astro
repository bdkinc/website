---
import { getEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import { TechCard, TechCardGrid } from '@/components/TechCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import NeuralPipeline from '@/components/NeuralPipeline';
import WatsonxSpotlight from '@/components/WatsonxSpotlight';

import ArtificialIntelligenceVisualization from '@/components/visualizations/ArtificialIntelligenceVisualization';
import FeatureCarousel from '@/components/FeatureCarousel';
import {
  PiLightning,
  PiTrendUp,
  PiShield,
  PiTarget,
  PiBrain,
  PiCpu,
  PiShieldCheck,
  PiQuotesFill,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';
const service = await getEntry('services', 'artificial-intelligence');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');
const metrics = [
  { value: '100+', label: 'Enterprise Models Deployed', icon: PiBrain },
  { value: '6 weeks', label: 'MVP to Production', icon: PiLightning },
  { value: '40%', label: 'Ops Efficiency Gain', icon: PiTrendUp },
  { value: '99.9%', label: 'Inference Uptime', icon: PiShield },
];
const faqs = [
  {
    question: 'How do you calculate ROI for an AI initiative?',
    answer:
      'We focus on measurable outcomes: reduced operational costs, increased throughput, or revenue uplift. Our Discovery Phase establishes clear KPIs, ensuring every model deployed drives tangible business value within 3-6 months.',
  },
  {
    question: 'Is my proprietary data safe when using Generative AI?',
    answer:
      'Absolutely. We utilize private model instances and RAG (Retrieval-Augmented Generation) architectures where your data is used strictly for context retrieval, never for public model training. Your intellectual property remains isolated and secure.',
  },
  {
    question: 'Can you integrate AI into our legacy ERP systems?',
    answer:
      "Yes. Our 'API-first' approach allows us to wrap legacy systems with modern AI interfaces. We can inject predictive insights or automated actions directly into your existing screens and workflows.",
  },
];
const strategicFeatures = [
  {
    title: 'Neural Orchestration',
    description: 'Secure, governed AI ecosystems powered by IBM watsonx.',
    highlight: 'Secure AI ecosystems',
    icon: 'Brain',
    detail:
      'We design AI architectures that prioritize security and governance. By utilizing watsonx.governance, we ensure that every model in your ecosystem is transparent, explainable, and aligned with your operational standards.',
  },
  {
    title: 'Retrieval-Augmented Intelligence',
    description:
      'Grounding LLMs in your proprietary data for zero hallucination.',
    highlight: 'Zero hallucination',
    icon: 'Target',
    detail:
      'Your data is your competitive edge. We implement RAG architectures that allow generative models to retrieve context from your secure internal databases, providing highly accurate responses without risking your intellectual property.',
  },
  {
    title: 'Predictive Precision',
    description:
      'High-fidelity forecasting using machine learning and time-series analysis.',
    highlight: 'High-fidelity forecasting',
    icon: 'ChartLine',
    detail:
      'Transform historical drag into future momentum. Our predictive engines identify patterns in supply chain, demand, and risk, allowing you to make decisions based on mathematical certainty rather than intuition.',
  },
  {
    title: 'Operational Cognitive Automation',
    description:
      'Embedding intelligence directly into high-volume business workflows.',
    highlight: 'High-volume workflows',
    icon: 'Lightning',
    detail:
      "AI shouldn't be a separate tool; it should be the engine. We inject cognitive capabilities directly into your ERP and CRM systems, automating complex decision paths and accelerating overall business throughput.",
  },
];
---

<Layout
  title={`${service.data.title} - BDKinc`}
  description={service.data.description}
>
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <!-- AI-specific: extra purple radial glow -->
      <div
        class="pointer-events-none absolute inset-0"
        style="background: radial-gradient(ellipse 80% 50% at 50% 0%, oklch(0.65 0.22 280 / 0.12) 0%, transparent 70%);"
      >
      </div>
      <div class="circuit-overlay absolute inset-0 opacity-40"></div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
          <!-- Badge -->
          <div
            class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
          >
            <div class="flex items-center gap-2 text-sm">
              <span
                >Enterprise <span class="text-accent font-semibold"
                  >AI Intelligence</span
                ></span
              >
            </div>
          </div>
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <!-- Heading -->
          <h1
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold tracking-tight delay-100 duration-700 md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <!-- Subtitle -->
          <p
            class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 mx-auto mb-16 max-w-3xl text-xl leading-relaxed delay-200 duration-700"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            BDKinc delivers engineered intelligence using IBM watsonx and proven
            ML workflows. We design secure, governed AI ecosystems that
            integrate cleanly with your core systems.
          </p>
        </div>
        <!-- Visualization -->
        <div
          class="fill-mode-both animate-in fade-in zoom-in delay-300 duration-700"
        >
          <div class="mx-auto max-w-5xl">
            <ArtificialIntelligenceVisualization client:visible />
          </div>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--accent]/50"
      >
      </div>
    </section>
    <!-- Core Services -->
    <section
      class="bg-muted/30 px-4 py-24 sm:px-6 lg:px-8 dark:bg-white/[0.02]"
    >
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight normal-case md:text-4xl"
          >
            <span class="text-foreground">Core </span>
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >Capabilities</span
            >
          </h2>
          <p
            class="text-muted-foreground mx-auto mt-4 max-w-2xl font-sans text-xl"
          >
            Engineered intelligence designed for the
            <span class="text-accent font-semibold">modern enterprise</span>.
          </p>
        </div>
        <TechCardGrid client:visible className="md:grid-cols-3">
          <TechCard variant="technical" interactive={true}>
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiBrain
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Generative AI & LLMs
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Build secure, domain-specific generative models using RAG
                architectures. We implement watsonx.ai to ensure your assistants
                are grounded in your proprietary data.
              </div>
            </div>
          </TechCard>
          <TechCard variant="technical" interactive={true}>
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiTrendUp
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Predictive Analytics
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Transform historical data into future certainty. Our ML models
                forecast demand and optimize resource allocation with
                high-precision inference engines.
              </div>
            </div>
          </TechCard>
          <TechCard variant="technical" interactive={true}>
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiTarget
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Intelligent Automation
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Embed AI into operational workflows. From computer vision for
                quality control to NLP for document processing, we automate
                complex cognitive tasks.
              </div>
            </div>
          </TechCard>
        </TechCardGrid>
      </div>
    </section>
    <!-- Strategic Leadership Section -->
    <section class="relative overflow-hidden py-24">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-4xl font-bold tracking-tight duration-600 md:text-5xl"
          >
            <span class="text-foreground">Cognitive </span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Leadership</span
            >
          </h2>
        </div>

        <!-- Glass Quote Container -->
        <div class="relative mx-auto max-w-4xl">
          <!-- Floating Icon -->
          <div class="text-primary absolute -top-10 -left-6 z-20 md:-left-10">
            <PiQuotesFill
              className="h-20 w-20 rotate-[-12deg] drop-shadow-xl filter"
              aria-hidden="true"
            />
          </div>

          <!-- Glass Card -->
          <div
            class="relative z-10 overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-10 backdrop-blur-xl md:p-14 dark:border-white/[0.05] dark:bg-white/[0.03]"
          >
            <!-- Ambient Glow -->
            <div
              class="bg-primary/20 absolute -top-24 -right-24 h-64 w-64 rounded-full opacity-50 blur-3xl"
            >
            </div>
            <div
              class="bg-secondary/20 absolute -bottom-24 -left-24 h-64 w-64 rounded-full opacity-50 blur-3xl"
            >
            </div>

            <!-- Background Watermark -->
            <div
              class="pointer-events-none absolute top-0 right-0 z-0 opacity-[0.03]"
            >
              <PiQuotesFill
                className="h-64 w-64 translate-x-1/4 -translate-y-1/4 -rotate-12"
                aria-hidden="true"
              />
            </div>

            <blockquote
              class="font-display text-foreground relative z-10 text-center text-2xl leading-relaxed font-medium md:text-3xl"
            >
              &ldquo;AI is not a separate tool; it&rsquo;s the engine of modern
              business. We architect
              <span class="text-accent"> intelligent ecosystems</span>
              that automate complexity and transform your proprietary data into your
              most powerful competitive advantage.&rdquo;
            </blockquote>
          </div>
        </div>
      </div>
      <div
        class="via-primary/20 absolute bottom-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
    </section>
    <!-- Strategic Advantage -->
    <section
      class="to-muted/20 bg-linear-to-b from-transparent px-4 py-24 sm:px-6 lg:px-8 dark:to-white/[0.02]"
    >
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            The Strategic <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Advantage</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            Move beyond experiments with a partner who builds production-ready,
            governed AI solutions.
          </p>
        </div>
        <FeatureCarousel client:visible features={strategicFeatures} />
      </div>
    </section>
    <!-- Watsonx Spotlight -->
    <section class="bg-muted/30 py-24 dark:bg-white/[0.02]">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <WatsonxSpotlight client:visible />
      </div>
    </section>
    <!-- Generative Solutions: Numbered Timeline -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <div class="mb-16 text-center">
          <h2
            class="text-foreground font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            Generative <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Solutions</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            Enterprise-grade LLMs designed for measurable business use cases.
          </p>
        </div>
        <div class="relative">
          <!-- Vertical connecting line -->
          <div
            class="from-primary/60 via-secondary/40 absolute top-8 bottom-8 left-6 hidden w-px bg-linear-to-b to-transparent md:block"
            aria-hidden="true"
          >
          </div>
          <div class="space-y-6">
            {
              [
                {
                  num: '01',
                  title: 'Custom AI Assistants',
                  desc: 'Deploy intelligent agents trained on your documentation, ensuring context-aware support for internal teams or customers. Grounded in your proprietary data via RAG — zero hallucination.',
                  tag: 'Conversational AI',
                },
                {
                  num: '02',
                  title: 'Intelligent Document Processing',
                  desc: 'Automate the extraction of critical data from contracts, invoices, and reports with high-precision NLP models. Reduce manual review time by up to 80%.',
                  tag: 'NLP / OCR',
                },
                {
                  num: '03',
                  title: 'Code Modernization',
                  desc: 'Accelerate development cycles using AI to refactor legacy codebases, generate comprehensive test suites, and auto-document complex systems at scale.',
                  tag: 'Dev Acceleration',
                },
                {
                  num: '04',
                  title: 'Content Strategy at Scale',
                  desc: 'Generate high-fidelity technical documentation and on-brand marketing copy with consistent brand-voice alignment across all channels and formats.',
                  tag: 'Content AI',
                },
              ].map(({ num, title, desc, tag }) => (
                <div class="group relative flex gap-6 md:gap-8">
                  {/* Number bubble */}
                  <div class="relative z-10 shrink-0">
                    <div class="border-primary/40 bg-background group-hover:border-primary group-hover:bg-primary/10 flex h-12 w-12 items-center justify-center rounded-full border transition-[background-color,border-color] duration-300">
                      <span class="text-primary font-mono text-xs font-bold">
                        {num}
                      </span>
                    </div>
                  </div>
                  {/* Content */}
                  <div class="border-border bg-card/30 group-hover:border-primary/30 flex-1 rounded-xl border p-6 transition-[border-color,box-shadow] duration-300 group-hover:shadow-[0_0_20px_oklch(0.7_0.18_210_/_0.08)]">
                    <div class="mb-3 flex flex-wrap items-center gap-3">
                      <h3 class="font-display text-foreground group-hover:text-primary text-lg font-bold transition-colors duration-300">
                        {title}
                      </h3>
                      <span class="text-secondary bg-secondary/10 border-secondary/20 rounded border px-2 py-0.5 font-mono text-[10px] font-bold tracking-widest">
                        {tag}
                      </span>
                    </div>
                    <p class="text-muted-foreground text-sm leading-relaxed">
                      {desc}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>
    <!-- Before AI / After AI Contrast Section -->
    <section
      class="bg-muted/20 px-4 py-24 sm:px-6 lg:px-8 dark:bg-white/[0.01]"
    >
      <div class="mx-auto max-w-6xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            Before AI. <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >After BDK.</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            What changes when governed enterprise AI is embedded in your
            operations.
          </p>
        </div>
        <div
          class="border-border grid gap-0 overflow-hidden rounded-2xl border md:grid-cols-2"
        >
          <!-- Before -->
          <div class="bg-muted/60 p-8 md:p-10 dark:bg-white/[0.03]">
            <div class="mb-8 flex items-center gap-3">
              <div class="bg-destructive/10 rounded-lg p-2">
                <PiCpu
                  className="text-destructive h-5 w-5"
                  aria-hidden="true"
                />
              </div>
              <h3
                class="font-display text-muted-foreground text-lg font-bold tracking-tight"
              >
                Before AI Integration
              </h3>
            </div>
            <ul class="space-y-5">
              {
                [
                  'Manual review of hundreds of documents daily',
                  'Decisions based on lagging historical reports',
                  'Generic public AI tools handling sensitive data',
                  'Engineers buried in repetitive code documentation',
                  'Customer support queues with long resolution times',
                  'Demand forecasting based on intuition and spreadsheets',
                ].map((text) => (
                  <li class="flex items-start gap-3">
                    <div class="border-destructive/30 bg-destructive/10 mt-1 h-4 w-4 shrink-0 rounded-full border" />
                    <span class="text-muted-foreground text-sm leading-relaxed">
                      {text}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
          <!-- After -->
          <div
            class="bg-secondary/5 dark:bg-secondary/10 border-border border-t p-8 md:border-t-0 md:border-l md:p-10"
          >
            <div class="mb-8 flex items-center gap-3">
              <div class="bg-primary/15 rounded-lg p-2">
                <PiBrain className="text-primary h-5 w-5" aria-hidden="true" />
              </div>
              <h3
                class="font-display text-foreground text-lg font-bold tracking-tight"
              >
                After BDK AI Deployment
              </h3>
            </div>
            <ul class="space-y-5">
              {
                [
                  {
                    text: 'Automated document extraction at 10× human speed',
                    stat: '10×',
                  },
                  {
                    text: 'Predictive models surfacing insights 30–90 days ahead',
                    stat: '90-day foresight',
                  },
                  {
                    text: 'Private model instances — your data never trains public LLMs',
                    stat: 'Air-gapped',
                  },
                  {
                    text: 'AI-assisted refactoring and test generation in CI/CD',
                    stat: 'Dev velocity',
                  },
                  {
                    text: 'Context-aware AI assistants resolving 70%+ of tier-1 tickets',
                    stat: '70% deflection',
                  },
                  {
                    text: 'ML-powered demand forecasting with measurable accuracy gains',
                    stat: 'High-fidelity',
                  },
                ].map(({ text, stat }) => (
                  <li class="flex items-start gap-3">
                    <div class="mt-0.5 shrink-0">
                      <PiShieldCheck
                        className="h-4 w-4 text-primary"
                        aria-hidden="true"
                      />
                    </div>
                    <div class="min-w-0 flex-1">
                      <span class="text-foreground text-sm leading-relaxed">
                        {text}
                      </span>
                    </div>
                    <span class="text-primary bg-primary/10 shrink-0 self-center rounded px-2 py-0.5 font-mono text-[10px] font-bold tracking-widest">
                      {stat}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>
    <!-- Pipeline Section -->
    <section class="bg-muted/30 py-24 dark:bg-white/[0.02]">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2
          class="text-foreground font-display mb-12 text-center text-3xl font-bold tracking-tight md:text-4xl"
        >
          AI Delivery <span
            class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
            >Framework</span
          >
        </h2>
        <NeuralPipeline client:visible />
      </div>
    </section>

    <!-- FAQ -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
          Frequently Asked Questions
        </h3>
        <div class="mb-20">
          <TechnicalFAQ client:visible faqs={faqs} />
        </div>
      </div>
    </section>
    <ImpactMetricsSection metrics={metrics} />
    <!-- CTA -->
    <CTASection
      client:visible
      title="Plan Your AI Roadmap"
      description="Define the first 90 days of a governed AI program powered by IBM watsonx."
      buttonText="Book an AI Strategy Session"
      buttonHref="/contact#chat"
    />
  </main>
  <Footer />
</Layout>
