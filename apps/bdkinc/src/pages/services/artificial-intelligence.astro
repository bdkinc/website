---
import { createAppContentReader, type ContentProps } from '@/lib/content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import { TechCard, TechCardGrid } from '@/components/TechCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import NeuralPipeline from '@/components/NeuralPipeline';
import WatsonxSpotlight from '@/components/WatsonxSpotlight';

import CohesiveOrbit from '@/components/visualizations/CohesiveOrbit';
import FeatureCarousel, { type Feature } from '@/components/FeatureCarousel';
import ServiceBlockquote from '@/components/ServiceBlockquote.astro';
import {
  PiLightning,
  PiTrendUp,
  PiShield,
  PiTarget,
  PiBrain,
  PiCpu,
  PiShieldCheck,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';
import EditSection from '@/components/preview/EditSection.astro';
import { servicePageSchemas } from '@/lib/schema';
interface Props extends ContentProps {}
const { contentContext, publicPath = Astro.url.pathname, reader: suppliedReader } = Astro.props;
const reader = suppliedReader ?? createAppContentReader(contentContext);
const copy = await reader.getPage('service-artificial-intelligence');
const settings = await reader.getSettings();
const service = (await reader.getCollection('services')).find((entry) => entry.id === 'artificial-intelligence');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData(reader);
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');
const metrics = [
  { ...copy.metrics.enterpriseModelsDeployed, icon: PiBrain },
  { ...copy.metrics.mvpToProduction, icon: PiLightning },
  { ...copy.metrics.opsEfficiencyGain, icon: PiTrendUp },
  { ...copy.metrics.inferenceUptime, icon: PiShield },
];
const faqs = [
  copy.faqs.howDoYouCalculateRoiForAn,
  copy.faqs.isMyProprietaryDataSafeWhenUsing,
  copy.faqs.canYouIntegrateAiIntoOurLegacy,
];
const { breadcrumb: breadcrumbSchema, faq: faqSchema } = servicePageSchemas({
  copy: settings.navigation,
  serviceName: service.data.title,
  servicePath: `/services/${service.id}`,
  faqs,
});
const strategicFeatures: Feature[] = [
  { ...copy.strategy.features.neuralOrchestration, icon: 'Brain' },
  { ...copy.strategy.features.retrievalAugmentedIntelligence, icon: 'Target' },
  { ...copy.strategy.features.predictivePrecision, icon: 'ChartLine' },
  {
    ...copy.strategy.features.operationalCognitiveAutomation,
    icon: 'Lightning',
  },
];
---

<Layout reader={reader}
  contentContext={contentContext}
  publicPath={publicPath}
  title={`${service.data.title} - BDKinc`}
  description={service.data.description}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema)}
  />
  <EditSection record="settings" section="navigation">
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={publicPath}
    copy={settings.navigation}
    brand={settings.brand}
  />
  </EditSection>
  <main id="main-content" class="services-page-shell">
    <EditSection record="service-artificial-intelligence" section="hero">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <!-- AI-specific: extra purple radial glow -->
      <div
        class="pointer-events-none absolute inset-0"
        style="background: radial-gradient(ellipse 80% 50% at 50% 0%, oklch(0.65 0.22 280 / 0.12) 0%, transparent 70%);"
      >
      </div>
      <div class="scanlines pointer-events-none absolute inset-0 opacity-50">
      </div>

      <!-- Visualization -->
      <div
        class="pointer-events-none absolute inset-0 z-0 flex items-center justify-center opacity-80 md:opacity-100"
      >
        <CohesiveOrbit client:idle />
      </div>

      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
          <!-- Badge -->
          <div
            class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
          >
            <div class="flex items-center gap-2 text-sm">
              <span
                >{copy.hero.badgePrefix}{' '}<span
                  class="text-accent font-semibold"
                  >{copy.hero.badgeAccent}</span
                ></span
              >
            </div>
          </div>
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <!-- Heading -->
          <h1
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold tracking-tight delay-100 duration-700 md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <!-- Subtitle -->
          <p
            class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 mx-auto mb-16 max-w-3xl text-xl leading-relaxed delay-200 duration-700"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            {copy.hero.body}
          </p>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--accent]/50"
      >
      </div>
    </section>
    </EditSection>
    <EditSection record="service-artificial-intelligence" section="capabilities">
    <!-- Core Services -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight normal-case md:text-4xl"
          >
            <span class="text-foreground">{copy.capabilities.heading}{' '}</span
            >
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.capabilities.headingAccent}</span
            >
          </h2>
          <p
            class="text-muted-foreground mx-auto mt-4 max-w-2xl font-sans text-xl"
          >
            {copy.capabilities.bodyBefore}{' '}<span
              class="text-accent font-semibold"
              >{copy.capabilities.bodyAccent}</span
            >{copy.capabilities.bodyAfter}
          </p>
        </div>
        <TechCardGrid client:visible className="md:grid-cols-3">
          <TechCard variant="technical" interactive={true}>
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiBrain
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                {copy.capabilities.generativeAi.title}
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                {copy.capabilities.generativeAi.description}
              </div>
            </div>
          </TechCard>
          <TechCard variant="technical" interactive={true}>
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiTrendUp
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                {copy.capabilities.predictiveAnalytics.title}
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                {copy.capabilities.predictiveAnalytics.description}
              </div>
            </div>
          </TechCard>
          <TechCard variant="technical" interactive={true}>
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiTarget
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                {copy.capabilities.intelligentAutomation.title}
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                {copy.capabilities.intelligentAutomation.description}
              </div>
            </div>
          </TechCard>
        </TechCardGrid>
      </div>
    </section>
    </EditSection>
    <EditSection record="service-artificial-intelligence" section="leadership">
    <!-- Strategic Leadership Section -->
    <section class="relative overflow-hidden py-24">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-4xl font-bold tracking-tight duration-600 md:text-5xl"
          >
            <span class="text-foreground">{copy.leadership.heading}{' '}</span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.leadership.headingAccent}</span
            >
          </h2>
        </div>

        <ServiceBlockquote>
          {copy.leadership.quoteBefore}{' '}<span class="text-accent"
            >{copy.leadership.quoteAccent}</span
          >{' '}{copy.leadership.quoteAfter}
        </ServiceBlockquote>
      </div>
      <div
        class="via-primary/20 absolute bottom-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
    </section>
    </EditSection>
    <EditSection record="service-artificial-intelligence" section="strategy">
    <!-- Strategic Advantage -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            {copy.strategy.heading}{' '}<span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.strategy.headingAccent}</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            {copy.strategy.body}
          </p>
        </div>
        <FeatureCarousel client:visible features={strategicFeatures} />
      </div>
    </section>
    </EditSection>
    <EditSection record="service-artificial-intelligence" section="watsonx">
    <!-- Watsonx Spotlight -->
    <section class="py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <WatsonxSpotlight client:visible copy={copy.watsonx} />
      </div>
    </section>
    </EditSection>
    <EditSection record="service-artificial-intelligence" section="solutions">
    <!-- Generative Solutions: Numbered Timeline -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <div class="mb-16 text-center">
          <h2
            class="text-foreground font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            {copy.solutions.heading}{' '}<span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.solutions.headingAccent}</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            {copy.solutions.body}
          </p>
        </div>
        <div class="relative">
          <!-- Vertical connecting line -->
          <div
            class="from-primary/60 via-secondary/40 absolute top-8 bottom-8 left-6 hidden w-px bg-linear-to-b to-transparent md:block"
            aria-hidden="true"
          >
          </div>
          <div class="space-y-6">
            {
              [
                {
                  num: '01',
                  ...copy.solutions.items.customAiAssistants,
                },
                {
                  num: '02',
                  ...copy.solutions.items.intelligentDocumentProcessing,
                },
                {
                  num: '03',
                  ...copy.solutions.items.codeModernization,
                },
                {
                  num: '04',
                  ...copy.solutions.items.contentStrategyAtScale,
                },
              ].map(({ num, title, desc, tag }) => (
                <div class="group relative flex gap-6 md:gap-8">
                  {/* Number bubble */}
                  <div class="relative z-10 shrink-0">
                    <div class="border-primary/40 bg-background group-hover:border-primary group-hover:bg-primary/10 flex h-12 w-12 items-center justify-center rounded-full border transition-[background-color,border-color] duration-300">
                      <span class="text-primary font-mono text-xs font-bold">
                        {num}
                      </span>
                    </div>
                  </div>
                  {/* Content */}
                  <div class="border-border bg-card/30 group-hover:border-primary/30 flex-1 rounded-xl border p-6 transition-[border-color,box-shadow] duration-300 group-hover:shadow-[0_0_20px_oklch(0.7_0.18_210_/_0.08)]">
                    <div class="mb-3 flex flex-wrap items-center gap-3">
                      <h3 class="font-display text-foreground group-hover:text-primary text-lg font-bold transition-colors duration-300">
                        {title}
                      </h3>
                      <span class="text-secondary bg-secondary/10 border-secondary/20 rounded border px-2 py-0.5 font-mono text-[10px] font-bold tracking-widest">
                        {tag}
                      </span>
                    </div>
                    <p class="text-muted-foreground text-sm leading-relaxed">
                      {desc}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>
    </EditSection>
    <EditSection record="service-artificial-intelligence" section="comparison">
    <!-- Before AI / After AI Contrast Section -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            {copy.comparison.heading}{' '}<span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.comparison.headingAccent}</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            {copy.comparison.body}
          </p>
        </div>
        <div
          class="border-border grid gap-0 overflow-hidden rounded-2xl border md:grid-cols-2"
        >
          <!-- Before -->
          <div class="bg-muted/60 p-8 md:p-10 dark:bg-white/[0.03]">
            <div class="mb-8 flex items-center gap-3">
              <div class="bg-destructive/10 rounded-lg p-2">
                <PiCpu
                  className="text-destructive h-5 w-5"
                  aria-hidden="true"
                />
              </div>
              <h3
                class="font-display text-muted-foreground text-lg font-bold tracking-tight"
              >
                {copy.comparison.beforeHeading}
              </h3>
            </div>
            <ul class="space-y-5">
              {
                [
                  copy.comparison.before.manualReviewOfHundredsOfDocumentsDaily,
                  copy.comparison.before
                    .decisionsBasedOnLaggingHistoricalReports,
                  copy.comparison.before
                    .genericPublicAiToolsHandlingSensitiveData,
                  copy.comparison.before
                    .engineersBuriedInRepetitiveCodeDocumentation,
                  copy.comparison.before
                    .customerSupportQueuesWithLongResolutionTimes,
                  copy.comparison.before
                    .demandForecastingBasedOnIntuitionAndSpreadsheets,
                ].map((text) => (
                  <li class="flex items-start gap-3">
                    <div class="border-destructive/30 bg-destructive/10 mt-1 h-4 w-4 shrink-0 rounded-full border" />
                    <span class="text-muted-foreground text-sm leading-relaxed">
                      {text}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
          <!-- After -->
          <div
            class="bg-secondary/5 dark:bg-secondary/10 border-border border-t p-8 md:border-t-0 md:border-l md:p-10"
          >
            <div class="mb-8 flex items-center gap-3">
              <div class="bg-primary/15 rounded-lg p-2">
                <PiBrain className="text-primary h-5 w-5" aria-hidden="true" />
              </div>
              <h3
                class="font-display text-foreground text-lg font-bold tracking-tight"
              >
                {copy.comparison.afterHeading}
              </h3>
            </div>
            <ul class="space-y-5">
              {
                [
                  copy.comparison.after
                    .automatedDocumentExtractionAt10HumanSpeed,
                  copy.comparison.after
                    .predictiveModelsSurfacingInsights3090Days,
                  copy.comparison.after
                    .privateModelInstancesYourDataNeverTrains,
                  copy.comparison.after
                    .aiAssistedRefactoringAndTestGenerationIn,
                  copy.comparison.after.contextAwareAiAssistantsResolving70Of,
                  copy.comparison.after
                    .mlPoweredDemandForecastingWithMeasurableAccuracy,
                ].map(({ text, stat }) => (
                  <li class="flex items-start gap-3">
                    <div class="mt-0.5 shrink-0">
                      <PiShieldCheck
                        className="h-4 w-4 text-primary"
                        aria-hidden="true"
                      />
                    </div>
                    <div class="min-w-0 flex-1">
                      <span class="text-foreground text-sm leading-relaxed">
                        {text}
                      </span>
                    </div>
                    <span class="text-primary bg-primary/10 shrink-0 self-center rounded px-2 py-0.5 font-mono text-[10px] font-bold tracking-widest">
                      {stat}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>
    </EditSection>
    <EditSection record="service-artificial-intelligence" section="pipeline">
    <!-- Pipeline Section -->
    <section class="py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2
          class="text-foreground font-display mb-12 text-center text-3xl font-bold tracking-tight md:text-4xl"
        >
          {copy.pipeline.heading}{' '}<span
            class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
            >{copy.pipeline.headingAccent}</span
          >
        </h2>
        <NeuralPipeline client:visible copy={copy.pipeline.steps} />
      </div>
    </section>

    </EditSection>
    <EditSection record="service-artificial-intelligence" section="faqs" also={['faqHeading']}>
    <!-- FAQ -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
          {copy.faqHeading}
        </h3>
        <div class="mb-20">
          <TechnicalFAQ client:visible faqs={faqs} />
        </div>
      </div>
    </section>
    </EditSection>
    <EditSection record="service-artificial-intelligence" section="metrics">
    <ImpactMetricsSection metrics={metrics} copy={settings.metrics} />
    </EditSection>
    <EditSection record="service-artificial-intelligence" section="cta">
    <!-- CTA -->
    <CTASection client:visible copy={settings.cta} {...copy.cta} />
    </EditSection>
  </main>
  <Footer reader={reader} contentContext={contentContext} />
</Layout>
