---
import { createAppContentReader, type ContentProps } from '@/lib/content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import { TechCard, TechCardGrid } from '@/components/TechCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import TechnicalFAQ from '@/components/TechnicalFAQ';

import CohesiveOrbit from '@/components/visualizations/CohesiveOrbit';
import FeatureCarousel from '@/components/FeatureCarousel';
import BenefitGrid from '@/components/BenefitGrid.astro';
import ServiceBlockquote from '@/components/ServiceBlockquote.astro';
import {
  PiArrowsClockwise,
  PiBell,
  PiEye,
  PiFileText,
  PiHardDrives,
  PiLock,
  PiShield,
  PiShieldCheck,
  PiUsers,
  PiWarning,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';
import EditSection from '@/components/preview/EditSection.astro';
import { servicePageSchemas } from '@/lib/schema';
interface Props extends ContentProps {}
const { contentContext, publicPath = Astro.url.pathname, reader: suppliedReader } = Astro.props;
const reader = suppliedReader ?? createAppContentReader(contentContext);
const [service, copy, settings] = await Promise.all([
  reader.getCollection('services').then((entries) => entries.find((entry) => entry.id === 'cybersecurity')),
  reader.getPage('service-cybersecurity'),
  reader.getSettings(),
]);
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData(reader);
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');
const _serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.title,
  description: copy.serviceSchema.description,
  provider: {
    '@type': 'Organization',
    name: settings.siteName,
    url: settings.organization.url,
  },
  serviceType: copy.serviceSchema.serviceType,
  areaServed: [copy.serviceSchema.areaServed.national, copy.serviceSchema.areaServed.global],
};
const metrics = [
  { ...copy.metrics.securityMonitoring, icon: PiEye },
  { ...copy.metrics.averageAlertResponse, icon: PiBell },
  { ...copy.metrics.uptimeTarget, icon: PiShieldCheck },
  { ...copy.metrics.complianceReadiness, icon: PiFileText },
];
const faqs = [
  copy.faqs.howDoesBdkincIntegrateWithOurExisting,
  copy.faqs.canYouAssistWithSoc2Hipaa,
  copy.faqs.whatIsYourResponseTimeForCritical,
];
const { breadcrumb: breadcrumbSchema, faq: faqSchema } = servicePageSchemas({
  serviceName: service.data.title,
  servicePath: '/services/cybersecurity',
  faqs,
  copy: settings.navigation,
});
const strategicFeatures = [
  { ...copy.strategy.features.adaptiveThreatIntelligence, icon: 'ShieldCheck' },
  { ...copy.strategy.features.zeroTrustArchitecture, icon: 'Lock' },
  { ...copy.strategy.features.complianceEngineering, icon: 'FileText' },
  { ...copy.strategy.features.resilientRecovery, icon: 'ArrowsClockwise' },
];
const detailColumns = [
  {
    title: copy.specifications.columns.managedDetectionResponse.title,
    icon: PiShieldCheck,
    items: [
      copy.specifications.columns.managedDetectionResponse.items.realTimeMonitoringAcrossEndpointsNetworkAnd,
      copy.specifications.columns.managedDetectionResponse.items.securityAnalystsTriageAlertsAndCoordinateRemediation,
      copy.specifications.columns.managedDetectionResponse.items.threatIntelligenceFeedsKeepDefensesTunedTo,
    ],
  },
  {
    title: copy.specifications.columns.complianceRisk.title,
    icon: PiFileText,
    items: [
      copy.specifications.columns.complianceRisk.items.mappedControlsForHipaaPciCjisNist,
      copy.specifications.columns.complianceRisk.items.auditReadyReportingWithEvidenceCollectionAnd,
      copy.specifications.columns.complianceRisk.items.executiveBriefingsTranslateRiskPostureIntoAction,
    ],
  },
];

const keyBenefits = [
  { ...copy.benefits.items.reduceRisk, icon: PiWarning },
  { ...copy.benefits.items.ensureCompliance, icon: PiFileText },
  { ...copy.benefits.items.minimizeDowntime, icon: PiArrowsClockwise },
  { ...copy.benefits.items.protectReputation, icon: PiShield },
  { ...copy.benefits.items.item247PeaceOfMind, icon: PiEye },
  { ...copy.benefits.items.expertGuidance, icon: PiUsers },
];
---

<Layout reader={reader}
  title={`${service.data.title} ${copy.seo.titleSuffix.trimStart()}`}
  description={copy.seo.description}
  ogDescription={copy.seo.ogDescription}
  contentContext={contentContext}
  publicPath={publicPath}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(_serviceSchema).replace(/</g, '\\u003c')}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbSchema).replace(/</g, '\\u003c')}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema).replace(/</g, '\\u003c')}
  />
  <EditSection record="settings" section="navigation">
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={publicPath}
    copy={settings.navigation}
    brand={settings.brand}
  />
  </EditSection>
  <main id="main-content" class="services-page-shell">
    <EditSection record="service-cybersecurity" section="hero">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="scanlines pointer-events-none absolute inset-0 opacity-50">
      </div>
      <div
        class="pointer-events-none absolute inset-0 z-0 flex items-center justify-center opacity-80 md:opacity-100"
      >
        <CohesiveOrbit client:idle />
      </div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
          <!-- Badge -->
          <div
            class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
          >
            <div class="flex items-center gap-2 text-sm">
              <span
                >{copy.hero.badgePrefix}{' '}<span class="text-accent font-semibold"
                  >{copy.hero.badgeAccent}</span
                ></span
              >
            </div>
          </div>
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <!-- Heading -->
          <h1
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold tracking-tight delay-100 duration-700 md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <!-- Subtitle -->
          <p
            class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 mx-auto mb-16 max-w-3xl text-xl leading-relaxed delay-200 duration-700"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            {copy.hero.body}
          </p>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--accent]/50"
      >
      </div>
    </section>
    </EditSection>
    <EditSection record="service-cybersecurity" section="capabilities">
    <!-- Core Services -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight normal-case md:text-4xl"
          >
            <span class="text-foreground">{copy.capabilities.heading}{' '}</span>
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.capabilities.headingAccent}</span
            >
          </h2>
          <p
            class="text-muted-foreground mx-auto mt-4 max-w-2xl font-sans text-xl"
          >
            {copy.capabilities.bodyBefore}{' '}<span class="text-accent font-semibold">{copy.capabilities.bodyAccent}</span>{copy.capabilities.bodyAfter}
          </p>
        </div>
        <TechCardGrid client:visible className="md:grid-cols-3">
          <TechCard
            variant="technical"
            interactive={true}
            trackingColor={'primary'}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="from-primary/10 to-primary/5 border-primary/20 group-hover:border-primary/50 mx-auto mb-6 flex w-fit items-center justify-center rounded-xl border bg-linear-to-br p-5 transition-colors duration-500 group-hover:scale-110"
              >
                <PiShieldCheck
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                {copy.capabilities.managedDetection.title}
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                {copy.capabilities.managedDetection.description}
              </div>
            </div>
          </TechCard>
          <TechCard
            variant="technical"
            interactive={true}
            trackingColor={'secondary'}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="from-secondary/10 to-secondary/5 border-secondary/20 group-hover:border-secondary/50 mx-auto mb-6 flex w-fit items-center justify-center rounded-xl border bg-linear-to-br p-5 transition-colors duration-500 group-hover:scale-110"
              >
                <PiLock
                  className="text-secondary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-secondary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                {copy.capabilities.ransomwareDefense.title}
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                {copy.capabilities.ransomwareDefense.description}
              </div>
            </div>
          </TechCard>
          <TechCard
            variant="technical"
            interactive={true}
            trackingColor={'accent'}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="from-accent/20 to-accent/10 border-accent/30 group-hover:border-accent/60 mx-auto mb-6 flex w-fit items-center justify-center rounded-xl border bg-linear-to-br p-5 transition-colors duration-500 group-hover:scale-110"
              >
                <PiFileText
                  className="text-accent h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-accent mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                {copy.capabilities.complianceEngineering.title}
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                {copy.capabilities.complianceEngineering.description}
              </div>
            </div>
          </TechCard>
        </TechCardGrid>
      </div>
    </section>
    </EditSection>
    <EditSection record="service-cybersecurity" section="leadership">
    <!-- Strategic Leadership Section -->
    <section class="relative overflow-hidden py-24">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-4xl font-bold tracking-tight duration-600 md:text-5xl"
          >
            <span class="text-foreground">{copy.leadership.heading}{' '}</span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.leadership.headingAccent}</span
            >
          </h2>
        </div>

        <ServiceBlockquote>
          {copy.leadership.quoteBefore}{' '}<span class="text-accent">{copy.leadership.quoteAccent}</span>{' '}{copy.leadership.quoteAfter}
        </ServiceBlockquote>
      </div>
      <div
        class="via-primary/20 absolute bottom-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
    </section>
    </EditSection>
    <EditSection record="service-cybersecurity" section="strategy">
    <!-- Strategic Advantage -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            {copy.strategy.heading}{' '}<span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.strategy.headingAccent}</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            {copy.strategy.body}
          </p>
        </div>
        <FeatureCarousel client:visible features={strategicFeatures} />
      </div>
    </section>
    </EditSection>
    <EditSection record="service-cybersecurity" section="framework">
    <!-- Security Framework Section -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            {copy.framework.heading}{' '}<span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.framework.headingAccent}</span
            >
          </h2>
        </div>
        <div class="relative">
          <!-- Connecting Path (Desktop) -->
          <div
            class="absolute top-8 right-[10%] left-[10%] hidden h-0.5 overflow-hidden rounded-full md:block"
          >
            <!-- Base Line -->
            <div class="bg-muted/30 absolute inset-0"></div>
            <!-- Steady Gradient Background -->
            <div
              class="from-muted-foreground via-primary to-accent absolute inset-0 bg-linear-to-r opacity-20"
            >
            </div>
            <!-- Animated Progress Beam -->
            <div
              class="via-primary absolute top-0 bottom-0 left-0 w-1/2 animate-[shimmer_3s_linear_infinite] bg-linear-to-r from-transparent to-transparent opacity-80 blur-sm"
              style="animation-name: slide-right; animation-duration: 3s; animation-iteration-count: infinite;"
            >
            </div>
            <!-- Add keyframes for this specific local animation if not global -->
            <style>
              @keyframes slide-right {
                0% {
                  transform: translateX(-100%);
                }
                100% {
                  transform: translateX(200%);
                }
              }
            </style>
          </div>

          <div class="grid gap-6 md:grid-cols-4">
            {
              [
                {
                  num: '01',
                  label: copy.framework.stages.prevent.label,
                  Icon: PiShieldCheck,
                  color: 'foreground',
                  items: [
                    copy.framework.stages.prevent.items.firewallManagement,
                    copy.framework.stages.prevent.items.endpointProtection,
                    copy.framework.stages.prevent.items.emailSecurity,
                    copy.framework.stages.prevent.items.userEducation,
                    copy.framework.stages.prevent.items.accessControls,
                  ],
                },
                {
                  num: '02',
                  label: copy.framework.stages.detect.label,
                  Icon: PiEye,
                  color: 'primary',
                  items: [
                    copy.framework.stages.detect.items.item247Monitoring,
                    copy.framework.stages.detect.items.intrusionDetection,
                    copy.framework.stages.detect.items.logAnalysis,
                    copy.framework.stages.detect.items.vulnerabilityScanning,
                    copy.framework.stages.detect.items.threatIntelligence,
                  ],
                },
                {
                  num: '03',
                  label: copy.framework.stages.respond.label,
                  Icon: PiBell,
                  color: 'secondary',
                  items: [
                    copy.framework.stages.respond.items.incidentResponse,
                    copy.framework.stages.respond.items.forensicAnalysis,
                    copy.framework.stages.respond.items.containmentProcedures,
                    copy.framework.stages.respond.items.recoveryProcesses,
                    copy.framework.stages.respond.items.postIncidentReview,
                  ],
                },
                {
                  num: '04',
                  label: copy.framework.stages.recover.label,
                  Icon: PiHardDrives,
                  color: 'accent',
                  items: [
                    copy.framework.stages.recover.items.backupSystems,
                    copy.framework.stages.recover.items.recoveryProcedures,
                    copy.framework.stages.recover.items.continuityPlanning,
                    copy.framework.stages.recover.items.communicationProtocols,
                    copy.framework.stages.recover.items.systemRestoration,
                  ],
                },
              ].map(({ num, label, Icon, items, color }) => {
                // Map color names to Tailwind classes
                const colorScales = {
                  primary: {
                    border: 'border-primary/30 hover:border-primary',
                    bg: 'bg-primary/5',
                    text: 'text-primary',
                    marker: 'bg-primary',
                    connector: 'from-primary',
                  },
                  secondary: {
                    border: 'border-secondary/30 hover:border-secondary',
                    bg: 'bg-secondary/5',
                    text: 'text-secondary',
                    marker: 'bg-secondary',
                    connector: 'from-secondary',
                  },
                  accent: {
                    border: 'border-accent/30 hover:border-accent',
                    bg: 'bg-accent/5',
                    text: 'text-accent',
                    marker: 'bg-accent',
                    connector: 'from-accent',
                  },
                  foreground: {
                    border: 'border-foreground/30 hover:border-foreground',
                    bg: 'bg-foreground/5',
                    text: 'text-foreground',
                    marker: 'bg-foreground',
                    connector: 'from-foreground',
                  },
                };

                const theme = colorScales[color as keyof typeof colorScales];

                return (
                  <div class="group relative flex h-full flex-col pt-16">
                    {/* Node on the path */}
                    <div class="absolute top-8 left-1/2 z-20 hidden -translate-x-1/2 -translate-y-1/2 md:block">
                      <div
                        class={`bg-background h-4 w-4 rounded-full border-2 transition-transform duration-300 group-hover:scale-150 ${theme.border.split(' ')[0]} ${theme.text}`}
                      />
                    </div>

                    {/* Vertical connector line */}
                    <div
                      class={`absolute top-8 left-1/2 hidden h-8 w-px -translate-x-1/2 bg-linear-to-b to-transparent md:block ${theme.connector}`}
                    />

                    <div
                      class={`relative z-10 flex h-full flex-col rounded-xl border p-6 backdrop-blur-xl transition-[color,background-color,border-color,box-shadow,opacity] duration-300 hover:shadow-[0_0_30px_rgba(0,0,0,0.1)] dark:hover:shadow-[0_0_30px_rgba(255,255,255,0.05)] ${theme.border} ${theme.bg}`}
                    >
                      <div class="scanlines pointer-events-none absolute inset-0 opacity-[0.02]" />

                      {/* Subtle gradient overlay */}
                      <div class="pointer-events-none absolute inset-0 rounded-xl bg-linear-to-br from-white/5 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100 dark:from-white/5" />

                      <div class="mb-4 flex items-center justify-between">
                        <div
                          class={`inline-flex h-14 w-14 items-center justify-center rounded-lg ring-1 transition-[background-color,box-shadow] duration-300 ${theme.bg} ${theme.border.split(' ')[0]} ${theme.text}`}
                        >
                          <Icon
                            className={`h-8 w-8 ${theme.text}`}
                            aria-hidden="true"
                          />
                        </div>
                        <span
                          class={`font-mono text-4xl leading-none font-bold opacity-20 transition-colors duration-300 group-hover:opacity-40 ${theme.text}`}
                        >
                          {num}
                        </span>
                      </div>
                      <h4
                        class={`font-display mb-3 text-xl font-bold ${theme.text}`}
                      >
                        {label}
                      </h4>
                      <ul class="text-muted-foreground space-y-2 font-sans text-sm">
                        {items.map((item) => (
                          <li class="flex items-start gap-2">
                            <span
                              class={`mt-1 ${theme.text}`}
                              aria-hidden="true"
                            >
                              •
                            </span>
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                );
              })
            }
          </div>
        </div>
      </div>
    </section>
    </EditSection>
    <EditSection record="service-cybersecurity" section="benefits">
    <!-- Key Benefits -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <BenefitGrid benefits={keyBenefits} copy={settings.benefits} />
      </div>
    </section>
    </EditSection>
    <EditSection record="service-cybersecurity" section="specifications">
    <!-- Detailed Capabilities Section -->
    <div class="relative">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <section class="px-4 py-24 sm:px-6 md:py-32 lg:px-8">
        <div class="mx-auto max-w-7xl">
          <div class="mb-16 text-center md:mb-24">
            <h2
              class="text-foreground font-display mb-6 text-3xl font-bold tracking-tight md:text-5xl"
            >
              {copy.specifications.heading}{' '}<span
                class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
                >{copy.specifications.headingAccent}</span
              >
            </h2>
            <p
              class="text-muted-foreground mx-auto max-w-2xl text-lg leading-relaxed md:text-xl"
            >
              {copy.specifications.body}
            </p>
          </div>

          <div class="grid gap-16 md:grid-cols-2 md:gap-24">
            {
              detailColumns.map((column, idx) => {
                const theme =
                  idx === 0
                    ? {
                        glow: 'bg-primary/5',
                        iconBg: 'from-primary/10 to-primary/5',
                        iconBorder: 'border-primary/20',
                        text: 'text-primary',
                        line: 'from-primary/50',
                        bulletGlow: 'group-hover:shadow-primary/30',
                        ringHover: 'group-hover:ring-primary',
                      }
                    : {
                        glow: 'bg-secondary/5',
                        iconBg: 'from-secondary/10 to-secondary/5',
                        iconBorder: 'border-secondary/20',
                        text: 'text-secondary',
                        line: 'from-secondary/50',
                        bulletGlow: 'group-hover:shadow-secondary/30',
                        ringHover: 'group-hover:ring-secondary',
                      };

                return (
                  <div class="relative">
                    <div
                      class={`absolute -top-8 -left-8 h-64 w-64 rounded-full ${theme.glow} blur-3xl`}
                    />

                    <div class="relative">
                      <div class="mb-10 flex items-center gap-6">
                        <div
                          class={`inline-flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl border ${theme.iconBorder} ${theme.iconBg} shadow-sm`}
                        >
                          <column.icon
                            className={`h-8 w-8 ${theme.text}`}
                            aria-hidden="true"
                          />
                        </div>
                        <h4 class="text-foreground font-display text-2xl font-bold tracking-tight md:text-3xl">
                          {column.title}
                        </h4>
                      </div>

                      <div class="relative pl-8">
                        {/* Connecting vertical line */}
                        <div
                          class={`absolute top-2 bottom-6 left-[15px] w-px bg-linear-to-b ${theme.line} to-transparent opacity-30`}
                        />

                        <ul class="space-y-10">
                          {column.items.map((item) => (
                            <li class="group relative">
                              {/* Custom bullet point on the line */}
                              <div
                                class={`bg-background ring-muted-foreground/30 absolute top-1.5 -left-[37px] h-2 w-2 rounded-full ring-2 transition-all duration-300 group-hover:scale-150 ${theme.ringHover} ${theme.bulletGlow}`}
                              />

                              <div class="flex items-start gap-4">
                                <span class="text-muted-foreground group-hover:text-foreground text-lg leading-relaxed transition-colors duration-300">
                                  {item}
                                </span>
                              </div>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  </div>
                );
              })
            }
          </div>
        </div>
      </section>
    </div>

    </EditSection>
    <EditSection record="service-cybersecurity" section="faqs" also={['faqHeading']}>
    <!-- FAQ -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
          {copy.faqHeading}
        </h3>
        <div class="mb-20">
          <TechnicalFAQ client:visible faqs={faqs} />
        </div>
      </div>
    </section>
    </EditSection>
    <EditSection record="service-cybersecurity" section="metrics">
    <ImpactMetricsSection metrics={metrics} copy={settings.metrics} />
    </EditSection>
    <EditSection record="service-cybersecurity" section="cta">
    <!-- CTA -->
    <CTASection
      client:visible
      copy={settings.cta}
      {...copy.cta}
    />
    </EditSection>
  </main>
  <Footer reader={reader} contentContext={contentContext} />
</Layout>
