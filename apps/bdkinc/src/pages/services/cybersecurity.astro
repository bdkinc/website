---
import { getEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { getBlogPosts } from '@/lib/blog';
import { iconMap } from '@/lib/icons';
import { TechCard, TechCardGrid } from '@/components/TechCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import TechnicalFAQ from '@/components/TechnicalFAQ';

import TechnicalSection from '@/components/TechnicalSection';
import CohesiveOrbit from '@/components/visualizations/CohesiveOrbit';
import FeatureCarousel from '@/components/FeatureCarousel';
import BenefitGrid from '@/components/BenefitGrid.astro';
import ServiceBlockquote from '@/components/ServiceBlockquote.astro';
import {
  PiArrowsClockwise,
  PiBell,
  PiCheckCircle,
  PiEye,
  PiFileText,
  PiHardDrives,
  PiLock,
  PiShield,
  PiShieldCheck,
  PiUsers,
  PiWarning,
  PiArrowRight,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';
import { servicePageSchemas } from '@/lib/schema';
const service = await getEntry('services', 'cybersecurity');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');
const _serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.title,
  description:
    'Fortified security for a complex world. Enterprise-grade threat resilience, managed detection and response, and rigorous compliance engineering for high-stakes environments.',
  provider: {
    '@type': 'Organization',
    name: 'BDKinc',
    url: 'https://www.bdkinc.com',
  },
  serviceType: 'Managed Cybersecurity Services',
  areaServed: ['National', 'Global'],
};
const relatedTags = [
  'cybersecurity',
  'security',
  'compliance',
  'incident-response',
];
const relatedPosts = (await getBlogPosts())
  .filter((post) => {
    return (
      Array.isArray(post.tags) &&
      post.tags.some((tag) => relatedTags.includes(tag))
    );
  })
  .slice(0, 3);
const metrics = [
  { value: '24/7', label: 'Security Monitoring', icon: PiEye },
  { value: '15 min', label: 'Average Alert Response', icon: PiBell },
  { value: '99.99%', label: 'Uptime Target', icon: PiShieldCheck },
  { value: '100%', label: 'Compliance Readiness', icon: PiFileText },
];
const faqs = [
  {
    question: 'How does BDKinc integrate with our existing IT team?',
    answer:
      'We operate as a force multiplier for your internal team. Whether you need a fully managed security operations center (SOC) or co-managed support, we integrate seamlessly into your workflows. We provide the tools, telemetry, and tier-3 expertise, allowing your staff to focus on strategic initiatives while we handle threat detection and response.',
  },
  {
    question: 'Can you assist with SOC 2, HIPAA, and PCI compliance?',
    answer:
      'Yes. We do not just consult on compliance; we engineer it. Our team implements the specific technical controls required for HIPAA, PCI DSS, SOC 2, and NIST frameworks. We map your infrastructure to regulatory requirements, automate evidence collection, and ensure your organization is prepared to pass rigorous third-party audits.',
  },
  {
    question: 'What is your response time for critical security incidents?',
    answer:
      'Time is the critical factor in containment. Our Security Operations Center (SOC) operates 24/7/365 with aggressive SLAs. For critical severity incidents, we initiate containment protocols immediately upon detection, minimizing dwell time and preventing lateral movement within your network.',
  },
];
const { breadcrumb: breadcrumbSchema, faq: faqSchema } = servicePageSchemas({
  serviceName: service.data.title,
  servicePath: `/services/${service.id}`,
  faqs,
});
const strategicFeatures = [
  {
    title: 'Adaptive Threat Intelligence',
    description: 'Real-time defense that evolves with the threat landscape.',
    highlight: 'Real-time defense',
    icon: 'ShieldCheck',
    detail:
      "We don't just react to known threats; we use advanced telemetry and global intelligence feeds to anticipate and block emerging attack vectors before they reach your network.",
  },
  {
    title: 'Zero-Trust Architecture',
    description:
      'Verify every user and device, every time, regardless of location.',
    highlight: 'Verify every user',
    icon: 'Lock',
    detail:
      "Our security models are built on the principle of 'never trust, always verify.' We implement robust identity management and micro-segmentation to prevent lateral movement within your infrastructure.",
  },
  {
    title: 'Compliance Engineering',
    description:
      'Automating evidence collection and technical controls for rigorous audits.',
    highlight: 'Automating evidence collection',
    icon: 'FileText',
    detail:
      'We map your technical controls directly to HIPAA, PCI, and SOC 2 frameworks, turning compliance from a yearly burden into a continuous, automated property of your IT operations.',
  },
  {
    title: 'Resilient Recovery',
    description:
      'Immutable backups and rapid containment protocols to neutralize ransomware.',
    highlight: 'Immutable backups',
    icon: 'ArrowsClockwise',
    detail:
      'In the event of an incident, our rapid-response protocols isolate threats instantly while our immutable backup systems ensure you can restore operations without paying a ransom.',
  },
];
const detailColumns = [
  {
    title: 'Managed Detection & Response',
    icon: PiShieldCheck,
    items: [
      'Real-time monitoring across endpoints, network, and cloud workloads',
      'Security analysts triage alerts and coordinate remediation 24/7',
      'Threat intelligence feeds keep defenses tuned to current attacks',
    ],
  },
  {
    title: 'Compliance & Risk',
    icon: PiFileText,
    items: [
      'Mapped controls for HIPAA, PCI, CJIS, NIST, and regional mandates',
      'Audit-ready reporting with evidence collection and retention',
      'Executive briefings translate risk posture into action plans',
    ],
  },
];

const keyBenefits = [
  {
    title: 'Reduce Risk',
    description:
      'Protect against data breaches, ransomware, and other emerging cyber threats.',
    icon: PiWarning,
  },
  {
    title: 'Ensure Compliance',
    description:
      'Meet industry security standards and regulations including HIPAA, PCI DSS, and SOC 2.',
    icon: PiFileText,
  },
  {
    title: 'Minimize Downtime',
    description:
      'Quick incident recovery ensures your business operations continue without disruption.',
    icon: PiArrowsClockwise,
  },
  {
    title: 'Protect Reputation',
    description:
      'Prevent damaging data breaches that erode customer trust and brand equity.',
    icon: PiShield,
  },
  {
    title: '24/7 Peace of Mind',
    description:
      'Rest easy knowing your critical systems are monitored and protected around the clock.',
    icon: PiEye,
  },
  {
    title: 'Expert Guidance',
    description:
      'Direct access to senior security professionals with deep industry expertise.',
    icon: PiUsers,
  },
];
---

<Layout
  title={`${service.data.title} & Compliance Services | BDKinc`}
  description="Fortified security for a complex world. Enterprise-grade threat resilience, managed detection and response, and rigorous compliance engineering."
  ogDescription="BDKinc delivers 24/7 managed cybersecurity with ransomware protection, compliance readiness, and rapid incident response for enterprise environments."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(_serviceSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema)}
  />
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content" class="services-page-shell">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="scanlines pointer-events-none absolute inset-0 opacity-50">
      </div>
      <div
        class="pointer-events-none absolute inset-0 z-0 flex items-center justify-center opacity-80 md:opacity-100"
      >
        <CohesiveOrbit client:idle />
      </div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
          <!-- Badge -->
          <div
            class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
          >
            <div class="flex items-center gap-2 text-sm">
              <span
                >24/7 Threat <span class="text-accent font-semibold"
                  >Protection</span
                ></span
              >
            </div>
          </div>
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <!-- Heading -->
          <h1
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold tracking-tight delay-100 duration-700 md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <!-- Subtitle -->
          <p
            class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 mx-auto mb-16 max-w-3xl text-xl leading-relaxed delay-200 duration-700"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            Fortified security for a complex world. Enterprise-grade threat
            resilience, managed detection and response, and rigorous compliance
            engineering for high-stakes environments.
          </p>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--accent]/50"
      >
      </div>
    </section>
    <!-- Core Services -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight normal-case md:text-4xl"
          >
            <span class="text-foreground">Core </span>
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >Capabilities</span
            >
          </h2>
          <p
            class="text-muted-foreground mx-auto mt-4 max-w-2xl font-sans text-xl"
          >
            Comprehensive security management designed for the
            <span class="text-accent font-semibold">modern enterprise</span>.
          </p>
        </div>
        <TechCardGrid client:visible className="md:grid-cols-3">
          <TechCard
            variant="technical"
            interactive={true}
            trackingColor={'primary'}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="from-primary/10 to-primary/5 border-primary/20 group-hover:border-primary/50 mx-auto mb-6 flex w-fit items-center justify-center rounded-xl border bg-linear-to-br p-5 transition-colors duration-500 group-hover:scale-110"
              >
                <PiShieldCheck
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Managed Detection & Response
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                24/7/365 surveillance of your entire digital estate. Our SOC
                analysts leverage advanced telemetry to detect anomalies,
                investigate threats, and neutralize attacks before they impact
                operations.
              </div>
            </div>
          </TechCard>
          <TechCard
            variant="technical"
            interactive={true}
            trackingColor={'secondary'}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="from-secondary/10 to-secondary/5 border-secondary/20 group-hover:border-secondary/50 mx-auto mb-6 flex w-fit items-center justify-center rounded-xl border bg-linear-to-br p-5 transition-colors duration-500 group-hover:scale-110"
              >
                <PiLock
                  className="text-secondary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-secondary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Ransomware Defense
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Zero-trust architecture combined with immutable backups. We
                implement rigorous prevention strategies and rapid recovery
                protocols to ensure business continuity in the face of extortion
                attempts.
              </div>
            </div>
          </TechCard>
          <TechCard
            variant="technical"
            interactive={true}
            trackingColor={'accent'}
          >
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="from-accent/20 to-accent/10 border-accent/30 group-hover:border-accent/60 mx-auto mb-6 flex w-fit items-center justify-center rounded-xl border bg-linear-to-br p-5 transition-colors duration-500 group-hover:scale-110"
              >
                <PiFileText
                  className="text-accent h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-accent mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Compliance Engineering
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                We don't just consult on compliance; we engineer it. Our team
                implements the technical controls required for HIPAA, PCI DSS,
                SOC 2, and NIST frameworks to prepare you for audits.
              </div>
            </div>
          </TechCard>
        </TechCardGrid>
      </div>
    </section>
    <!-- Strategic Leadership Section -->
    <section class="relative overflow-hidden py-24">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-4xl font-bold tracking-tight duration-600 md:text-5xl"
          >
            <span class="text-foreground">Security </span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Leadership</span
            >
          </h2>
        </div>

        <ServiceBlockquote>
          &ldquo;In an era of sophisticated attacks, reactive security is
          failure. We architect
          <span class="text-accent"> proactive resilience</span>
          into every layer of your digital estate, ensuring your data is protected
          and your operations are audit-ready 24/7.&rdquo;
        </ServiceBlockquote>
      </div>
      <div
        class="via-primary/20 absolute bottom-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
    </section>
    <!-- Strategic Advantage -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            The Strategic <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Advantage</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            Move beyond antivirus and basic firewalls with a partner who builds
            defense-in-depth security architectures.
          </p>
        </div>
        <FeatureCarousel client:visible features={strategicFeatures} />
      </div>
    </section>
    <!-- Security Framework Section -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            Our Security <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Framework</span
            >
          </h2>
        </div>
        <div class="relative">
          <!-- Connecting Path (Desktop) -->
          <div
            class="absolute top-8 right-[10%] left-[10%] hidden h-0.5 overflow-hidden rounded-full md:block"
          >
            <!-- Base Line -->
            <div class="bg-muted/30 absolute inset-0"></div>
            <!-- Steady Gradient Background -->
            <div
              class="from-muted-foreground via-primary to-accent absolute inset-0 bg-linear-to-r opacity-20"
            >
            </div>
            <!-- Animated Progress Beam -->
            <div
              class="via-primary absolute top-0 bottom-0 left-0 w-1/2 animate-[shimmer_3s_linear_infinite] bg-linear-to-r from-transparent to-transparent opacity-80 blur-sm"
              style="animation-name: slide-right; animation-duration: 3s; animation-iteration-count: infinite;"
            >
            </div>
            <!-- Add keyframes for this specific local animation if not global -->
            <style>
              @keyframes slide-right {
                0% {
                  transform: translateX(-100%);
                }
                100% {
                  transform: translateX(200%);
                }
              }
            </style>
          </div>

          <div class="grid gap-6 md:grid-cols-4">
            {
              [
                {
                  num: '01',
                  label: 'Prevent',
                  Icon: PiShieldCheck,
                  color: 'foreground',
                  items: [
                    'Firewall management',
                    'Endpoint protection',
                    'Email security',
                    'User education',
                    'Access controls',
                  ],
                },
                {
                  num: '02',
                  label: 'Detect',
                  Icon: PiEye,
                  color: 'primary',
                  items: [
                    '24/7 monitoring',
                    'Intrusion detection',
                    'Log analysis',
                    'Vulnerability scanning',
                    'Threat intelligence',
                  ],
                },
                {
                  num: '03',
                  label: 'Respond',
                  Icon: PiBell,
                  color: 'secondary',
                  items: [
                    'Incident response',
                    'Forensic analysis',
                    'Containment procedures',
                    'Recovery processes',
                    'Post-incident review',
                  ],
                },
                {
                  num: '04',
                  label: 'Recover',
                  Icon: PiHardDrives,
                  color: 'accent',
                  items: [
                    'Backup systems',
                    'Recovery procedures',
                    'Continuity planning',
                    'Communication protocols',
                    'System restoration',
                  ],
                },
              ].map(({ num, label, Icon, items, color }) => {
                // Map color names to Tailwind classes
                const colorScales = {
                  primary: {
                    border: 'border-primary/30 hover:border-primary',
                    bg: 'bg-primary/5',
                    text: 'text-primary',
                    marker: 'bg-primary',
                    connector: 'from-primary',
                  },
                  secondary: {
                    border: 'border-secondary/30 hover:border-secondary',
                    bg: 'bg-secondary/5',
                    text: 'text-secondary',
                    marker: 'bg-secondary',
                    connector: 'from-secondary',
                  },
                  accent: {
                    border: 'border-accent/30 hover:border-accent',
                    bg: 'bg-accent/5',
                    text: 'text-accent',
                    marker: 'bg-accent',
                    connector: 'from-accent',
                  },
                  foreground: {
                    border: 'border-foreground/30 hover:border-foreground',
                    bg: 'bg-foreground/5',
                    text: 'text-foreground',
                    marker: 'bg-foreground',
                    connector: 'from-foreground',
                  },
                };

                const theme = colorScales[color as keyof typeof colorScales];

                return (
                  <div class="group relative flex h-full flex-col pt-16">
                    {/* Node on the path */}
                    <div class="absolute top-8 left-1/2 z-20 hidden -translate-x-1/2 -translate-y-1/2 md:block">
                      <div
                        class={`bg-background h-4 w-4 rounded-full border-2 transition-transform duration-300 group-hover:scale-150 ${theme.border.split(' ')[0]} ${theme.text}`}
                      />
                    </div>

                    {/* Vertical connector line */}
                    <div
                      class={`absolute top-8 left-1/2 hidden h-8 w-px -translate-x-1/2 bg-linear-to-b to-transparent md:block ${theme.connector}`}
                    />

                    <div
                      class={`relative z-10 flex h-full flex-col rounded-xl border p-6 backdrop-blur-xl transition-[color,background-color,border-color,box-shadow,opacity] duration-300 hover:shadow-[0_0_30px_rgba(0,0,0,0.1)] dark:hover:shadow-[0_0_30px_rgba(255,255,255,0.05)] ${theme.border} ${theme.bg}`}
                    >
                      <div class="scanlines pointer-events-none absolute inset-0 opacity-[0.02]" />

                      {/* Subtle gradient overlay */}
                      <div class="pointer-events-none absolute inset-0 rounded-xl bg-linear-to-br from-white/5 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100 dark:from-white/5" />

                      <div class="mb-4 flex items-center justify-between">
                        <div
                          class={`inline-flex h-14 w-14 items-center justify-center rounded-lg ring-1 transition-[background-color,box-shadow] duration-300 ${theme.bg} ${theme.border.split(' ')[0]} ${theme.text}`}
                        >
                          <Icon
                            className={`h-8 w-8 ${theme.text}`}
                            aria-hidden="true"
                          />
                        </div>
                        <span
                          class={`font-mono text-4xl leading-none font-bold opacity-20 transition-colors duration-300 group-hover:opacity-40 ${theme.text}`}
                        >
                          {num}
                        </span>
                      </div>
                      <h4
                        class={`font-display mb-3 text-xl font-bold ${theme.text}`}
                      >
                        {label}
                      </h4>
                      <ul class="text-muted-foreground space-y-2 font-sans text-sm">
                        {items.map((item) => (
                          <li class="flex items-start gap-2">
                            <span
                              class={`mt-1 ${theme.text}`}
                              aria-hidden="true"
                            >
                              •
                            </span>
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                );
              })
            }
          </div>
        </div>
      </div>
    </section>
    <!-- Key Benefits -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <BenefitGrid benefits={keyBenefits} />
      </div>
    </section>
    <!-- Detailed Capabilities Section -->
    <div class="relative">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <section class="px-4 py-24 sm:px-6 md:py-32 lg:px-8">
        <div class="mx-auto max-w-7xl">
          <div class="mb-16 text-center md:mb-24">
            <h2
              class="text-foreground font-display mb-6 text-3xl font-bold tracking-tight md:text-5xl"
            >
              Technical <span
                class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
                >Specifications</span
              >
            </h2>
            <p
              class="text-muted-foreground mx-auto max-w-2xl text-lg leading-relaxed md:text-xl"
            >
              Rigorous defense protocols engineered for zero-tolerance
              environments. We build defense-in-depth architectures that protect
              your most critical assets.
            </p>
          </div>

          <div class="grid gap-16 md:grid-cols-2 md:gap-24">
            {
              detailColumns.map((column, idx) => {
                const theme =
                  idx === 0
                    ? {
                        glow: 'bg-primary/5',
                        iconBg: 'from-primary/10 to-primary/5',
                        iconBorder: 'border-primary/20',
                        text: 'text-primary',
                        line: 'from-primary/50',
                        bulletGlow: 'group-hover:shadow-primary/30',
                        ringHover: 'group-hover:ring-primary',
                      }
                    : {
                        glow: 'bg-secondary/5',
                        iconBg: 'from-secondary/10 to-secondary/5',
                        iconBorder: 'border-secondary/20',
                        text: 'text-secondary',
                        line: 'from-secondary/50',
                        bulletGlow: 'group-hover:shadow-secondary/30',
                        ringHover: 'group-hover:ring-secondary',
                      };

                return (
                  <div class="relative">
                    <div
                      class={`absolute -top-8 -left-8 h-64 w-64 rounded-full ${theme.glow} blur-3xl`}
                    />

                    <div class="relative">
                      <div class="mb-10 flex items-center gap-6">
                        <div
                          class={`inline-flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl border ${theme.iconBorder} ${theme.iconBg} shadow-sm`}
                        >
                          <column.icon
                            className={`h-8 w-8 ${theme.text}`}
                            aria-hidden="true"
                          />
                        </div>
                        <h4 class="text-foreground font-display text-2xl font-bold tracking-tight md:text-3xl">
                          {column.title}
                        </h4>
                      </div>

                      <div class="relative pl-8">
                        {/* Connecting vertical line */}
                        <div
                          class={`absolute top-2 bottom-6 left-[15px] w-px bg-linear-to-b ${theme.line} to-transparent opacity-30`}
                        />

                        <ul class="space-y-10">
                          {column.items.map((item) => (
                            <li class="group relative">
                              {/* Custom bullet point on the line */}
                              <div
                                class={`bg-background ring-muted-foreground/30 absolute top-1.5 -left-[37px] h-2 w-2 rounded-full ring-2 transition-all duration-300 group-hover:scale-150 ${theme.ringHover} ${theme.bulletGlow}`}
                              />

                              <div class="flex items-start gap-4">
                                <span class="text-muted-foreground group-hover:text-foreground text-lg leading-relaxed transition-colors duration-300">
                                  {item}
                                </span>
                              </div>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  </div>
                );
              })
            }
          </div>
        </div>
      </section>
    </div>

    <!-- FAQ -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
          Frequently Asked Questions
        </h3>
        <div class="mb-20">
          <TechnicalFAQ client:visible faqs={faqs} />
        </div>
      </div>
    </section>
    <ImpactMetricsSection metrics={metrics} />
    <!-- CTA -->
    <CTASection
      client:visible
      title="Secure Your Digital Future"
      description="Stop settling for standard protection. Partner with the experts who understand enterprise-grade threat resilience."
      buttonText="Request a Security Audit"
      buttonHref="/contact#chat"
    />
  </main>
  <Footer />
</Layout>
