---
import { getContentEntry, getPageCopy, getSettings, type ContentProps } from '@/lib/content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import { TechCard, TechCardGrid } from '@/components/TechCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import CohesiveOrbit from '@/components/visualizations/CohesiveOrbit';

import FeatureCarousel from '@/components/FeatureCarousel';
import BenefitGrid from '@/components/BenefitGrid.astro';
import ServiceBlockquote from '@/components/ServiceBlockquote.astro';
import {
  PiLightning,
  PiUsers,
  PiShoppingCart,
  PiEye,
  PiCheckCircle,
  PiCurrencyDollar,
  PiGlobe,
  PiShieldCheck,
  PiNetwork,
  PiFileText,
  PiArrowRight,
  PiLockKey,
  PiFolderLock,
  PiPlugsConnected,
  PiShareNetwork,
  PiArrowsLeftRight,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';
import EditSection from '@/components/preview/EditSection.astro';
import { servicePageSchemas } from '@/lib/schema';
interface Props extends ContentProps {}
const { contentContext, publicPath = Astro.url.pathname } = Astro.props;
const [service, copy, settings] = await Promise.all([
  getContentEntry('services', 'edi-solutions', contentContext),
  getPageCopy('service-edi-solutions', contentContext),
  getSettings(contentContext),
]);
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData(contentContext);
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');
const metrics = [
  { ...copy.metrics.retailConnections, icon: PiShoppingCart },
  { ...copy.metrics.uptimeSla, icon: PiCheckCircle },
  { ...copy.metrics.averageOnboarding, icon: PiLightning },
  { ...copy.metrics.transactionMonitoring, icon: PiEye },
];
const faqs = [
  copy.faqs.whatProtocolsAndStandardsDoYouSupport,
  copy.faqs.howDoYouHandleHighVolumeTransaction,
  copy.faqs.canYouIntegrateWithOurExistingErp,
];
const { breadcrumb: breadcrumbSchema, faq: faqSchema } = servicePageSchemas({
  serviceName: service.data.title,
  servicePath: `/services/${service.id}`,
  faqs,
  copy: settings.navigation,
});

const strategicFeatures = [
  { ...copy.strategy.features.supplyChainOrchestration, icon: 'Network' },
  { ...copy.strategy.features.protocolAgnosticIntegration, icon: 'ArrowsLeftRight' },
  { ...copy.strategy.features.highVelocityThroughput, icon: 'Lightning' },
  { ...copy.strategy.features.complianceContinuity, icon: 'ShieldCheck' },
];
const keyBenefits = [
  { ...copy.benefits.items.item9999Uptime, icon: PiCheckCircle },
  { ...copy.benefits.items.highVelocity, icon: PiLightning },
  { ...copy.benefits.items.activeCompliance, icon: PiShieldCheck },
  { ...copy.benefits.items.costOptimization, icon: PiCurrencyDollar },
  { ...copy.benefits.items.globalReach, icon: PiGlobe },
  { ...copy.benefits.items.totalVisibility, icon: PiEye },
];
const documents = [copy.standards.documents.ansiX12, copy.standards.documents.edifact,
  copy.standards.documents.tradacoms, copy.standards.documents.xmlJson, copy.standards.documents.flatFile];
const protocols = [
  { ...copy.standards.protocols.as2, icon: PiShieldCheck },
  { ...copy.standards.protocols.sftp, icon: PiLockKey },
  { ...copy.standards.protocols.ftps, icon: PiFolderLock },
  { ...copy.standards.protocols.httpsApi, icon: PiPlugsConnected },
  { ...copy.standards.protocols.van, icon: PiShareNetwork },
];
const transactions = [
  copy.standards.transactions.invoice, copy.standards.transactions.purchaseOrder,
  copy.standards.transactions.shipNoticeAsn, copy.standards.transactions.inventoryInquiry,
  copy.standards.transactions.motorCarrierLoad, copy.standards.transactions.freightInvoice,
  copy.standards.transactions.shipmentStatus, copy.standards.transactions.paymentOrder,
  copy.standards.transactions.warehouseShipping, copy.standards.transactions.warehouseShippingAdvice,
  copy.standards.transactions.functionalAcknowledgment, copy.standards.transactions.priceSalesCatalog,
  copy.standards.transactions.poAcknowledgment, copy.standards.transactions.poChange,
];
---

<Layout
  contentContext={contentContext}
  publicPath={publicPath}
  title={`${service.data.title} - ${settings.siteName}`}
  description={service.data.description}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema)}
  />
  <EditSection record="settings" section="navigation">
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={publicPath}
    copy={settings.navigation}
    brand={settings.brand}
  />
  </EditSection>
  <main id="main-content" class="services-page-shell">
    <EditSection record="service-edi-solutions" section="hero">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="scanlines pointer-events-none absolute inset-0 opacity-50">
      </div>

      <!-- Visualization -->
      <div
        class="pointer-events-none absolute inset-0 z-0 flex items-center justify-center opacity-80 md:opacity-100"
      >
        <CohesiveOrbit client:idle />
      </div>

      <div class="relative z-10 mx-auto max-w-7xl">
        <div
          class="relative z-10 mx-auto flex max-w-4xl flex-col items-center text-center"
        >
          <!-- Badge -->
          <div
            class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
          >
            <div class="flex items-center gap-2 text-sm">
              <div
                class="bg-primary h-2 w-2 animate-pulse rounded-full"
                aria-hidden="true"
              >
              </div>
              <span
                >{copy.hero.badgePrefix}{' '}<span
                  class="text-accent font-semibold">{copy.hero.badgeAccent}</span
                ></span
              >
            </div>
          </div>
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <!-- Heading -->
          <h1
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold tracking-tight delay-100 duration-700 md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <!-- Subtitle -->
          <p
            class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 mx-auto mb-16 max-w-3xl text-xl leading-relaxed delay-200 duration-700"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            {copy.hero.body}
          </p>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--accent]/50"
      >
      </div>
    </section>
    </EditSection>
    <EditSection record="service-edi-solutions" section="capabilities">
    <!-- Core Services -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight normal-case md:text-4xl"
          >
            <span class="text-foreground">{copy.capabilities.heading}{' '}</span>
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.capabilities.headingAccent}</span
            >
          </h2>
          <p
            class="text-muted-foreground mx-auto mt-4 max-w-2xl font-sans text-xl"
          >
            {copy.capabilities.bodyBefore}{' '}
            <span class="text-accent font-semibold">{copy.capabilities.bodyAccent}</span>{copy.capabilities.bodyAfter}
          </p>
        </div>
        <TechCardGrid client:visible className="md:grid-cols-3">
          <TechCard variant="technical" interactive={true}>
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiUsers
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                {copy.capabilities.globalIntegration.title}
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                {copy.capabilities.globalIntegration.description}
              </div>
            </div>
          </TechCard>
          <TechCard variant="technical" interactive={true}>
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiLightning
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                {copy.capabilities.automatedWorkflows.title}
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                {copy.capabilities.automatedWorkflows.description}
              </div>
            </div>
          </TechCard>
          <TechCard variant="technical" interactive={true}>
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiNetwork
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                {copy.capabilities.agnosticProtocol.title}
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                {copy.capabilities.agnosticProtocol.description}
              </div>
            </div>
          </TechCard>
        </TechCardGrid>
      </div>
    </section>
    </EditSection>
    <EditSection record="service-edi-solutions" section="leadership">
    <!-- Strategic Leadership Section -->
    <section class="relative overflow-hidden py-24">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-4xl font-bold tracking-tight duration-600 md:text-5xl"
          >
            <span class="text-foreground">{copy.leadership.heading}{' '}</span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.leadership.headingAccent}</span
            >
          </h2>
        </div>

        <ServiceBlockquote>
          {copy.leadership.quoteBefore}{' '}
          <span class="text-accent">{copy.leadership.quoteAccent}</span>{' '}
          {copy.leadership.quoteAfter}
        </ServiceBlockquote>
      </div>
      <div
        class="via-primary/20 absolute bottom-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
    </section>
    </EditSection>
    <EditSection record="service-edi-solutions" section="strategy">
    <!-- Strategic Advantage -->
    <section class="relative px-4 py-24 sm:px-6 lg:px-8">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            {copy.strategy.heading}{' '}<span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.strategy.headingAccent}</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            {copy.strategy.body}
          </p>
        </div>
        <FeatureCarousel client:visible features={strategicFeatures} />
      </div>
    </section>
    </EditSection>
    <EditSection record="service-edi-solutions" section="benefits">
    <!-- Key Benefits -->
    <section class="relative px-4 py-24 sm:px-6 lg:px-8">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="mx-auto max-w-7xl">
        <BenefitGrid benefits={keyBenefits} copy={settings.benefits} />
      </div>
    </section>
    </EditSection>
    <EditSection record="service-edi-solutions" section="standards">
    <!-- Standards, Protocols & Transaction Reference -->
    <section class="relative overflow-hidden px-4 py-24 sm:px-6 lg:px-8">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>

      <!-- Ambient Background -->
      <div
        class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-20"
      >
        <div
          class="bg-primary/20 h-[500px] w-[500px] rounded-full blur-[120px]"
        >
        </div>
        <div
          class="bg-secondary/20 absolute h-[400px] w-[400px] translate-x-1/2 translate-y-1/4 rounded-full blur-[100px]"
        >
        </div>
      </div>

      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="mb-20 text-center">
          <h2
            class="font-display mb-6 text-4xl font-bold tracking-tight md:text-5xl"
          >
            {copy.standards.heading}{' '}<span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.standards.headingAccent}</span
            >
          </h2>
          <p
            class="text-muted-foreground mx-auto max-w-2xl text-xl leading-relaxed"
          >
            {copy.standards.body}
          </p>
        </div>

        <div class="grid gap-8 lg:grid-cols-12">
          <!-- Document Standards (Left Column) -->
          <div class="group relative lg:col-span-5">
            <div
              class="from-primary/20 absolute -inset-px rounded-3xl bg-linear-to-b to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            >
            </div>
            <div
              class="border-border/50 bg-card/40 relative h-full rounded-3xl border p-8 backdrop-blur-xl"
            >
              <div class="mb-8 flex items-center gap-4">
                <div
                  class="border-primary/20 from-primary/10 to-primary/5 flex h-12 w-12 items-center justify-center rounded-xl border bg-linear-to-br"
                >
                  <PiFileText
                    className="text-primary h-6 w-6"
                    aria-hidden="true"
                  />
                </div>
                <h3 class="font-display text-foreground text-2xl font-bold">
                  {copy.standards.documentHeading}
                </h3>
              </div>

              <div class="space-y-4">
                {
                  documents.map(({ std, desc, regions }) => (
                    <div class="group/item border-border/50 bg-background/50 hover:border-primary/30 hover:bg-primary/5 relative overflow-hidden rounded-2xl border p-4 transition-all">
                      <div class="flex items-center justify-between gap-4">
                        <div>
                          <div class="mb-1 flex items-center gap-2">
                            <span class="text-primary font-mono text-sm font-bold">
                              {std}
                            </span>
                            <span class="bg-muted text-muted-foreground rounded-full px-2 py-0.5 text-[10px] font-medium">
                              {regions}
                            </span>
                          </div>
                          <p class="text-muted-foreground text-sm">{desc}</p>
                        </div>
                        <div class="text-primary/0 group-hover/item:text-primary transition-colors">
                          <PiArrowRight
                            className="h-5 w-5"
                            aria-hidden="true"
                          />
                        </div>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

          <!-- Transmission Protocols (Right Column) -->
          <div class="group relative lg:col-span-7">
            <div
              class="from-secondary/20 absolute -inset-px rounded-3xl bg-linear-to-b to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            >
            </div>
            <div
              class="border-border/50 bg-card/40 relative h-full rounded-3xl border p-8 backdrop-blur-xl"
            >
              <div class="mb-8 flex items-center gap-4">
                <div
                  class="border-secondary/20 from-secondary/10 to-secondary/5 flex h-12 w-12 items-center justify-center rounded-xl border bg-linear-to-br"
                >
                  <PiNetwork
                    className="text-secondary h-6 w-6"
                    aria-hidden="true"
                  />
                </div>
                <h3 class="font-display text-foreground text-2xl font-bold">
                  {copy.standards.protocolHeading}
                </h3>
              </div>

              <div class="grid gap-4 sm:grid-cols-2">
                {
                  protocols.map(({ proto, desc, security, icon: Icon }, i) => (
                    <div
                      class={`group/item border-border/50 bg-background/50 hover:border-secondary/30 hover:bg-secondary/5 relative overflow-hidden rounded-2xl border p-5 transition-all ${i === 4 ? 'sm:col-span-2' : ''}`}
                    >
                      <div class="mb-4 flex items-center justify-between">
                        <span class="text-secondary font-mono text-lg font-bold">
                          {proto}
                        </span>
                        <Icon
                          className="h-5 w-5 text-muted-foreground transition-colors group-hover/item:text-secondary"
                          aria-hidden="true"
                        />
                      </div>
                      <p class="text-muted-foreground mb-4 text-sm">{desc}</p>
                      <div class="bg-secondary/10 text-secondary inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium">
                        <PiShieldCheck
                          className="h-3.5 w-3.5"
                          aria-hidden="true"
                        />
                        {security}
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

          <!-- Transaction Sets (Bottom Full Width) -->
          <div class="group relative lg:col-span-12">
            <div
              class="from-primary/20 via-secondary/20 to-accent/20 absolute -inset-px rounded-3xl bg-linear-to-r opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            >
            </div>
            <div
              class="border-border/50 bg-card/40 relative rounded-3xl border p-8 backdrop-blur-xl"
            >
              <div
                class="mb-8 flex flex-col items-center justify-between gap-4 sm:flex-row"
              >
                <div class="flex items-center gap-4">
                  <div
                    class="border-accent/20 from-accent/10 to-accent/5 flex h-12 w-12 items-center justify-center rounded-xl border bg-linear-to-br"
                  >
                    <PiArrowsLeftRight
                      className="text-accent h-6 w-6"
                      aria-hidden="true"
                    />
                  </div>
                  <h3 class="font-display text-foreground text-2xl font-bold">
                    {copy.standards.transactionHeading}
                  </h3>
                </div>
                <p class="text-muted-foreground text-sm">
                  {copy.standards.transactionBody}
                </p>
              </div>

              <div class="flex flex-wrap gap-3">
                {
                  transactions.map(({ code, label }) => (
                    <div class="group/pill border-border/50 bg-background/50 hover:border-accent/30 hover:bg-accent/5 flex cursor-default items-center gap-3 rounded-full border py-2 pr-4 pl-2 transition-all hover:shadow-[0_0_15px_rgba(var(--accent),0.1)]">
                      <span class="bg-accent/10 text-accent group-hover/pill:bg-accent/20 flex h-7 items-center justify-center rounded-full px-3 font-mono text-xs font-bold transition-colors">
                        {code}
                      </span>
                      <span class="text-muted-foreground group-hover/pill:text-foreground text-sm font-medium transition-colors">
                        {label}
                      </span>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    </EditSection>
    <EditSection record="service-edi-solutions" section="faqs" also={['faqHeading']}>
    <!-- FAQ -->
    <section class="relative px-4 py-24 sm:px-6 lg:px-8">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="mx-auto max-w-5xl">
        <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
          {copy.faqHeading}
        </h3>
        <div class="mb-20">
          <TechnicalFAQ client:visible faqs={faqs} />
        </div>
      </div>
    </section>
    </EditSection>
    <EditSection record="service-edi-solutions" section="metrics">
    <ImpactMetricsSection metrics={metrics} copy={settings.metrics} />
    </EditSection>
    <EditSection record="service-edi-solutions" section="cta">
    <!-- CTA -->
    <CTASection
      client:visible
      copy={settings.cta}
      {...copy.cta}
    />
    </EditSection>
  </main>
  <Footer contentContext={contentContext} />
</Layout>
