---
import { getEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import { TechCard, TechCardGrid } from '@/components/TechCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import EDIFlowVisualization from '@/components/visualizations/EDIFlowVisualization';

import TechnicalSection from '@/components/TechnicalSection';
import FeatureCarousel from '@/components/FeatureCarousel';
import {
  PiLightning,
  PiUsers,
  PiShoppingCart,
  PiEye,
  PiCheckCircle,
  PiCurrencyDollar,
  PiGlobe,
  PiShieldCheck,
  PiNetwork,
  PiQuotesFill,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';
const service = await getEntry('services', 'edi-solutions');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');
const metrics = [
  { value: '250+', label: 'Retail Connections', icon: PiShoppingCart },
  { value: '99.99%', label: 'Uptime SLA', icon: PiCheckCircle },
  { value: '48h', label: 'Average Onboarding', icon: PiLightning },
  { value: '24/7', label: 'Transaction Monitoring', icon: PiEye },
];
const faqs = [
  {
    question: 'What protocols and standards do you support?',
    answer:
      'We support the full spectrum of industry-standard protocols including AS2, SFTP, FTPS, HTTPS, and traditional VAN networks. Our translation engine handles ANSI X12, EDIFACT, TRADACOMS, and XML formats, ensuring compatibility with any global trading partner.',
  },
  {
    question: 'How do you handle high-volume transaction scaling?',
    answer:
      'Our infrastructure is built on elastic cloud architecture designed for enterprise scale. It automatically provisions resources to handle peak loads—whether from seasonal spikes or rapid market expansion—ensuring consistent throughput and zero message loss.',
  },
  {
    question: 'Can you integrate with our existing ERP environment?',
    answer:
      'Yes. Our solution acts as a universal middleware layer, integrating seamlessly with major ERPs (SAP, Oracle, NetSuite, Microsoft Dynamics) as well as custom legacy systems. We map data directly to your internal formats, preserving your existing workflows.',
  },
];

const strategicFeatures = [
  {
    title: 'Supply Chain Orchestration',
    description: 'Synchronized document flow across global partner networks.',
    highlight: 'Synchronized document flow',
    icon: 'Network',
    detail:
      'Modern commerce is a precision game. We orchestrate your entire supply chain data flow, ensuring that orders, invoices, and shipping updates move instantly between you and your trading partners with zero manual friction.',
  },
  {
    title: 'Protocol Agnostic Integration',
    description:
      'Secure transmission across AS2, SFTP, FTPS, and VAN networks.',
    highlight: 'Secure transmission',
    icon: 'ArrowsLeftRight',
    detail:
      "Don't let your partners' technical constraints slow you down. Our architecture acts as a universal translator, adapting to any protocol or standard (ANSI X12, EDIFACT, XML) while maintaining a clean, consistent interface for your internal systems.",
  },
  {
    title: 'High-Velocity Throughput',
    description:
      'Elastic infrastructure designed for peak enterprise transaction volumes.',
    highlight: 'Peak transaction volumes',
    icon: 'Lightning',
    detail:
      "Built on elastic cloud infrastructure, our platform automatically scales to handle your most demanding spikes—whether it's seasonal retail surges or rapid market expansion—ensuring consistent throughput and zero message loss.",
  },
  {
    title: 'Compliance Continuity',
    description:
      'Certified maps and active monitoring for thousands of trading partners.',
    highlight: 'Certified partner maps',
    icon: 'ShieldCheck',
    detail:
      'We maintain a massive library of certified trading partner maps and actively monitor for mandate changes. This means you stay compliant with major retailers like Walmart, Amazon, and Target without ever touching a line of code.',
  },
];
---

<Layout
  title={`${service.data.title} - BDKinc`}
  description={service.data.description}
>
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="circuit-overlay absolute inset-0 opacity-40"></div>
      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
          <!-- Badge -->
          <div
            class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
          >
            <div class="flex items-center gap-2 text-sm">
              <div
                class="bg-primary h-2 w-2 animate-pulse rounded-full"
                aria-hidden="true"
              >
              </div>
              <span
                >Trading Partner Network &mdash; <span
                  class="text-accent font-semibold">Live</span
                ></span
              >
            </div>
          </div>
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <!-- Heading -->
          <h1
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold tracking-tight delay-100 duration-700 md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <!-- Subtitle -->
          <p
            class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 mx-auto mb-16 max-w-3xl text-xl leading-relaxed delay-200 duration-700"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            Orchestrate global EDI with a managed platform that keeps partners
            connected, documents flowing, and transactions visible in real time.
          </p>
        </div>
        <!-- Visualization -->
        <div
          class="fill-mode-both animate-in fade-in zoom-in delay-300 duration-700"
        >
          <div class="mx-auto max-w-5xl">
            <EDIFlowVisualization client:visible />
          </div>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--accent]/50"
      >
      </div>
    </section>
    <!-- Core Services -->
    <section
      class="bg-muted/30 px-4 py-24 sm:px-6 lg:px-8 dark:bg-white/[0.02]"
    >
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight normal-case md:text-4xl"
          >
            <span class="text-foreground">Core </span>
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >Capabilities</span
            >
          </h2>
          <p
            class="text-muted-foreground mx-auto mt-4 max-w-2xl font-sans text-xl"
          >
            Comprehensive document orchestration designed for the
            <span class="text-accent font-semibold">modern supply chain</span>.
          </p>
        </div>
        <TechCardGrid client:visible className="md:grid-cols-3">
          <TechCard variant="technical" interactive={true}>
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiUsers
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Global Integration
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Rapidly onboard retailers, suppliers, and 3PLs across any
                region. We maintain certified maps for thousands of trading
                partners, ensuring effortless compliance.
              </div>
            </div>
          </TechCard>
          <TechCard variant="technical" interactive={true}>
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiLightning
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Automated Workflows
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Eliminate manual intervention. Automate POs, invoices, and ASNs
                to reduce manual errors and accelerate your order-to-cash
                cycles.
              </div>
            </div>
          </TechCard>
          <TechCard variant="technical" interactive={true}>
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiNetwork
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Agnostic Protocol
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Secure transmission across AS2, SFTP, FTPS, and VAN. Our
                architecture adapts to your partners' technical constraints
                seamlessly.
              </div>
            </div>
          </TechCard>
        </TechCardGrid>
      </div>
    </section>
    <!-- Strategic Leadership Section -->
    <section class="relative overflow-hidden py-24">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-4xl font-bold tracking-tight duration-600 md:text-5xl"
          >
            <span class="text-foreground">Supply Chain </span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Orchestration</span
            >
          </h2>
        </div>

        <!-- Glass Quote Container -->
        <div class="relative mx-auto max-w-4xl">
          <!-- Floating Icon -->
          <div class="text-primary absolute -top-10 -left-6 z-20 md:-left-10">
            <PiQuotesFill
              className="h-20 w-20 rotate-[-12deg] drop-shadow-xl filter"
              aria-hidden="true"
            />
          </div>

          <!-- Glass Card -->
          <div
            class="relative z-10 overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-10 backdrop-blur-xl md:p-14 dark:border-white/[0.05] dark:bg-white/[0.03]"
          >
            <!-- Ambient Glow -->
            <div
              class="bg-primary/20 absolute -top-24 -right-24 h-64 w-64 rounded-full opacity-50 blur-3xl"
            >
            </div>
            <div
              class="bg-secondary/20 absolute -bottom-24 -left-24 h-64 w-64 rounded-full opacity-50 blur-3xl"
            >
            </div>

            <!-- Background Watermark -->
            <div
              class="pointer-events-none absolute top-0 right-0 z-0 opacity-[0.03]"
            >
              <PiQuotesFill
                className="h-64 w-64 translate-x-1/4 -translate-y-1/4 -rotate-12"
                aria-hidden="true"
              />
            </div>

            <blockquote
              class="font-display text-foreground relative z-10 text-center text-2xl leading-relaxed font-medium md:text-3xl"
            >
              &ldquo;Commerce moves at the speed of data. We don&rsquo;t just
              connect systems; we architect
              <span class="text-accent">
                zero-friction, real-time document orchestration</span
              >
              that ensures compliance and powers your global supply chain with 24/7
              visibility.&rdquo;
            </blockquote>
          </div>
        </div>
      </div>
      <div
        class="via-primary/20 absolute bottom-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
    </section>
    <!-- Strategic Advantage -->
    <section
      class="to-muted/20 bg-linear-to-b from-transparent px-4 py-24 sm:px-6 lg:px-8 dark:to-white/[0.02]"
    >
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            The Strategic <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Advantage</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            Move beyond simple connections with a partner who orchestrates
            enterprise-grade supply chain intelligence.
          </p>
        </div>
        <FeatureCarousel client:visible features={strategicFeatures} />
      </div>
    </section>
    <!-- Key Benefits -->
    <section
      class="bg-muted/30 px-4 py-24 sm:px-6 lg:px-8 dark:bg-white/[0.02]"
    >
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            Key <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Benefits</span
            >
          </h2>
        </div>
        <!-- Swiss Grid Layout -->
        <div
          class="bg-border grid gap-px overflow-hidden rounded-2xl sm:grid-cols-2 lg:grid-cols-3"
        >
          <!-- Benefit 1 -->
          <div
            class="group bg-card hover:bg-primary/5 relative p-8 transition-colors"
          >
            <div class="mb-4 flex items-center gap-4">
              <div
                class="bg-primary/10 text-primary flex h-10 w-10 items-center justify-center rounded-lg"
              >
                <PiCheckCircle className="h-5 w-5" aria-hidden="true" />
              </div>
              <h4
                class="font-display text-foreground group-hover:text-primary text-lg font-bold tracking-tight transition-colors"
              >
                99.99% Uptime
              </h4>
            </div>
            <p class="text-muted-foreground text-sm leading-relaxed">
              Mission-critical reliability for your most sensitive supply chain
              data streams.
            </p>
          </div>
          <!-- Benefit 2 -->
          <div
            class="group bg-card hover:bg-primary/5 relative p-8 transition-colors"
          >
            <div class="mb-4 flex items-center gap-4">
              <div
                class="bg-primary/10 text-primary flex h-10 w-10 items-center justify-center rounded-lg"
              >
                <PiLightning className="h-5 w-5" aria-hidden="true" />
              </div>
              <h4
                class="font-display text-foreground group-hover:text-primary text-lg font-bold tracking-tight transition-colors"
              >
                High-Velocity
              </h4>
            </div>
            <p class="text-muted-foreground text-sm leading-relaxed">
              Process thousands of transactions per second with low-latency
              enterprise throughput.
            </p>
          </div>
          <!-- Benefit 3 -->
          <div
            class="group bg-card hover:bg-primary/5 relative p-8 transition-colors"
          >
            <div class="mb-4 flex items-center gap-4">
              <div
                class="bg-primary/10 text-primary flex h-10 w-10 items-center justify-center rounded-lg"
              >
                <PiShieldCheck className="h-5 w-5" aria-hidden="true" />
              </div>
              <h4
                class="font-display text-foreground group-hover:text-primary text-lg font-bold tracking-tight transition-colors"
              >
                Active Compliance
              </h4>
            </div>
            <p class="text-muted-foreground text-sm leading-relaxed">
              Stay ahead of retailer mandate changes with our continuous
              compliance monitoring.
            </p>
          </div>
          <!-- Benefit 4 -->
          <div
            class="group bg-card hover:bg-primary/5 relative p-8 transition-colors"
          >
            <div class="mb-4 flex items-center gap-4">
              <div
                class="bg-primary/10 text-primary flex h-10 w-10 items-center justify-center rounded-lg"
              >
                <PiCurrencyDollar className="h-5 w-5" aria-hidden="true" />
              </div>
              <h4
                class="font-display text-foreground group-hover:text-primary text-lg font-bold tracking-tight transition-colors"
              >
                Cost Optimization
              </h4>
            </div>
            <p class="text-muted-foreground text-sm leading-relaxed">
              Eliminate expensive VAN fees and reduce overhead with direct
              protocol connections.
            </p>
          </div>
          <!-- Benefit 5 -->
          <div
            class="group bg-card hover:bg-primary/5 relative p-8 transition-colors"
          >
            <div class="mb-4 flex items-center gap-4">
              <div
                class="bg-primary/10 text-primary flex h-10 w-10 items-center justify-center rounded-lg"
              >
                <PiGlobe className="h-5 w-5" aria-hidden="true" />
              </div>
              <h4
                class="font-display text-foreground group-hover:text-primary text-lg font-bold tracking-tight transition-colors"
              >
                Global Reach
              </h4>
            </div>
            <p class="text-muted-foreground text-sm leading-relaxed">
              Connect with partners in any region with support for all major
              international standards.
            </p>
          </div>
          <!-- Benefit 6 -->
          <div
            class="group bg-card hover:bg-primary/5 relative p-8 transition-colors"
          >
            <div class="mb-4 flex items-center gap-4">
              <div
                class="bg-primary/10 text-primary flex h-10 w-10 items-center justify-center rounded-lg"
              >
                <PiEye className="h-5 w-5" aria-hidden="true" />
              </div>
              <h4
                class="font-display text-foreground group-hover:text-primary text-lg font-bold tracking-tight transition-colors"
              >
                Total Visibility
              </h4>
            </div>
            <p class="text-muted-foreground text-sm leading-relaxed">
              End-to-end real-time tracking of every single document in your
              supply chain.
            </p>
          </div>
        </div>
      </div>
    </section>
    <!-- Standards, Protocols & Transaction Reference -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            Standards &amp; <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Protocol Support</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            Every format, every protocol, every trading partner — handled.
          </p>
        </div>
        <div class="mb-16 grid gap-6 md:grid-cols-2">
          <!-- Standards table -->
          <div
            class="border-border bg-card/30 overflow-hidden rounded-xl border"
          >
            <div
              class="bg-muted/60 border-border border-b px-6 py-4 dark:bg-white/[0.03]"
            >
              <h3
                class="font-display text-foreground text-sm font-bold tracking-widest"
              >
                Document Standards
              </h3>
            </div>
            <div class="divide-border divide-y">
              {
                [
                  {
                    std: 'ANSI X12',
                    desc: 'North American retail & logistics standard',
                    regions: 'US / CA',
                  },
                  {
                    std: 'EDIFACT',
                    desc: 'International UN standard for global trade',
                    regions: 'Global',
                  },
                  {
                    std: 'TRADACOMS',
                    desc: 'UK grocery and retail EDI standard',
                    regions: 'UK',
                  },
                  {
                    std: 'XML / JSON',
                    desc: 'Modern structured data exchange formats',
                    regions: 'Universal',
                  },
                  {
                    std: 'Flat File',
                    desc: 'Custom delimited formats for legacy systems',
                    regions: 'Legacy',
                  },
                ].map(({ std, desc, regions }) => (
                  <div class="flex items-center gap-4 px-6 py-3">
                    <span class="text-primary bg-primary/10 border-primary/20 min-w-[90px] shrink-0 rounded border px-2 py-0.5 text-center font-mono text-xs font-bold">
                      {std}
                    </span>
                    <span class="text-muted-foreground flex-1 text-sm">
                      {desc}
                    </span>
                    <span class="text-muted-foreground/60 shrink-0 font-mono text-[10px]">
                      {regions}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>
          <!-- Protocol table -->
          <div
            class="border-border bg-card/30 overflow-hidden rounded-xl border"
          >
            <div
              class="bg-muted/60 border-border border-b px-6 py-4 dark:bg-white/[0.03]"
            >
              <h3
                class="font-display text-foreground text-sm font-bold tracking-widest"
              >
                Transmission Protocols
              </h3>
            </div>
            <div class="divide-border divide-y">
              {
                [
                  {
                    proto: 'AS2',
                    desc: 'Encrypted HTTP/S with MDN acknowledgments',
                    security: 'TLS 1.3',
                  },
                  {
                    proto: 'SFTP',
                    desc: 'Secure file transfer over SSH',
                    security: 'SSH',
                  },
                  {
                    proto: 'FTPS',
                    desc: 'FTP over explicit/implicit TLS',
                    security: 'TLS',
                  },
                  {
                    proto: 'HTTPS API',
                    desc: 'RESTful webhook-based partner connections',
                    security: 'OAuth 2.0',
                  },
                  {
                    proto: 'VAN',
                    desc: 'Value-added network relay (legacy)',
                    security: 'Encrypted',
                  },
                ].map(({ proto, desc, security }) => (
                  <div class="flex items-center gap-4 px-6 py-3">
                    <span class="text-secondary bg-secondary/10 border-secondary/20 min-w-[72px] shrink-0 rounded border px-2 py-0.5 text-center font-mono text-xs font-bold">
                      {proto}
                    </span>
                    <span class="text-muted-foreground flex-1 text-sm">
                      {desc}
                    </span>
                    <span class="text-muted-foreground/60 shrink-0 font-mono text-[10px]">
                      {security}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
        <!-- Transaction Type Pills -->
        <div>
          <h3
            class="font-display text-muted-foreground mb-6 text-center text-sm font-bold tracking-widest"
          >
            Common Transaction Sets Supported
          </h3>
          <div class="flex flex-wrap justify-center gap-2">
            {
              [
                { code: '810', label: 'Invoice' },
                { code: '850', label: 'Purchase Order' },
                { code: '856', label: 'Ship Notice / ASN' },
                { code: '846', label: 'Inventory Inquiry' },
                { code: '204', label: 'Motor Carrier Load' },
                { code: '210', label: 'Freight Invoice' },
                { code: '214', label: 'Shipment Status' },
                { code: '820', label: 'Payment Order' },
                { code: '940', label: 'Warehouse Shipping' },
                { code: '945', label: 'Warehouse Shipping Advice' },
                { code: '997', label: 'Functional Acknowledgment' },
                { code: '832', label: 'Price / Sales Catalog' },
                { code: '855', label: 'PO Acknowledgment' },
                { code: '860', label: 'PO Change' },
              ].map(({ code, label }) => (
