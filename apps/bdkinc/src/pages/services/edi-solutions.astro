---
import { getEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { iconMap } from '@/lib/icons';
import { TechCard, TechCardGrid } from '@/components/TechCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import TechnicalFAQ from '@/components/TechnicalFAQ';
import CohesiveOrbit from '@/components/visualizations/CohesiveOrbit';

import FeatureCarousel from '@/components/FeatureCarousel';
import BenefitGrid from '@/components/BenefitGrid.astro';
import ServiceBlockquote from '@/components/ServiceBlockquote.astro';
import {
  PiLightning,
  PiUsers,
  PiShoppingCart,
  PiEye,
  PiCheckCircle,
  PiCurrencyDollar,
  PiGlobe,
  PiShieldCheck,
  PiNetwork,
  PiFileText,
  PiArrowRight,
  PiLockKey,
  PiFolderLock,
  PiPlugsConnected,
  PiShareNetwork,
  PiArrowsLeftRight,
} from 'react-icons/pi';
import Footer from '@/components/Footer.astro';
const service = await getEntry('services', 'edi-solutions');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');
const metrics = [
  { value: '250+', label: 'Retail Connections', icon: PiShoppingCart },
  { value: '99.99%', label: 'Uptime SLA', icon: PiCheckCircle },
  { value: '48h', label: 'Average Onboarding', icon: PiLightning },
  { value: '24/7', label: 'Transaction Monitoring', icon: PiEye },
];
const faqs = [
  {
    question: 'What protocols and standards do you support?',
    answer:
      'We support the full spectrum of industry-standard protocols including AS2, SFTP, FTPS, HTTPS, and traditional VAN networks. Our translation engine handles ANSI X12, EDIFACT, TRADACOMS, and XML formats, ensuring compatibility with any global trading partner.',
  },
  {
    question: 'How do you handle high-volume transaction scaling?',
    answer:
      'Our infrastructure is built on elastic cloud architecture designed for enterprise scale. It automatically provisions resources to handle peak loads—whether from seasonal spikes or rapid market expansion—ensuring consistent throughput and zero message loss.',
  },
  {
    question: 'Can you integrate with our existing ERP environment?',
    answer:
      'Yes. Our solution acts as a universal middleware layer, integrating seamlessly with major ERPs (SAP, Oracle, NetSuite, Microsoft Dynamics) as well as custom legacy systems. We map data directly to your internal formats, preserving your existing workflows.',
  },
];

const strategicFeatures = [
  {
    title: 'Supply Chain Orchestration',
    description: 'Synchronized document flow across global partner networks.',
    highlight: 'Synchronized document flow',
    icon: 'Network',
    detail:
      'Modern commerce is a precision game. We orchestrate your entire supply chain data flow, ensuring that orders, invoices, and shipping updates move instantly between you and your trading partners with zero manual friction.',
  },
  {
    title: 'Protocol Agnostic Integration',
    description:
      'Secure transmission across AS2, SFTP, FTPS, and VAN networks.',
    highlight: 'Secure transmission',
    icon: 'ArrowsLeftRight',
    detail:
      "Don't let your partners' technical constraints slow you down. Our architecture acts as a universal translator, adapting to any protocol or standard (ANSI X12, EDIFACT, XML) while maintaining a clean, consistent interface for your internal systems.",
  },
  {
    title: 'High-Velocity Throughput',
    description:
      'Elastic infrastructure designed for peak enterprise transaction volumes.',
    highlight: 'Peak transaction volumes',
    icon: 'Lightning',
    detail:
      "Built on elastic cloud infrastructure, our platform automatically scales to handle your most demanding spikes—whether it's seasonal retail surges or rapid market expansion—ensuring consistent throughput and zero message loss.",
  },
  {
    title: 'Compliance Continuity',
    description:
      'Certified maps and active monitoring for thousands of trading partners.',
    highlight: 'Certified partner maps',
    icon: 'ShieldCheck',
    detail:
      'We maintain a massive library of certified trading partner maps and actively monitor for mandate changes. This means you stay compliant with major retailers like Walmart, Amazon, and Target without ever touching a line of code.',
  },
];

const keyBenefits = [
  {
    title: '99.99% Uptime',
    description:
      'Mission-critical reliability for your most sensitive supply chain data streams.',
    icon: PiCheckCircle,
  },
  {
    title: 'High-Velocity',
    description:
      'Process thousands of transactions per second with low-latency enterprise throughput.',
    icon: PiLightning,
  },
  {
    title: 'Active Compliance',
    description:
      'Stay ahead of retailer mandate changes with our continuous compliance monitoring.',
    icon: PiShieldCheck,
  },
  {
    title: 'Cost Optimization',
    description:
      'Eliminate expensive VAN fees and reduce overhead with direct protocol connections.',
    icon: PiCurrencyDollar,
  },
  {
    title: 'Global Reach',
    description:
      'Connect with partners in any region with support for all major international standards.',
    icon: PiGlobe,
  },
  {
    title: 'Total Visibility',
    description:
      'End-to-end real-time tracking of every single document in your supply chain.',
    icon: PiEye,
  },
];
---

<Layout
  title={`${service.data.title} - BDKinc`}
  description={service.data.description}
>
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content" class="services-page-shell">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="scanlines pointer-events-none absolute inset-0 opacity-50">
      </div>

      <!-- Visualization -->
      <div
        class="pointer-events-none absolute inset-0 z-0 flex items-center justify-center opacity-80 md:opacity-100"
      >
        <CohesiveOrbit client:load />
      </div>

      <div class="relative z-10 mx-auto max-w-7xl">
        <div
          class="relative z-10 mx-auto flex max-w-4xl flex-col items-center text-center"
        >
          <!-- Badge -->
          <div
            class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
          >
            <div class="flex items-center gap-2 text-sm">
              <div
                class="bg-primary h-2 w-2 animate-pulse rounded-full"
                aria-hidden="true"
              >
              </div>
              <span
                >Trading Partner Network &mdash; <span
                  class="text-accent font-semibold">Live</span
                ></span
              >
            </div>
          </div>
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <!-- Heading -->
          <h1
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold tracking-tight delay-100 duration-700 md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <!-- Subtitle -->
          <p
            class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 mx-auto mb-16 max-w-3xl text-xl leading-relaxed delay-200 duration-700"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            Orchestrate global EDI with a managed platform that keeps partners
            connected, documents flowing, and transactions visible in real time.
          </p>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--accent]/50"
      >
      </div>
    </section>
    <!-- Core Services -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight normal-case md:text-4xl"
          >
            <span class="text-foreground">Core </span>
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >Capabilities</span
            >
          </h2>
          <p
            class="text-muted-foreground mx-auto mt-4 max-w-2xl font-sans text-xl"
          >
            Comprehensive document orchestration designed for the
            <span class="text-accent font-semibold">modern supply chain</span>.
          </p>
        </div>
        <TechCardGrid client:visible className="md:grid-cols-3">
          <TechCard variant="technical" interactive={true}>
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiUsers
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Global Integration
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Rapidly onboard retailers, suppliers, and 3PLs across any
                region. We maintain certified maps for thousands of trading
                partners, ensuring effortless compliance.
              </div>
            </div>
          </TechCard>
          <TechCard variant="technical" interactive={true}>
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiLightning
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Automated Workflows
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Eliminate manual intervention. Automate POs, invoices, and ASNs
                to reduce manual errors and accelerate your order-to-cash
                cycles.
              </div>
            </div>
          </TechCard>
          <TechCard variant="technical" interactive={true}>
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiNetwork
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Agnostic Protocol
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Secure transmission across AS2, SFTP, FTPS, and VAN. Our
                architecture adapts to your partners' technical constraints
                seamlessly.
              </div>
            </div>
          </TechCard>
        </TechCardGrid>
      </div>
    </section>
    <!-- Strategic Leadership Section -->
    <section class="relative overflow-hidden py-24">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-4xl font-bold tracking-tight duration-600 md:text-5xl"
          >
            <span class="text-foreground">Supply Chain </span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Orchestration</span
            >
          </h2>
        </div>

        <ServiceBlockquote>
          &ldquo;Commerce moves at the speed of data. We don&rsquo;t just connect
          systems; we architect
          <span class="text-accent">
            zero-friction, real-time document orchestration</span
          >
          that ensures compliance and powers your global supply chain with 24/7
          visibility.&rdquo;
        </ServiceBlockquote>
      </div>
      <div
        class="via-primary/20 absolute bottom-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
    </section>
    <!-- Strategic Advantage -->
    <section class="relative px-4 py-24 sm:px-6 lg:px-8">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            The Strategic <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Advantage</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            Move beyond simple connections with a partner who orchestrates
            enterprise-grade supply chain intelligence.
          </p>
        </div>
        <FeatureCarousel client:visible features={strategicFeatures} />
      </div>
    </section>
    <!-- Key Benefits -->
    <section class="relative px-4 py-24 sm:px-6 lg:px-8">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="mx-auto max-w-7xl">
        <BenefitGrid benefits={keyBenefits} />
      </div>
    </section>
    <!-- Standards, Protocols & Transaction Reference -->
    <section class="relative overflow-hidden px-4 py-24 sm:px-6 lg:px-8">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>

      <!-- Ambient Background -->
      <div
        class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-20"
      >
        <div
          class="bg-primary/20 h-[500px] w-[500px] rounded-full blur-[120px]"
        >
        </div>
        <div
          class="bg-secondary/20 absolute h-[400px] w-[400px] translate-x-1/2 translate-y-1/4 rounded-full blur-[100px]"
        >
        </div>
      </div>

      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="mb-20 text-center">
          <h2
            class="font-display mb-6 text-4xl font-bold tracking-tight md:text-5xl"
          >
            Standards &amp; <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Protocol Support</span
            >
          </h2>
          <p
            class="text-muted-foreground mx-auto max-w-2xl text-xl leading-relaxed"
          >
            Every format, every protocol, every trading partner — handled with
            enterprise-grade precision and zero friction.
          </p>
        </div>

        <div class="grid gap-8 lg:grid-cols-12">
          <!-- Document Standards (Left Column) -->
          <div class="group relative lg:col-span-5">
            <div
              class="from-primary/20 absolute -inset-px rounded-3xl bg-linear-to-b to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            >
            </div>
            <div
              class="border-border/50 bg-card/40 relative h-full rounded-3xl border p-8 backdrop-blur-xl"
            >
              <div class="mb-8 flex items-center gap-4">
                <div
                  class="border-primary/20 from-primary/10 to-primary/5 flex h-12 w-12 items-center justify-center rounded-xl border bg-linear-to-br"
                >
                  <PiFileText
                    className="text-primary h-6 w-6"
                    aria-hidden="true"
                  />
                </div>
                <h3 class="font-display text-foreground text-2xl font-bold">
                  Document Standards
                </h3>
              </div>

              <div class="space-y-4">
                {
                  [
                    {
                      std: 'ANSI X12',
                      desc: 'North American retail & logistics',
                      regions: 'US / CA',
                    },
                    {
                      std: 'EDIFACT',
                      desc: 'International UN standard',
                      regions: 'Global',
                    },
                    {
                      std: 'TRADACOMS',
                      desc: 'UK grocery and retail',
                      regions: 'UK',
                    },
                    {
                      std: 'XML / JSON',
                      desc: 'Modern structured data',
                      regions: 'Universal',
                    },
                    {
                      std: 'Flat File',
                      desc: 'Custom delimited formats',
                      regions: 'Legacy',
                    },
                  ].map(({ std, desc, regions }) => (
                    <div class="group/item border-border/50 bg-background/50 hover:border-primary/30 hover:bg-primary/5 relative overflow-hidden rounded-2xl border p-4 transition-all">
                      <div class="flex items-center justify-between gap-4">
                        <div>
                          <div class="mb-1 flex items-center gap-2">
                            <span class="text-primary font-mono text-sm font-bold">
                              {std}
                            </span>
                            <span class="bg-muted text-muted-foreground rounded-full px-2 py-0.5 text-[10px] font-medium">
                              {regions}
                            </span>
                          </div>
                          <p class="text-muted-foreground text-sm">{desc}</p>
                        </div>
                        <div class="text-primary/0 group-hover/item:text-primary transition-colors">
                          <PiArrowRight
                            className="h-5 w-5"
                            aria-hidden="true"
                          />
                        </div>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

          <!-- Transmission Protocols (Right Column) -->
          <div class="group relative lg:col-span-7">
            <div
              class="from-secondary/20 absolute -inset-px rounded-3xl bg-linear-to-b to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            >
            </div>
            <div
              class="border-border/50 bg-card/40 relative h-full rounded-3xl border p-8 backdrop-blur-xl"
            >
              <div class="mb-8 flex items-center gap-4">
                <div
                  class="border-secondary/20 from-secondary/10 to-secondary/5 flex h-12 w-12 items-center justify-center rounded-xl border bg-linear-to-br"
                >
                  <PiNetwork
                    className="text-secondary h-6 w-6"
                    aria-hidden="true"
                  />
                </div>
                <h3 class="font-display text-foreground text-2xl font-bold">
                  Transmission Protocols
                </h3>
              </div>

              <div class="grid gap-4 sm:grid-cols-2">
                {
                  [
                    {
                      proto: 'AS2',
                      desc: 'Encrypted HTTP/S with MDN acknowledgments',
                      security: 'TLS 1.3',
                      icon: PiShieldCheck,
                    },
                    {
                      proto: 'SFTP',
                      desc: 'Secure file transfer over SSH',
                      security: 'SSH',
                      icon: PiLockKey,
                    },
                    {
                      proto: 'FTPS',
                      desc: 'FTP over explicit/implicit TLS',
                      security: 'TLS',
                      icon: PiFolderLock,
                    },
                    {
                      proto: 'HTTPS API',
                      desc: 'RESTful webhook-based partner connections',
                      security: 'OAuth 2.0',
                      icon: PiPlugsConnected,
                    },
                    {
                      proto: 'VAN',
                      desc: 'Value-added network relay (legacy)',
                      security: 'Encrypted',
                      icon: PiShareNetwork,
                    },
                  ].map(({ proto, desc, security, icon: Icon }, i) => (
                    <div
                      class={`group/item border-border/50 bg-background/50 hover:border-secondary/30 hover:bg-secondary/5 relative overflow-hidden rounded-2xl border p-5 transition-all ${i === 4 ? 'sm:col-span-2' : ''}`}
                    >
                      <div class="mb-4 flex items-center justify-between">
                        <span class="text-secondary font-mono text-lg font-bold">
                          {proto}
                        </span>
                        <Icon
                          className="h-5 w-5 text-muted-foreground transition-colors group-hover/item:text-secondary"
                          aria-hidden="true"
                        />
                      </div>
                      <p class="text-muted-foreground mb-4 text-sm">{desc}</p>
                      <div class="bg-secondary/10 text-secondary inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium">
                        <PiShieldCheck
                          className="h-3.5 w-3.5"
                          aria-hidden="true"
                        />
                        {security}
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

          <!-- Transaction Sets (Bottom Full Width) -->
          <div class="group relative lg:col-span-12">
            <div
              class="from-primary/20 via-secondary/20 to-accent/20 absolute -inset-px rounded-3xl bg-linear-to-r opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            >
            </div>
            <div
              class="border-border/50 bg-card/40 relative rounded-3xl border p-8 backdrop-blur-xl"
            >
              <div
                class="mb-8 flex flex-col items-center justify-between gap-4 sm:flex-row"
              >
                <div class="flex items-center gap-4">
                  <div
                    class="border-accent/20 from-accent/10 to-accent/5 flex h-12 w-12 items-center justify-center rounded-xl border bg-linear-to-br"
                  >
                    <PiArrowsLeftRight
                      className="text-accent h-6 w-6"
                      aria-hidden="true"
                    />
                  </div>
                  <h3 class="font-display text-foreground text-2xl font-bold">
                    Common Transaction Sets
                  </h3>
                </div>
                <p class="text-muted-foreground text-sm">
                  Over 100+ document types supported
                </p>
              </div>

              <div class="flex flex-wrap gap-3">
                {
                  [
                    { code: '810', label: 'Invoice' },
                    { code: '850', label: 'Purchase Order' },
                    { code: '856', label: 'Ship Notice / ASN' },
                    { code: '846', label: 'Inventory Inquiry' },
                    { code: '204', label: 'Motor Carrier Load' },
                    { code: '210', label: 'Freight Invoice' },
                    { code: '214', label: 'Shipment Status' },
                    { code: '820', label: 'Payment Order' },
                    { code: '940', label: 'Warehouse Shipping' },
                    { code: '945', label: 'Warehouse Shipping Advice' },
                    { code: '997', label: 'Functional Acknowledgment' },
                    { code: '832', label: 'Price / Sales Catalog' },
                    { code: '855', label: 'PO Acknowledgment' },
                    { code: '860', label: 'PO Change' },
                  ].map(({ code, label }) => (
                    <div class="group/pill border-border/50 bg-background/50 hover:border-accent/30 hover:bg-accent/5 flex cursor-default items-center gap-3 rounded-full border py-2 pr-4 pl-2 transition-all hover:shadow-[0_0_15px_rgba(var(--accent),0.1)]">
                      <span class="bg-accent/10 text-accent group-hover/pill:bg-accent/20 flex h-7 items-center justify-center rounded-full px-3 font-mono text-xs font-bold transition-colors">
                        {code}
                      </span>
                      <span class="text-muted-foreground group-hover/pill:text-foreground text-sm font-medium transition-colors">
                        {label}
                      </span>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="relative px-4 py-24 sm:px-6 lg:px-8">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="mx-auto max-w-5xl">
        <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
          Frequently Asked Questions
        </h3>
        <div class="mb-20">
          <TechnicalFAQ client:visible faqs={faqs} />
        </div>
      </div>
    </section>
    <ImpactMetricsSection metrics={metrics} />
    <!-- CTA -->
