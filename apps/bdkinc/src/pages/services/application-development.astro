---
import {
  getContentEntry,
  getPageCopy,
  getSettings,
  type ContentProps,
} from '@/lib/content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { getBlogPosts } from '@/lib/blog';
import { iconMap } from '@/lib/icons';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import Footer from '@/components/Footer.astro';
import EditSection from '@/components/preview/EditSection.astro';
import CapabilitiesGrid from '@/components/visualizations/CapabilitiesGrid';
import TechStackShowcase from '@/components/visualizations/TechStackShowcase';
import LifecycleVisualization from '@/components/visualizations/LifecycleVisualization';
import TechnicalFAQ from '@/components/TechnicalFAQ';

import TechnicalSection from '@/components/TechnicalSection';
import FeatureCarousel, { type Feature } from '@/components/FeatureCarousel';
import CohesiveOrbit from '@/components/visualizations/CohesiveOrbit';
import ServiceBlockquote from '@/components/ServiceBlockquote.astro';
import { servicePageSchemas } from '@/lib/schema';
import {
  PiCode,
  PiMedal,
  PiLink,
  PiRocket,
  PiStack,
  PiLightning,
  PiShieldCheck,
  PiMonitor,
  PiUsersThree,
  PiArrowRight,
} from 'react-icons/pi';
interface Props extends ContentProps {}
const { contentContext, publicPath = Astro.url.pathname } = Astro.props;
const copy = await getPageCopy(
  'service-application-development',
  contentContext
);
const settings = await getSettings(contentContext);
const service = await getContentEntry(
  'services',
  'application-development',
  contentContext
);
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData(contentContext);
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');
const _serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.title,
  description: copy.serviceSchema.description,
  provider: {
    '@type': 'Organization',
    name: 'BDKinc',
    url: 'https://www.bdkinc.com',
  },
  serviceType: copy.serviceSchema.serviceType,
  areaServed: [copy.serviceSchema.areaServed.unitedStates],
};
const relatedTags = [
  'application-development',
  'software-development',
  'modernization',
];
const relatedPosts = (await getBlogPosts(contentContext))
  .filter((post) => {
    return (
      Array.isArray(post.tags) &&
      post.tags.some((tag: string) => relatedTags.includes(tag))
    );
  })
  .slice(0, 3);
const metrics = [
  { ...copy.metrics.appsDelivered, icon: PiCode },
  { ...copy.metrics.clientRetention, icon: PiMedal },
  { ...copy.metrics.systemIntegrations, icon: PiLink },
  { ...copy.metrics.annualReleases, icon: PiRocket },
];
const faqs = [
  copy.faqs.howDoYouEnsureTheScalabilityOf,
  copy.faqs.whatIsYourApproachToLegacySystem,
  copy.faqs.doYouProvideOngoingSupportAfterDeployment,
];
const { breadcrumb: breadcrumbSchema, faq: faqSchema } = servicePageSchemas({
  copy: settings.navigation,
  serviceName: service.data.title,
  servicePath: `/services/${service.id}`,
  faqs,
});
const strategicFeatures: Feature[] = [
  { ...copy.strategy.features.architectureFirstMindset, icon: 'Stack' },
  {
    ...copy.strategy.features.modernizationEngineering,
    icon: 'ArrowsClockwise',
  },
  { ...copy.strategy.features.lifecycleAcceleration, icon: 'Rocket' },
  { ...copy.strategy.features.ecosystemIntegration, icon: 'NetworkX' },
];
---

<Layout
  contentContext={contentContext}
  publicPath={publicPath}
  title={copy.seo.title}
  description={copy.seo.description}
  ogDescription={copy.seo.ogDescription}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(_serviceSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema)}
  />
  <EditSection record="settings" section="navigation">
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={publicPath}
    copy={settings.navigation}
    brand={settings.brand}
  />
  </EditSection>
  <main id="main-content" class="services-page-shell">
    <EditSection record="service-application-development" section="hero">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="scanlines pointer-events-none absolute inset-0 opacity-50">
      </div>

      <!-- Visualization -->
      <div
        class="pointer-events-none absolute inset-0 z-0 flex items-center justify-center opacity-80 md:opacity-100"
      >
        <CohesiveOrbit client:idle />
      </div>

      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
          <!-- Badge -->
          <div
            class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
          >
            <div class="flex items-center gap-2 text-sm">
              <span
                >{copy.hero.badgePrefix}{' '}<span
                  class="text-accent font-semibold"
                  >{copy.hero.badgeAccent}</span
                ></span
              >
            </div>
          </div>
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <!-- Heading -->
          <h1
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold tracking-tight delay-100 duration-700 md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <!-- Subtitle -->
          <p
            class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 mx-auto mb-16 max-w-3xl text-xl leading-relaxed delay-200 duration-700"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            {copy.hero.body}
          </p>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--accent]/50"
      >
      </div>
    </section>
    </EditSection>
    <!-- Core Services -->

    <EditSection record="service-application-development" section="leadership">
    <!-- Strategic Leadership Section -->
    <section class="relative overflow-hidden py-24">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-4xl font-bold tracking-tight duration-600 md:text-5xl"
          >
            <span class="text-foreground">{copy.leadership.heading}{' '}</span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.leadership.headingAccent}</span
            >
          </h2>
        </div>

        <ServiceBlockquote>
          {copy.leadership.quoteBefore}{' '}<span class="text-accent"
            >{copy.leadership.quoteAccent}</span
          >{' '}{copy.leadership.quoteAfter}
        </ServiceBlockquote>
      </div>
      <div
        class="via-primary/20 absolute bottom-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
    </section>
    </EditSection>
    <EditSection record="service-application-development" section="strategy">
    <!-- Strategic Advantage -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            {copy.strategy.heading}{' '}<span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.strategy.headingAccent}</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            {copy.strategy.body}
          </p>
        </div>
        <FeatureCarousel client:visible features={strategicFeatures} />
      </div>
    </section>
    </EditSection>
    <!-- Capabilities & Stack Section (split into two focused sections) -->
    <section class="py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <EditSection record="service-application-development" section="capabilities">
          <CapabilitiesGrid client:visible copy={copy.capabilities} />
        </EditSection>
        <div class="mt-24">
          <EditSection record="service-application-development" section="techStack">
            <TechStackShowcase client:visible copy={copy.techStack} />
          </EditSection>
        </div>
      </div>
    </section>
    <EditSection record="service-application-development" section="benefits">
    <!-- Key Benefits with stats -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            {copy.benefits.heading}{' '}<span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.benefits.headingAccent}</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            {copy.benefits.body}
          </p>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            [
              {
                Icon: PiRocket,
                ...copy.benefits.items.rapidDelivery,
              },
              {
                Icon: PiStack,
                ...copy.benefits.items.scalableDesign,
              },
              {
                Icon: PiShieldCheck,
                ...copy.benefits.items.securityFirst,
              },
              {
                Icon: PiMonitor,
                ...copy.benefits.items.unifiedVisibility,
              },
              {
                Icon: PiUsersThree,
                ...copy.benefits.items.dedicatedTeams,
              },
              {
                Icon: PiLightning,
                ...copy.benefits.items.operationalAgility,
              },
            ].map(({ Icon, title, stat, desc }) => (
              <div class="group border-border bg-card/30 hover:border-primary/30 relative overflow-hidden rounded-xl border p-6 transition-[border-color,box-shadow] duration-300 hover:shadow-[0_0_20px_oklch(0.65_0.18_210_/_0.07)]">
                <div class="mb-4 flex items-start justify-between gap-3">
                  <div class="bg-primary/10 group-hover:bg-primary/20 rounded-lg p-2 transition-[background-color] duration-300">
                    <Icon className="text-primary h-5 w-5" aria-hidden="true" />
                  </div>
                  <span class="text-primary bg-primary/10 border-primary/20 self-center rounded border px-2 py-0.5 font-mono text-[10px] font-bold tracking-widest">
                    {stat}
                  </span>
                </div>
                <h4 class="font-display text-foreground group-hover:text-primary mb-2 text-base font-bold transition-colors duration-300">
                  {title}
                </h4>
                <p class="text-muted-foreground text-sm leading-relaxed">
                  {desc}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>
    </EditSection>
    <EditSection record="service-application-development" section="lifecycle">
    <!-- Lifecycle Visualization (standalone section) -->
    <section class="py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            {copy.lifecycle.heading}{' '}<span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >{copy.lifecycle.headingAccent}</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            {copy.lifecycle.body}
          </p>
        </div>
        <LifecycleVisualization
          client:visible
          copy={copy.lifecycle.visualization}
        />
      </div>
    </section>
    </EditSection>
    <EditSection record="service-application-development" section="operations">
    <TechnicalSection
      client:visible
      id="dev-shop-vault"
      overlayOpacity="opacity-10"
    >
      <div class="relative z-10 flex flex-col items-center text-center">
        <div
          class="border-primary/30 bg-primary/10 mb-6 flex items-center gap-2 rounded-full border px-4 py-1"
        >
          <div class="bg-primary h-2 w-2 animate-pulse rounded-full"></div>
          <span
            class="text-primary font-display text-xs font-bold tracking-widest"
            >{copy.operations.badge}</span
          >
        </div>
        <h3
          class="text-foreground font-display mb-6 max-w-2xl text-3xl font-bold tracking-tight"
        >
          {copy.operations.heading}{' '}<span class="text-primary"
            >{copy.operations.headingAccent}</span
          >
        </h3>
        <div
          class="text-muted-foreground mx-auto max-w-4xl font-sans text-lg leading-relaxed"
        >
          {copy.operations.body}
        </div>
      </div>
    </TechnicalSection>
    </EditSection>

    <EditSection record="service-application-development" section="faqs" also={['faqHeading']}>
    <!-- FAQ -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
          {copy.faqHeading}
        </h3>
        <div class="mb-20">
          <TechnicalFAQ client:visible faqs={faqs} />
        </div>
      </div>
    </section>
    </EditSection>
    <!-- Related Resources -->
    {
      relatedPosts.length > 0 && (
        <EditSection record="service-application-development" section="resources">
        <section class="mx-auto max-w-5xl px-4 py-24">
          <h2 class="text-foreground mb-6 text-center text-3xl font-bold">
            {copy.resources.heading}
          </h2>
          <div class="grid gap-6 md:grid-cols-3">
            {relatedPosts.map((post) => (
              <a
                href={`/blog/${post.slug}`}
                class="border-border hover:border-primary group focus-visible:ring-primary flex flex-col rounded-xl border p-6 transition-colors focus-visible:ring-2 focus-visible:outline-none"
              >
                <h3 class="text-foreground group-hover:text-primary mb-2 text-lg font-semibold transition-colors">
                  {post.title}
                </h3>
                <p class="text-muted-foreground line-clamp-3 text-sm">
                  {post.description}
                </p>
                <span class="text-primary mt-4 flex items-center gap-1 text-sm font-medium">
                  {copy.resources.articleLinkLabel}{' '}
                  <PiArrowRight className="h-3 w-3" aria-hidden="true" />
                </span>
              </a>
            ))}
          </div>
        </section>
        </EditSection>
      )
    }
    <EditSection record="service-application-development" section="metrics">
    <ImpactMetricsSection metrics={metrics} copy={settings.metrics} />
    </EditSection>
    <EditSection record="service-application-development" section="cta">
    <!-- CTA -->
    <CTASection client:visible copy={settings.cta} {...copy.cta} />
    </EditSection>
  </main>
  <Footer contentContext={contentContext} />
</Layout>
