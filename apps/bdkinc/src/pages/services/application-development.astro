---
import { getEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { getBlogPosts } from '@/lib/blog';
import { iconMap } from '@/lib/icons';
import { TechCard, TechCardGrid } from '@/components/TechCard';
import ImpactMetricsSection from '@/components/ImpactMetricsSection.astro';
import CTASection from '@/components/CTASection';
import Footer from '@/components/Footer.astro';
import CapabilitiesGrid from '@/components/visualizations/CapabilitiesGrid';
import TechStackShowcase from '@/components/visualizations/TechStackShowcase';
import LifecycleVisualization from '@/components/visualizations/LifecycleVisualization';
import TechnicalFAQ from '@/components/TechnicalFAQ';

import TechnicalSection from '@/components/TechnicalSection';
import FeatureCarousel from '@/components/FeatureCarousel';
import CohesiveOrbit from '@/components/visualizations/CohesiveOrbit';
import ServiceBlockquote from '@/components/ServiceBlockquote.astro';
import {
  PiArrowsClockwise,
  PiNetworkX,
  PiCode,
  PiMedal,
  PiLink,
  PiRocket,
  PiStack,
  PiLightning,
  PiShieldCheck,
  PiMonitor,
  PiUsersThree,
  PiArrowRight,
} from 'react-icons/pi';
const service = await getEntry('services', 'application-development');
if (!service) {
  return new Response(null, { status: 404 });
}
const { servicesData, recentPosts } = await getNavigationData();
const IconComponent = iconMap[service.data.icon];
const title = service.data.title;
const titleWords = title.split(' ');
const lastTitleWord = titleWords.pop();
const titleFirst = titleWords.join(' ');
const _serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.title,
  description:
    'BDKinc is your full-service development shop for custom software, enterprise integration, and application modernization. Built to power your vision.',
  provider: {
    '@type': 'Organization',
    name: 'BDKinc',
    url: 'https://www.bdkinc.com',
  },
  serviceType: 'Custom Application Development',
  areaServed: ['United States'],
};
const relatedTags = [
  'application-development',
  'software-development',
  'modernization',
];
const relatedPosts = (await getBlogPosts())
  .filter((post) => {
    return (
      Array.isArray(post.tags) &&
      post.tags.some((tag: string) => relatedTags.includes(tag))
    );
  })
  .slice(0, 3);
const metrics = [
  { value: '250+', label: 'Apps Delivered', icon: PiCode },
  { value: '92%', label: 'Client Retention', icon: PiMedal },
  { value: '60+', label: 'System Integrations', icon: PiLink },
  { value: '45', label: 'Annual Releases', icon: PiRocket },
];
const faqs = [
  {
    question: 'How do you ensure the scalability of custom applications?',
    answer:
      "We design with an 'architecture-first' mindset. By utilizing cloud-native technologies, microservices where appropriate, and robust database optimization (SQL/NoSQL), we ensure your application can handle increased loads and expanding feature sets without performance degradation.",
  },
  {
    question: 'What is your approach to legacy system modernization?',
    answer:
      "We prioritize risk mitigation and business continuity. Our team analyzes your existing codebase to identify the best path forward—whether it's refactoring, re-platforming, or a complete rebuild. We ensure that critical business logic is preserved while transitioning you to a modern, secure tech stack.",
  },
  {
    question: 'Do you provide ongoing support after deployment?',
    answer:
      "Absolutely. As a full-service partner, we offer comprehensive post-deployment support, including monitoring, security updates, and feature enhancements. Because we can also host what we build, we have full visibility into the application's performance, allowing us to proactively address issues before they impact your business.",
  },
];
const strategicFeatures = [
  {
    title: 'Architecture-First Mindset',
    description: 'Scalable, cloud-native designs that grow with your vision.',
    highlight: 'Architecture-first mindset',
    icon: 'Stack',
    detail:
      "We don't just write code; we architect systems. By utilizing microservices, robust API design, and cloud-native patterns, we ensure your application is built for performance today and massive scale tomorrow.",
  },
  {
    title: 'Modernization Engineering',
    description:
      'Phased upgrades for legacy systems with zero business friction.',
    highlight: 'Zero business friction',
    icon: 'ArrowsClockwise',
    detail:
      "Legacy technical debt shouldn't hold you back. Our engineering teams specialize in the phased modernization of complex enterprise systems, refactoring critical business logic into modern, secure, and maintainable stacks.",
  },
  {
    title: 'Lifecycle Acceleration',
    description: 'Rapid delivery cycles powered by automated CI/CD and DevOps.',
    highlight: 'Rapid delivery cycles',
    icon: 'Rocket',
    detail:
      'Speed to market is a competitive advantage. We implement end-to-end DevOps automation, ensuring that new features and security patches move from development to production with absolute reliability and speed.',
  },
  {
    title: 'Ecosystem Integration',
    description:
      'Seamlessly connecting disparate platforms into a unified data flow.',
    highlight: 'Unified data flow',
    icon: 'NetworkX',
    detail:
      'In a world of fragmented SaaS and legacy silos, we build the connective tissue. Our integration experts ensure that your data moves securely and reliably between platforms, creating a unified source of truth for your business.',
  },
];
---

<Layout
  title="Custom Application Development & Modernization | BDKinc"
  description="BDKinc is your full-service development shop for custom software, enterprise integration, and application modernization. Built to power your vision."
  ogDescription="BDKinc is your full-service development shop for custom software, enterprise integration, and application modernization. Built to power your vision."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(_serviceSchema)}
  />
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="scanlines pointer-events-none absolute inset-0 opacity-50"></div>

      <!-- Visualization -->
      <div
        class="pointer-events-none absolute inset-0 z-0 flex items-center justify-center opacity-80 md:opacity-100"
      >
        <CohesiveOrbit client:load />
      </div>

      <div class="relative z-10 mx-auto max-w-7xl">
        <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
          <!-- Badge -->
          <div
            class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
          >
            <div class="flex items-center gap-2 text-sm">
              <span
                >Full-Stack <span class="text-accent font-semibold"
                  >Dev Shop</span
                ></span
              >
            </div>
          </div>
          <div
            class="from-primary/10 to-secondary/10 mb-6 inline-flex items-center justify-center rounded-2xl bg-linear-to-br p-4 delay-100 duration-500"
            transition:name={`service-icon-${service.id}`}
          >
            <IconComponent
              className="text-primary h-12 w-12"
              aria-hidden="true"
            />
          </div>
          <!-- Heading -->
          <h1
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold tracking-tight delay-100 duration-700 md:text-6xl"
            transition:name={`service-title-${service.id}`}
            transition:animate="initial"
          >
            <span class="text-foreground"
              >{titleFirst ? `${titleFirst} ` : ''}</span
            >
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >{lastTitleWord}</span
            >
          </h1>
          <!-- Subtitle -->
          <p
            class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 mx-auto mb-16 max-w-3xl text-xl leading-relaxed delay-200 duration-700"
            transition:name={`service-description-${service.id}`}
            transition:animate="initial"
          >
            Custom applications and modernization that fit your workflows.
            BDKinc is your full-service development shop for custom software,
            enterprise integration, and application modernization.
          </p>
        </div>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--accent]/50"
      >
      </div>
    </section>
    <!-- Core Services -->
    <section
      class="bg-muted/30 px-4 py-24 sm:px-6 lg:px-8 dark:bg-white/[0.02]"
    >
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight normal-case md:text-4xl"
          >
            <span class="text-foreground">Core </span>
            <span
              class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent"
              >Capabilities</span
            >
          </h2>
          <p
            class="text-muted-foreground mx-auto mt-4 max-w-2xl font-sans text-xl"
          >
            Engineering enterprise systems designed for the
            <span class="text-accent font-semibold">modern business</span>.
          </p>
        </div>
        <TechCardGrid client:visible className="md:grid-cols-3">
          <TechCard variant="technical" interactive={true}>
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiCode className="text-primary h-16 w-16" aria-hidden="true" />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Custom Applications
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Purpose-built software tailored to your workflows, with
                automation and reporting that reduce manual steps for teams and
                improve operational efficiency.
              </div>
            </div>
          </TechCard>
          <TechCard variant="technical" interactive={true}>
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiNetworkX
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Enterprise Integration
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Secure integrations that connect legacy platforms, cloud
                services, and third-party APIs, ensuring your data moves
                reliably across your entire ecosystem.
              </div>
            </div>
          </TechCard>
          <TechCard variant="technical" interactive={true}>
            <div class="flex h-full flex-col items-center p-8 text-center">
              <div
                class="bg-primary/5 border-primary/20 group-hover:bg-primary/10 mb-6 rounded-lg border p-3 transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500 group-hover:scale-110"
              >
                <PiArrowsClockwise
                  className="text-primary h-16 w-16"
                  aria-hidden="true"
                />
              </div>
              <h4
                class="text-foreground font-display group-hover:text-primary mb-4 text-2xl font-bold tracking-tight transition-colors"
              >
                Application Modernization
              </h4>
              <div class="text-muted-foreground text-sm leading-relaxed">
                Modernize legacy apps with phased upgrades, performance tuning,
                and security improvements while preserving the core business
                logic that powers your organization.
              </div>
            </div>
          </TechCard>
        </TechCardGrid>
      </div>
    </section>
    <!-- Strategic Leadership Section -->
    <section class="relative overflow-hidden py-24">
      <div
        class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2
            class="font-display fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-4xl font-bold tracking-tight duration-600 md:text-5xl"
          >
            <span class="text-foreground">Engineering </span>
            <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Vision</span
            >
          </h2>
        </div>

        <ServiceBlockquote>
          &ldquo;Great software isn&rsquo;t just about features; it&rsquo;s about
          architecture that empowers growth. We build
          <span class="text-accent"> resilient digital foundations</span>
          that automate complexity and transform your technology from a cost
          center into a competitive advantage.&rdquo;
        </ServiceBlockquote>
      </div>
      <div
        class="via-primary/20 absolute bottom-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
      >
      </div>
    </section>
    <!-- Strategic Advantage -->
    <section
      class="to-muted/20 bg-linear-to-b from-transparent px-4 py-24 sm:px-6 lg:px-8 dark:to-white/[0.02]"
    >
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            The Strategic <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Advantage</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            Move beyond standard development with a partner who builds for
            enterprise scale and long-term maintainability.
          </p>
        </div>
        <FeatureCarousel client:visible features={strategicFeatures} />
      </div>
    </section>
    <!-- Capabilities & Stack Section (split into two focused sections) -->
    <section class="bg-muted/30 py-24 dark:bg-white/[0.02]">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <CapabilitiesGrid client:visible />
        <div class="mt-24">
          <TechStackShowcase client:visible />
        </div>
      </div>
    </section>
    <!-- Key Benefits with stats -->
    <section
      class="bg-muted/20 px-4 py-24 sm:px-6 lg:px-8 dark:bg-white/[0.01]"
    >
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            Why BDK for <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Custom Development</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            What we deliver — and the numbers that back it up.
          </p>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            [
              {
                Icon: PiRocket,
                title: 'Rapid Delivery',
                stat: '45 releases/yr',
                desc: 'Automated CI/CD and DevOps workflows ensure features move from concept to production at peak speed',
              },
              {
                Icon: PiStack,
                title: 'Scalable Design',
                stat: 'Cloud-native',
                desc: 'Architectures that grow seamlessly with your user base and data volume without re-platforming',
              },
              {
                Icon: PiShieldCheck,
                title: 'Security-First',
                stat: 'Shift-left',
                desc: 'Vulnerability scanning and security controls integrated directly into the development lifecycle',
              },
              {
                Icon: PiMonitor,
                title: 'Unified Visibility',
                stat: 'Real-time',
                desc: 'Full-stack monitoring providing live insights into application health, latency, and error rates',
              },
              {
                Icon: PiUsersThree,
                title: 'Dedicated Teams',
                stat: '92% retention',
                desc: 'Senior engineers who embed with your team to understand and architect solutions for your domain',
              },
              {
                Icon: PiLightning,
                title: 'Operational Agility',
                stat: '2-week sprints',
                desc: 'Agile methodologies that allow rapid pivoting and iterative delivery based on real-world feedback',
              },
            ].map(({ Icon, title, stat, desc }) => (
              <div class="group border-border bg-card/30 hover:border-primary/30 relative overflow-hidden rounded-xl border p-6 transition-[border-color,box-shadow] duration-300 hover:shadow-[0_0_20px_oklch(0.65_0.18_210_/_0.07)]">
                <div class="mb-4 flex items-start justify-between gap-3">
                  <div class="bg-primary/10 group-hover:bg-primary/20 rounded-lg p-2 transition-[background-color] duration-300">
                    <Icon className="text-primary h-5 w-5" aria-hidden="true" />
                  </div>
                  <span class="text-primary bg-primary/10 border-primary/20 self-center rounded border px-2 py-0.5 font-mono text-[10px] font-bold tracking-widest">
                    {stat}
                  </span>
                </div>
                <h4 class="font-display text-foreground group-hover:text-primary mb-2 text-base font-bold transition-colors duration-300">
                  {title}
                </h4>
                <p class="text-muted-foreground text-sm leading-relaxed">
                  {desc}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>
    <!-- Lifecycle Visualization (standalone section) -->
    <section class="bg-muted/30 py-24 dark:bg-white/[0.02]">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
          <h2
            class="font-display mb-4 text-3xl font-bold tracking-tight md:text-4xl"
          >
            Development <span
              class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
              >Lifecycle</span
            >
          </h2>
          <p class="text-muted-foreground mx-auto max-w-2xl text-xl">
            How we take you from discovery to production — and keep improving
            from there.
          </p>
        </div>
        <LifecycleVisualization client:visible />
      </div>
    </section>
    <TechnicalSection
      client:visible
      id="dev-shop-vault"
      overlayOpacity="opacity-10"
    >
      <div class="relative z-10 flex flex-col items-center text-center">
        <div
          class="border-primary/30 bg-primary/10 mb-6 flex items-center gap-2 rounded-full border px-4 py-1"
        >
          <div class="bg-primary h-2 w-2 animate-pulse rounded-full"></div>
          <span
            class="text-primary font-display text-xs font-bold tracking-widest"
            >BDK Dev Shop Operations</span
          >
        </div>
        <h3
          class="text-foreground font-display mb-6 max-w-2xl text-3xl font-bold tracking-tight"
        >
          Engineering Enterprise Systems. <span class="text-primary"
            >Zero Legacy Friction.</span
          >
        </h3>
        <div
          class="text-muted-foreground mx-auto max-w-4xl font-sans text-lg leading-relaxed"
        >
          We help you meet the demands of modern business by automating
          workflows, connecting disparate data sources, and reducing technical
          debt. Our full-stack teams own the architecture, delivery, and
          modernization of your applications end-to-end, ensuring your vision is
          powered by excellence.
        </div>
      </div>
    </TechnicalSection>

    <!-- FAQ -->
    <section class="px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h3 class="text-foreground mb-6 text-center text-2xl font-bold">
          Frequently Asked Questions
        </h3>
        <div class="mb-20">
          <TechnicalFAQ client:visible faqs={faqs} />
        </div>
      </div>
    </section>
    <!-- Related Resources -->
    {
      relatedPosts.length > 0 && (
        <section class="mx-auto max-w-5xl px-4 py-24">
          <h2 class="text-foreground mb-6 text-center text-3xl font-bold">
            Related Insights
          </h2>
          <div class="grid gap-6 md:grid-cols-3">
            {relatedPosts.map((post) => (
              <a
                href={`/blog/${post.slug}`}
                class="border-border hover:border-primary group focus-visible:ring-primary flex flex-col rounded-xl border p-6 transition-colors focus-visible:ring-2 focus-visible:outline-none"
              >
                <h3 class="text-foreground group-hover:text-primary mb-2 text-lg font-semibold transition-colors">
                  {post.title}
                </h3>
                <p class="text-muted-foreground line-clamp-3 text-sm">
                  {post.description}
                </p>
                <span class="text-primary mt-4 flex items-center gap-1 text-sm font-medium">
                  Read Article{' '}
                  <PiArrowRight className="h-3 w-3" aria-hidden="true" />
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }
    <ImpactMetricsSection metrics={metrics} />
    <!-- CTA -->
    <CTASection
      client:visible
      title="Build Your Vision with BDK"
      description="Ready to engineer the future of your business? Partner with a development shop that understands enterprise scale."
      buttonText="Start Your Project"
      buttonHref="/contact#chat"
    />
  </main>
  <Footer />
</Layout>
