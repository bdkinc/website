---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import CTASection from '@/components/CTASection';
import { getNavigationData } from '@/lib/navigation-data';
import Footer from '@/components/Footer.astro';
import { BlogList } from '@/components/BlogList';
import { PiArrowRight } from 'react-icons/pi';
import { getBlogPosts } from '@/lib/blog';
import PageHeroEffects from '@/components/PageHeroEffects';
import EditSection from '@/components/preview/EditSection.astro';
import { createAppContentReader, type ContentProps } from '@/lib/content';
interface Props extends ContentProps {}
const { contentContext, publicPath = Astro.url.pathname, reader: suppliedReader } = Astro.props;
const reader = suppliedReader ?? createAppContentReader(contentContext);

const [copy, settings] = await Promise.all([reader.getPage('blog'), reader.getSettings()]);
const { servicesData, recentPosts } = await getNavigationData(reader);

const sortedPosts = await getBlogPosts(reader);

// Calculate read time
const postsWithReadTime = sortedPosts.map((post) => {
  const wordsPerMinute = 200;
  const words = post.content ? post.content.trim().split(/\s+/).length : 0;
  const minutes = Math.ceil(words / wordsPerMinute);
  return {
    ...post,
    readTime: copy.posts.readTime.replace('{minutes}', String(minutes)),
  };
});

// Separate featured post (latest) from list
const featuredPost = postsWithReadTime[0];
const remainingPosts = postsWithReadTime.slice(1);
---

<Layout reader={reader}
  title={copy.metadata.title}
  contentContext={contentContext}
  publicPath={publicPath}
>
  <EditSection record="settings" section="navigation">
    <Navigation
      client:load
      services={servicesData}
      blogPosts={recentPosts}
      currentPath={publicPath}
      copy={settings.navigation}
      brand={settings.brand}
    />
  </EditSection>
  <main id="main-content">
    <!-- Hero Section -->
    <EditSection record="blog" section="hero">
    <section class="relative overflow-hidden pt-32 pb-20">
      <PageHeroEffects client:idle />

      <div class="relative z-10 mx-auto max-w-7xl px-4 text-center">
        <!-- Badge -->
        <div
          class="glass border-border animate-in fade-in slide-in-from-top-4 fill-mode-both mb-8 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
        >
          <div class="text-sm">
            {copy.hero.badgeLead}{' '}<span class="text-accent font-semibold"
              >{copy.hero.badgeAccent}</span
            >
          </div>
        </div>

        <!-- Title -->
        <h1
          class="font-display mb-6 text-5xl font-bold tracking-tight md:text-7xl"
        >
          <span class="text-foreground">{copy.hero.headingLead}{' '}</span>
          <span
            class="from-primary to-secondary bg-gradient-to-r bg-clip-text text-transparent"
            >{copy.hero.headingAccent}</span
          >
        </h1>

        <!-- Subtitle -->
        <p class="text-muted-foreground mx-auto max-w-2xl text-xl font-light">
          {copy.hero.description}
        </p>
      </div>

      <!-- Bottom Ticker Border (Visual only) -->
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--accent]/50"
      >
      </div>
    </section>
    </EditSection>

    <!-- Featured Post Section -->
    <EditSection record="blog" section="posts">
    <section class="border-border/10 bg-card/20 relative z-20 border-b">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <a
          href={`/blog/${featuredPost.slug}`}
          class="group border-primary/20 bg-card/40 hover:border-primary/40 hover:bg-card/50 relative block overflow-hidden rounded-3xl border backdrop-blur-md transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-500"
        >
          <!-- Background Effects -->
          <div
            class="from-primary/5 to-secondary/5 absolute inset-0 bg-gradient-to-br via-transparent opacity-50"
          >
          </div>
          <div
            class="bg-primary/10 group-hover:bg-primary/20 absolute -top-20 -right-20 h-96 w-96 rounded-full blur-3xl transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] duration-700"
          >
          </div>

          <div
            class="relative z-10 grid gap-8 p-8 md:p-12 lg:grid-cols-2 lg:gap-16"
          >
            <div class="flex flex-col justify-center space-y-6">
              <!-- Meta Badge -->
              <div class="flex items-center gap-4">
                <span
                  class="border-primary/20 bg-primary/5 text-primary/90 inline-flex items-center rounded-sm border px-2 py-1 text-xs font-medium"
                >
                  {copy.posts.featuredLabel}
                </span>
                <span class="text-muted-foreground/60 text-xs font-medium">
                  {
                    new Intl.DateTimeFormat('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    }).format(featuredPost.pubDate)
                  }
                </span>
              </div>

              <!-- Title -->
              <h2
                class="font-display text-foreground text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl lg:leading-tight"
              >
                {featuredPost.title}
              </h2>

              <!-- Description -->
              <p
                class="text-muted-foreground text-lg leading-relaxed md:text-xl"
              >
                {featuredPost.description}
              </p>

              <!-- Action -->
              <div class="pt-4">
                <span
                  class="text-primary inline-flex items-center gap-2 text-sm font-bold tracking-widest transition-[color,background-color,border-color,box-shadow,opacity,transform,width,gap,letter-spacing] group-hover:gap-4"
                >
                  {copy.posts.readAction}
                  <PiArrowRight className="h-4 w-4" />
                </span>
              </div>
            </div>

            <!-- Featured article illustration / Right Column -->
            {(featuredPost.image || copy.detail.image) && <div
              class="relative hidden min-h-[300px] overflow-hidden rounded-xl border border-white/5 bg-black/20 lg:block"
            >
              <img
                src={featuredPost.image || copy.detail.image}
                alt={featuredPost.image ? `Editorial illustration for ${featuredPost.title}` : copy.detail.imageAlt}
                width="1200"
                height="675"
                class="absolute inset-0 h-full w-full object-cover"
                decoding="async"
              />
            </div>}
          </div>
        </a>
      </div>
    </section>
    </EditSection>

    <!-- Blog Posts List -->
    <section>
      <div class="relative z-10 mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
        <BlogList client:visible posts={remainingPosts} />
      </div>
    </section>

    <!-- CTA Section -->
    <EditSection record="blog" section="cta">
      <CTASection
        client:visible
        copy={settings.cta}
        title={copy.cta.title}
        description={copy.cta.description}
        buttonText={copy.cta.buttonText}
        buttonHref={copy.cta.buttonHref}
        icon="arrow"
      />
    </EditSection>
  </main>

  <Footer reader={reader} contentContext={contentContext} />
</Layout>
