---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { Card } from '@bdkinc/design-system';
import { getNavigationData } from '@/lib/navigation-data';
import Footer from '@/components/Footer.astro';
import { PiScales } from 'react-icons/pi';
import EditSection from '@/components/preview/EditSection.astro';
import { getPageCopy, getSettings, type ContentProps } from '@/lib/content';
interface Props extends ContentProps {}
const { contentContext, publicPath = Astro.url.pathname } = Astro.props;
const [copy, settings] = await Promise.all([getPageCopy('terms', contentContext), getSettings(contentContext)]);
const { servicesData, recentPosts } = await getNavigationData(contentContext);
// Section identities, numbering, paragraph counts, and list structure remain code-owned.
const sections = [
  { id: 'agreement-to-terms', heading: copy.agreementToTerms.heading, paragraphs: [copy.agreementToTerms.body] },
  { id: 'services-description', heading: copy.servicesDescription.heading, paragraphs: [copy.servicesDescription.services, copy.servicesDescription.conditions] },
  { id: 'user-responsibilities', heading: copy.userResponsibilities.heading, paragraphs: [copy.userResponsibilities.introduction], items: [copy.userResponsibilities.lawfulUse, copy.userResponsibilities.disruption, copy.userResponsibilities.credentials, copy.userResponsibilities.access, copy.userResponsibilities.notification] },
  { id: 'payment-terms', heading: copy.paymentTerms.heading, paragraphs: [copy.paymentTerms.billing, copy.paymentTerms.latePayments, copy.paymentTerms.taxes] },
  { id: 'service-level', heading: copy.serviceLevel.heading, paragraphs: [copy.serviceLevel.commitments, copy.serviceLevel.interruptions] },
  { id: 'intellectual-property', heading: copy.intellectualProperty.heading, paragraphs: [copy.intellectualProperty.ownership, copy.intellectualProperty.license] },
  { id: 'confidentiality', heading: copy.confidentiality.heading, paragraphs: [copy.confidentiality.obligations, copy.confidentiality.protection] },
  { id: 'warranties-disclaimers', heading: copy.warrantiesDisclaimers.heading, paragraphs: [copy.warrantiesDisclaimers.warranties, copy.warrantiesDisclaimers.disclaimers] },
  { id: 'limitation-of-liability', heading: copy.limitationOfLiability.heading, paragraphs: [copy.limitationOfLiability.exclusions, copy.limitationOfLiability.cap] },
  { id: 'indemnification', heading: copy.indemnification.heading, paragraphs: [copy.indemnification.body] },
  { id: 'term-termination', heading: copy.termTermination.heading, paragraphs: [copy.termTermination.terms, copy.termTermination.consequences] },
  { id: 'dispute-resolution', heading: copy.disputeResolution.heading, paragraphs: [copy.disputeResolution.resolution, copy.disputeResolution.jurisdiction] },
  { id: 'general-provisions', heading: copy.generalProvisions.heading, paragraphs: [copy.generalProvisions.severability, copy.generalProvisions.agreement, copy.generalProvisions.transfer] },
];
// Anchor ids are the kebab-case of their editorial field keys.
const fieldKey = (id: string) => id.replace(/-(.)/g, (_, letter: string) => letter.toUpperCase());
const tocItems = [...sections.map(({ id, heading }) => ({ id, label: heading })), { id: 'contact-information', label: copy.contactInformation.heading }];
---

<Layout title={copy.metadata.title} description={copy.metadata.description} contentContext={contentContext} publicPath={publicPath}>
  <EditSection record="settings" section="navigation">
    <Navigation client:load services={servicesData} blogPosts={recentPosts} currentPath={publicPath} copy={settings.navigation} brand={settings.brand} />
  </EditSection>
  <main id="main-content">
    <EditSection record="terms" section="hero">
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="circuit-overlay absolute inset-0 opacity-40"></div>
      <div class="relative z-10 mx-auto flex max-w-4xl flex-col items-center text-center">
        <div class="glass border-primary/20 animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500">
          <span class="text-sm"><span class="font-semibold text-[--accent]">{copy.hero.badgeAccent}</span>{' '}{copy.hero.badgeEnd}</span>
        </div>
        <div class="bg-primary/10 mb-6 inline-flex items-center justify-center rounded-lg p-4">
          <PiScales className="text-primary h-10 w-10" />
        </div>
        <h1 class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold duration-700 md:text-6xl">
          <span class="text-foreground">{copy.hero.headingLead}{' '}</span>
          <span class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent">{copy.hero.headingAccent}</span>
        </h1>
        <p class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 mb-4 text-lg leading-relaxed delay-200 duration-700">{copy.hero.description}</p>
        <p class="text-muted-foreground/70 text-sm">{copy.hero.updatedLabel}{' '}{copy.hero.updatedDate}</p>
      </div>
      <div class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-gradient-to-r to-[--accent]/50"></div>
    </section>
    </EditSection>
    <section class="px-4 py-12 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-8 lg:grid-cols-4">
          <aside class="lg:col-span-1">
            <div class="sticky top-24">
              <EditSection record="terms" section="contents">
              <Card className="fill-mode-both animate-in fade-in slide-in-from-left-8 duration-700" size="lg" interactive={false}>
                <nav class="space-y-1">
                  <p class="text-foreground mb-4 text-sm font-semibold tracking-widest">{copy.contents.heading}</p>
                  <ul class="space-y-2">
                    {tocItems.map((item) => <li><a href={`#${item.id}`} class="text-muted-foreground hover:text-primary block py-1 text-sm transition-colors duration-200">{item.label}</a></li>)}
                  </ul>
                </nav>
              </Card>
              </EditSection>
            </div>
          </aside>
          <article class="space-y-12 lg:col-span-3">
            {sections.map((section, sectionIndex) => <EditSection record="terms" section={fieldKey(section.id)}><section id={section.id}>
              <h2 class="text-foreground mb-4 text-3xl font-bold"><span class="text-primary">{sectionIndex + 1}.</span>{' '}{section.heading}</h2>
              {section.paragraphs.map((paragraph, index) => <p class:list={['text-muted-foreground leading-relaxed', { 'mb-4': index < section.paragraphs.length - 1 || !!section.items }]}>{paragraph}</p>)}
              {section.items && <ul class="text-muted-foreground ml-4 space-y-2">{section.items.map((item) => <li class="flex gap-3"><span class="text-primary flex-shrink-0">•</span><span>{item}</span></li>)}</ul>}
            </section></EditSection>)}
            <EditSection record="terms" section="contactInformation">
            <section id="contact-information">
              <h2 class="text-foreground mb-4 text-3xl font-bold"><span class="text-primary">14.</span>{' '}{copy.contactInformation.heading}</h2>
              <p class="text-muted-foreground mb-6 leading-relaxed">{copy.contactInformation.introduction}</p>
              <Card className="bg-card/50 border-primary/20" size="lg" interactive={false}>
                <div class="space-y-3">
                  <div><p class="text-foreground font-semibold">{copy.contactInformation.organization}</p></div>
                  <div><p class="text-muted-foreground text-sm">{copy.contactInformation.emailLabel}</p><a href={copy.contactInformation.emailUrl} class="text-primary hover:text-primary/80 transition-colors">{copy.contactInformation.email}</a></div>
                  <div><p class="text-muted-foreground text-sm">{copy.contactInformation.phoneLabel}</p><a href={copy.contactInformation.phoneUrl} class="text-primary hover:text-primary/80 transition-colors">{copy.contactInformation.phone}</a></div>
                </div>
              </Card>
            </section>
            </EditSection>
          </article>
        </div>
      </div>
    </section>
  </main>
  <Footer contentContext={contentContext} />
</Layout>
