---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import Hero from '@/components/Hero';
import Services from '@/components/Services';
import TrustShowcase from '@/components/TrustShowcase';
import WhyChooseUs from '@/components/WhyChooseUs';
import Testimonials from '@/components/Testimonials.astro';
import CTASection from '@/components/CTASection';
import { getNavigationData } from '@/lib/navigation-data';
import Footer from '@/components/Footer.astro';

const { servicesData, recentPosts } = await getNavigationData();

const pageTitle = 'Premier Managed IT Services & Cloud Hosting | BDKinc';
const pageDescription =
  'IT Made Simple - Your trusted technology partner for managed IT services, cloud hosting, and cybersecurity solutions.';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'BDKinc',
  legalName: 'BDK Inc',
  url: 'https://www.bdkinc.com',
  logo: {
    '@type': 'ImageObject',
    url: 'https://www.bdkinc.com/favicon.svg',
  },
  image: 'https://www.bdkinc.com/favicon.svg',
  description:
    'Premier technology partner delivering Managed IT, Cloud Solutions, and Custom Software with enterprise-grade expertise.',
  foundingDate: '1999',
  sameAs: [
    'https://www.linkedin.com/company/bdk-inc./',
    'https://www.facebook.com/bdkinctech',
    'https://www.instagram.com/bdkinctech/',
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '29515 Canvasback Drive',
    addressLocality: 'Easton',
    addressRegion: 'MD',
    postalCode: '21601',
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 38.7846,
    longitude: -76.0756,
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: '+1-800-309-0004',
      contactType: 'customer support',
      email: 'info@bdkinc.com',
      areaServed: 'US',
      availableLanguage: ['English'],
    },
    {
      '@type': 'ContactPoint',
      telephone: '+1-800-309-0004',
      contactType: 'sales',
      email: 'info@bdkinc.com',
      areaServed: 'US',
      availableLanguage: ['English'],
    },
  ],
};
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- JSON-LD Organization Schema -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(organizationSchema)}
  />

  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <Hero client:load />
    <Services client:visible services={servicesData} />
    <WhyChooseUs client:visible />
    <TrustShowcase client:visible />
    <Testimonials />
    <CTASection client:visible icon="click" />
  </main>

  <Footer />
</Layout>
