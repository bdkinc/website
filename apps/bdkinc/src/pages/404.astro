---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import Footer from '@/components/Footer.astro';
import EditSection from '@/components/preview/EditSection.astro';
import CTAButton from '@/components/CTAButton';
import { Card } from '@bdkinc/design-system';
import { getNavigationData } from '@/lib/navigation-data';
import { PiWarningCircle, PiHouse, PiArrowLeft } from 'react-icons/pi';

import { getPageCopy, getSettings, type ContentProps } from '@/lib/content';
interface Props extends ContentProps {}
const { contentContext, publicPath = Astro.url.pathname } = Astro.props;
const [copy, settings] = await Promise.all([getPageCopy('not-found', contentContext), getSettings(contentContext)]);
const { servicesData, recentPosts } = await getNavigationData(contentContext);
---

<Layout title={copy.metadata.title} contentContext={contentContext} publicPath={publicPath}>
  <EditSection record="settings" section="navigation">
    <Navigation
      client:load
      services={servicesData}
      blogPosts={recentPosts}
      currentPath={publicPath}
      copy={settings.navigation}
      brand={settings.brand}
    />
  </EditSection>

  <main id="main-content">
    <!-- 404 Hero Section -->
    <section
      class="relative flex min-h-screen items-center justify-center overflow-hidden px-4 py-16 sm:px-6 lg:px-8"
    >
      <!-- Background Effects -->
      <div class="gradient-mesh absolute inset-0 opacity-50"></div>
      <div class="circuit-overlay absolute inset-0 opacity-30"></div>

      <!-- Floating decorative elements -->
      <div
        class="bg-brand-primary/10 animate-float absolute top-20 left-10 h-20 w-20 rounded-full blur-xl"
      >
      </div>
      <div
        class="bg-brand-secondary/10 animate-float absolute right-10 bottom-20 h-32 w-32 rounded-full blur-xl"
        style="animation-delay: 2s;"
      >
      </div>

      <!-- Content -->
      <div class="relative z-10 mx-auto max-w-4xl text-center">
        <EditSection record="not-found" section="error">
        <!-- Error Icon with animation -->
        <div
          class="animate-in fade-in slide-in-from-bottom-4 fill-mode-both mb-8 duration-500"
        >
          <div class="inline-flex items-center justify-center">
            <PiWarningCircle
              className="icon-xl text-brand-primary animate-float"
            />
          </div>
        </div>

        <!-- 404 Number -->
        <h1
          class="text-foreground animate-in fade-in slide-in-from-bottom-4 fill-mode-both mb-4 text-7xl font-bold duration-500 md:text-9xl"
          style="animation-delay: 100ms;"
        >
          404
        </h1>

        <!-- Error Message -->
        <h2
          class="text-foreground animate-in fade-in slide-in-from-bottom-4 fill-mode-both mb-6 text-3xl font-bold duration-500 md:text-5xl"
          style="animation-delay: 200ms;"
        >
          {copy.error.heading}
        </h2>

        <!-- Description Card -->
        <div
          class="animate-in fade-in slide-in-from-bottom-4 fill-mode-both mb-12 duration-500"
          style="animation-delay: 300ms;"
        >
          <Card size="lg" interactive={false} className="mx-auto max-w-2xl">
            <p class="text-muted-foreground mb-6 text-lg">
              {copy.error.description}
            </p>

            <div
              class="flex flex-col items-center justify-center gap-4 sm:flex-row"
            >
              <!-- Go Home Button -->
              <CTAButton
                href="/"
                icon="none"
                className="bg-brand-primary hover:bg-brand-primary/90 text-primary-foreground group w-full gap-2 sm:w-auto"
                aria-label={copy.error.homeLabel}
              >
                <PiHouse
                  className="icon-sm transition-transform duration-300 group-hover:scale-110"
                />
                <span>{copy.error.homeText}</span>
              </CTAButton>

              <!-- Go Back Button -->
              <CTAButton
                icon="none"
                variant="outline"
                className="border-brand-primary text-brand-primary hover:bg-brand-primary/10 group w-full gap-2 sm:w-auto"
                type="button"
                data-back-button="true"
                aria-label={copy.error.backLabel}
              >
                <PiArrowLeft
                  className="icon-sm transition-transform duration-300 group-hover:-translate-x-1"
                />
                <span>{copy.error.backText}</span>
              </CTAButton>
            </div>
          </Card>
        </div>
        </EditSection>

        <EditSection record="not-found" section="helpfulLinks">
        <!-- Helpful Links -->
        <div
          class="animate-in fade-in slide-in-from-bottom-4 fill-mode-both duration-500"
          style="animation-delay: 400ms;"
        >
          <p class="text-muted-foreground mb-4">
            {copy.helpfulLinks.description}
          </p>
          <div class="flex flex-wrap justify-center gap-3">
            <a
              href="/services"
              class="text-brand-primary hover:text-brand-primary/80 transition-colors duration-300"
              aria-label={copy.helpfulLinks.services.label}
            >
              {copy.helpfulLinks.services.text}
            </a>
            <span class="text-muted-foreground/50">•</span>
            <a
              href="/about"
              class="text-brand-primary hover:text-brand-primary/80 transition-colors duration-300"
              aria-label={copy.helpfulLinks.about.label}
            >
              {copy.helpfulLinks.about.text}
            </a>
            <span class="text-muted-foreground/50">•</span>
            <a
              href="/blog"
              class="text-brand-primary hover:text-brand-primary/80 transition-colors duration-300"
              aria-label={copy.helpfulLinks.blog.label}
            >
              {copy.helpfulLinks.blog.text}
            </a>
            <span class="text-muted-foreground/50">•</span>
            <a
              href="/contact"
              class="text-brand-primary hover:text-brand-primary/80 transition-colors duration-300"
              aria-label={copy.helpfulLinks.contact.label}
            >
              {copy.helpfulLinks.contact.text}
            </a>
          </div>
        </div>
        </EditSection>
      </div>
    </section>
  </main>

  <Footer contentContext={contentContext} />
</Layout>

<script>
  // Handle Go Back button click
  const backButton = document.querySelector('[data-back-button="true"]');
  if (backButton) {
    backButton.addEventListener('click', (event) => {
      event.preventDefault();
      window.history.back();
    });
  }
</script>
