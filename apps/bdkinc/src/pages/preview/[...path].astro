---
import Home from '@/pages/index.astro';
import ItConsultation from '@/pages/campaigns/it-consultation.astro';
import About from '@/pages/about.astro';
import Services from '@/pages/services.astro';
import Blog from '@/pages/blog.astro';
import Contact from '@/pages/contact-us.astro';
import NotFound from '@/pages/404.astro';
import Maryland from '@/pages/locations/maryland-eastern-shore.astro';
import Delaware from '@/pages/locations/delaware-eastern-shore.astro';
import ApplicationDevelopment from '@/pages/services/application-development.astro';
import ArtificialIntelligence from '@/pages/services/artificial-intelligence.astro';
import BusinessAnalytics from '@/pages/business-analytics.astro';
import CloudHosting from '@/pages/cloud-services.astro';
import Cybersecurity from '@/pages/managed-cybersecurity.astro';
import EdiSolutions from '@/pages/electronic-data-interchange-edi.astro';
import HostedErp from '@/pages/hosted-erp.astro';
import IbmPower from '@/pages/ibm-power-servers.astro';
import IbmPowerSolutions from '@/pages/ibm-power-servers/ibm-solutions/ibm-power.astro';
import ManagedIt from '@/pages/managed-it.astro';
import UnlimitedHelpDesk from '@/pages/unlimited-help-desk.astro';
import DisasterRecoveryPlanning from '@/pages/disaster-recovery-planning.astro';
import Communications from '@/pages/communications.astro';
import TheBdkTeam from '@/pages/about/the-bdk-team.astro';
import BdkInTheCommunity from '@/pages/about/bdk-in-the-community.astro';
import PublicPrivateHosting from '@/pages/public-private-hosting.astro';
import IbmSolutions from '@/pages/ibm-power-servers/ibm-solutions/index.astro';
import IbmStorage from '@/pages/ibm-power-servers/ibm-solutions/ibm-storage.astro';
import IbmWatsonx from '@/pages/ibm-watsonx.astro';
import WpautotermsPrivacy from '@/pages/wpautoterms/privacy-policy.astro';
import WpautotermsTerms from '@/pages/wpautoterms/terms-and-conditions.astro';
import BlogPost from '@/pages/blog/[slug].astro';
import ServiceLocation from '@/pages/services/[service]/[location].astro';
import IndustryLocation from '@/pages/industries/[industry]/[location].astro';
import { resolvePreview, previewHeaders } from '@/lib/preview';
import { getBlogPostBySlug } from '@/lib/blog';
import type { ContentReader } from '@/lib/content';

export const prerender = false;
for (const [name, value] of Object.entries(previewHeaders))
  Astro.response.headers.set(name, value);
// Astro's spread param drops the trailing slash; bind the grant to the URL instead.
const { pathname } = Astro.url;
const previewPrefix = '/preview';
const publicPath = pathname === previewPrefix
  ? '/'
  : pathname.startsWith(`${previewPrefix}/`) ? pathname.slice(previewPrefix.length) : '';
const pages = {
  'campaign-it-consultation': ItConsultation,
  home: Home,
  about: About,
  services: Services,
  blog: Blog,
  contact: Contact,
  'not-found': NotFound,
  'location-maryland-eastern-shore': Maryland,
  'location-delaware-eastern-shore': Delaware,
  'service-application-development': ApplicationDevelopment,
  'service-artificial-intelligence': ArtificialIntelligence,
  'service-business-analytics': BusinessAnalytics,
  'service-cloud-hosting': CloudHosting,
  'service-cybersecurity': Cybersecurity,
  'service-edi-solutions': EdiSolutions,
  'service-hosted-erp': HostedErp,
  'service-ibm-power': IbmPower,
  'ibm-power-solutions': IbmPowerSolutions,
  'service-managed-it': ManagedIt,
  'unlimited-help-desk': UnlimitedHelpDesk,
  'disaster-recovery-planning': DisasterRecoveryPlanning,
  communications: Communications,
  'the-bdk-team': TheBdkTeam,
  'bdk-in-the-community': BdkInTheCommunity,
  'public-private-hosting': PublicPrivateHosting,
  'ibm-solutions': IbmSolutions,
  'ibm-storage': IbmStorage,
  'ibm-watsonx': IbmWatsonx,
  'wpautoterms-privacy': WpautotermsPrivacy,
  'wpautoterms-terms': WpautotermsTerms,
};
let contentContext;
let route;
let post;
let reader: ContentReader;
try {
  if (!publicPath) throw new Error('Invalid preview path.');
  const resolved = await resolvePreview(
    Astro.url.searchParams.get('token') || '',
    publicPath
  );
  contentContext = resolved.context;
  route = resolved.route;
  reader = resolved.reader;
  if (route.template === 'blog-post') {
    post = await getBlogPostBySlug(route.slug, reader);
    if (!post) throw new Error('Post unavailable.');
  }
} catch {
  return new Response('Preview authorization failed or expired.', {
    status: 401,
    headers: previewHeaders,
  });
}
// Concept A retires the shared privacy/terms keys (getPagePaths), so no signed A route resolves to them.
const PageTemplate =
  route.template === 'page' ? pages[route.pageKey as Exclude<typeof route.pageKey, 'privacy' | 'terms'>] : undefined;
---

{
  PageTemplate && (
    <PageTemplate
      reader={reader}
      contentContext={contentContext}
      publicPath={publicPath}
    />
  )
}
{
  route.template === 'blog-post' && post && (
    <BlogPost
      reader={reader}
      post={post}
      contentContext={contentContext}
      publicPath={publicPath}
    />
  )
}
{
  route.template === 'service-location' && (
    <ServiceLocation
      reader={reader}
      {...route}
      contentContext={contentContext}
      publicPath={publicPath}
    />
  )
}
{
  route.template === 'industry-location' && (
    <IndustryLocation
      reader={reader}
      {...route}
      contentContext={contentContext}
      publicPath={publicPath}
    />
  )
}
