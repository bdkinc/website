---
import BlogPost from '@/pages/blog/[slug].astro';
import { getBlogPostBySlug } from '@/lib/blog';
import { createAppContentReader } from '@/lib/content';
import { blogPostHref } from '@/lib/public-url';

const slug = 'cybersecurity-best-practices';
const reader = createAppContentReader();
const post = await getBlogPostBySlug(slug, reader);
if (!post) throw new Error(`Missing published blog post: ${slug}`);
---

<BlogPost {post} {reader} publicPath={blogPostHref(slug)} />
