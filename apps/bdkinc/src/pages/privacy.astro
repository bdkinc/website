---
import { getConceptAContentAliasTarget } from '@bdkinc/content/routes';
import { createAppContentReader } from '@/lib/content';
import { slashPagePath } from '@/lib/public-url';

// Retired in Concept A: the shared 'privacy' record stays for the review concepts only.
export const prerender = false;
const target = await getConceptAContentAliasTarget(createAppContentReader(), '/privacy');
if (!target) return new Response(null, { status: 404 });
return Astro.redirect(slashPagePath(target), 301);
---
