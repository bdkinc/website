---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { Card } from '@bdkinc/design-system';
import { getNavigationData } from '@/lib/navigation-data';
import Footer from '@/components/Footer.astro';
import { PiShield } from 'react-icons/pi';
import EditSection from '@/components/preview/EditSection.astro';
import { createAppContentReader, type ContentProps } from '@/lib/content';
interface Props extends ContentProps {}
const { contentContext, publicPath = Astro.url.pathname, reader: suppliedReader } = Astro.props;
const reader = suppliedReader ?? createAppContentReader(contentContext);
const [copy, settings] = await Promise.all([reader.getPage('privacy'), reader.getSettings()]);
const { servicesData, recentPosts } = await getNavigationData(reader);
// Section identities, paragraph counts, and list structure remain code-owned.
const sections = [
  { id: 'information-we-collect', heading: copy.informationWeCollect.heading, paragraphs: [copy.informationWeCollect.introduction], items: [copy.informationWeCollect.contactDetails, copy.informationWeCollect.professionalDetails, copy.informationWeCollect.preferences, copy.informationWeCollect.technicalDetails] },
  { id: 'how-we-use', heading: copy.howWeUse.heading, paragraphs: [copy.howWeUse.introduction], items: [copy.howWeUse.services, copy.howWeUse.inquiries, copy.howWeUse.marketing, copy.howWeUse.analysis, copy.howWeUse.security] },
  { id: 'information-sharing', heading: copy.informationSharing.heading, paragraphs: [copy.informationSharing.providers, copy.informationSharing.disclosure] },
  { id: 'data-security', heading: copy.dataSecurity.heading, paragraphs: [copy.dataSecurity.measures, copy.dataSecurity.limitations] },
  { id: 'your-rights', heading: copy.yourRights.heading, paragraphs: [copy.yourRights.introduction], items: [copy.yourRights.access, copy.yourRights.correction, copy.yourRights.deletion, copy.yourRights.objection, copy.yourRights.portability], after: copy.yourRights.exercise },
  { id: 'cookies-tracking', heading: copy.cookiesTracking.heading, paragraphs: [copy.cookiesTracking.usage, copy.cookiesTracking.controls, copy.cookiesTracking.analytics] },
  { id: 'third-party-links', heading: copy.thirdPartyLinks.heading, paragraphs: [copy.thirdPartyLinks.body] },
  { id: 'childrens-privacy', heading: copy.childrensPrivacy.heading, paragraphs: [copy.childrensPrivacy.body] },
  { id: 'changes-to-policy', heading: copy.changesToPolicy.heading, paragraphs: [copy.changesToPolicy.body] },
];
// Anchor ids are the kebab-case of their editorial field keys.
const fieldKey = (id: string) => id.replace(/-(.)/g, (_, letter: string) => letter.toUpperCase());
const tocItems = [...sections.map(({ id, heading }) => ({ id, label: heading })), { id: 'contact-us', label: copy.contactUs.heading }];
---

<Layout reader={reader} title={copy.metadata.title} description={copy.metadata.description} contentContext={contentContext} publicPath={publicPath}>
  <EditSection record="settings" section="navigation">
    <Navigation client:load services={servicesData} blogPosts={recentPosts} currentPath={publicPath} copy={settings.navigation} brand={settings.brand} />
  </EditSection>
  <main id="main-content">
    <EditSection record="privacy" section="hero">
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <div class="gradient-mesh absolute inset-0 opacity-30"></div>
      <div class="circuit-overlay absolute inset-0 opacity-40"></div>
      <div class="relative z-10 mx-auto flex max-w-4xl flex-col items-center text-center">
        <div class="glass border-primary/20 animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500">
          <span class="text-sm">{copy.hero.badgeLead}{' '}<span class="font-semibold text-[--accent]">{copy.hero.badgeAccent}</span>{' '}{copy.hero.badgeEnd}</span>
        </div>
        <div class="bg-primary/10 mb-6 inline-flex items-center justify-center rounded-lg p-4">
          <PiShield className="text-primary h-10 w-10" />
        </div>
        <h1 class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 mb-6 text-5xl font-bold duration-700 md:text-6xl">
          <span class="text-foreground">{copy.hero.headingLead}{' '}</span>
          <span class="to-secondary from-primary bg-linear-to-br bg-clip-text text-transparent">{copy.hero.headingAccent}</span>
        </h1>
        <p class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-6 mb-4 text-lg leading-relaxed delay-200 duration-700">{copy.hero.description}</p>
        <p class="text-muted-foreground/70 text-sm">{copy.hero.updatedLabel}{' '}{copy.hero.updatedDate}</p>
      </div>
      <div class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-gradient-to-r to-[--accent]/50"></div>
    </section>
    </EditSection>
    <section class="px-4 py-12 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-8 lg:grid-cols-4">
          <aside class="lg:col-span-1">
            <div class="sticky top-24">
              <EditSection record="privacy" section="contents">
              <Card className="fill-mode-both animate-in fade-in slide-in-from-left-8 duration-700" size="lg" interactive={false}>
                <nav class="space-y-1">
                  <p class="text-foreground mb-4 text-sm font-semibold tracking-widest">{copy.contents.heading}</p>
                  <ul class="space-y-2">
                    {tocItems.map((item) => <li><a href={`#${item.id}`} class="text-muted-foreground hover:text-primary block py-1 text-sm transition-colors duration-200">{item.label}</a></li>)}
                  </ul>
                </nav>
              </Card>
              </EditSection>
            </div>
          </aside>
          <article class="space-y-12 lg:col-span-3">
            {sections.map((section) => <EditSection record="privacy" section={fieldKey(section.id)}><section id={section.id}>
              <h2 class="text-foreground mb-4 text-3xl font-bold">{section.heading}</h2>
              {section.paragraphs.map((paragraph, index) => <p class:list={['text-muted-foreground leading-relaxed', { 'mb-4': index < section.paragraphs.length - 1 || !!section.items }]}>{paragraph}</p>)}
              {section.items && <ul class="text-muted-foreground ml-4 space-y-2">{section.items.map((item) => <li class="flex gap-3"><span class="text-primary flex-shrink-0">•</span><span>{item}</span></li>)}</ul>}
              {section.id === 'your-rights' && <p class="text-muted-foreground mt-4 leading-relaxed">{section.after}</p>}
            </section></EditSection>)}
            <EditSection record="privacy" section="contactUs">
            <section id="contact-us">
              <h2 class="text-foreground mb-4 text-3xl font-bold">{copy.contactUs.heading}</h2>
              <p class="text-muted-foreground mb-6 leading-relaxed">{copy.contactUs.introduction}</p>
              <Card className="bg-card/50 border-primary/20" size="lg" interactive={false}>
                <div class="space-y-3">
                  <div><p class="text-foreground font-semibold">{copy.contactUs.organization}</p></div>
                  <div><p class="text-muted-foreground text-sm">{copy.contactUs.emailLabel}</p><a href={copy.contactUs.emailUrl} class="text-primary hover:text-primary/80 transition-colors">{copy.contactUs.email}</a></div>
                  <div><p class="text-muted-foreground text-sm">{copy.contactUs.phoneLabel}</p><a href={copy.contactUs.phoneUrl} class="text-primary hover:text-primary/80 transition-colors">{copy.contactUs.phone}</a></div>
                </div>
              </Card>
            </section>
            </EditSection>
          </article>
        </div>
      </div>
    </section>
  </main>
  <Footer reader={reader} contentContext={contentContext} />
</Layout>
