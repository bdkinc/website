---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import { getNavigationData } from '@/lib/navigation-data';
import { getContentCollection, getPageCopy, getSettings, type ContentProps } from '@/lib/content';
import InteractiveServiceCard from '@/components/InteractiveServiceCard';
import CTASection from '@/components/CTASection';
import Footer from '@/components/Footer.astro';
import PageHeroEffects from '@/components/PageHeroEffects';
import EditSection from '@/components/preview/EditSection.astro';

interface Props extends ContentProps {}
const { contentContext, publicPath = Astro.url.pathname } = Astro.props;
const [copy, settings] = await Promise.all([getPageCopy('services', contentContext), getSettings(contentContext)]);
const { servicesData, recentPosts } = await getNavigationData(contentContext);

// Get all services from the content collection
const allServices = await getContentCollection('services', contentContext);
// Sort by order field
const services = allServices.sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title={copy.metadata.title}
  contentContext={contentContext}
  publicPath={publicPath}
>
  <EditSection record="settings" section="navigation">
    <Navigation
      client:load
      services={servicesData}
      blogPosts={recentPosts}
      currentPath={publicPath}
      copy={settings.navigation}
      brand={settings.brand}
    />
  </EditSection>
  <main id="main-content">
    <!-- Hero Section -->
    <EditSection record="services" section="hero">
    <section class="relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <PageHeroEffects client:idle />
      <div class="relative z-10 mx-auto max-w-7xl text-center">
        {/* Badge */}
        <div
          class="glass border-primary/20 animate-in fade-in slide-in-from-top-4 fill-mode-both mb-6 inline-flex items-center rounded-full border px-4 py-2 backdrop-blur-xl duration-500"
        >
          <span class="text-sm">
            <span class="font-semibold text-[--accent]">{copy.hero.badgeAccent}</span>{' '}{copy.hero.badgeEnd}
          </span>
        </div>

        <h1
          class="fill-mode-both animate-in fade-in slide-in-from-top-6 mb-4 text-5xl font-bold delay-100 duration-700 md:text-6xl"
        >
          <span class="text-foreground">{copy.hero.headingLead}{' '}</span>
          <span
            class="from-primary to-secondary bg-linear-to-br bg-clip-text text-transparent"
            >{copy.hero.headingAccent}</span
          >
        </h1>
        <p
          class="text-muted-foreground fill-mode-both animate-in fade-in slide-in-from-bottom-4 mx-auto max-w-2xl text-xl delay-200 duration-600"
        >
          {copy.hero.description}
        </p>
      </div>
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-gradient-to-r to-[--accent]/50"
      >
      </div>
    </section>
    </EditSection>

    <!-- Services Grid Section -->
    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        {/* 3x3 Grid Layout */}
        <div
          class="grid auto-rows-fr grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
        >
          {
            services.map((service, index) => {
              return (
                <InteractiveServiceCard
                  client:visible
                  id={service.id}
                  title={service.data.title}
                  description={service.data.description}
                  icon={service.data.icon}
                  index={index}
                />
              );
            })
          }
        </div>
      </div>
    </section>

    {/* CTA Section */}
    <EditSection record="services" section="cta">
      <CTASection
        client:visible
        copy={settings.cta}
        title={copy.cta.title}
        description={copy.cta.description}
        buttonText={copy.cta.buttonText}
        buttonHref={copy.cta.buttonHref}
        icon="mail"
      />
    </EditSection>
  </main>

  <Footer contentContext={contentContext} />
</Layout>
