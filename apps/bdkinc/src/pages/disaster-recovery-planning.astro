---
import {
  PiArrowCounterClockwise,
  PiHardDrives,
} from 'react-icons/pi';
import type { ContentProps } from '@/lib/content';
import ServiceChildPage from '@/components/ServiceChildPage.astro';
interface Props extends ContentProps {}
---

<ServiceChildPage
  {...Astro.props}
  pageKey="disaster-recovery-planning"
  icon={PiArrowCounterClockwise}
  featureIcons={{
    offsiteBackups: 'CloudArrowUp',
    encryptionImmutability: 'Lock',
    recoveryObjectives: 'Timer',
    planTesting: 'ListChecks',
  }}
  detailIcon={PiHardDrives}
/>
