---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import ContactChat from '@bdkinc/design-system/contact-chat';
import { getNavigationData } from '@/lib/navigation-data';
import Footer from '@/components/Footer.astro';
import { TechCard } from '@/components/TechCard';
import { PiPhone, PiEnvelope, PiMapPin, PiHeadset } from 'react-icons/pi';
import { referrerSuggestions } from '@/actions';
import PageHeroEffects from '@/components/PageHeroEffects';
import EditSection from '@/components/preview/EditSection.astro';
import { createAppContentReader, type ContentProps } from '@/lib/content';
interface Props extends ContentProps {}
const { contentContext, publicPath = Astro.url.pathname, reader: suppliedReader } = Astro.props;
const reader = suppliedReader ?? createAppContentReader(contentContext);
export const prerender = false;
const [copy, settings] = await Promise.all([reader.getPage('contact'), reader.getSettings()]);
const { servicesData, recentPosts } = await getNavigationData(reader);
// Reuse this render's copy with the same query-param/referer precedence.
const fromParam = Astro.url.searchParams.get('from');
let initialSuggestions;
try {
  initialSuggestions = referrerSuggestions(copy.referrerSuggestions, fromParam || Astro.request.headers.get('referer'));
} catch (error) {
  // The former public action reported handler errors and used these page suggestions.
  if (contentContext) throw error;
  initialSuggestions = [
    copy.chat.pageFallbackSuggestions.consultation,
    copy.chat.pageFallbackSuggestions.assessment,
    copy.chat.pageFallbackSuggestions.managedServices,
    copy.chat.pageFallbackSuggestions.cloud,
  ];
}
---

<Layout reader={reader} title={copy.metadata.title} contentContext={contentContext} publicPath={publicPath}>
  <EditSection record="settings" section="navigation">
    <Navigation
      client:load
      services={servicesData}
      blogPosts={recentPosts}
      currentPath={publicPath}
      copy={settings.navigation}
      brand={settings.brand}
    />
  </EditSection>
  <main id="main-content">
    {/* HERO Section: Background + Text + Gradient Border */}
    <EditSection record="contact" section="hero">
    <section class="relative overflow-hidden px-4 pt-24 pb-24 sm:px-6 lg:px-8">
      <PageHeroEffects client:idle />
      <div class="relative z-10">
        {/* Text block */}
        <div class="mx-auto max-w-4xl text-center">
          <div
            class="fill-mode-both animate-in fade-in slide-in-from-bottom-8 duration-700"
          >
            <div
              class="border-primary/20 bg-background/40 text-muted-foreground mb-6 inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-semibold tracking-wide backdrop-blur-md"
            >
              <div class="text-foreground/80">
                {copy.hero.badgeLead}{' '}<span class="text-accent">{copy.hero.badgeAccent}</span>
              </div>
            </div>
          </div>
          <h1
            class="mb-5 text-4xl font-bold tracking-tight md:text-5xl lg:text-6xl"
          >
            <span class="text-foreground">{copy.hero.headingLead}{' '}</span>
            <span
              class="from-brand-primary to-brand-secondary bg-linear-to-br bg-clip-text text-transparent"
            >
              {copy.hero.headingAccent}
            </span>
          </h1>
          <p
            class="text-muted-foreground mx-auto max-w-2xl text-xl leading-relaxed"
          >
            {copy.hero.description}
          </p>
          <div
            class="text-muted-foreground mt-8 flex flex-wrap justify-center gap-x-6 gap-y-3 text-sm"
          >
            <div class="flex items-center gap-2">
              <div class="bg-primary/60 h-1.5 w-1.5 rounded-full"></div>
              <span>{copy.hero.responsePromise}</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="bg-secondary/60 h-1.5 w-1.5 rounded-full"></div>
              <span>{copy.hero.invitation}</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="h-1.5 w-1.5 rounded-full bg-emerald-500/60"></div>
              <span>{copy.hero.technology}</span>
            </div>
          </div>
        </div>
      </div>
      {/* Gradient border at bottom of hero */}
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--accent]/50"
      >
      </div>
    </section>
    </EditSection>
  </main>
  {/* CHAT Section: Mostly below hero, slight overlap at top */}
  <EditSection record="contact" section="chat" also={['referrerSuggestions']}>
  <section
    id="chat"
    aria-label={copy.chat.sectionLabel}
    class="relative z-20 -mt-16 px-4 pb-24 sm:px-6 lg:px-8"
  >
    <div class="mx-auto max-w-5xl">
      <div
        class="fill-mode-both animate-in fade-in slide-in-from-bottom-6 delay-150 duration-700"
      >
        <ContactChat
          client:only="react"
          initialSuggestions={initialSuggestions}
          copy={copy.chat}
        />
      </div>
    </div>
  </section>
  </EditSection>
  {/* Secondary content: Contact cards BELOW chat */}
  <EditSection record="contact" section="directContact">
  <section class="bg-muted/5 relative px-4 py-14 sm:px-6 lg:px-8">
    {/* Faded Border Separator */}
    <div
      class="via-border/60 absolute top-0 left-1/2 h-px w-full -translate-x-1/2 bg-linear-to-r from-transparent to-transparent"
    >
    </div>
    <div class="mx-auto max-w-7xl">
      <div class="mb-16 text-center">
        <h2
          class="text-foreground text-3xl font-bold tracking-tight md:text-4xl"
        >
          <span class="text-foreground">{copy.directContact.headingLead}{' '}</span>
          <span class="gradient-primary bg-clip-text text-transparent"
            >{copy.directContact.headingAccent}</span
          >
        </h2>
        <p class="text-muted-foreground mx-auto mt-4 max-w-2xl text-lg">
          {copy.directContact.description}
        </p>
      </div>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
        {/* PHONE */}
        <TechCard
          variant="technical"
          interactive
          client:visible
          delay={100}
          className="h-full"
          asChild
        >
          <a
            href={copy.directContact.phone.linkUrl}
            class="flex h-full flex-col items-center text-center"
          >
            <div
              class="bg-primary/10 text-brand-primary mb-6 inline-flex h-12 w-12 items-center justify-center rounded-lg"
            >
              <PiPhone className="h-6 w-6" />
            </div>
            <h3
              class="text-muted-foreground mb-1 text-xs font-bold tracking-wider"
            >
              {copy.directContact.phone.label}
            </h3>
            <span
              class="text-foreground group-hover:text-brand-primary text-xl font-bold transition-colors"
            >
              {copy.directContact.phone.value}
            </span>
            <span class="text-muted-foreground mt-1 text-sm"
              >{copy.directContact.phone.availability}</span
            >
          </a>
        </TechCard>
        {/* EMAIL */}
        <TechCard
          variant="technical"
          interactive
          client:visible
          delay={200}
          className="h-full"
          asChild
        >
          <a
            href={copy.directContact.email.linkUrl}
            class="flex h-full flex-col items-center text-center"
          >
            <div
              class="bg-primary/10 text-brand-primary mb-6 inline-flex h-12 w-12 items-center justify-center rounded-lg"
            >
              <PiEnvelope className="h-6 w-6" />
            </div>
            <h3
              class="text-muted-foreground mb-1 text-xs font-bold tracking-wider"
            >
              {copy.directContact.email.label}
            </h3>
            <span
              class="text-foreground group-hover:text-brand-primary text-xl font-bold transition-colors"
            >
              {copy.directContact.email.value}
            </span>
            <span class="text-muted-foreground mt-1 text-sm"
              >{copy.directContact.email.description}</span
            >
          </a>
        </TechCard>
        {/* HEADQUARTERS */}
        <TechCard
          variant="technical"
          interactive
          client:visible
          delay={300}
          className="h-full"
          asChild
        >
          <a
            href={copy.directContact.headquarters.mapUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-full flex-col items-center text-center"
          >
            <div
              class="bg-primary/10 text-brand-primary mb-6 inline-flex h-12 w-12 items-center justify-center rounded-lg"
            >
              <PiMapPin className="h-6 w-6" />
            </div>
            <h3
              class="text-muted-foreground mb-1 text-xs font-bold tracking-wider"
            >
              {copy.directContact.headquarters.label}
            </h3>
            <span
              class="text-foreground group-hover:text-brand-primary text-xl font-bold transition-colors"
            >
              {copy.directContact.headquarters.location}
            </span>
            <span class="text-muted-foreground mt-1 text-sm"
              >{copy.directContact.headquarters.address}</span
            >
          </a>
        </TechCard>
        {/* SUPPORT */}
        <TechCard
          variant="technical"
          interactive
          client:visible
          delay={400}
          className="h-full"
        >
          <div class="flex h-full flex-col items-center text-center">
            <div
              class="bg-primary/10 text-brand-primary mb-6 inline-flex h-12 w-12 items-center justify-center rounded-lg"
            >
              <PiHeadset className="h-6 w-6" />
            </div>
            <h3
              class="text-muted-foreground mb-1 text-xs font-bold tracking-wider"
            >
              {copy.directContact.support.label}
            </h3>
            <div class="text-foreground text-xl font-bold">
              {copy.directContact.support.description}
            </div>
            <div
              class="text-muted-foreground mt-1 flex items-center gap-2 text-sm"
            >
              <div class="h-1.5 w-1.5 rounded-full bg-emerald-500"></div>
              <span>{copy.directContact.support.status}</span>
            </div>
          </div>
        </TechCard>
      </div>
    </div>
  </section>
  </EditSection>
  <Footer reader={reader} contentContext={contentContext} />
</Layout>
