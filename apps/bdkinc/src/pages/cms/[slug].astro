---
import Layout from '@/layouts/Layout.astro';
import { getPageBySlug } from '@/lib/cms';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

const page = await getPageBySlug(slug);

if (!page) {
  return Astro.redirect('/404');
}
---

<Layout
  title={page.seoTitle || `${page.title} | BDKinc`}
  description={
    page.seoDescription ||
    'Managed IT, cloud, and software services from the BDKinc team.'
  }
>
  <main class="mx-auto max-w-4xl px-6 py-20">
    <p class="text-muted-foreground mb-3 text-sm uppercase tracking-[0.18em]">
      CMS Page
    </p>
    <h1 class="text-foreground text-4xl font-bold tracking-tight md:text-5xl">
      {page.heroHeading || page.title}
    </h1>
    {page.heroBody && (
      <p class="text-muted-foreground mt-6 max-w-2xl text-lg leading-relaxed">
        {page.heroBody}
      </p>
    )}
  </main>
</Layout>
