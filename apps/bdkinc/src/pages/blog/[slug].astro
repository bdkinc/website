---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import CTASection from '@/components/CTASection';
import { PiCalendar, PiUser, PiTag, PiArrowLeft } from 'react-icons/pi';
import { getNavigationData } from '@/lib/navigation-data';
import Footer from '@/components/Footer.astro';
import { getBlogPosts } from '@/lib/blog';
import { renderMarkdownToHtml } from '@/lib/markdown';

export async function getStaticPaths() {
  const blogPosts = await getBlogPosts();
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

export const prerender = true;

interface Props {
  post: {
    slug: string;
    title: string;
    description: string;
    author: string;
    pubDate: Date;
    tags: string[];
    content: string;
  };
}

const { post } = Astro.props;
const contentHtml = renderMarkdownToHtml(post.content);

const { servicesData, recentPosts } = await getNavigationData();

// Format date helper
function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
}
---

<Layout title={`${post.title} - BDKinc Blog`}>
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={Astro.url.pathname}
  />
  <main id="main-content">
    <!-- Blog Post Header -->
    <section class="relative overflow-hidden bg-background px-4 pt-24 pb-12 sm:px-6 lg:px-8">
      <!-- Fade overlays (Base) -->
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-background/10 to-background/65"></div>
      <div class="radial-vignette pointer-events-none absolute inset-0"></div>
      <div class="noise-texture pointer-events-none absolute inset-0 opacity-[0.06] mix-blend-overlay"></div>

      <!-- Grid -->
      <div class="blog-hero-dots pointer-events-none absolute inset-0"></div>

      <!-- Orbs (Top Layer, immediately behind text) -->
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div class="blog-orb blog-orb-1 absolute"></div>
        <div class="blog-orb blog-orb-2 absolute"></div>
        <div class="blog-orb blog-orb-3 absolute"></div>
      </div>

      <div class="relative z-10 mx-auto max-w-4xl">
        <a
          href="/blog"
          class="text-primary hover:text-primary/80 animate-in fade-in slide-in-from-bottom-3 fill-mode-both mb-8 inline-flex items-center gap-2 transition-colors delay-100 duration-500"
        >
          <PiArrowLeft className="h-4 w-4" />
          Back to Blog
        </a>

        <h1
          transition:name={`blog-title-${post.slug}`}
          transition:animate="initial"
          class="text-foreground mb-6 text-4xl font-bold md:text-5xl lg:text-6xl"
        >
          {post.title}
        </h1>

        <div
          class="text-muted-foreground animate-in fade-in slide-in-from-bottom-3 fill-mode-both mb-6 flex flex-wrap items-center gap-6 delay-300 duration-500"
        >
          <div class="flex items-center gap-2">
            <PiCalendar className="h-5 w-5" />
            <time datetime={post.pubDate.toISOString()}>
              {formatDate(post.pubDate)}
            </time>
          </div>
          <div class="flex items-center gap-2">
            <PiUser className="h-5 w-5" />
            <span>{post.author}</span>
          </div>
        </div>

        {
          post.tags && post.tags.length > 0 && (
            <div class="animate-in fade-in slide-in-from-bottom-2 fill-mode-both mb-8 flex flex-wrap gap-2 delay-500 duration-500">
              {post.tags.map((tag: string) => (
                <span class="text-primary/70 inline-flex items-center gap-1 px-3 py-1 text-sm">
                  <PiTag className="w-3 h-3" />
                  {tag}
                </span>
              ))}
            </div>
          )
        }

        <p
          transition:name={`blog-description-${post.slug}`}
          transition:animate="initial"
          class="text-muted-foreground text-xl"
        >
          {post.description}
        </p>
      </div>
      <div
        class="from-brand-primary to-brand-secondary absolute right-0 bottom-0 left-0 h-2 bg-linear-to-br"
      >
      </div>
    </section>

    <style>
      .blog-orb {
        filter: blur(60px);
        border-radius: 9999px;
        opacity: 0.95;
        animation-duration: 25s;
        animation-timing-function: ease-in-out;
        animation-iteration-count: infinite;
        animation-direction: alternate;
        will-change: transform;
      }

      .blog-orb-1 {
        top: -10%;
        left: -5%;
        width: 55%;
        height: 65%;
        background: radial-gradient(
          circle at 40% 40%,
          oklch(0.65 0.18 210 / 0.52) 0%,
          oklch(0.65 0.18 210 / 0.2) 45%,
          transparent 75%
        );
        animation-name: orb-float-1;
      }

      .blog-orb-2 {
        right: -5%;
        bottom: -10%;
        width: 55%;
        height: 65%;
        background: radial-gradient(
          circle at 60% 60%,
          oklch(0.65 0.22 280 / 0.46) 0%,
          oklch(0.65 0.22 280 / 0.18) 45%,
          transparent 75%
        );
        animation-name: orb-float-2;
        animation-delay: -7s;
      }

      .blog-orb-3 {
        top: 20%;
        left: 25%;
        width: 45%;
        height: 55%;
        background: radial-gradient(
          circle at 50% 50%,
          oklch(0.7 0.18 45 / 0.38) 0%,
          oklch(0.7 0.18 45 / 0.14) 45%,
          transparent 75%
        );
        animation-name: orb-float-3;
        animation-delay: -14s;
      }

      :global(.dark) .blog-orb-1 {
        background: radial-gradient(
          circle at 40% 40%,
          oklch(0.7 0.18 210 / 0.56) 0%,
          oklch(0.7 0.18 210 / 0.22) 45%,
          transparent 75%
        );
      }

      :global(.dark) .blog-orb-2 {
        background: radial-gradient(
          circle at 60% 60%,
          oklch(0.7 0.22 280 / 0.5) 0%,
          oklch(0.7 0.22 280 / 0.22) 45%,
          transparent 75%
        );
      }

      :global(.dark) .blog-orb-3 {
        background: radial-gradient(
          circle at 50% 50%,
          oklch(0.75 0.18 45 / 0.42) 0%,
          oklch(0.75 0.18 45 / 0.18) 45%,
          transparent 75%
        );
      }

      .blog-hero-dots {
        background-image: radial-gradient(oklch(0.4 0 0 / 0.1) 1.5px, transparent 1.5px);
        background-size: 28px 28px;
        background-position: center;
        mask-image: linear-gradient(to bottom, black 30%, transparent 100%);
      }

      :global(.dark) .blog-hero-dots {
        background-image: radial-gradient(oklch(0.9 0 0 / 0.1) 1.5px, transparent 1.5px);
      }

      .radial-vignette {
        background: radial-gradient(circle at center, transparent 40%, rgba(0, 0, 0, 0.05) 100%);
      }

      :global(.dark) .radial-vignette {
        background: radial-gradient(circle at center, transparent 40%, rgba(0, 0, 0, 0.4) 100%);
      }

      @keyframes orb-float-1 {
        0% { transform: translate(0, 0) scale(1); }
        100% { transform: translate(8%, 12%) scale(1.1); }
      }

      @keyframes orb-float-2 {
        0% { transform: translate(0, 0) scale(1); }
        100% { transform: translate(-12%, -8%) scale(1.05); }
      }

      @keyframes orb-float-3 {
        0% { transform: translate(0, 0) scale(1); }
        100% { transform: translate(10%, -15%) scale(1.15); }
      }

      @media (prefers-reduced-motion: reduce) {
        .blog-orb { animation: none !important; }
      }

      @media (max-width: 768px) {
        .blog-orb { filter: blur(42px); }
        .blog-hero-dots { background-size: 20px 20px; }
      }
    </style>

    <!-- Featured Image Placeholder -->
    <section class="px-4 py-12 sm:px-6 lg:px-8">
      <div
        class="fill-mode-both animate-in fade-in zoom-in mx-auto max-w-4xl delay-400 duration-700"
      >
        <div
          class="glass border-primary/20 overflow-hidden rounded-2xl border shadow-lg"
        >
          <div
            class="from-primary/5 via-secondary/5 to-primary/5 flex aspect-video items-center justify-center bg-linear-to-br"
          >
            <div class="p-6 text-center">
              <div
                class="text-muted-foreground/40 mb-2 text-sm font-medium tracking-wider"
              >
                Featured Image Placeholder
              </div>
              <div class="text-muted-foreground/60 text-lg">
                Article Hero Image
              </div>
              <div class="text-muted-foreground/40 mt-2 text-xs">
                Recommended: 1200x675px
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Blog Post Content -->
    <article class="px-4 py-12 sm:px-6 lg:px-8">
      <div
        class="animate-in fade-in slide-in-from-bottom-4 fill-mode-both mx-auto max-w-4xl delay-200 duration-700"
      >
        <div class="prose prose-neutral prose-lg dark:prose-invert max-w-none">
          <Fragment set:html={contentHtml} />
        </div>
      </div>
    </article>

    <!-- Related CTA Section -->
    <CTASection
      client:visible
      title="Ready to Implement These Solutions?"
      description="Our team can help you apply these best practices to your business infrastructure."
      buttonText="Contact Us"
      buttonHref="/contact#chat"
    />
  </main>

  <Footer />
</Layout>
