---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import CTASection from '@/components/CTASection';
import { PiCalendar, PiUser, PiTag, PiArrowLeft } from 'react-icons/pi';
import { getNavigationData } from '@/lib/navigation-data';
import Footer from '@/components/Footer.astro';
import EditSection from '@/components/preview/EditSection.astro';
import { getBlogPostBySlug, type BlogPostContent } from '@/lib/blog';
import { getSiteRoutes } from '@bdkinc/content/routes';
import { createAppContentReader, type ContentProps } from '@/lib/content';

export async function getStaticPaths() {
  const reader = createAppContentReader();
  const routes = await getSiteRoutes(reader);
  return Promise.all(
    routes.filter((route) => route.template === 'blog-post').map(async (route) => {
      const post = await getBlogPostBySlug(route.slug, reader);
      if (!post) throw new Error('Published blog route is missing its post.');
      return { params: { slug: route.slug }, props: { post } };
    })
  );
}

export const prerender = true;

interface Props extends ContentProps {
  post: BlogPostContent;
}
const { post, contentContext, publicPath = Astro.url.pathname, reader: suppliedReader } = Astro.props;
const reader = suppliedReader ?? createAppContentReader(contentContext);
const contentHtml = post.content;
const [copy, settings] = await Promise.all([reader.getPage('blog'), reader.getSettings()]);
const { servicesData, recentPosts } = await getNavigationData(reader);

// Format date helper
function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
}

const siteOrigin = Astro.site?.origin ?? 'https://www.bdkinc.com';
const postUrl = new URL(publicPath, siteOrigin).toString();
const articleImage = post.image || copy.detail.image;
const articleAlt = post.imageAlt || (post.image ? `Editorial illustration for ${post.title}` : copy.detail.imageAlt);
const defaultImage = new URL(articleImage || settings.brand.favicon, siteOrigin).toString();
const publishedIso = post.pubDate.toISOString();

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: publishedIso,
  dateModified: publishedIso,
  author: {
    '@type': 'Person',
    name: post.author,
  },
  publisher: {
    '@type': 'Organization',
    name: settings.siteName,
    url: siteOrigin,
    logo: {
      '@type': 'ImageObject',
      url: defaultImage,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
  image: [defaultImage],
  url: postUrl,
  keywords: Array.isArray(post.tags) ? post.tags.join(', ') : undefined,
};
---

<Layout reader={reader}
  contentContext={contentContext}
  publicPath={publicPath}
  title={`${post.title} ${copy.detail.titleSuffix}`}
  description={post.description}
  ogType="article"
  ogTitle={post.title}
  ogDescription={post.description}
  ogImage={articleImage || undefined}
  ogImageAlt={articleAlt}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(blogPostingSchema)}
  />
  <EditSection record="settings" section="navigation">
  <Navigation
    client:load
    services={servicesData}
    blogPosts={recentPosts}
    currentPath={publicPath}
    copy={settings.navigation}
    brand={settings.brand}
  />
  </EditSection>
  <main id="main-content">
    <EditSection record="blog" section="detail">
    <!-- Blog Post Header -->
    <section
      class="bg-background relative overflow-hidden px-4 pt-24 pb-12 sm:px-6 lg:px-8"
    >
      <!-- Complex Background Gradients -->
      <div class="static-hero-gradient pointer-events-none absolute inset-0">
      </div>

      <!-- Fade overlays (Base) -->
      <div
        class="via-background/10 to-background/65 pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent"
      >
      </div>
      <div class="radial-vignette pointer-events-none absolute inset-0"></div>
      <div
        class="noise-texture pointer-events-none absolute inset-0 opacity-[0.06] mix-blend-overlay"
      >
      </div>

      <!-- Grid -->
      <div class="blog-hero-dots pointer-events-none absolute inset-0"></div>

      <!-- Orbital Data Network (Animated) -->
      <div
        class="pointer-events-none absolute inset-0 flex items-center justify-center overflow-hidden opacity-80 mix-blend-screen dark:mix-blend-color-dodge"
      >
        <!-- Outer Orbit (Secondary) -->
        <div
          class="orbit-ring orbit-ring-1 border-secondary/15 absolute aspect-square w-[750px] rounded-full border border-dashed md:w-[950px]"
        >
          <!-- Node 1 -->
          <div
            class="orbit-node-secondary absolute top-0 left-1/2 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-full"
          >
          </div>

          <!-- Node 2 (opposite side) -->
          <div
            class="orbit-node-secondary absolute bottom-0 left-1/2 h-2 w-2 -translate-x-1/2 translate-y-1/2 rounded-full opacity-60"
          >
          </div>
        </div>

        <!-- Mid Orbit (Accent) -->
        <div
          class="orbit-ring orbit-ring-mid border-accent/15 absolute aspect-square w-[550px] rounded-full border border-dotted md:w-[700px]"
        >
          <!-- Node 3 -->
          <div
            class="orbit-node-accent absolute top-1/2 left-0 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-full"
          >
          </div>
        </div>

        <!-- Inner Orbit (Primary) -->
        <div
          class="orbit-ring orbit-ring-2 border-primary/20 absolute aspect-square w-[350px] rounded-full border border-dashed md:w-[450px]"
        >
          <!-- Node 4 -->
          <div
            class="orbit-node-primary absolute top-1/2 right-0 h-2 w-2 translate-x-1/2 -translate-y-1/2 rounded-full"
          >
          </div>
        </div>

        <!-- Floating Data Packets -->
        <div
          class="particle-float particle-1 bg-primary/60 absolute h-1 w-1 rounded-full shadow-[0_0_8px_2px_rgba(0,212,255,0.4)]"
        >
        </div>
        <div
          class="particle-float particle-2 bg-accent/50 absolute h-1.5 w-1.5 rounded-full shadow-[0_0_10px_2px_rgba(255,165,0,0.3)]"
        >
        </div>
        <div
          class="particle-float particle-3 bg-secondary/70 absolute h-1 w-1 rounded-full shadow-[0_0_5px_1px_rgba(124,58,237,0.5)]"
        >
        </div>
        <div
          class="particle-float particle-4 bg-primary/40 absolute h-1.5 w-1.5 rounded-full shadow-[0_0_10px_2px_rgba(0,212,255,0.2)]"
        >
        </div>
      </div>

      <div class="relative z-10 mx-auto max-w-4xl">
        <a
          href="/blog"
          class="text-primary hover:text-primary/80 animate-in fade-in slide-in-from-bottom-3 fill-mode-both mb-8 inline-flex items-center gap-2 transition-colors delay-100 duration-500"
        >
          <PiArrowLeft className="h-4 w-4" />
          {copy.detail.backLabel}
        </a>

        <h1
          transition:name={`blog-title-${post.slug}`}
          transition:animate="initial"
          class="text-foreground mb-6 text-4xl font-bold md:text-5xl lg:text-6xl"
        >
          {post.title}
        </h1>

        <div
          class="text-muted-foreground animate-in fade-in slide-in-from-bottom-3 fill-mode-both mb-6 flex flex-wrap items-center gap-6 delay-300 duration-500"
        >
          <div class="flex items-center gap-2">
            <PiCalendar className="h-5 w-5" />
            <time datetime={post.pubDate.toISOString()}>
              {formatDate(post.pubDate)}
            </time>
          </div>
          <div class="flex items-center gap-2">
            <PiUser className="h-5 w-5" />
            <span>{post.author}</span>
          </div>
        </div>

        {
          post.tags && post.tags.length > 0 && (
            <div class="animate-in fade-in slide-in-from-bottom-2 fill-mode-both mb-8 flex flex-wrap gap-2 delay-500 duration-500">
              {post.tags.map((tag: string) => (
                <span class="text-primary/70 inline-flex items-center gap-1 px-3 py-1 text-sm">
                  <PiTag className="w-3 h-3" />
                  {tag}
                </span>
              ))}
            </div>
          )
        }

        <p
          transition:name={`blog-description-${post.slug}`}
          transition:animate="initial"
          class="text-muted-foreground text-xl"
        >
          {post.description}
        </p>
      </div>
      <!-- Bottom Ticker Border (Visual only) -->
      <div
        class="from-primary/50 via-secondary/50 absolute right-0 bottom-0 left-0 h-1 bg-linear-to-r to-[--accent]/50"
      >
      </div>
    </section>
    </EditSection>

    <style>
      /* Orbital Data Network Styles */
      .orbit-ring {
        transform-origin: center;
        will-change: transform;
      }
      .orbit-ring-1 {
        animation: spin-slow 45s linear infinite;
      }
      .orbit-ring-mid {
        animation: spin-slow 60s linear infinite reverse;
      }
      .orbit-ring-2 {
        animation: spin-slow-reverse 35s linear infinite;
      }

      @keyframes spin-slow {
        from {
          transform: rotate(0deg);
        }
        to {
          transform: rotate(360deg);
        }
      }
      @keyframes spin-slow-reverse {
        from {
          transform: rotate(360deg);
        }
        to {
          transform: rotate(0deg);
        }
      }

      .orbit-node-primary {
        box-shadow: 0 0 20px 4px oklch(0.65 0.2 210 / 0.8);
        background-color: oklch(0.65 0.2 210);
      }
      .orbit-node-secondary {
        box-shadow: 0 0 20px 4px oklch(0.65 0.2 280 / 0.8);
        background-color: oklch(0.65 0.2 280);
      }
      .orbit-node-accent {
        box-shadow: 0 0 20px 4px oklch(0.7 0.18 45 / 0.8);
        background-color: oklch(0.7 0.18 45);
      }

      :global(.dark) .orbit-node-primary {
        box-shadow: 0 0 30px 6px oklch(0.7 0.2 210 / 0.9);
        background-color: oklch(0.75 0.2 210);
      }
      :global(.dark) .orbit-node-secondary {
        box-shadow: 0 0 30px 6px oklch(0.7 0.2 280 / 0.9);
        background-color: oklch(0.75 0.2 280);
      }
      :global(.dark) .orbit-node-accent {
        box-shadow: 0 0 30px 6px oklch(0.75 0.18 45 / 0.9);
        background-color: oklch(0.8 0.18 45);
      }

      .particle-float {
        will-change: transform, opacity;
      }
      .particle-1 {
        top: 25%;
        left: 20%;
        animation: float-particle 12s ease-in-out infinite alternate;
      }
      .particle-2 {
        top: 65%;
        right: 15%;
        animation: float-particle 15s ease-in-out infinite alternate-reverse;
      }
      .particle-3 {
        bottom: 20%;
        left: 35%;
        animation: float-particle 18s ease-in-out infinite alternate;
      }
      .particle-4 {
        top: 35%;
        right: 35%;
        animation: float-particle 10s ease-in-out infinite alternate-reverse;
      }

      @keyframes float-particle {
        0% {
          transform: translate(0, 0) scale(1);
          opacity: 0.2;
        }
        50% {
          transform: translate(30px, -20px) scale(1.5);
          opacity: 0.8;
        }
        100% {
          transform: translate(-15px, 25px) scale(0.8);
          opacity: 0.2;
        }
      }

      .static-hero-gradient {
        background:
          radial-gradient(
            circle at 15% 15%,
            oklch(0.65 0.2 210 / 0.4) 0%,
            transparent 60%
          ),
          radial-gradient(
            circle at 85% 85%,
            oklch(0.65 0.2 280 / 0.3) 0%,
            transparent 60%
          );
      }

      :global(.dark) .static-hero-gradient {
        background:
          radial-gradient(
            circle at 15% 15%,
            oklch(0.7 0.2 210 / 0.5) 0%,
            transparent 60%
          ),
          radial-gradient(
            circle at 85% 85%,
            oklch(0.7 0.2 280 / 0.4) 0%,
            transparent 60%
          );
      }

      .radial-vignette {
        background: radial-gradient(
          circle at center,
          transparent 40%,
          rgba(0, 0, 0, 0.05) 100%
        );
      }

      :global(.dark) .radial-vignette {
        background: radial-gradient(
          circle at center,
          transparent 40%,
          rgba(0, 0, 0, 0.4) 100%
        );
      }

      .blog-hero-dots {
        background-image: radial-gradient(
          oklch(0.4 0 0 / 0.1) 1.5px,
          transparent 1.5px
        );
        background-size: 28px 28px;
        background-position: center;
        mask-image: linear-gradient(to bottom, black 30%, transparent 100%);
      }

      :global(.dark) .blog-hero-dots {
        background-image: radial-gradient(
          oklch(0.9 0 0 / 0.1) 1.5px,
          transparent 1.5px
        );
      }
    </style>

    <!-- Featured article illustration -->
    <section class="px-4 py-12 sm:px-6 lg:px-8">
      <div
        class="fill-mode-both animate-in fade-in zoom-in mx-auto max-w-4xl delay-400 duration-700"
      >
        <div
          class="glass border-primary/20 overflow-hidden rounded-2xl border shadow-lg"
        >
          {articleImage ? <img src={articleImage} alt={articleAlt} width="1200" height="675" decoding="async" class="aspect-video w-full object-cover" /> : <div
            class="from-primary/5 via-secondary/5 to-primary/5 flex aspect-video items-center justify-center bg-linear-to-br"
          >
            <div class="p-6 text-center">
              <div
                class="text-muted-foreground/40 mb-2 text-sm font-medium tracking-wider"
              >
                {copy.detail.placeholderTitle}
              </div>
              <div class="text-muted-foreground/60 text-lg">
                {copy.detail.placeholderDescription}
              </div>
              <div class="text-muted-foreground/40 mt-2 text-xs">
                {copy.detail.placeholderHint}
              </div>
            </div>
          </div>}
        </div>
      </div>
    </section>

    <!-- Blog Post Content -->
    <article class="px-4 py-12 sm:px-6 lg:px-8">
      <div
        class="animate-in fade-in slide-in-from-bottom-4 fill-mode-both mx-auto max-w-4xl delay-200 duration-700"
      >
        <div class="prose prose-neutral prose-lg dark:prose-invert max-w-none">
          <Fragment set:html={contentHtml} />
        </div>
      </div>
    </article>

    <!-- Related CTA Section -->
    <EditSection record="blog" section="detail">
      <CTASection
        client:visible
        copy={settings.cta}
        title={copy.detail.ctaTitle}
        description={copy.detail.ctaDescription}
        buttonText={copy.detail.ctaButtonText}
        buttonHref={copy.detail.ctaButtonHref}
      />
    </EditSection>
  </main>

  <Footer reader={reader} contentContext={contentContext} />
</Layout>
