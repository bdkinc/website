{
  "name": "bdkinc-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vp run @bdkinc/bdkinc#dev",
    "dev:site": "vp run @bdkinc/bdkinc#dev",
    "dev:editorial": "vp run @bdkinc/design-editorial#dev",
    "dev:systems": "vp run @bdkinc/design-systems#dev",
    "build": "vp run @bdkinc/bdkinc#build",
    "build:editorial": "vp run @bdkinc/design-editorial#build",
    "build:systems": "vp run @bdkinc/design-systems#build",
    "preview": "vp run @bdkinc/bdkinc#preview",
    "preview:editorial": "vp run @bdkinc/design-editorial#preview",
    "preview:systems": "vp run @bdkinc/design-systems#preview",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present"
  },
  "devDependencies": {
    "oxc-transform-react": "0.145.0",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0",
    "npm": ">=10"
  },
  "dependencies": {
    "baseline-browser-mapping": "^2.11.27",
    "caniuse-lite": "^1.0.30001814"
  }
}
